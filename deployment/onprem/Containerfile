FROM rust:1.77-bookworm AS builder

ARG STRUCTURAL_RELEASE_ID
ARG STRUCTURAL_SOURCE_SHA256

RUN test -n "$STRUCTURAL_RELEASE_ID" \
    && printf '%s\n' "$STRUCTURAL_SOURCE_SHA256" \
      | grep -Eq '^sha256:[0-9a-f]{64}$'
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates cmake g++ make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY native ./native
COPY implementation/phase1/mgt_hip_full_residual_ffi \
  ./implementation/phase1/mgt_hip_full_residual_ffi
COPY scripts/build_native_distribution.sh ./scripts/build_native_distribution.sh

RUN mkdir -p /tmp/structural-native-output \
    && scripts/build_native_distribution.sh \
      --backend cpu-only \
      --linkage static \
      --release-id "$STRUCTURAL_RELEASE_ID" \
      --source-sha256 "$STRUCTURAL_SOURCE_SHA256" \
      --output /tmp/structural-native-output/bundle

FROM debian:bookworm-slim AS runtime

ARG STRUCTURAL_RELEASE_ID
ARG STRUCTURAL_SOURCE_SHA256

LABEL org.opencontainers.image.title="Structural Native Workbench"
LABEL org.opencontainers.image.description="CPU-only Rust/C++ structural Workbench batch runtime"
LABEL org.opencontainers.image.version="$STRUCTURAL_RELEASE_ID"
LABEL org.opencontainers.image.revision="$STRUCTURAL_SOURCE_SHA256"

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 structural \
    && useradd --uid 65532 --gid 65532 --no-create-home \
      --shell /usr/sbin/nologin structural \
    && mkdir -p /opt/structural /workspace \
    && chown 65532:65532 /workspace

COPY --from=builder --chown=65532:65532 \
  /tmp/structural-native-output/bundle/payload/ /opt/structural/

ENV PATH="/opt/structural/bin:${PATH}"
USER 65532:65532
WORKDIR /workspace

ENTRYPOINT ["/opt/structural/bin/structural-workbench"]
CMD ["--version"]
