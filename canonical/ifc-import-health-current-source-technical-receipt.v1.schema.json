{
  "$defs": {
    "caseReceipt": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "$ref": "#/$defs/nonemptyString"
          },
          "type": "array",
          "uniqueItems": true
        },
        "case_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "import_health_contract_pass": {
          "type": "boolean"
        },
        "import_health_executed": {
          "type": "boolean"
        },
        "lane_kind": {
          "enum": [
            "clean",
            "dirty"
          ]
        },
        "license_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "parsed_record_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "record_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "report_path": {
          "pattern": "^implementation/phase1/release_evidence/productization/.+\\.json$",
          "type": "string"
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_path": {
          "pattern": "^implementation/phase1/release_evidence/productization/.+\\.json$",
          "type": "string"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "silent_import_loss_gate_pass": {
          "type": "boolean"
        },
        "source_byte_length": {
          "minimum": 1,
          "type": "integer"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "technical_contract_pass": {
          "type": "boolean"
        },
        "upstream_commit_sha": {
          "$ref": "#/$defs/commitSha"
        },
        "upstream_path": {
          "$ref": "#/$defs/nonemptyString"
        },
        "upstream_repository": {
          "$ref": "#/$defs/nonemptyString"
        },
        "visible_entity_accounting": {
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "lane_kind",
        "upstream_repository",
        "upstream_commit_sha",
        "upstream_path",
        "source_sha256",
        "source_byte_length",
        "license_id",
        "import_health_executed",
        "import_health_contract_pass",
        "silent_import_loss_gate_pass",
        "visible_entity_accounting",
        "record_count",
        "parsed_record_count",
        "result_path",
        "result_sha256",
        "report_path",
        "report_sha256",
        "technical_contract_pass",
        "blockers"
      ],
      "type": "object"
    },
    "commitSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "nonemptyString": {
      "minLength": 1,
      "type": "string"
    },
    "receiptBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/nonemptyString"
        },
        "schema_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit_matches": {
          "type": "boolean"
        },
        "source_commit_sha": {
          "$ref": "#/$defs/commitSha"
        }
      },
      "required": [
        "path",
        "sha256",
        "source_commit_sha",
        "source_commit_matches",
        "schema_version"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "stringList": {
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "$id": "https://structural-analysis.local/schemas/ifc-import-health-current-source-technical-receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_receipts": {
      "items": {
        "$ref": "#/$defs/caseReceipt"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "claim_boundary": {
      "$ref": "#/$defs/nonemptyString"
    },
    "claims": {
      "additionalProperties": false,
      "properties": {
        "commercial_use_authority": {
          "const": false
        },
        "immutable_source_and_license_byte_identity": {
          "type": "boolean"
        },
        "independent_reproduction": {
          "const": false
        },
        "phase3_quantity_credit": {
          "const": false
        },
        "product_legal_approval": {
          "const": false
        },
        "redistribution_authority": {
          "const": false
        },
        "release_authority": {
          "const": false
        },
        "same_operator_current_source_execution": {
          "type": "boolean"
        },
        "solver_ready_geometry_or_topology": {
          "const": false
        },
        "technical_silent_import_loss_zero": {
          "type": "boolean"
        },
        "text_scan_import_health_only": {
          "const": true
        }
      },
      "required": [
        "same_operator_current_source_execution",
        "immutable_source_and_license_byte_identity",
        "technical_silent_import_loss_zero",
        "text_scan_import_health_only",
        "solver_ready_geometry_or_topology",
        "independent_reproduction",
        "product_legal_approval",
        "redistribution_authority",
        "commercial_use_authority",
        "phase3_quantity_credit",
        "release_authority"
      ],
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "clean_case_count": {
          "maximum": 2,
          "minimum": 0,
          "type": "integer"
        },
        "dirty_case_count": {
          "maximum": 8,
          "minimum": 0,
          "type": "integer"
        },
        "import_health_contract_pass_count": {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "import_health_execution_count": {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "required_case_count": {
          "const": 10
        },
        "silent_import_loss_gate_pass_count": {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "source_checksum_attached_count": {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "source_file_acquired_count": {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "visible_entity_accounting_case_count": {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "required_case_count",
        "case_count",
        "clean_case_count",
        "dirty_case_count",
        "source_file_acquired_count",
        "source_checksum_attached_count",
        "import_health_execution_count",
        "import_health_contract_pass_count",
        "visible_entity_accounting_case_count",
        "silent_import_loss_gate_pass_count"
      ],
      "type": "object"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "legal_and_product_blockers": {
      "$ref": "#/$defs/stringList"
    },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "const": 10
        },
        "path": {
          "pattern": "^benchmarks/import_health/.+\\.json$",
          "type": "string"
        },
        "schema_version": {
          "const": "buildingsmart-ifc-current-source-manifest.v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "storage_boundary": {
          "const": "download_to_gitignored_private_corpus_never_bundle_or_upload"
        }
      },
      "required": [
        "path",
        "sha256",
        "schema_version",
        "case_count",
        "storage_boundary"
      ],
      "type": "object"
    },
    "nontechnical_blockers": {
      "$ref": "#/$defs/stringList"
    },
    "raw_ifc_files_uploaded": {
      "const": false
    },
    "receipt_schema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "canonical/ifc-import-health-current-source-technical-receipt.v1.schema.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "ifc-import-health-current-source-technical-receipt.v1"
    },
    "source_commit_sha": {
      "$ref": "#/$defs/commitSha"
    },
    "spillover_blockers": {
      "$ref": "#/$defs/stringList"
    },
    "status": {
      "enum": [
        "technical_ready_product_authority_blocked",
        "technical_blocked"
      ]
    },
    "supporting_receipts": {
      "additionalProperties": false,
      "properties": {
        "phase3_buildingsmart_dirty_ifc_acquisition_receipt.json": {
          "$ref": "#/$defs/receiptBinding"
        },
        "phase3_buildingsmart_ifc_acquisition_receipt.json": {
          "$ref": "#/$defs/receiptBinding"
        },
        "phase3_ifc_import_health_execution_receipt.json": {
          "$ref": "#/$defs/receiptBinding"
        },
        "phase3_ifc_source_license_receipt.json": {
          "$ref": "#/$defs/receiptBinding"
        },
        "phase6_silent_import_loss_status.json": {
          "$ref": "#/$defs/receiptBinding"
        }
      },
      "required": [
        "phase3_buildingsmart_dirty_ifc_acquisition_receipt.json",
        "phase3_buildingsmart_ifc_acquisition_receipt.json",
        "phase3_ifc_import_health_execution_receipt.json",
        "phase3_ifc_source_license_receipt.json",
        "phase6_silent_import_loss_status.json"
      ],
      "type": "object"
    },
    "technical_blockers": {
      "$ref": "#/$defs/stringList"
    },
    "technical_contract_pass": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "source_commit_sha",
    "status",
    "technical_contract_pass",
    "receipt_schema",
    "manifest",
    "counts",
    "claims",
    "case_receipts",
    "supporting_receipts",
    "technical_blockers",
    "legal_and_product_blockers",
    "nontechnical_blockers",
    "spillover_blockers",
    "raw_ifc_files_uploaded",
    "claim_boundary"
  ],
  "title": "IFC import-health current-source technical receipt",
  "type": "object"
}
