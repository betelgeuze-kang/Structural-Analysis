{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/canonical/rights-holder-license-trust-root.v1.schema.json",
  "title": "Repository-owned rights-holder signer trust root v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "approved_signers",
    "revoked_signer_ids",
    "revoked_decision_ids",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "rights-holder-license-trust-root.v1"},
    "repository_id": {"const": "betelgeuze-kang/structural-analysis"},
    "approved_signers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signer_id",
          "rights_holder_id",
          "algorithm",
          "public_key_path",
          "public_key_sha256",
          "allowed_repository_license_sha256",
          "allowed_license_ids",
          "allowed_license_policy",
          "allowed_tiers",
          "allowed_approver_roles",
          "allowed_product_scope"
        ],
        "properties": {
          "signer_id": {"type": "string", "minLength": 3},
          "rights_holder_id": {"type": "string", "minLength": 3},
          "algorithm": {"const": "rsa-sha256"},
          "public_key_path": {"type": "string", "minLength": 3},
          "public_key_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "allowed_repository_license_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "allowed_license_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 3},
            "uniqueItems": true
          },
          "allowed_license_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_path",
              "document_sha256",
              "version",
              "covered_first_party_paths"
            ],
            "properties": {
              "document_path": {
                "type": "string",
                "pattern": "^canonical/license-policies/[A-Za-z0-9._/-]+$"
              },
              "document_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "version": {"type": "string", "minLength": 3},
              "covered_first_party_paths": {
                "const": [
                  ".betelgeuze/**",
                  ".coveragerc",
                  ".cursor/**",
                  ".gitattributes",
                  ".github/**",
                  ".gitignore",
                  ".ignore",
                  ".kiro/**",
                  ".phase1_missing_artifact",
                  "AGENTS.md",
                  "CONTRIBUTING.md",
                  "DESIGN.md",
                  "LICENSE",
                  "README.md",
                  "SECURITY.md",
                  "apps/**",
                  "artifacts/**",
                  "benchmarks/**",
                  "canonical/**",
                  "ci/**",
                  "commercial_gap_analysis.md",
                  "deployment/**",
                  "docs/**",
                  "examples/**",
                  "implementation/**",
                  "index.html",
                  "native/**",
                  "opencode.json",
                  "package-lock.json",
                  "package.json",
                  "prototype/**",
                  "pyproject.toml",
                  "pytest.ini",
                  "requirements.txt",
                  "schemas/**",
                  "scripts/**",
                  "setup.cfg",
                  "src/**",
                  "structural_viewer.html",
                  "tests/**",
                  "tsconfig.json",
                  "verification/**",
                  "vite.config.ts"
                ]
              }
            }
          },
          "allowed_tiers": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["paid-pilot", "limited-commercial"]},
            "uniqueItems": true
          },
          "allowed_approver_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "product_owner",
                "legal_counsel",
                "product_and_legal",
                "delegated_product_owner"
              ]
            },
            "uniqueItems": true
          },
          "allowed_product_scope": {
            "const": [
              "review-assist",
              "specified-structure-families",
              "specified-workflows",
              "engine-and-reviewer-evidence-package"
            ]
          }
        }
      }
    },
    "revoked_signer_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    },
    "revoked_decision_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 8},
      "uniqueItems": true
    },
    "claim_boundary": {"type": "string", "minLength": 80}
  }
}
