{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/current-main-evidence-lanes.v1.schema.json",
  "title": "Exact-main authenticated technical handoff pair catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "required_lane_count",
    "required_run_attempt",
    "technical_claims_only",
    "release_authority",
    "product_state_upstream",
    "issue_state_observation",
    "lanes"
  ],
  "properties": {
    "schema_version": {"const": "current-main-evidence-lanes.v1"},
    "catalog_id": {"const": "current-main-authenticated-technical-handoff-pairs.v1"},
    "required_lane_count": {"const": 5},
    "required_run_attempt": {"const": 1},
    "technical_claims_only": {"const": true},
    "release_authority": {"const": false},
    "product_state_upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_name",
        "workflow_path",
        "trigger",
        "exact_source_required",
        "successful_first_attempt_required",
        "required_jobs",
        "overlay_interface"
      ],
      "properties": {
        "workflow_name": {"const": "Product State Current"},
        "workflow_path": {"const": ".github/workflows/product-state-current.yml"},
        "trigger": {"const": "workflow_run"},
        "exact_source_required": {"const": true},
        "successful_first_attempt_required": {"const": true},
        "required_jobs": {
          "const": [
            "build-current-state",
            "attest-current-state",
            "verify-current-state",
            "replay-final-attestations"
          ]
        },
        "overlay_interface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction", "version", "consumption_enabled", "artifact_name_template"],
          "properties": {
            "direction": {"const": "nightly_to_product_state_to_evidence_index"},
            "version": {"const": "authenticated-product-state-overlay.v1"},
            "consumption_enabled": {"const": true},
            "artifact_name_template": {"const": "post-main-evidence-overlay-attested-{run_id}-{run_attempt}-{source_sha}"}
          }
        }
      }
    },
    "issue_state_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_name",
        "workflow_path",
        "allowed_event",
        "exact_source_required",
        "successful_first_attempt_required",
        "required_jobs",
        "artifact_name_template",
        "bundle_files",
        "report_path",
        "inventory_path",
        "schema_path",
        "validator_path",
        "technical_lane",
        "promotion_eligible",
        "observation_scope"
      ],
      "properties": {
        "workflow_name": {"const": "Issue State Current"},
        "workflow_path": {"const": ".github/workflows/issue-state-current.yml"},
        "allowed_event": {"const": "push"},
        "exact_source_required": {"const": true},
        "successful_first_attempt_required": {"const": true},
        "required_jobs": {"const": ["offline-contract", "live-exact-main"]},
        "artifact_name_template": {"const": "issue-state-current-{source_sha}-{run_id}-{run_attempt}"},
        "bundle_files": {
          "const": [
            ".github/workflows/issue-state-current.yml",
            "artifacts/manifests/issue_supersession_inventory.json",
            "canonical/issue-state-current.v1.schema.json",
            "issue-state-current.json",
            "scripts/check_issue_supersession_inventory.py"
          ]
        },
        "report_path": {"const": "issue-state-current.json"},
        "inventory_path": {"const": "artifacts/manifests/issue_supersession_inventory.json"},
        "schema_path": {"const": "canonical/issue-state-current.v1.schema.json"},
        "validator_path": {"const": "scripts/check_issue_supersession_inventory.py"},
        "technical_lane": {"const": false},
        "promotion_eligible": {"const": false},
        "observation_scope": {"const": "github_issue_state_hygiene_only"}
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"const": {"lane_id": "medium", "category": "medium_scale", "evidence_mode": "handoff_pair", "workflow_name": "Medium Scale Current Source", "workflow_path": ".github/workflows/medium-scale-current-source.yml", "allowed_events": ["push"], "producer_job": "produce-unprivileged", "attestor_job_suffix": "verify-attest-privileged-fresh-hosted", "subject_path": "artifacts/medium-scale/current-source/medium-scale-execution.v1.json", "subject_schema_version": "medium-scale-current-source-execution.v1", "subject_source_key": "source_commit_sha", "handoff_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}", "attestation_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}-attestation", "technical_scope": "Five bounded same-operator medium-scale executions and internal oracle comparisons.", "authority_not_granted": ["scientific_validation", "native_medium_product", "engineering_design", "commercial_use", "release"], "promotion_blockers": ["scientific_medium_reference_missing", "native_medium_authority_missing"]}},
        {"const": {"lane_id": "ifc", "category": "import_health", "evidence_mode": "handoff_pair", "workflow_name": "IFC Import Health Current Source", "workflow_path": ".github/workflows/ifc-import-health-current-source.yml", "allowed_events": ["push"], "producer_job": "produce-unprivileged", "attestor_job_suffix": "verify-attest-privileged-fresh-hosted", "subject_path": ".ci/ifc-import-health-current-source/technical-receipt.json", "subject_schema_version": "ifc-import-health-current-source-technical-receipt.v1", "subject_source_key": "source_commit_sha", "handoff_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}", "attestation_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}-attestation", "technical_scope": "Ten-case IFC text import-health accounting with bounded silent-loss-zero checks.", "authority_not_granted": ["solver_geometry", "independent_reproduction", "redistribution", "commercial_use", "engineering_design", "release"], "promotion_blockers": ["independent_operator_missing", "legal_rights_missing"]}},
        {"const": {"lane_id": "mgt9", "category": "import_health", "evidence_mode": "handoff_pair", "workflow_name": "MGT Import Health Current Source", "workflow_path": ".github/workflows/mgt-import-health-current-source.yml", "allowed_events": ["push"], "producer_job": "produce-unprivileged", "attestor_job_suffix": "verify-attest-privileged-fresh-hosted", "subject_path": ".ci/mgt-import-health-current-source/technical-receipt.json", "subject_schema_version": "mgt-import-health-current-source-technical-receipt.v1", "subject_source_key": "source_commit_sha", "handoff_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}", "attestation_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}-attestation", "technical_scope": "Tracked MGT corpus technical nine-case accounting; this lane remains explicitly 9/10.", "authority_not_granted": ["target_10_case_in_this_lane", "independent_reproduction", "redistribution", "commercial_use", "engineering_design", "release"], "promotion_blockers": ["current_lane_is_intentionally_9_of_10", "legal_rights_missing"]}},
        {"const": {"lane_id": "mgt10", "category": "import_health", "evidence_mode": "handoff_pair", "workflow_name": "MGT Import Health Tenth Source", "workflow_path": ".github/workflows/mgt-import-health-tenth-source.yml", "allowed_events": ["push"], "producer_job": "produce-unprivileged", "attestor_job_suffix": "verify-attest-privileged-fresh-hosted", "subject_path": ".ci/mgt-import-health-tenth-source/technical-receipt.json", "subject_schema_version": "mgt-import-health-tenth-source-technical-receipt.v1", "subject_source_key": "source_commit_sha", "handoff_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}", "attestation_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}-attestation", "technical_scope": "Same-run MGT core nine plus runtime tenth-source technical accounting.", "authority_not_granted": ["independent_reproduction", "redistribution", "commercial_use", "engineering_design", "release"], "promotion_blockers": ["raw_tenth_source_not_retained", "legal_rights_missing", "independent_operator_missing"]}},
        {"const": {"lane_id": "native", "category": "distribution", "evidence_mode": "handoff_pair", "workflow_name": "Native Frame Alpha Clean Install", "workflow_path": ".github/workflows/native-frame-alpha-clean-install.yml", "allowed_events": ["push", "workflow_dispatch"], "producer_job": "produce-unprivileged", "attestor_job_suffix": "verify-attest-privileged-fresh-hosted", "subject_path": "native-clean-install-summary.json", "subject_schema_version": "technical-native-clean-install-handoff.v1", "subject_source_key": "source_sha", "handoff_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}", "attestation_name_template": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}-attestation", "technical_scope": "Bounded Linux/Windows portable package, clean-install, update, rollback, parity, and browser replay summary.", "authority_not_granted": ["os_code_signing", "human_new_user", "independent_reproduction", "engineering_design", "commercial_use", "release"], "promotion_blockers": ["os_code_signing_missing", "human_new_user_observation_missing"]}}
      ],
      "items": false
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "category",
        "evidence_mode",
        "workflow_name",
        "workflow_path",
        "allowed_events",
        "producer_job",
        "attestor_job_suffix",
        "subject_path",
        "subject_schema_version",
        "subject_source_key",
        "handoff_name_template",
        "attestation_name_template",
        "technical_scope",
        "authority_not_granted",
        "promotion_blockers"
      ],
      "properties": {
        "lane_id": {"enum": ["medium", "ifc", "mgt9", "mgt10", "native"]},
        "category": {"enum": ["medium_scale", "import_health", "distribution"]},
        "evidence_mode": {"const": "handoff_pair"},
        "workflow_name": {"type": "string", "minLength": 1},
        "workflow_path": {"$ref": "#/$defs/path"},
        "allowed_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["push", "workflow_dispatch"]}
        },
        "producer_job": {"const": "produce-unprivileged"},
        "attestor_job_suffix": {"const": "verify-attest-privileged-fresh-hosted"},
        "subject_path": {"$ref": "#/$defs/path"},
        "subject_schema_version": {"type": "string", "minLength": 1},
        "subject_source_key": {"enum": ["source_commit_sha", "source_sha"]},
        "handoff_name_template": {"const": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}"},
        "attestation_name_template": {"const": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}-attestation"},
        "technical_scope": {"type": "string", "minLength": 1},
        "authority_not_granted": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "contains": {"const": "release"},
          "items": {"type": "string", "minLength": 1}
        },
        "promotion_blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
