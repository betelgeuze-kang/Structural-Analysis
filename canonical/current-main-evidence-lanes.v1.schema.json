{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/current-main-evidence-lanes.v1.schema.json",
  "title": "Exact-main authenticated technical handoff pair catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "required_lane_count",
    "required_run_attempt",
    "technical_claims_only",
    "release_authority",
    "product_state_upstream",
    "lanes"
  ],
  "properties": {
    "schema_version": {"const": "current-main-evidence-lanes.v1"},
    "catalog_id": {"const": "current-main-authenticated-technical-handoff-pairs.v1"},
    "required_lane_count": {"const": 5},
    "required_run_attempt": {"const": 1},
    "technical_claims_only": {"const": true},
    "release_authority": {"const": false},
    "product_state_upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_name",
        "workflow_path",
        "trigger",
        "exact_source_required",
        "successful_first_attempt_required",
        "required_jobs",
        "overlay_interface"
      ],
      "properties": {
        "workflow_name": {"const": "Product State Current"},
        "workflow_path": {"const": ".github/workflows/product-state-current.yml"},
        "trigger": {"const": "workflow_run"},
        "exact_source_required": {"const": true},
        "successful_first_attempt_required": {"const": true},
        "required_jobs": {
          "const": ["build-current-state", "attest-current-state", "verify-current-state"]
        },
        "overlay_interface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction", "version", "consumption_enabled", "artifact"],
          "properties": {
            "direction": {"const": "nightly_to_product_state_to_evidence_index"},
            "version": {"const": "reserved-for-authenticated-product-state-overlay.v1"},
            "consumption_enabled": {"const": false},
            "artifact": {"type": "null"}
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/lane"}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "category",
        "evidence_mode",
        "workflow_name",
        "workflow_path",
        "allowed_events",
        "producer_job",
        "attestor_job_suffix",
        "subject_path",
        "subject_schema_version",
        "subject_source_key",
        "handoff_name_template",
        "attestation_name_template",
        "technical_scope",
        "authority_not_granted",
        "promotion_blockers"
      ],
      "properties": {
        "lane_id": {"enum": ["medium", "ifc", "mgt9", "mgt10", "native"]},
        "category": {"enum": ["medium_scale", "import_health", "distribution"]},
        "evidence_mode": {"const": "handoff_pair"},
        "workflow_name": {"type": "string", "minLength": 1},
        "workflow_path": {"$ref": "#/$defs/path"},
        "allowed_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["push", "workflow_dispatch"]}
        },
        "producer_job": {"const": "produce-unprivileged"},
        "attestor_job_suffix": {"const": "verify-attest-privileged-fresh-hosted"},
        "subject_path": {"$ref": "#/$defs/path"},
        "subject_schema_version": {"type": "string", "minLength": 1},
        "subject_source_key": {"enum": ["source_commit_sha", "source_sha"]},
        "handoff_name_template": {"const": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}"},
        "attestation_name_template": {"const": "{lane}-technical-handoff-{run_id}-{run_attempt}-{source_sha}-attestation"},
        "technical_scope": {"type": "string", "minLength": 1},
        "authority_not_granted": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "contains": {"const": "release"},
          "items": {"type": "string", "minLength": 1}
        },
        "promotion_blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
