{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.invalid/schemas/source-quarry-inventory.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "audit_source", "retirement_policy", "pull_requests", "unresolved_file_extraction_blockers", "claim_boundary", "inventory_digest"],
  "properties": {
    "schema_version": {"const": "structural-analysis-source-quarry-inventory.v1"},
    "repository": {"const": "betelgeuze-kang/Structural-Analysis"},
    "audit_source": {"const": "github_rest_pull_request_changed_files_api"},
    "retirement_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "disposition", "retired_scope_status", "scope_disposition_only", "semantic_equivalence_claim", "policy_projection", "policy_projection_digest"],
      "properties": {
        "policy_id": {"const": "frame-alpha-retire-source-quarry-retained-device-fgmres.v1"},
        "disposition": {"const": "owner_scope_retirement"},
        "retired_scope_status": {"const": "retired_not_planned_for_current_product"},
        "scope_disposition_only": {"const": true},
        "semantic_equivalence_claim": {"const": false},
        "policy_projection": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/projection"}},
        "policy_projection_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "pull_requests": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/pr"}},
    "unresolved_file_extraction_blockers": {"const": []},
    "claim_boundary": {"$ref": "#/$defs/boundary"},
    "inventory_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0},
    "projection": {"type": "object", "additionalProperties": false, "required": ["path", "blob_sha"], "properties": {"path": {"enum": ["docs/adr/010-retire-source-quarry-retained-device-fgmres.md", "README.md", "artifacts/manifests/capabilities.yaml"]}, "blob_sha": {"$ref": "#/$defs/gitSha"}}},
    "pr": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "source_issue", "state", "merged", "base_sha", "head_sha", "changed_file_count", "allowed_statuses", "github_changed_files_api", "api_rows_digest", "status_counts", "files"],
      "properties": {
        "number": {"enum": [77, 78]}, "source_issue": {"enum": [143, 144]}, "state": {"const": "closed"}, "merged": {"const": false},
        "base_sha": {"$ref": "#/$defs/gitSha"}, "head_sha": {"$ref": "#/$defs/gitSha"}, "changed_file_count": {"$ref": "#/$defs/nonnegative"},
        "allowed_statuses": {"const": ["present", "superseded"]},
        "github_changed_files_api": {"type": "string", "pattern": "^https://api\\.github\\.com/repos/betelgeuze-kang/Structural-Analysis/pulls/(77|78)/files$"},
        "api_rows_digest": {"$ref": "#/$defs/sha256"},
        "status_counts": {"type": "object", "additionalProperties": false, "required": ["present", "superseded"], "properties": {"present": {"$ref": "#/$defs/nonnegative"}, "superseded": {"$ref": "#/$defs/nonnegative"}}},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "change_status", "blob_sha", "additions", "deletions", "changes", "current_blob_sha", "current_relation", "status", "reason", "replacement_paths"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "previous_path": {"type": "string", "minLength": 1},
        "change_status": {"enum": ["added", "changed", "modified", "removed", "renamed"]}, "blob_sha": {"$ref": "#/$defs/gitSha"},
        "additions": {"$ref": "#/$defs/nonnegative"}, "deletions": {"$ref": "#/$defs/nonnegative"}, "changes": {"$ref": "#/$defs/nonnegative"},
        "current_blob_sha": {"oneOf": [{"$ref": "#/$defs/gitSha"}, {"type": "null"}]}, "current_relation": {"enum": ["absent", "different", "identical"]},
        "status": {"enum": ["present", "superseded"]}, "reason": {"enum": ["exact_blob_present", "owner_scope_retirement"]},
        "replacement_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_complete", "old_branch_merge_allowed", "old_branch_import_allowed", "readiness_promoted", "numerical_authority", "hardware_authority", "operator_authority", "signature_authority", "release_authority", "commercial_authority", "statement"],
      "properties": {
        "inventory_complete": {"const": true}, "old_branch_merge_allowed": {"const": false}, "old_branch_import_allowed": {"const": false}, "readiness_promoted": {"const": false},
        "numerical_authority": {"const": false}, "hardware_authority": {"const": false}, "operator_authority": {"const": false}, "signature_authority": {"const": false}, "release_authority": {"const": false}, "commercial_authority": {"const": false},
        "statement": {"const": "This is an owner-approved scope disposition, not a semantic-equivalence or implementation claim."}
      }
    }
  }
}
