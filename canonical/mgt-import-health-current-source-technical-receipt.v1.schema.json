{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.invalid/schemas/mgt-import-health-current-source-technical-receipt.v1.schema.json",
  "title": "MGT import-health current-source technical receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_commit_sha",
    "execution_environment",
    "manifest",
    "source_binding",
    "identity_gate",
    "summary",
    "cases",
    "technical_available_set_contract_pass",
    "target_10_case_contract_pass",
    "status",
    "technical_blockers",
    "target_blockers",
    "target_gap",
    "claims",
    "raw_mgt_files_uploaded",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "mgt-import-health-current-source-technical-receipt.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_environment": {"enum": ["local", "github-hosted"]},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_path", "schema_version"],
      "properties": {
        "path": {"const": "benchmarks/import_health/mgt_current_source.v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_path": {"const": "canonical/mgt-import-health-current-source-manifest.v1.schema.json"},
        "schema_version": {"const": "mgt-import-health-current-source-manifest.v1"}
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_source_commit_sha",
        "observed_head_sha",
        "head_matches_declared_source",
        "source_tree_clean",
        "source_tree_clean_required",
        "contract_pass",
        "blockers"
      ],
      "properties": {
        "declared_source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_matches_declared_source": {"type": "boolean"},
        "source_tree_clean": {"type": "boolean"},
        "source_tree_clean_required": {"type": "boolean"},
        "contract_pass": {"type": "boolean"},
        "blockers": {"$ref": "#/$defs/string_array"}
      }
    },
    "identity_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credit_unit",
        "duplicate_sha256_credit_allowed",
        "derived_variant_credit_allowed",
        "unique_case_id_count",
        "unique_lineage_count",
        "unique_source_sha256_count",
        "contract_pass",
        "blockers"
      ],
      "properties": {
        "credit_unit": {"const": "unique_source_or_model_lineage"},
        "duplicate_sha256_credit_allowed": {"const": false},
        "derived_variant_credit_allowed": {"const": false},
        "unique_case_id_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "unique_lineage_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "unique_source_sha256_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "contract_pass": {"type": "boolean"},
        "blockers": {"$ref": "#/$defs/string_array"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_independent_case_count",
        "available_independent_case_count",
        "executed_case_count",
        "clean_case_count",
        "dirty_case_count",
        "case_contract_pass_count",
        "record_accounting_pass_count",
        "silent_loss_negative_pass_count",
        "rights_reviewed_case_count"
      ],
      "properties": {
        "target_independent_case_count": {"const": 10},
        "available_independent_case_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "executed_case_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "clean_case_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "dirty_case_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "case_contract_pass_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "record_accounting_pass_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "silent_loss_negative_pass_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "rights_reviewed_case_count": {"const": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/case"}
    },
    "technical_available_set_contract_pass": {"type": "boolean"},
    "target_10_case_contract_pass": {"type": "boolean"},
    "status": {
      "enum": ["target_pass", "available_set_pass_target_blocked", "technical_blocked"]
    },
    "technical_blockers": {"$ref": "#/$defs/string_array"},
    "target_blockers": {"$ref": "#/$defs/string_array"},
    "target_gap": {"$ref": "#/$defs/target_gap"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver_ready_import",
        "design_authority",
        "independent_reproduction",
        "product_legal_approval",
        "redistribution_authority",
        "commercial_use_authority",
        "release_authority"
      ],
      "properties": {
        "solver_ready_import": {"const": false},
        "design_authority": {"const": false},
        "independent_reproduction": {"const": false},
        "product_legal_approval": {"const": false},
        "redistribution_authority": {"const": false},
        "commercial_use_authority": {"const": false},
        "release_authority": {"const": false}
      }
    },
    "raw_mgt_files_uploaded": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 100}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "int_map": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "lineage_id",
        "path",
        "corpus_class",
        "expected_parser_outcome",
        "observed_parser_outcome",
        "source",
        "provenance_and_rights",
        "parser",
        "record_accounting",
        "entity_accounting",
        "negative_silent_loss_gate",
        "contract_pass"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "lineage_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "path": {"type": "string", "pattern": "^[^/].*\\.mgt$"},
        "corpus_class": {"enum": ["clean", "dirty"]},
        "expected_parser_outcome": {"$ref": "#/$defs/parser_outcome"},
        "observed_parser_outcome": {"$ref": "#/$defs/parser_outcome"},
        "source": {"$ref": "#/$defs/source"},
        "provenance_and_rights": {"$ref": "#/$defs/provenance"},
        "parser": {"$ref": "#/$defs/parser"},
        "record_accounting": {"$ref": "#/$defs/record_accounting"},
        "entity_accounting": {"$ref": "#/$defs/entity_accounting"},
        "negative_silent_loss_gate": {"$ref": "#/$defs/negative_gate"},
        "contract_pass": {"type": "boolean"}
      }
    },
    "parser_outcome": {
      "enum": ["pass", "pass_with_visible_unsupported_rows", "reject_with_visible_omissions"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked",
        "expected_sha256",
        "observed_sha256",
        "expected_size_bytes",
        "observed_size_bytes",
        "record_fingerprint_sha256",
        "utf8_replacement_character_count"
      ],
      "properties": {
        "tracked": {"type": "boolean"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "observed_sha256": {"$ref": "#/$defs/sha256"},
        "expected_size_bytes": {"type": "integer", "minimum": 1},
        "observed_size_bytes": {"type": "integer", "minimum": 1},
        "record_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "utf8_replacement_character_count": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_owner",
        "origin_url",
        "provenance_status",
        "rights_status",
        "redistribution_reviewed",
        "commercial_use_reviewed"
      ],
      "properties": {
        "source_kind": {"type": "string", "minLength": 1},
        "source_owner": {"type": "string", "minLength": 1},
        "origin_url": {"type": "string"},
        "provenance_status": {"type": "string", "minLength": 1},
        "rights_status": {"type": "string", "minLength": 1},
        "redistribution_reviewed": {"const": false},
        "commercial_use_reviewed": {"const": false}
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "return_code",
        "return_code_matches_contract",
        "contract_pass",
        "reason_code",
        "report_path",
        "report_sha256"
      ],
      "properties": {
        "script": {"const": "implementation/phase1/parse_midas_mgt_to_json_npz.py"},
        "return_code": {"type": "integer", "minimum": 0},
        "return_code_matches_contract": {"type": "boolean"},
        "contract_pass": {"type": "boolean"},
        "reason_code": {"type": "string", "minLength": 1},
        "report_path": {"type": "string", "pattern": "^\\.ci/mgt-import-health-current-source/case-reports/.+\\.json$"},
        "report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "record_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_data_row_count",
        "parser_recognized_row_count",
        "visible_unsupported_or_omitted_row_count",
        "visible_unsupported_or_omitted_by_section",
        "unaccounted_row_count"
      ],
      "properties": {
        "source_data_row_count": {"type": "integer", "minimum": 1},
        "parser_recognized_row_count": {"type": "integer", "minimum": 0},
        "visible_unsupported_or_omitted_row_count": {"type": "integer", "minimum": 0},
        "visible_unsupported_or_omitted_by_section": {"$ref": "#/$defs/int_map"},
        "unaccounted_row_count": {"const": 0}
      }
    },
    "entity_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "element", "material", "section", "output_suppressed_by_parser_contract"],
      "properties": {
        "node": {"$ref": "#/$defs/id_entity"},
        "element": {"$ref": "#/$defs/id_entity"},
        "material": {"$ref": "#/$defs/simple_entity"},
        "section": {"$ref": "#/$defs/simple_entity"},
        "output_suppressed_by_parser_contract": {"type": "boolean"}
      }
    },
    "id_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_row_count",
        "source_id_count",
        "parser_reported_row_count",
        "parser_reported_parsed_count",
        "parser_reported_skipped_count",
        "output_count",
        "source_id_sha256",
        "output_id_sha256"
      ],
      "properties": {
        "source_row_count": {"type": "integer", "minimum": 0},
        "source_id_count": {"type": "integer", "minimum": 0},
        "parser_reported_row_count": {"type": "integer", "minimum": 0},
        "parser_reported_parsed_count": {"type": "integer", "minimum": 0},
        "parser_reported_skipped_count": {"type": "integer", "minimum": 0},
        "output_count": {"type": "integer", "minimum": 0},
        "source_id_sha256": {"$ref": "#/$defs/sha256"},
        "output_id_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "simple_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_row_count", "parser_reported_row_count", "parser_reported_parsed_count"],
      "properties": {
        "source_row_count": {"type": "integer", "minimum": 0},
        "parser_reported_row_count": {"type": "integer", "minimum": 0},
        "parser_reported_parsed_count": {"type": "integer", "minimum": 0}
      }
    },
    "negative_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_deletion_detected",
        "accounting_record_deletion_detected",
        "source_mutation_reason",
        "accounting_mutation_reason"
      ],
      "properties": {
        "source_record_deletion_detected": {"type": "boolean"},
        "accounting_record_deletion_detected": {"type": "boolean"},
        "source_mutation_reason": {"const": "source_sha256_and_record_count_mismatch"},
        "accounting_mutation_reason": {"const": "node_parser_balance_mismatch"}
      }
    },
    "target_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_id",
        "missing_independent_case_count",
        "artifact_attached",
        "source_owner_identified",
        "rights_basis_recorded",
        "required_acquisition",
        "required_owner_action",
        "acceptance_command"
      ],
      "properties": {
        "blocker_id": {"const": "mgt_import_health_independent_source_10_missing"},
        "missing_independent_case_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "artifact_attached": {"type": "boolean"},
        "source_owner_identified": {"type": "boolean"},
        "rights_basis_recorded": {"type": "boolean"},
        "required_acquisition": {"type": "string", "minLength": 1},
        "required_owner_action": {"type": "string", "minLength": 1},
        "acceptance_command": {"type": "string", "minLength": 1}
      }
    }
  }
}
