{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/bounded_planar_opensees_nonlinear_material_recovery_result_v1.schema.json",
  "title": "Bounded planar OpenSees nonlinear material recovery result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "case_id",
    "executed_at",
    "runner_file_sha256",
    "source_model_file_sha256",
    "runtime",
    "return_codes",
    "metrics",
    "contract_pass",
    "blockers",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "bounded-planar-opensees-nonlinear-material-recovery-result.v1"},
    "package_id": {"const": "bounded-planar-nonlinear-material-recovery-v1"},
    "case_id": {"$ref": "#/$defs/caseId"},
    "executed_at": {"type": "string", "format": "date-time"},
    "runner_file_sha256": {"$ref": "#/$defs/sha256"},
    "source_model_file_sha256": {"$ref": "#/$defs/sha256"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "platform", "openseespy_version", "opensees_core_version"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "openseespy_version": {"const": "3.7.1.2"},
        "opensees_core_version": {"const": "3.7.1"}
      }
    },
    "return_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer"}
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(pdelta|snap|steel|section|fiber|rc)\\.[A-Za-z0-9_.-]+$"},
      "additionalProperties": {"type": "number"}
    },
    "contract_pass": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "items": {
        "enum": [
          "openseespy_version_mismatch",
          "opensees_core_version_mismatch",
          "nonzero_return_code",
          "nonfinite_metric",
          "pdelta_amplification_not_monotonic",
          "snap_through_descending_branch_missing",
          "snap_through_negative_load_branch_missing",
          "steel_yield_signature_missing",
          "rc_steel_yield_signature_missing",
          "rc_concrete_nonlinearity_signature_missing",
          "recovery_fiber_inventory_invalid"
        ]
      },
      "uniqueItems": true
    },
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "caseId": {
      "enum": [
        "bounded_planar_p_delta",
        "bounded_planar_snap_through",
        "bounded_planar_steel_yield",
        "bounded_planar_rc_fiber",
        "bounded_planar_section_recovery",
        "bounded_planar_fiber_recovery"
      ]
    }
  }
}
