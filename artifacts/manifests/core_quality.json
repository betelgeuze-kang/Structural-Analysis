{
  "schema_version": "structural-analysis-core-quality.v1",
  "scope_id": "bounded_public_core_v1",
  "typecheck": {
    "tool": "mypy",
    "config": "pyproject.toml",
    "paths": [
      "src/structural_analysis/adapters",
      "src/structural_analysis/analyses",
      "src/structural_analysis/dynamics/transient_checkpoint.py",
      "src/structural_analysis/elements/corotational_frame3d.py",
      "src/structural_analysis/elements/stateful_corotational_fiber_frame3d.py",
      "src/structural_analysis/materials",
      "src/structural_analysis/model",
      "src/structural_analysis/results/schema.py",
      "src/structural_analysis/results/validation.py",
      "src/structural_analysis/engine_v2/contracts/result_quantity.py",
      "src/structural_analysis/solvers/nonlinear/transient.py",
      "src/structural_analysis/units"
    ]
  },
  "coverage": {
    "tool": "coverage.py",
    "config": ".coveragerc",
    "branch": true,
    "minimum_percent": 85,
    "sources": [
      "src/structural_analysis/analyses",
      "src/structural_analysis/model",
      "src/structural_analysis/results",
      "src/structural_analysis/units"
    ],
    "omits": [
      "src/structural_analysis/results/__init__.py",
      "src/structural_analysis/results/viewer.py"
    ],
    "tests": [
      "tests/test_structural_analysis_core_api.py",
      "tests/test_typed_domain_model.py",
      "tests/test_authoritative_linear_engineering_semantics.py",
      "tests/test_authoritative_linear_frame.py",
      "tests/test_authoritative_linear_frame_reference_cases.py",
      "tests/test_whole_model_modal_analysis.py",
      "tests/test_whole_model_buckling_analysis.py",
      "tests/test_result_validation_tolerance.py",
      "tests/test_result_quantity_catalog.py"
    ]
  },
  "compatibility_matrix": {
    "operating_systems": [
      "ubuntu-latest",
      "windows-latest",
      "macos-latest"
    ],
    "python_versions": [
      "3.10",
      "3.12",
      "3.13"
    ],
    "required_coordinate_count": 9,
    "workflow": ".github/workflows/core-quality-ci.yml"
  },
  "claim_boundary": "This gate enforces exact parity between the manifest-driven mypy inputs and pyproject.toml tool.mypy.files for the P0 adapters, analyses, transient checkpoint and solver, Frame3D elements, materials, model, result schema and validation, ResultIR SI quantity contract, and units. The compatibility matrix remains scoped to its declared tests, and the 85 percent branch metric remains scoped to the coverage.sources list. It does not erase type debt outside that bounded scope, promote experimental or legacy code, prove release readiness, or replace independent engineering review."
}
