{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/frame_alpha_clean_install_replay_v1.schema.json",
  "title": "Frame Alpha portable clean-runner replay receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "source", "platform_tag", "runner", "archive",
    "package_smoke", "analysis_replay", "authority", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "structural-frame-alpha-clean-install-replay.v1"},
    "status": {"const": "pass"},
    "source": {"$ref": "#/$defs/source"},
    "platform_tag": {"enum": ["linux-x86_64-gnu", "windows-x86_64-msvc"]},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile", "fresh_extraction_directory", "source_build_output_used",
        "network_isolation", "network_observation", "network_used_during_replay"
      ],
      "properties": {
        "profile": {"enum": ["github_hosted_ephemeral", "local_isolated_test"]},
        "fresh_extraction_directory": {"const": true},
        "source_build_output_used": {"const": false},
        "network_isolation": {"const": "not_enforced"},
        "network_observation": {"const": "not_performed"},
        "network_used_during_replay": {"type": "null"}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "package_id", "manifest_hash"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 262144000},
        "package_id": {
          "type": "string",
          "pattern": "^structural-frame-alpha-workstation-0\\.1\\.0-(linux-x86_64-gnu|windows-x86_64-msvc)$"
        },
        "manifest_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "package_smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_sha256", "loopback_static_and_capability_smoke"
      ],
      "properties": {
        "schema_version": {"const": "structural-frame-alpha-workstation-distribution-smoke.v2"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "loopback_static_and_capability_smoke": {"const": "passed"}
      }
    },
    "analysis_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat_count", "byte_identical", "canonical_result_sha256",
        "result_schema_sha256", "schema_and_hash_validation",
        "persisted_result_contract_replay", "packaged_example_identity_binding",
        "schema_version", "authority_profile", "result_id", "model_id", "result_hash",
        "model_content_hash", "model_semantic_hash", "model_provenance_hash",
        "load_pattern_id", "load_combination_id", "native_abi_version", "solver",
        "node_count", "member_count"
      ],
      "properties": {
        "repeat_count": {"const": 2},
        "byte_identical": {"const": true},
        "canonical_result_sha256": {"$ref": "#/$defs/sha256"},
        "result_schema_sha256": {"$ref": "#/$defs/sha256"},
        "schema_and_hash_validation": {"const": "passed"},
        "persisted_result_contract_replay": {"const": "passed"},
        "packaged_example_identity_binding": {"const": "passed"},
        "schema_version": {"const": "structural-native-linear-frame3d-result-ir.v1"},
        "authority_profile": {"const": "bounded_native_cpu_result_candidate.v1"},
        "result_id": {"const": "clean-install.LC_WEAK"},
        "model_id": {"const": "frame-alpha-distribution-cantilever"},
        "result_hash": {"$ref": "#/$defs/sha256"},
        "model_content_hash": {"$ref": "#/$defs/sha256"},
        "model_semantic_hash": {"$ref": "#/$defs/sha256"},
        "model_provenance_hash": {"$ref": "#/$defs/sha256"},
        "load_pattern_id": {"const": "LC_WEAK"},
        "load_combination_id": {"type": "null"},
        "native_abi_version": {"const": 65541},
        "solver": {
          "const": {
            "formulation": "linear_timoshenko_frame3d",
            "backend": "cpu_reference_dense",
            "residual_sign": "internal_minus_external",
            "unit_profile": "node_m_rad_force_n_nm_member_local_n_nm.v1"
          }
        },
        "node_count": {"const": 2},
        "member_count": {"const": 1}
      }
    },
    "authority": {
      "const": {
        "portable_clean_runner_installation": "passed",
        "same_source_linux_windows_parity": "not_established_by_one_receipt",
        "browser_execution": "not_evaluated",
        "os_code_signing": "not_evaluated",
        "artifact_attestation": "not_evaluated_in_runner_receipt",
        "automatic_update": "not_implemented",
        "rollback": "not_implemented",
        "engineering_design": "not_authoritative",
        "commercial_use": "not_authoritative",
        "release_readiness": "not_authoritative"
      }
    },
    "claim_boundary": {
      "const": "one_source_bound_portable_workstation_archive_verified_and_replayed_twice_from_a_fresh_extraction_on_one_runner_without_network_isolation_or_offline_observation_not_cross_platform_browser_code_signing_update_rollback_or_release_authority"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "binding_profile"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/git_sha"},
        "tree_sha": {"$ref": "#/$defs/git_sha"},
        "binding_profile": {"const": "verified_clean_git_checkout.v1"}
      }
    }
  }
}
