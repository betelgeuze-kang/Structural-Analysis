{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/frame_alpha_workstation_distribution_manifest_v2.schema.json",
  "title": "Structural Frame Alpha workstation distribution candidate manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_hash", "package_id", "package_version", "platform_tag",
    "source", "archive_profile", "build_profile", "binary", "license", "workbench", "files",
    "authority", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "structural-frame-alpha-workstation-distribution.v2"},
    "manifest_hash": {"$ref": "#/$defs/sha256"},
    "package_id": {
      "type": "string",
      "pattern": "^structural-frame-alpha-workstation-0\\.1\\.0-(linux-x86_64-gnu|windows-x86_64-msvc)$"
    },
    "package_version": {"const": "0.1.0"},
    "platform_tag": {"enum": ["linux-x86_64-gnu", "windows-x86_64-msvc"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "binding_profile"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/git_sha"},
        "tree_sha": {"$ref": "#/$defs/git_sha"},
        "binding_profile": {"const": "verified_clean_git_checkout.v1"}
      }
    },
    "archive_profile": {"const": "deterministic_zip_deflate.v1"},
    "build_profile": {"const": "rust_release_static_cpp_cpu_plus_operator_supplied_vite.v2"},
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "format", "sha256", "byte_length"],
      "properties": {
        "path": {"enum": ["bin/structural-cli", "bin/structural-cli.exe"]},
        "version": {"const": "structural-cli 0.1.0"},
        "format": {"enum": ["elf64-x86_64", "pe32plus-x86_64"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 209715200}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_posture", "license_ref", "license_path", "license_sha256",
        "sbom_path", "sbom_sha256", "product_license_approval",
        "commercial_redistribution_approved", "third_party_redistribution_clearance",
        "release_clearance", "release_blockers"
      ],
      "properties": {
        "repository_posture": {"const": "all_rights_reserved_no_license_granted"},
        "license_ref": {"const": "LicenseRef-Repository-Default-No-License"},
        "license_path": {"const": "LICENSE"},
        "license_sha256": {"$ref": "#/$defs/sha256"},
        "sbom_path": {"const": "SBOM.native-license.json"},
        "sbom_sha256": {"$ref": "#/$defs/sha256"},
        "product_license_approval": {"const": false},
        "commercial_redistribution_approved": {"const": false},
        "third_party_redistribution_clearance": {"const": "not_established"},
        "release_clearance": {"const": "blocked"},
        "release_blockers": {
          "const": [
            "product_license_approval_not_established",
            "commercial_redistribution_approval_not_established",
            "third_party_redistribution_clearance_not_established"
          ]
        }
      }
    },
    "workbench": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root", "index_path", "index_sha256", "file_count", "byte_length",
        "submission_url", "build_binding"
      ],
      "properties": {
        "root": {"const": "workbench"},
        "index_path": {"const": "workbench/index.html"},
        "index_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 2, "maximum": 512},
        "byte_length": {"type": "integer", "minimum": 2, "maximum": 262144000},
        "submission_url": {"const": "/api/v1/frame3d/jobs"},
        "build_binding": {"const": "hash_bound_operator_supplied_vite_output.v1"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 14,
      "maxItems": 524,
      "items": {"$ref": "#/$defs/file"}
    },
    "authority": {
      "const": {
        "package_construction": "bounded_candidate",
        "workbench_static_files": "hash_bound_operator_supplied_build",
        "same_runner_extracted_loopback_host": "not_evaluated_in_manifest",
        "browser_execution": "not_evaluated",
        "clean_machine_installation": "not_evaluated",
        "linux_windows_parity": "not_established",
        "engineering_design": "not_authoritative",
        "commercial_use": "not_authoritative",
        "release_readiness": "not_authoritative"
      }
    },
    "claim_boundary": {
      "const": "hash_bound_cli_and_workbench_static_distribution_not_installer_browser_execution_clean_machine_or_release_authority"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "byte_length", "sha256", "executable"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^\\\\/][^\\\\]*$"},
        "media_type": {
          "enum": [
            "application/octet-stream", "application/json", "text/html; charset=utf-8",
            "text/javascript; charset=utf-8", "text/css; charset=utf-8",
            "text/markdown; charset=utf-8", "text/plain; charset=utf-8",
            "image/svg+xml", "image/png", "image/x-icon", "font/woff2"
          ]
        },
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 209715200},
        "sha256": {"$ref": "#/$defs/sha256"},
        "executable": {"type": "boolean"}
      }
    }
  }
}
