{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/frame_alpha_packaged_browser_replay_v1.schema.json",
  "title": "Frame Alpha packaged Workbench browser replay receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "source", "platform_tag", "package", "browser",
    "execution", "checks", "authority", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "structural-frame-alpha-packaged-browser-replay.v1"},
    "status": {"const": "pass"},
    "source": {"$ref": "#/$defs/source"},
    "platform_tag": {"enum": ["linux-x86_64-gnu", "windows-x86_64-msvc"]},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id", "manifest_sha256", "binary_sha256", "workbench_index_sha256"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^structural-frame-alpha-workstation-0\\.1\\.0-(linux-x86_64-gnu|windows-x86_64-msvc)$"
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "workbench_index_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "version", "route", "packaged_static_files_only"],
      "properties": {
        "engine": {"const": "chromium"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "route": {"const": "/#/workbench-v2"},
        "packaged_static_files_only": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id", "job_view_sha256", "bundle_manifest_sha256", "result_ir_sha256",
        "result_hash", "elapsed_ms"
      ],
      "properties": {
        "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
        "job_view_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "result_ir_sha256": {"$ref": "#/$defs/sha256"},
        "result_hash": {"$ref": "#/$defs/sha256"},
        "elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 120000}
      }
    },
    "checks": {
      "const": {
        "model_file_uploaded": true,
        "same_origin_job_submitted": true,
        "native_worker_succeeded": true,
        "bundle_integrity_verified_in_browser": true,
        "result_ir_verified_in_browser": true,
        "numerical_gates_passed": true,
        "release_authority_remained_blocked": true,
        "page_error_count": 0
      }
    },
    "authority": {
      "const": {
        "packaged_browser_execution": "passed",
        "human_new_user_observation": "not_evaluated",
        "accessibility_review": "not_evaluated",
        "os_code_signing": "not_evaluated",
        "automatic_update": "not_implemented",
        "rollback": "not_implemented",
        "engineering_design": "not_authoritative",
        "commercial_use": "not_authoritative",
        "release_readiness": "not_authoritative"
      }
    },
    "claim_boundary": {
      "const": "one_packaged_workbench_chromium_upload_submit_run_poll_and_verified_result_replay_not_human_observation_accessibility_code_signing_update_rollback_or_release_authority"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "binding_profile"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/git_sha"},
        "tree_sha": {"$ref": "#/$defs/git_sha"},
        "binding_profile": {"const": "verified_clean_git_checkout.v1"}
      }
    }
  }
}
