{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/native_linear_frame3d_job_request_v1.schema.json",
  "title": "Bounded native linear Frame3D job request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_hash", "job_id", "submitted_unix_ms", "model_content_hash", "load_source", "result_id", "report_id", "output_profile", "service_profile", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "structural-native-linear-frame3d-job-request.v1"},
    "request_hash": {"$ref": "#/$defs/sha256"},
    "job_id": {"$ref": "#/$defs/job_id"},
    "submitted_unix_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "model_content_hash": {"$ref": "#/$defs/sha256"},
    "load_source": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"const": "pattern"}, "id": {"$ref": "#/$defs/stable_id"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"const": "combination"}, "id": {"$ref": "#/$defs/stable_id"}}}
      ]
    },
    "result_id": {"$ref": "#/$defs/stable_id"},
    "report_id": {"$ref": "#/$defs/stable_id"},
    "output_profile": {"const": "hash_bound_workbench_bundle.v1"},
    "service_profile": {"const": "filesystem_append_only_single_host.v1"},
    "claim_boundary": {"const": "submitted_native_frame3d_job_not_execution_or_result_authority"}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
