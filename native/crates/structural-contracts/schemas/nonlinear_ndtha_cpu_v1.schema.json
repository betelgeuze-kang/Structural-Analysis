{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/nonlinear-ndtha-cpu-v1.schema.json",
  "title": "Nonlinear NDTHA CPU product golden v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "config", "inputs", "result"],
  "properties": {
    "schema_version": { "const": "structural-solver-cpu-nonlinear-ndtha.v1" },
    "operation": { "const": "nonlinear_ndtha" },
    "config": { "$ref": "#/$defs/config" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "finiteNumber": { "type": "number" },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "positiveCount": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "f64Vector": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finiteNumber" }
    },
    "positiveVector": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/positiveNumber" }
    },
    "nonNegativeVector": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonNegativeNumber" }
    },
    "u32Vector": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/u32" }
    },
    "boolVector": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "boolean" }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_count",
        "step_count",
        "dt_s",
        "newmark_beta",
        "newmark_gamma",
        "tolerance",
        "max_step_iterations",
        "adaptive_load_decay",
        "damping_force_cap_ratio",
        "newton_max_iter",
        "line_search_decay",
        "line_search_min",
        "hardening_ratio",
        "pdelta_factor",
        "collapse_drift_threshold_pct"
      ],
      "properties": {
        "story_count": { "$ref": "#/$defs/positiveCount" },
        "step_count": { "$ref": "#/$defs/positiveCount" },
        "dt_s": { "$ref": "#/$defs/positiveNumber" },
        "newmark_beta": { "$ref": "#/$defs/positiveNumber" },
        "newmark_gamma": { "$ref": "#/$defs/positiveNumber" },
        "tolerance": { "$ref": "#/$defs/positiveNumber" },
        "max_step_iterations": { "$ref": "#/$defs/positiveCount" },
        "adaptive_load_decay": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "damping_force_cap_ratio": { "$ref": "#/$defs/positiveNumber" },
        "newton_max_iter": { "$ref": "#/$defs/positiveCount" },
        "line_search_decay": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "line_search_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "hardening_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "pdelta_factor": { "$ref": "#/$defs/nonNegativeNumber" },
        "collapse_drift_threshold_pct": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_k_n_per_m",
        "story_h_m",
        "story_axial_n",
        "story_yield_drift_m",
        "story_mass_kg",
        "story_damping_n_s_per_m",
        "floor_load_base_n",
        "ag_g"
      ],
      "properties": {
        "story_k_n_per_m": { "$ref": "#/$defs/positiveVector" },
        "story_h_m": { "$ref": "#/$defs/positiveVector" },
        "story_axial_n": { "$ref": "#/$defs/f64Vector" },
        "story_yield_drift_m": { "$ref": "#/$defs/f64Vector" },
        "story_mass_kg": { "$ref": "#/$defs/positiveVector" },
        "story_damping_n_s_per_m": { "$ref": "#/$defs/nonNegativeVector" },
        "floor_load_base_n": { "$ref": "#/$defs/f64Vector" },
        "ag_g": { "$ref": "#/$defs/f64Vector" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_displacement_m",
        "drift_ratio_pct",
        "base_shear_kn",
        "core_drift_pct",
        "core_shear_kn",
        "step_converged",
        "step_iterations",
        "step_plastic_story_count",
        "step_residual_inf",
        "story_drift_envelope_pct",
        "final_story_drift_pct"
      ],
      "properties": {
        "top_displacement_m": { "$ref": "#/$defs/f64Vector" },
        "drift_ratio_pct": { "$ref": "#/$defs/f64Vector" },
        "base_shear_kn": { "$ref": "#/$defs/f64Vector" },
        "core_drift_pct": { "$ref": "#/$defs/f64Vector" },
        "core_shear_kn": { "$ref": "#/$defs/f64Vector" },
        "step_converged": { "$ref": "#/$defs/boolVector" },
        "step_iterations": { "$ref": "#/$defs/u32Vector" },
        "step_plastic_story_count": { "$ref": "#/$defs/u32Vector" },
        "step_residual_inf": { "$ref": "#/$defs/f64Vector" },
        "story_drift_envelope_pct": { "$ref": "#/$defs/f64Vector" },
        "final_story_drift_pct": { "$ref": "#/$defs/f64Vector" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "converged_all_steps",
        "collapsed",
        "collapse_step",
        "collapse_time_s",
        "collapse_drift_ratio_pct",
        "collapse_top_displacement_m",
        "step_count_completed",
        "max_plastic_story_count",
        "max_drift_ratio_pct",
        "avg_step_iterations",
        "residual_top_displacement_m",
        "residual_drift_ratio_pct",
        "total_line_search_backtracks",
        "execution_backend",
        "fallback_count",
        "response"
      ],
      "properties": {
        "converged_all_steps": { "type": "boolean" },
        "collapsed": { "type": "boolean" },
        "collapse_step": { "type": "integer", "minimum": -1, "maximum": 999999 },
        "collapse_time_s": { "$ref": "#/$defs/nonNegativeNumber" },
        "collapse_drift_ratio_pct": { "$ref": "#/$defs/nonNegativeNumber" },
        "collapse_top_displacement_m": { "$ref": "#/$defs/finiteNumber" },
        "step_count_completed": { "$ref": "#/$defs/u32" },
        "max_plastic_story_count": { "$ref": "#/$defs/u32" },
        "max_drift_ratio_pct": { "$ref": "#/$defs/nonNegativeNumber" },
        "avg_step_iterations": { "$ref": "#/$defs/nonNegativeNumber" },
        "residual_top_displacement_m": { "$ref": "#/$defs/finiteNumber" },
        "residual_drift_ratio_pct": { "$ref": "#/$defs/nonNegativeNumber" },
        "total_line_search_backtracks": { "$ref": "#/$defs/u32" },
        "execution_backend": { "const": "cpu" },
        "fallback_count": { "const": 0 },
        "response": { "$ref": "#/$defs/response" }
      }
    }
  }
}
