{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/native_linear_frame3d_job_view_v1.schema.json",
  "title": "Materialized bounded native linear Frame3D job view v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "request_hash", "model_content_hash", "revision", "status", "created_unix_ms", "updated_unix_ms", "bundle_manifest", "error", "service_profile", "capabilities", "solver_truth_owner", "result_authority", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "structural-native-linear-frame3d-job-view.v1"},
    "job_id": {"$ref": "#/$defs/job_id"},
    "request_hash": {"$ref": "#/$defs/sha256"},
    "model_content_hash": {"$ref": "#/$defs/sha256"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 32},
    "status": {"enum": ["queued", "running", "succeeded", "failed"]},
    "created_unix_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "updated_unix_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "bundle_manifest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]},
    "service_profile": {"const": "filesystem_append_only_single_host.v1"},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["process_isolation", "cancellation", "resume", "crash_recovery", "multi_host"],
      "properties": {
        "process_isolation": {"const": false}, "cancellation": {"const": false},
        "resume": {"const": false}, "crash_recovery": {"const": false}, "multi_host": {"const": false}
      }
    },
    "solver_truth_owner": {"const": "structural_native_runtime"},
    "result_authority": {"const": "referenced_hash_bound_bundle_contract_only"},
    "claim_boundary": {"const": "single_host_materialized_view_not_release_or_durable_worker_authority"}
  },
  "$defs": {
    "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "content_hash", "byte_length"],
      "properties": {
        "path": {"const": "bundle/manifest.json"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
