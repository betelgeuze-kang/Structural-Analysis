{
  "name": "structural-analysis",
  "private": true,
  "version": "0.3.0",
  "description": "Deterministic Vite/React shell for structural review and release surfaces.",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10.8.2 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- frontend-build --root .",
    "preview": "vite preview",
    "verify:frontend-contract": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- check --root .",
    "verify:frontend-smoke": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- smoke --root .",
    "verify:viewer-js-syntax": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- viewer-js-syntax --root .",
    "verify:viewer-manifest": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- viewer-manifest --root .",
    "verify:frontend-browser-smoke": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- browser-smoke --root .",
    "verify:workbench-prototype-dom-contract": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- prototype --root .",
    "verify:workbench-prototype-browser-smoke": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- prototype-browser-smoke --root .",
    "build:benchmark-catalog": "bash ./scripts/build_native_benchmark_catalog.sh",
    "verify:benchmark-catalog-contract": "cargo test --locked --manifest-path native/Cargo.toml -p structural-catalog",
    "verify:workbench-v2-e2e": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- workbench-v2-browser-smoke --root .",
    "verify:workbench-viewer-delivery": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- delivery --root .",
    "build:evidence-bundle": "bash ./scripts/build_native_workbench_evidence_bundle.sh",
    "verify:evidence-bundle-contract": "cargo test --locked --manifest-path native/Cargo.toml -p structural-evidence",
    "capture:readme-viewer-image": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- viewer-readme-capture --root .",
    "export:viewer-report-pdf": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- viewer-report-pdf-export --root .",
    "verify:viewer-report-pdf": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- viewer-report-pdf-smoke --root .",
    "verify:viewer-performance-probe": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- viewer-performance-probe --root .",
    "verify:viewer-sample-workflow": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- viewer-sample-workflow --root .",
    "verify:viewer-visual-regression": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- viewer-visual-regression --root .",
    "serve:viewer": "cargo run --quiet --locked --manifest-path native/Cargo.toml -p structural-frontend-contract -- serve --root .",
    "ai:kiro-design": "./scripts/ai-run-kiro-design.sh",
    "ai:preflight": "bash scripts/ai-preflight.sh",
    "ai:verify": "bash scripts/ai-verify.sh",
    "ai:verify:contract": "bash scripts/ai-verify.sh --contract",
    "ai:verify:full": "bash scripts/ai-verify.sh --full",
    "ai:validate-worker-output": "node ./scripts/validate-ai-worker-output.mjs"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "18.2.15",
    "@types/react-dom": "18.2.7",
    "@vitejs/plugin-react": "6.0.1",
    "postcss": "8.5.26",
    "typescript": "5.0.2",
    "vite": "8.0.16"
  }
}
