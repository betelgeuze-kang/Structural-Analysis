{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/coupled_shallow_arch_vector_arc_length_v1.schema.json",
  "title": "Phase 2 coupled shallow-arch vector arc-length benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "contract_pass",
    "case_id",
    "analysis_type",
    "truth_basis",
    "problem_definition",
    "solver_result",
    "verification",
    "exact_reduction_errors",
    "exact_first_limit_point",
    "computed_first_limit_bracket",
    "finite_difference_rows",
    "claims",
    "blockers_remaining",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "phase2-coupled-shallow-arch-vector-arc-length.v1"
    },
    "status": {"enum": ["partial", "blocked"]},
    "contract_pass": {"type": "boolean"},
    "case_id": {"type": "string", "minLength": 1},
    "analysis_type": {
      "const": "dense_vector_spherical_arc_length_continuation"
    },
    "truth_basis": {
      "const": "analytic_coupled_two_dof_conservative_potential"
    },
    "problem_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equation_count",
        "coupling_ratio",
        "coupling_stiffness_kn_per_m",
        "reference_load_kn",
        "exact_reduction"
      ],
      "properties": {
        "equation_count": {"const": 2},
        "coupling_ratio": {"type": "number"},
        "coupling_stiffness_kn_per_m": {"type": "number", "exclusiveMinimum": 0},
        "reference_load_kn": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "items": false
        },
        "exact_reduction": {"type": "string", "minLength": 1}
      }
    },
    "solver_result": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "terminal_reason",
        "case_id",
        "path_contract_hash",
        "residual_formula",
        "constraint_formula",
        "config",
        "reference_load_kn",
        "initial_checkpoint",
        "final_checkpoint",
        "checkpoints",
        "attempts",
        "metrics"
      ],
      "properties": {
        "schema_version": {"const": "structural-analysis-vector-arc-length.v1"},
        "status": {"enum": ["ready", "blocked"]},
        "terminal_reason": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "path_contract_hash": {"$ref": "#/$defs/sha256"},
        "residual_formula": {"type": "string", "minLength": 1},
        "constraint_formula": {"type": "string", "minLength": 1},
        "config": {"type": "object"},
        "reference_load_kn": {"type": "array", "minItems": 2, "maxItems": 2},
        "initial_checkpoint": {"$ref": "#/$defs/checkpoint"},
        "final_checkpoint": {"$ref": "#/$defs/checkpoint"},
        "checkpoints": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/checkpoint"}
        },
        "attempts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "metrics": {
          "type": "object",
          "required": [
            "contract_pass",
            "equation_count",
            "target_monitor_displacement_reached",
            "accepted_step_count",
            "rejected_step_count",
            "rollback_exact",
            "fallback_count",
            "regularization_count",
            "maximum_checkpoint_residual_inf_norm_kn",
            "maximum_accepted_constraint_residual_m2",
            "descending_load_branch_observed",
            "negative_load_factor_observed",
            "rehardening_load_branch_observed",
            "claim_boundary"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_gate_passed",
        "exact_scalar_reduction_gate_passed",
        "limit_point_gate_passed",
        "tangent_energy_finite_difference_gate_passed",
        "rollback_evidence_passed",
        "checkpoint_restart_exact",
        "deterministic_replay_exact",
        "path_contract_hash",
        "restart_checkpoint_state_hash",
        "final_checkpoint_state_hash",
        "restarted_final_checkpoint_state_hash"
      ],
      "properties": {
        "path_gate_passed": {"type": "boolean"},
        "exact_scalar_reduction_gate_passed": {"type": "boolean"},
        "limit_point_gate_passed": {"type": "boolean"},
        "tangent_energy_finite_difference_gate_passed": {"type": "boolean"},
        "rollback_evidence_passed": {"type": "boolean"},
        "checkpoint_restart_exact": {"type": "boolean"},
        "deterministic_replay_exact": {"type": "boolean"},
        "path_contract_hash": {"$ref": "#/$defs/sha256"},
        "restart_checkpoint_state_hash": {"$ref": "#/$defs/sha256"},
        "final_checkpoint_state_hash": {"$ref": "#/$defs/sha256"},
        "restarted_final_checkpoint_state_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "exact_reduction_errors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_coupling_relation_absolute_error_m",
        "maximum_reduced_equilibrium_absolute_error_kn",
        "contract_pass"
      ],
      "properties": {
        "maximum_coupling_relation_absolute_error_m": {"type": "number", "minimum": 0},
        "maximum_reduced_equilibrium_absolute_error_kn": {"type": "number", "minimum": 0},
        "contract_pass": {"type": "boolean"}
      }
    },
    "exact_first_limit_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_displacement_m", "coupled_displacement_m", "load_factor"],
      "properties": {
        "primary_displacement_m": {"type": "number"},
        "coupled_displacement_m": {"type": "number"},
        "load_factor": {"type": "number"}
      }
    },
    "computed_first_limit_bracket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "below_step_index",
        "below_primary_displacement_m",
        "below_load_factor",
        "above_step_index",
        "above_primary_displacement_m",
        "above_load_factor",
        "first_local_maximum_step_index",
        "first_local_maximum_load_factor",
        "first_limit_load_relative_error",
        "relative_tolerance",
        "contract_pass"
      ],
      "properties": {
        "below_step_index": {"type": "integer", "minimum": 0},
        "below_primary_displacement_m": {"type": "number"},
        "below_load_factor": {"type": "number"},
        "above_step_index": {"type": "integer", "minimum": 0},
        "above_primary_displacement_m": {"type": "number"},
        "above_load_factor": {"type": "number"},
        "first_local_maximum_step_index": {"type": "integer", "minimum": 0},
        "first_local_maximum_load_factor": {"type": "number"},
        "first_limit_load_relative_error": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "contract_pass": {"type": "boolean"}
      }
    },
    "finite_difference_rows": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "free_displacements_m",
          "finite_difference_step_m",
          "consistent_tangent_kn_per_m",
          "finite_difference_tangent_kn_per_m",
          "internal_force_kn",
          "finite_difference_energy_gradient_kn",
          "maximum_tangent_absolute_error_kn_per_m",
          "maximum_energy_gradient_absolute_error_kn",
          "tangent_symmetry_absolute_error_kn_per_m",
          "tangent_allowed_error_kn_per_m",
          "energy_gradient_allowed_error_kn",
          "contract_pass"
        ],
        "properties": {
          "free_displacements_m": {"type": "array", "minItems": 2, "maxItems": 2},
          "finite_difference_step_m": {"type": "number", "exclusiveMinimum": 0},
          "consistent_tangent_kn_per_m": {"type": "array", "minItems": 2, "maxItems": 2},
          "finite_difference_tangent_kn_per_m": {"type": "array", "minItems": 2, "maxItems": 2},
          "internal_force_kn": {"type": "array", "minItems": 2, "maxItems": 2},
          "finite_difference_energy_gradient_kn": {"type": "array", "minItems": 2, "maxItems": 2},
          "maximum_tangent_absolute_error_kn_per_m": {"type": "number", "minimum": 0},
          "maximum_energy_gradient_absolute_error_kn": {"type": "number", "minimum": 0},
          "tangent_symmetry_absolute_error_kn_per_m": {"type": "number", "minimum": 0},
          "tangent_allowed_error_kn_per_m": {"type": "number", "exclusiveMinimum": 0},
          "energy_gradient_allowed_error_kn": {"type": "number", "exclusiveMinimum": 0},
          "contract_pass": {"type": "boolean"}
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dense_multi_dof_vector_arc_length",
        "coupled_two_dof_limit_point_crossing",
        "consistent_vector_tangent",
        "failed_step_rollback",
        "checkpoint_restart",
        "general_frame_shell_arc_length",
        "lee_frame_snapthrough",
        "material_geometric_coupling",
        "published_or_experimental_validation",
        "production_sparse_backend",
        "production_rocm_hip_parity",
        "g1_full_building_closure"
      ],
      "properties": {
        "dense_multi_dof_vector_arc_length": {"type": "boolean"},
        "coupled_two_dof_limit_point_crossing": {"type": "boolean"},
        "consistent_vector_tangent": {"type": "boolean"},
        "failed_step_rollback": {"type": "boolean"},
        "checkpoint_restart": {"type": "boolean"},
        "general_frame_shell_arc_length": {"const": false},
        "lee_frame_snapthrough": {"const": false},
        "material_geometric_coupling": {"const": false},
        "published_or_experimental_validation": {"const": false},
        "production_sparse_backend": {"const": false},
        "production_rocm_hip_parity": {"const": false},
        "g1_full_building_closure": {"const": false}
      }
    },
    "blockers_remaining": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "schema_version",
        "case_id",
        "path_contract_hash",
        "step_index",
        "free_displacements_m",
        "load_factor",
        "previous_tangent_displacements",
        "previous_tangent_load_factor",
        "current_arc_length_m",
        "state_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "structural-analysis-vector-arc-length-checkpoint.v1"
        },
        "case_id": {"type": "string", "minLength": 1},
        "path_contract_hash": {"$ref": "#/$defs/sha256"},
        "step_index": {"type": "integer", "minimum": 0},
        "free_displacements_m": {"type": "array", "minItems": 2, "maxItems": 2},
        "load_factor": {"type": "number"},
        "previous_tangent_displacements": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
          ]
        },
        "previous_tangent_load_factor": {"type": ["number", "null"]},
        "current_arc_length_m": {"type": "number", "exclusiveMinimum": 0},
        "state_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
