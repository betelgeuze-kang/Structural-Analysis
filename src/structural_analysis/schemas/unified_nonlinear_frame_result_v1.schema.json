{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.invalid/schemas/unified-nonlinear-frame-result-v1.schema.json",
  "title": "Unified Nonlinear Frame Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "contract_pass",
    "result_hash",
    "profile",
    "source_result_hash",
    "canonical_model_checksum",
    "input_checksum",
    "solver_id",
    "compiler_profile",
    "configuration",
    "contract_bindings",
    "checkpoint",
    "authority",
    "node_displacements",
    "support_reactions",
    "member_end_forces",
    "section_results",
    "fiber_results",
    "convergence_history",
    "metrics",
    "unsupported_features",
    "warnings",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "unified-nonlinear-frame-result.v1"},
    "status": {"enum": ["ready", "blocked"]},
    "contract_pass": {"type": "boolean"},
    "result_hash": {"$ref": "#/$defs/hash"},
    "profile": {"enum": ["fixed_chord_serial_cantilever.v1", "corotational_one_bay_portal.v1"]},
    "source_result_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "canonical_model_checksum": {"$ref": "#/$defs/hash"},
    "input_checksum": {"$ref": "#/$defs/hash"},
    "solver_id": {"type": "string", "minLength": 1},
    "compiler_profile": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"},
    "contract_bindings": {"type": "object"},
    "checkpoint": {"type": "object", "required": ["available"], "properties": {"available": {"type": "boolean"}}},
    "authority": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["convergence", "displacement", "reaction", "member_force", "section_resultant", "fiber_result", "fallback", "public_api", "external_vv", "engineering_design", "release_readiness"]
    },
    "node_displacements": {"$ref": "#/$defs/objectArray"},
    "support_reactions": {"$ref": "#/$defs/objectArray"},
    "member_end_forces": {"$ref": "#/$defs/objectArray"},
    "section_results": {"$ref": "#/$defs/objectArray"},
    "fiber_results": {"$ref": "#/$defs/objectArray"},
    "convergence_history": {"$ref": "#/$defs/objectArray"},
    "metrics": {"type": "object"},
    "unsupported_features": {"$ref": "#/$defs/objectArray"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "objectArray": {"type": "array", "items": {"type": "object"}}
  }
}
