{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/rtc_residual_jvp_receipt_v1.schema.json",
  "title": "Engine v2 HIPRTC residual JVP receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capability_profile", "status", "execution_id",
    "context_id", "opening_context_receipt_hash", "requested_backend",
    "actual_backend", "evidence_scope", "promotion_eligible",
    "fallback_policy", "fallback_used", "reason", "bindings", "direction",
    "residual", "jvp", "telemetry_delta", "parity", "work", "claims",
    "extensions", "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-rtc-residual-jvp-receipt.v1"},
    "capability_profile": {"const": "phase0_hiprtc_canonical_csr_residual_jvp"},
    "status": {"enum": ["verified", "parity_failed", "unavailable"]},
    "execution_id": {"type": "string", "pattern": "^HipRtcResidualJvp:[0-9a-f]{24}$"},
    "context_id": {"type": "string", "pattern": "^HipRtcCsrContext:[0-9a-f]{24}$"},
    "opening_context_receipt_hash": {"$ref": "#/$defs/hash"},
    "requested_backend": {"const": "hip_rtc"},
    "actual_backend": {"type": ["string", "null"], "enum": ["hip", "test_double", null]},
    "evidence_scope": {"enum": ["native_hiprtc", "injected_test_double"]},
    "promotion_eligible": {"const": false},
    "fallback_policy": {"const": "forbidden"},
    "fallback_used": {"const": false},
    "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]},
    "bindings": {"$ref": "#/$defs/bindings"},
    "direction": {"$ref": "#/$defs/array"},
    "residual": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/array"}]},
    "jvp": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/array"}]},
    "telemetry_delta": {"$ref": "#/$defs/delta"},
    "parity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/parity"}]},
    "work": {"$ref": "#/$defs/work"},
    "claims": {"$ref": "#/$defs/claims"},
    "extensions": {"type": "object", "maxProperties": 0},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0},
    "reason": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128}, "detail": {"type": "string", "minLength": 1, "maxLength": 512}}
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_plan_hash", "operator_hash", "pattern_hash", "state_hash", "state_epoch", "kernel_identity_hash", "kernel_identity_snapshot_hash", "kernel_runtime_library_discovery_source", "kernel_runtime_library_sha256", "kernel_hiprtc_library_discovery_source", "kernel_hiprtc_library_sha256"],
      "properties": {
        "execution_plan_hash": {"$ref": "#/$defs/hash"}, "operator_hash": {"$ref": "#/$defs/hash"},
        "pattern_hash": {"$ref": "#/$defs/hash"}, "state_hash": {"$ref": "#/$defs/hash"},
        "state_epoch": {"type": "integer", "minimum": 0}, "kernel_identity_hash": {"$ref": "#/$defs/hash"},
        "kernel_identity_snapshot_hash": {"$ref": "#/$defs/hash"},
        "kernel_runtime_library_discovery_source": {"enum": ["explicit", "opt_rocm", "system_loader", "injected"]},
        "kernel_runtime_library_sha256": {"$ref": "#/$defs/hash"},
        "kernel_hiprtc_library_discovery_source": {"enum": ["explicit", "opt_rocm", "system_loader", "injected"]},
        "kernel_hiprtc_library_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "array": {
      "type": "object", "additionalProperties": false,
      "required": ["dtype", "shape", "byte_length", "data_hash"],
      "properties": {
        "dtype": {"const": "<f8"},
        "shape": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 1}},
        "byte_length": {"type": "integer", "minimum": 8}, "data_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "delta": {
      "type": "object", "additionalProperties": false,
      "required": ["h2d_bytes", "d2h_bytes", "h2d_operation_count", "d2h_operation_count", "blocking_copy_count", "explicit_sync_count", "allocation_count", "kernel_launch_attempt_count", "kernel_launch_count", "fallback_count"],
      "properties": {
        "h2d_bytes": {"$ref": "#/$defs/nonnegative"}, "d2h_bytes": {"$ref": "#/$defs/nonnegative"},
        "h2d_operation_count": {"$ref": "#/$defs/nonnegative"}, "d2h_operation_count": {"$ref": "#/$defs/nonnegative"},
        "blocking_copy_count": {"const": 0}, "explicit_sync_count": {"$ref": "#/$defs/nonnegative"},
        "allocation_count": {"const": 0}, "kernel_launch_attempt_count": {"$ref": "#/$defs/nonnegative"},
        "kernel_launch_count": {"$ref": "#/$defs/nonnegative"}, "fallback_count": {"const": 0}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "max_abs_error", "relative_l2_error", "max_scaled_error", "absolute_tolerance", "relative_tolerance", "passed"],
      "properties": {
        "count": {"type": "integer", "minimum": 0}, "max_abs_error": {"type": "number", "minimum": 0},
        "relative_l2_error": {"type": "number", "minimum": 0}, "max_scaled_error": {"type": "number", "minimum": 0},
        "absolute_tolerance": {"const": 1e-8}, "relative_tolerance": {"const": 1e-8}, "passed": {"type": "boolean"}
      }
    },
    "partitioned": {
      "type": "object", "additionalProperties": false,
      "required": ["full", "free", "constrained"],
      "properties": {"full": {"$ref": "#/$defs/metric"}, "free": {"$ref": "#/$defs/metric"}, "constrained": {"$ref": "#/$defs/metric"}}
    },
    "parity": {
      "type": "object", "additionalProperties": false,
      "required": ["oracle", "oracle_role", "residual", "jvp", "zero_direction_exact", "passed"],
      "properties": {
        "oracle": {"const": "cpu_canonical_csr_fp64"}, "oracle_role": {"const": "verification_only_never_fallback"},
        "residual": {"$ref": "#/$defs/partitioned"}, "jvp": {"$ref": "#/$defs/partitioned"},
        "zero_direction_exact": {"type": ["boolean", "null"]}, "passed": {"type": "boolean"}
      }
    },
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "load_source", "state_load_factor_applied", "host_execution_plan_dense_operator_present", "operation_count_basis", "global_dof_count", "free_dof_count", "constrained_dof_count", "csr_nnz", "csr_pass_count", "multiplication_count", "accumulation_count", "load_subtraction_count", "flop_equivalent_count", "logical_source_bytes", "physical_dram_bytes", "end_to_end_o_n_claim"],
      "properties": {
        "scope": {"const": "hiprtc_csr_residual_jvp_kernel_only"}, "load_source": {"const": "execution_plan_global_load"},
        "state_load_factor_applied": {"const": false}, "host_execution_plan_dense_operator_present": {"const": true},
        "operation_count_basis": {"const": "structural_source_equivalent_not_hardware_counter"},
        "global_dof_count": {"type": "integer", "minimum": 1}, "free_dof_count": {"$ref": "#/$defs/nonnegative"},
        "constrained_dof_count": {"$ref": "#/$defs/nonnegative"}, "csr_nnz": {"type": "integer", "minimum": 1},
        "csr_pass_count": {"const": 1}, "multiplication_count": {"$ref": "#/$defs/nonnegative"},
        "accumulation_count": {"$ref": "#/$defs/nonnegative"}, "load_subtraction_count": {"$ref": "#/$defs/nonnegative"},
        "flop_equivalent_count": {"$ref": "#/$defs/nonnegative"}, "logical_source_bytes": {"$ref": "#/$defs/nonnegative"},
        "physical_dram_bytes": {"const": "not_instrumented"}, "end_to_end_o_n_claim": {"const": false}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["residual_jvp_executed", "cpu_reference_parity_verified", "solver_ready", "device_resident_newton_krylov", "commercial_readiness"],
      "properties": {
        "residual_jvp_executed": {"type": "boolean"}, "cpu_reference_parity_verified": {"type": "boolean"},
        "solver_ready": {"const": false}, "device_resident_newton_krylov": {"const": false}, "commercial_readiness": {"const": false}
      }
    }
  }
}
