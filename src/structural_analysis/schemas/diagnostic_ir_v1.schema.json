{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/diagnostic_ir_v1.schema.json",
  "title": "Engine v2 max-iterations partial-iterate DiagnosticIR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "diagnostic_id",
    "input_bindings",
    "analysis",
    "ordering",
    "arrays",
    "termination",
    "state_lifecycle",
    "source_provenance",
    "claims",
    "numerical_diagnostic_hash",
    "diagnostic_ir_hash",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-diagnostic-ir.v1"},
    "capability_profile": {
      "const": "hip_source_bound_fgmres_max_iterations_partial_iterate"
    },
    "diagnostic_id": {"$ref": "#/$defs/stableId"},
    "input_bindings": {"$ref": "#/$defs/inputBindings"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "ordering": {"$ref": "#/$defs/ordering"},
    "arrays": {"$ref": "#/$defs/arrays"},
    "termination": {"$ref": "#/$defs/termination"},
    "state_lifecycle": {"$ref": "#/$defs/stateLifecycle"},
    "source_provenance": {"$ref": "#/$defs/sourceProvenance"},
    "claims": {"$ref": "#/$defs/claims"},
    "numerical_diagnostic_hash": {"$ref": "#/$defs/sha256"},
    "diagnostic_ir_hash": {"$ref": "#/$defs/sha256"},
    "extensions": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ir_content_hash",
        "solver_numeric_buffer_hash",
        "solver_entity_mapping_hash",
        "solver_artifact_hash",
        "execution_plan_hash",
        "accepted_state_hash",
        "evaluated_trial_state_hash",
        "committed_state_hash"
      ],
      "properties": {
        "model_ir_content_hash": {"$ref": "#/$defs/sha256"},
        "solver_numeric_buffer_hash": {"$ref": "#/$defs/sha256"},
        "solver_entity_mapping_hash": {"$ref": "#/$defs/sha256"},
        "solver_artifact_hash": {"$ref": "#/$defs/sha256"},
        "execution_plan_hash": {"$ref": "#/$defs/sha256"},
        "accepted_state_hash": {"$ref": "#/$defs/sha256"},
        "evaluated_trial_state_hash": {"$ref": "#/$defs/sha256"},
        "committed_state_hash": {"type": "null"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status",
        "state_disposition",
        "load_pattern_id",
        "residual_sign",
        "exported_free_residual_sign",
        "operator_version",
        "operator_hash"
      ],
      "properties": {
        "type": {"const": "linear_static"},
        "status": {"const": "not_ready_nonconverged"},
        "state_disposition": {"const": "evaluated_trial_not_committed"},
        "load_pattern_id": {"$ref": "#/$defs/stableId"},
        "residual_sign": {"const": "internal_minus_external"},
        "exported_free_residual_sign": {
          "const": "external_minus_internal"
        },
        "operator_version": {"type": "string", "minLength": 1},
        "operator_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_ids",
        "dof_components",
        "constrained_dofs",
        "free_dofs",
        "ordering_hash"
      ],
      "properties": {
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "dof_components": {"const": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
        "constrained_dofs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/index"}
        },
        "free_dofs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/index"}
        },
        "ordering_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "arrayDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "layout",
        "axis_labels",
        "component_labels",
        "component_units",
        "byte_length",
        "data_hash",
        "content_hash"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dtype": {"const": "<f8"},
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}
        },
        "layout": {"const": "C"},
        "axis_labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "component_labels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "component_units": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "byte_length": {
          "type": "integer",
          "minimum": 8,
          "maximum": 9007199254740991
        },
        "data_hash": {"$ref": "#/$defs/sha256"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partial_displacement_si",
        "residual_si",
        "exported_free_residual_si"
      ],
      "properties": {
        "partial_displacement_si": {"$ref": "#/$defs/arrayDescriptor"},
        "residual_si": {"$ref": "#/$defs/arrayDescriptor"},
        "exported_free_residual_si": {"$ref": "#/$defs/arrayDescriptor"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "method",
        "restart_dimension",
        "max_iterations",
        "absolute_tolerance",
        "relative_tolerance",
        "stagnation_checkpoint_limit",
        "stagnation_relative_tolerance",
        "divergence_factor",
        "orthogonalization",
        "preconditioner",
        "solver_norm",
        "authoritative_norm",
        "fallback_forbidden",
        "policy_hash"
      ],
      "properties": {
        "schema_version": {"const": "structural-analysis-fgmres-policy.v1"},
        "method": {"const": "fixed_restart_right_preconditioned_fgmres"},
        "restart_dimension": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_iterations": {"type": "integer", "minimum": 0, "maximum": 4096},
        "absolute_tolerance": {"$ref": "#/$defs/nonnegativeNumber"},
        "relative_tolerance": {"$ref": "#/$defs/nonnegativeNumber"},
        "stagnation_checkpoint_limit": {
          "type": "integer",
          "minimum": 2,
          "maximum": 16
        },
        "stagnation_relative_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "divergence_factor": {"type": "number", "exclusiveMinimum": 1},
        "orthogonalization": {"const": "dgks_conditional_two_pass_mgs"},
        "preconditioner": {"const": "positive_unshifted_jacobi_right"},
        "solver_norm": {"const": "l2"},
        "authoritative_norm": {"const": "scaled_true_residual_linf"},
        "fallback_forbidden": {"const": true},
        "policy_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration_count",
        "restart_count",
        "operator_apply_count",
        "preconditioner_apply_count"
      ],
      "properties": {
        "iteration_count": {"$ref": "#/$defs/index"},
        "restart_count": {"$ref": "#/$defs/index"},
        "operator_apply_count": {"$ref": "#/$defs/index"},
        "preconditioner_apply_count": {"$ref": "#/$defs/index"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_residual_l2",
        "solver_tolerance_l2",
        "final_residual_l2",
        "final_residual_linf",
        "scaled_true_residual",
        "load_scale",
        "free_residual_l2",
        "free_residual_linf",
        "scaled_free_residual",
        "exported_free_residual_l2",
        "exported_free_residual_linf",
        "scaled_exported_free_residual",
        "solver_tolerance_passed",
        "authoritative_plan_tolerance_passed"
      ],
      "properties": {
        "initial_residual_l2": {"$ref": "#/$defs/nonnegativeNumber"},
        "solver_tolerance_l2": {"$ref": "#/$defs/nonnegativeNumber"},
        "final_residual_l2": {"$ref": "#/$defs/nonnegativeNumber"},
        "final_residual_linf": {"$ref": "#/$defs/nonnegativeNumber"},
        "scaled_true_residual": {"$ref": "#/$defs/nonnegativeNumber"},
        "load_scale": {"type": "number", "minimum": 1},
        "free_residual_l2": {"$ref": "#/$defs/nonnegativeNumber"},
        "free_residual_linf": {"$ref": "#/$defs/nonnegativeNumber"},
        "scaled_free_residual": {"$ref": "#/$defs/nonnegativeNumber"},
        "exported_free_residual_l2": {"$ref": "#/$defs/nonnegativeNumber"},
        "exported_free_residual_linf": {"$ref": "#/$defs/nonnegativeNumber"},
        "scaled_exported_free_residual": {"$ref": "#/$defs/nonnegativeNumber"},
        "solver_tolerance_passed": {"const": false},
        "authoritative_plan_tolerance_passed": {"const": false}
      }
    },
    "restartRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restart_index",
        "start_iteration",
        "end_iteration",
        "arnoldi_step_count",
        "preconditioner_apply_count",
        "reorthogonalization_count",
        "estimated_residual_l2",
        "true_residual_l2",
        "true_residual_linf",
        "scaled_true_residual",
        "solution_update_l2",
        "termination_hint"
      ],
      "properties": {
        "restart_index": {"$ref": "#/$defs/index"},
        "start_iteration": {"$ref": "#/$defs/index"},
        "end_iteration": {"$ref": "#/$defs/index"},
        "arnoldi_step_count": {"$ref": "#/$defs/index"},
        "preconditioner_apply_count": {"$ref": "#/$defs/index"},
        "reorthogonalization_count": {"$ref": "#/$defs/index"},
        "estimated_residual_l2": {"$ref": "#/$defs/nonnegativeNumber"},
        "true_residual_l2": {"$ref": "#/$defs/nonnegativeNumber"},
        "true_residual_linf": {"$ref": "#/$defs/nonnegativeNumber"},
        "scaled_true_residual": {"$ref": "#/$defs/nonnegativeNumber"},
        "solution_update_l2": {"$ref": "#/$defs/nonnegativeNumber"},
        "termination_hint": {"const": "restart_completed"}
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "termination_code",
        "policy",
        "counters",
        "metrics",
        "history"
      ],
      "properties": {
        "status": {"const": "max_iterations"},
        "termination_code": {"const": "max_iterations_exhausted"},
        "policy": {"$ref": "#/$defs/policy"},
        "counters": {"$ref": "#/$defs/counters"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "history": {
          "type": "array",
          "items": {"$ref": "#/$defs/restartRecord"}
        }
      }
    },
    "stateLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_state_role",
        "evaluated_state_role",
        "accepted_state_preserved",
        "evaluated_trial_committed",
        "committed_state_hash",
        "rollback_result"
      ],
      "properties": {
        "accepted_state_role": {"const": "committed"},
        "evaluated_state_role": {"const": "trial"},
        "accepted_state_preserved": {"const": true},
        "evaluated_trial_committed": {"const": false},
        "committed_state_hash": {"type": "null"},
        "rollback_result": {"const": "accepted_state_retained"}
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_parity_receipt_hash",
        "terminal_observation_receipt_hash",
        "completion_export_receipt_hash",
        "completion_export_payload_hash",
        "device_identity_receipt_hash",
        "source_schema_version",
        "cpu_result_hash",
        "terminal_outcome_hash",
        "terminal_observation_id",
        "completion_export_context_id",
        "source_binding_hash",
        "actual_backend",
        "solution_payload_sha256",
        "exported_free_residual_payload_sha256",
        "solve_record_payload_sha256",
        "compiled_architecture",
        "runtime_architecture_base",
        "device_ordinal",
        "device_uuid_bytes_hex",
        "device_pci_bdf",
        "source_kind",
        "additional_device_operation_count",
        "additional_d2h_operation_count",
        "additional_solve_count",
        "additional_export_count",
        "fallback_count",
        "live_authority_serialized",
        "signed_evidence",
        "standalone_provenance"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/stableId"},
        "case_parity_receipt_hash": {"$ref": "#/$defs/sha256"},
        "terminal_observation_receipt_hash": {"$ref": "#/$defs/sha256"},
        "completion_export_receipt_hash": {"$ref": "#/$defs/sha256"},
        "completion_export_payload_hash": {"$ref": "#/$defs/sha256"},
        "device_identity_receipt_hash": {"$ref": "#/$defs/sha256"},
        "source_schema_version": {"$ref": "#/$defs/stableId"},
        "cpu_result_hash": {"$ref": "#/$defs/sha256"},
        "terminal_outcome_hash": {"$ref": "#/$defs/sha256"},
        "terminal_observation_id": {"$ref": "#/$defs/sha256"},
        "completion_export_context_id": {"$ref": "#/$defs/sha256"},
        "source_binding_hash": {"$ref": "#/$defs/sha256"},
        "actual_backend": {"const": "hip"},
        "solution_payload_sha256": {"$ref": "#/$defs/sha256"},
        "exported_free_residual_payload_sha256": {"$ref": "#/$defs/sha256"},
        "solve_record_payload_sha256": {"$ref": "#/$defs/sha256"},
        "compiled_architecture": {
          "type": "string",
          "pattern": "^gfx[0-9a-f]+(?::[A-Za-z0-9_+.-]+)*$"
        },
        "runtime_architecture_base": {
          "type": "string",
          "pattern": "^gfx[0-9a-f]+$"
        },
        "device_ordinal": {"$ref": "#/$defs/index"},
        "device_uuid_bytes_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "not": {"const": "00000000000000000000000000000000"}
        },
        "device_pci_bdf": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
        },
        "source_kind": {"const": "fgmres_partial_iterate"},
        "additional_device_operation_count": {"const": 0},
        "additional_d2h_operation_count": {"const": 0},
        "additional_solve_count": {"const": 0},
        "additional_export_count": {"const": 0},
        "fallback_count": {"const": 0},
        "live_authority_serialized": {"const": false},
        "signed_evidence": {"const": false},
        "standalone_provenance": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_ready",
        "diagnostic_ir_verified",
        "partial_iterate_preserved",
        "nonconverged_max_iterations_verified",
        "evaluated_trial_state_verified",
        "true_residual_replayed",
        "restart_history_preserved",
        "rollback_to_accepted_state_verified",
        "committed_state_created",
        "analysis_state_committed",
        "solution_ready",
        "result_ir_ready",
        "restart_checkpoint_ready",
        "code_check_ready",
        "optimization_consumable",
        "reaction_recovery_verified",
        "member_force_recovery_verified",
        "energy_identities_verified",
        "device_execution_verified",
        "iteration_host_copy_zero_proven",
        "end_to_end_o_n_proven",
        "performance_or_speedup_proven",
        "commercial_ready",
        "promotion_eligible",
        "signed_evidence",
        "standalone_provenance"
      ],
      "properties": {
        "diagnostic_ready": {"type": "boolean"},
        "diagnostic_ir_verified": {"const": true},
        "partial_iterate_preserved": {"type": "boolean"},
        "nonconverged_max_iterations_verified": {"type": "boolean"},
        "evaluated_trial_state_verified": {"const": true},
        "true_residual_replayed": {"const": true},
        "restart_history_preserved": {"type": "boolean"},
        "rollback_to_accepted_state_verified": {"const": true},
        "committed_state_created": {"const": false},
        "analysis_state_committed": {"const": false},
        "solution_ready": {"const": false},
        "result_ir_ready": {"const": false},
        "restart_checkpoint_ready": {"const": false},
        "code_check_ready": {"const": false},
        "optimization_consumable": {"const": false},
        "reaction_recovery_verified": {"const": false},
        "member_force_recovery_verified": {"const": false},
        "energy_identities_verified": {"const": false},
        "device_execution_verified": {"const": false},
        "iteration_host_copy_zero_proven": {"const": false},
        "end_to_end_o_n_proven": {"const": false},
        "performance_or_speedup_proven": {"const": false},
        "commercial_ready": {"const": false},
        "promotion_eligible": {"const": false},
        "signed_evidence": {"const": false},
        "standalone_provenance": {"const": false}
      }
    }
  }
}
