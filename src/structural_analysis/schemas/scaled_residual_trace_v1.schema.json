{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/scaled_residual_trace_v1.schema.json",
  "title": "Engine v2 non-authoritative ScaledResidualTrace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authority", "execution_plan_hash", "scaling_hash",
    "residual_sign", "active_equations", "vectors", "vector_hashes",
    "norms", "governing", "trace_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-scaled-residual-trace.v1"},
    "authority": {"const": "non_authoritative_diagnostic"},
    "execution_plan_hash": {"$ref": "#/$defs/sha256"},
    "scaling_hash": {"$ref": "#/$defs/sha256"},
    "residual_sign": {"const": "internal_minus_external"},
    "active_equations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "vectors": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_residual_si", "scaled_residual"],
      "properties": {
        "raw_residual_si": {"$ref": "#/$defs/vector"},
        "scaled_residual": {"$ref": "#/$defs/vector"}
      }
    },
    "vector_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["raw", "scaled"],
      "properties": {"raw": {"$ref": "#/$defs/sha256"}, "scaled": {"$ref": "#/$defs/sha256"}}
    },
    "norms": {
      "type": "object", "additionalProperties": false,
      "required": [
        "raw_translation_l2_n", "raw_translation_linf_n", "raw_rotation_l2_nm",
        "raw_rotation_linf_nm", "scaled_l2", "scaled_linf"
      ],
      "properties": {
        "raw_translation_l2_n": {"$ref": "#/$defs/nonnegative"},
        "raw_translation_linf_n": {"$ref": "#/$defs/nonnegative"},
        "raw_rotation_l2_nm": {"$ref": "#/$defs/nonnegative"},
        "raw_rotation_linf_nm": {"$ref": "#/$defs/nonnegative"},
        "scaled_l2": {"$ref": "#/$defs/nonnegative"},
        "scaled_linf": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "governing": {
      "type": "object", "additionalProperties": false,
      "required": ["equation", "node_id", "dof"],
      "properties": {
        "equation": {"type": "integer", "minimum": 0},
        "node_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "dof": {"enum": ["UX", "UY", "UZ", "RX", "RY", "RZ"]}
      }
    },
    "trace_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonnegative": {"type": "number", "minimum": 0},
    "vector": {"type": "array", "minItems": 1, "items": {"type": "number"}}
  }
}
