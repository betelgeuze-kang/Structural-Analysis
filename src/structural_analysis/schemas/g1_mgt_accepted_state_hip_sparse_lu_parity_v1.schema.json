{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/g1-mgt-accepted-state-hip-sparse-lu-parity-v1.schema.json",
  "title": "G1 full-load accepted-state HIP sparse-LU parity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_hash", "generated_at", "status",
    "contract_pass", "contract_scope", "source", "runtime",
    "accepted_state", "preconditioner", "hardware_execution",
    "host_timings", "comparison", "claims", "blockers_remaining",
    "artifacts", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "g1-mgt-accepted-state-hip-sparse-lu-parity-receipt.v1"},
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "partial"},
    "contract_pass": {"const": true},
    "contract_scope": {"const": "actual_mgt_full_load_accepted_state_local_gfx1030_sparse_lu_apply"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_commit_sha", "source_paths_clean_at_execution", "input_checksums", "engine_version"],
      "properties": {
        "repository_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_paths_clean_at_execution": {"const": true},
        "input_checksums": {"type": "object", "minProperties": 11, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "engine_version": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "device_name", "gcn_arch_name", "device_nodes", "compiler", "binary_sha256", "binary_byte_length", "wheel"],
      "properties": {
        "backend": {"const": "amd_rocm_hip"},
        "device_name": {"const": "AMD Radeon RX 6900 XT"},
        "gcn_arch_name": {"const": "gfx1030"},
        "device_nodes": {"const": ["/dev/kfd", "/dev/dri/renderD128"]},
        "compiler": {"$ref": "#/$defs/compiler"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "binary_byte_length": {"type": "integer", "minimum": 1},
        "wheel": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "bound_at_execution"],
          "properties": {
            "path": {"const": "dist/structural_analysis-0.3.0-py3-none-any.whl"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bound_at_execution": {"const": true}
          }
        }
      }
    },
    "accepted_state": {
      "type": "object", "additionalProperties": false,
      "required": [
        "mgt_path", "mgt_sha256", "checkpoint_npz", "checkpoint_sha256",
        "load_factor", "equation_count", "state_policy", "accepted_state_hash",
        "state_data_hash", "free_equation_order_data_hash",
        "physical_residual_data_hash", "right_hand_side_policy",
        "right_hand_side_data_hash", "physical_residual_inf_kn",
        "checkpoint_residual_inf_n"
      ],
      "properties": {
        "mgt_path": {"type": "string", "minLength": 1},
        "mgt_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_npz": {"const": "implementation/phase1/release_evidence/productization/g1_mgt_state_updated_frame_axial_full_load_checkpoint.npz"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "load_factor": {"const": 1.0},
        "equation_count": {"const": 70560},
        "state_policy": {"const": "full_load_checkpoint_accepted_free_displacements"},
        "accepted_state_hash": {"$ref": "#/$defs/sha256"},
        "state_data_hash": {"$ref": "#/$defs/sha256"},
        "free_equation_order_data_hash": {"$ref": "#/$defs/sha256"},
        "physical_residual_data_hash": {"$ref": "#/$defs/sha256"},
        "right_hand_side_policy": {"const": "negative_physical_residual_at_accepted_state"},
        "right_hand_side_data_hash": {"$ref": "#/$defs/sha256"},
        "physical_residual_inf_kn": {"type": "number", "exclusiveMinimum": 0, "maximum": 5e-7},
        "checkpoint_residual_inf_n": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.0005}
      }
    },
    "preconditioner": {
      "type": "object", "additionalProperties": false,
      "required": [
        "profile", "factorization_backend", "scipy_version", "drop_tolerance",
        "fill_factor", "column_permutation", "reference_operator_pattern_hash",
        "reference_operator_numeric_values_hash", "factor_manifest",
        "fixture_manifest", "factor_persisted", "fixture_persisted"
      ],
      "properties": {
        "profile": {"const": "fixed_reference_host_spilu_canonical_sparse_lu.v1"},
        "factorization_backend": {"const": "scipy.sparse.linalg.spilu_superlu"},
        "scipy_version": {"type": "string", "minLength": 1},
        "drop_tolerance": {"const": 1e-6},
        "fill_factor": {"const": 20.0},
        "column_permutation": {"const": "COLAMD"},
        "reference_operator_pattern_hash": {"$ref": "#/$defs/sha256"},
        "reference_operator_numeric_values_hash": {"$ref": "#/$defs/sha256"},
        "factor_manifest": {
          "type": "object", "required": ["schema_version", "contract_hash", "dimension", "lower_nnz", "upper_nnz", "factor_nnz", "total_byte_length"],
          "properties": {
            "schema_version": {"const": "canonical-sparse-lu-factor.v1"},
            "contract_hash": {"$ref": "#/$defs/sha256"},
            "dimension": {"const": 70560},
            "lower_nnz": {"type": "integer", "minimum": 70560},
            "upper_nnz": {"type": "integer", "minimum": 70560},
            "factor_nnz": {"type": "integer", "minimum": 141120},
            "total_byte_length": {"type": "integer", "minimum": 1000000}
          }
        },
        "fixture_manifest": {
          "type": "object", "required": ["schema_version", "fixture_hash", "dimension", "lower_level_count", "upper_level_count", "expected_kernel_invocation_count"],
          "properties": {
            "schema_version": {"const": "engine-v2-hip-sparse-lu-apply-fixture.v1"},
            "fixture_hash": {"$ref": "#/$defs/sha256"},
            "dimension": {"const": 70560},
            "lower_level_count": {"type": "integer", "minimum": 1},
            "upper_level_count": {"type": "integer", "minimum": 1},
            "expected_kernel_invocation_count": {"type": "integer", "minimum": 4}
          }
        },
        "factor_persisted": {"const": false},
        "fixture_persisted": {"const": false}
      }
    },
    "hardware_execution": {
      "type": "object", "additionalProperties": false,
      "required": ["actual_hardware", "runtime_metadata", "runtime_output_hash", "fixture_file_sha256", "fixture_file_byte_length", "process_wall_time_ms", "telemetry", "solution_artifact"],
      "properties": {
        "actual_hardware": {"const": true},
        "runtime_metadata": {"$ref": "#/$defs/runtime_metadata"},
        "runtime_output_hash": {"$ref": "#/$defs/sha256"},
        "fixture_file_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_file_byte_length": {"type": "integer", "minimum": 1000000},
        "process_wall_time_ms": {"type": "number", "exclusiveMinimum": 0},
        "telemetry": {"$ref": "#/$defs/telemetry"},
        "solution_artifact": {"$ref": "#/$defs/solution_artifact"}
      }
    },
    "host_timings": {
      "type": "object", "additionalProperties": false,
      "required": ["problem_build_seconds", "host_factorization_seconds", "fixture_schedule_seconds", "canonical_cpu_apply_seconds", "device_order_cpu_apply_seconds"],
      "properties": {
        "problem_build_seconds": {"type": "number", "minimum": 0},
        "host_factorization_seconds": {"type": "number", "minimum": 0},
        "fixture_schedule_seconds": {"type": "number", "minimum": 0},
        "canonical_cpu_apply_seconds": {"type": "number", "minimum": 0},
        "device_order_cpu_apply_seconds": {"type": "number", "minimum": 0}
      }
    },
    "comparison": {"$ref": "#/$defs/comparison"},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["actual_mgt_full_load_accepted_state", "actual_mgt_70560_factor_apply", "production_scale_level_schedule", "actual_gfx1030_hardware", "mid_apply_d2h_zero", "cpu_hip_numerical_parity", "production_current_tangent_fgmres", "persistent_factor_across_krylov_iterations", "independent_gfx1100", "g1_closure"],
      "properties": {
        "actual_mgt_full_load_accepted_state": {"const": true},
        "actual_mgt_70560_factor_apply": {"const": true},
        "production_scale_level_schedule": {"const": true},
        "actual_gfx1030_hardware": {"const": true},
        "mid_apply_d2h_zero": {"const": true},
        "cpu_hip_numerical_parity": {"const": true},
        "production_current_tangent_fgmres": {"const": false},
        "persistent_factor_across_krylov_iterations": {"const": false},
        "independent_gfx1100": {"const": false},
        "g1_closure": {"const": false}
      }
    },
    "blockers_remaining": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "prefixItems": [
        {"const": "current_tangent_operator_and_preconditioner_not_integrated_in_one_device_fgmres"},
        {"const": "factor_not_persisted_across_krylov_iterations"},
        {"const": "factorization_is_host_scipy_superlu_specific"},
        {"const": "independent_gfx1100_run_not_available"},
        {"const": "same_clean_source_cross_device_receipt_not_available"},
        {"const": "g1_full_building_device_newton_closure_not_established"}
      ], "items": false
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt", "solution_vector", "schema", "runner", "hip_source"],
      "properties": {
        "receipt": {"type": "string", "minLength": 1},
        "solution_vector": {"type": "string", "minLength": 1},
        "schema": {"const": "src/structural_analysis/schemas/g1_mgt_accepted_state_hip_sparse_lu_parity_v1.schema.json"},
        "runner": {"const": "scripts/run_g1_mgt_accepted_state_hip_sparse_lu_parity.py"},
        "hip_source": {"const": "implementation/phase1/hip_kernels/engine_v2_sparse_lu_apply.hip.cpp"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 300}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "version_first_line", "version_output_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version_first_line": {"type": "string", "minLength": 1},
        "version_output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "cpu_backend", "device_name", "gcn_arch_name", "execution_profile", "accumulation_profile", "dimension", "lower_level_count", "upper_level_count", "kernel_invocation_count", "mid_apply_d2h_transfer_count", "blocking_d2h_synchronization_count"],
      "properties": {
        "schema_version": {"const": "engine-v2-hip-sparse-lu-apply-output.v1"},
        "status": {"const": "ok"},
        "cpu_backend": {"const": false},
        "device_name": {"const": "AMD Radeon RX 6900 XT"},
        "gcn_arch_name": {"const": "gfx1030"},
        "execution_profile": {"const": "same_stream_level_scheduled_csr_forward_backward.v1"},
        "accumulation_profile": {"const": "ascending_column_sequential_fp64.v1"},
        "dimension": {"const": 70560},
        "lower_level_count": {"type": "integer", "minimum": 1},
        "upper_level_count": {"type": "integer", "minimum": 1},
        "kernel_invocation_count": {"type": "integer", "minimum": 4},
        "mid_apply_d2h_transfer_count": {"const": 0},
        "blocking_d2h_synchronization_count": {"const": 1}
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["h2d_bytes", "d2h_bytes", "mid_apply_d2h_bytes", "tracked_peak_device_allocation_bytes"],
      "properties": {
        "h2d_bytes": {"type": "integer", "minimum": 1000000},
        "d2h_bytes": {"const": 564480},
        "mid_apply_d2h_bytes": {"const": 0},
        "tracked_peak_device_allocation_bytes": {"type": "integer", "minimum": 1000000}
      }
    },
    "solution_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "format", "dtype", "shape", "byte_length", "file_sha256", "data_hash", "persisted"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"const": "canonical_little_endian_float64_vector.v1"},
        "dtype": {"const": "<f8"},
        "shape": {"const": [70560]},
        "byte_length": {"const": 564480},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "data_hash": {"$ref": "#/$defs/sha256"},
        "persisted": {"const": true}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "contract_pass", "canonical_cpu_max_abs_error_m", "device_order_cpu_max_abs_error_m", "comparison_tolerance_m", "solution_data_hash", "canonical_solution_data_hash", "device_order_solution_data_hash", "actual_hardware_execution_required_for_claim", "production_performance_claim"],
      "properties": {
        "profile": {"const": "engine-v2-cpu-hip-canonical-sparse-lu-apply-parity.v1"},
        "contract_pass": {"const": true},
        "canonical_cpu_max_abs_error_m": {"type": "number", "minimum": 0},
        "device_order_cpu_max_abs_error_m": {"type": "number", "minimum": 0},
        "comparison_tolerance_m": {"type": "number", "exclusiveMinimum": 0},
        "solution_data_hash": {"$ref": "#/$defs/sha256"},
        "canonical_solution_data_hash": {"$ref": "#/$defs/sha256"},
        "device_order_solution_data_hash": {"$ref": "#/$defs/sha256"},
        "actual_hardware_execution_required_for_claim": {"const": true},
        "production_performance_claim": {"const": false}
      }
    }
  }
}
