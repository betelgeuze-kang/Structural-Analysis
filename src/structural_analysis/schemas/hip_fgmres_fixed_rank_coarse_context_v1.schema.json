{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_fgmres_fixed_rank_coarse_context_v1.schema.json",
  "title": "HIP FGMRES fixed-rank coarse execution context receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "context_id",
    "evidence_scope",
    "actual_backend",
    "promotion_eligible",
    "reason",
    "bindings",
    "kernel",
    "dimensions",
    "owned_buffers",
    "allocation_lineage",
    "telemetry",
    "claims",
    "context_receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-hip-fgmres-fixed-rank-coarse-context.v1"
    },
    "capability_profile": {
      "const": "phase0_live_hip_fgmres_fixed_rank_coarse_resource_owner"
    },
    "status": {
      "enum": [
        "context_ready",
        "poisoned",
        "context_closed",
        "cleanup_failed",
        "cleanup_quarantined",
        "unavailable"
      ]
    },
    "context_id": { "$ref": "#/$defs/hash" },
    "evidence_scope": {
      "const": "allocation_lineage_live_parent_delegation_non_promoting"
    },
    "actual_backend": { "enum": ["hip", "test_double", null] },
    "promotion_eligible": { "const": false },
    "reason": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "detail"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_checkpoint_context_id",
        "live_checkpoint_opening_receipt_hash",
        "source_fgmres_plan_hash",
        "recurrence_plan_hash",
        "coarse_plan_hash",
        "coarse_space_hash",
        "coarse_memory_layout_hash",
        "kernel_abi_hash",
        "parent_child_epoch",
        "parent_generation_binding_hash",
        "owned_generation_binding_hash"
      ],
      "properties": {
        "live_checkpoint_context_id": { "$ref": "#/$defs/hash" },
        "live_checkpoint_opening_receipt_hash": { "$ref": "#/$defs/hash" },
        "source_fgmres_plan_hash": { "$ref": "#/$defs/hash" },
        "recurrence_plan_hash": { "$ref": "#/$defs/hash" },
        "coarse_plan_hash": { "$ref": "#/$defs/hash" },
        "coarse_space_hash": { "$ref": "#/$defs/hash" },
        "coarse_memory_layout_hash": { "$ref": "#/$defs/hash" },
        "kernel_abi_hash": { "$ref": "#/$defs/hash" },
        "parent_child_epoch": { "type": "integer", "minimum": 1 },
        "parent_generation_binding_hash": { "$ref": "#/$defs/hash" },
        "owned_generation_binding_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "identity_hash",
        "source_sha256",
        "code_object_sha256",
        "kernel_abi_hash",
        "runtime_library_sha256",
        "runtime_library_discovery_source",
        "hiprtc_library_sha256",
        "hiprtc_library_discovery_source",
        "kernel_origin"
      ],
      "properties": {
        "architecture": { "type": "string", "pattern": "^gfx[0-9a-f]+$" },
        "identity_hash": { "$ref": "#/$defs/hash" },
        "source_sha256": { "$ref": "#/$defs/hash" },
        "code_object_sha256": { "$ref": "#/$defs/hash" },
        "kernel_abi_hash": { "$ref": "#/$defs/hash" },
        "runtime_library_sha256": { "$ref": "#/$defs/hash" },
        "runtime_library_discovery_source": {
          "enum": ["explicit", "opt_rocm", "system_loader", "injected"]
        },
        "hiprtc_library_sha256": { "$ref": "#/$defs/hash" },
        "hiprtc_library_discovery_source": {
          "enum": ["explicit", "opt_rocm", "system_loader", "injected"]
        },
        "kernel_origin": { "enum": ["internally_compiled", "caller_supplied"] }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_dof_count",
        "restart_dimension",
        "retained_rank",
        "parent_capability_count",
        "owned_capability_count",
        "static_upload_count",
        "launches_per_application"
      ],
      "properties": {
        "free_dof_count": { "type": "integer", "minimum": 1 },
        "restart_dimension": { "type": "integer", "minimum": 1, "maximum": 16 },
        "retained_rank": { "type": "integer", "minimum": 1, "maximum": 16 },
        "parent_capability_count": { "const": 3 },
        "owned_capability_count": { "const": 6 },
        "static_upload_count": { "const": 3 },
        "launches_per_application": { "const": 4 }
      }
    },
    "owned_buffers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/physical_basis" },
        { "$ref": "#/$defs/operator_basis" },
        { "$ref": "#/$defs/cholesky" },
        { "$ref": "#/$defs/rhs" },
        { "$ref": "#/$defs/coefficients" },
        { "$ref": "#/$defs/status" }
      ],
      "items": false
    },
    "allocation_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_profile",
        "evidence_scope",
        "owner_role",
        "runtime_device_bound",
        "same_stream_bound",
        "delegated_parent_capability_count",
        "managed_buffer_count",
        "managed_device_bytes",
        "all_owned_buffers_managed",
        "duplicate_registry_borrow_count",
        "pointer_values_serialized",
        "promotion_eligible"
      ],
      "properties": {
        "capability_profile": { "const": "foundation_non_promoting" },
        "evidence_scope": { "const": "foundation_non_promoting" },
        "owner_role": { "const": "fgmres_fixed_rank_coarse_owned_buffers" },
        "runtime_device_bound": { "type": "boolean" },
        "same_stream_bound": { "type": "boolean" },
        "delegated_parent_capability_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "managed_buffer_count": { "type": "integer", "minimum": 0, "maximum": 6 },
        "managed_device_bytes": { "type": "integer", "minimum": 0 },
        "all_owned_buffers_managed": { "type": "boolean" },
        "duplicate_registry_borrow_count": { "const": 0 },
        "pointer_values_serialized": { "const": false },
        "promotion_eligible": { "const": false }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_attempt_count",
        "allocation_success_count",
        "deallocation_attempt_count",
        "deallocation_success_count",
        "current_device_bytes",
        "peak_device_bytes",
        "quarantined_device_bytes",
        "lineage_owner_open_success_count",
        "lineage_owner_close_success_count",
        "lineage_capability_mint_success_count",
        "lineage_capability_mint_bytes",
        "lineage_free_acknowledgement_count",
        "lineage_free_quarantine_count",
        "lineage_orphan_acknowledgement_count",
        "lineage_orphan_quarantine_count",
        "parent_delegation_acquire_success_count",
        "parent_delegation_release_success_count",
        "module_owner_acquire_success_count",
        "module_close_attempt_count",
        "module_close_success_count",
        "h2d_operation_attempt_count",
        "h2d_operation_success_count",
        "h2d_bytes_attempted",
        "h2d_bytes_succeeded",
        "application_attempt_count",
        "application_success_count",
        "kernel_launch_attempt_count",
        "kernel_launch_success_count",
        "fence_attempt_count",
        "fence_success_count",
        "fence_acknowledged_launch_count",
        "d2h_operation_count",
        "fallback_count"
      ],
      "properties": {
        "allocation_attempt_count": { "$ref": "#/$defs/nonnegative" },
        "allocation_success_count": { "$ref": "#/$defs/nonnegative" },
        "deallocation_attempt_count": { "$ref": "#/$defs/nonnegative" },
        "deallocation_success_count": { "$ref": "#/$defs/nonnegative" },
        "current_device_bytes": { "$ref": "#/$defs/nonnegative" },
        "peak_device_bytes": { "$ref": "#/$defs/nonnegative" },
        "quarantined_device_bytes": { "$ref": "#/$defs/nonnegative" },
        "lineage_owner_open_success_count": { "$ref": "#/$defs/nonnegative" },
        "lineage_owner_close_success_count": { "$ref": "#/$defs/nonnegative" },
        "lineage_capability_mint_success_count": { "$ref": "#/$defs/nonnegative" },
        "lineage_capability_mint_bytes": { "$ref": "#/$defs/nonnegative" },
        "lineage_free_acknowledgement_count": { "$ref": "#/$defs/nonnegative" },
        "lineage_free_quarantine_count": { "$ref": "#/$defs/nonnegative" },
        "lineage_orphan_acknowledgement_count": { "$ref": "#/$defs/nonnegative" },
        "lineage_orphan_quarantine_count": { "$ref": "#/$defs/nonnegative" },
        "parent_delegation_acquire_success_count": { "$ref": "#/$defs/nonnegative" },
        "parent_delegation_release_success_count": { "$ref": "#/$defs/nonnegative" },
        "module_owner_acquire_success_count": { "$ref": "#/$defs/nonnegative" },
        "module_close_attempt_count": { "$ref": "#/$defs/nonnegative" },
        "module_close_success_count": { "$ref": "#/$defs/nonnegative" },
        "h2d_operation_attempt_count": { "$ref": "#/$defs/nonnegative" },
        "h2d_operation_success_count": { "$ref": "#/$defs/nonnegative" },
        "h2d_bytes_attempted": { "$ref": "#/$defs/nonnegative" },
        "h2d_bytes_succeeded": { "$ref": "#/$defs/nonnegative" },
        "application_attempt_count": { "$ref": "#/$defs/nonnegative" },
        "application_success_count": { "$ref": "#/$defs/nonnegative" },
        "kernel_launch_attempt_count": { "$ref": "#/$defs/nonnegative" },
        "kernel_launch_success_count": { "$ref": "#/$defs/nonnegative" },
        "fence_attempt_count": { "$ref": "#/$defs/nonnegative" },
        "fence_success_count": { "$ref": "#/$defs/nonnegative" },
        "fence_acknowledged_launch_count": { "$ref": "#/$defs/nonnegative" },
        "d2h_operation_count": { "const": 0 },
        "fallback_count": { "const": 0 }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_live_parent_delegated",
        "allocator_provenance_bound",
        "static_uploads_enqueued_once",
        "same_stream_application_ready",
        "application_host_copy_zero_by_construction",
        "actual_device_application_observed",
        "recurrence_state_machine_integrated",
        "device_status_terminal_bound",
        "iteration_host_copy_zero_proven",
        "asymptotic_o_n_proven",
        "speedup_proven",
        "commercial_ready",
        "promotion_eligible"
      ],
      "properties": {
        "exact_live_parent_delegated": { "type": "boolean" },
        "allocator_provenance_bound": { "type": "boolean" },
        "static_uploads_enqueued_once": { "type": "boolean" },
        "same_stream_application_ready": { "type": "boolean" },
        "application_host_copy_zero_by_construction": { "type": "boolean" },
        "actual_device_application_observed": { "const": false },
        "recurrence_state_machine_integrated": { "const": false },
        "device_status_terminal_bound": { "const": false },
        "iteration_host_copy_zero_proven": { "const": false },
        "asymptotic_o_n_proven": { "const": false },
        "speedup_proven": { "const": false },
        "commercial_ready": { "const": false },
        "promotion_eligible": { "const": false }
      }
    },
    "context_receipt_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonnegative": { "type": "integer", "minimum": 0 },
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "element_count",
        "byte_length",
        "memory_space",
        "ownership",
        "access",
        "initialization",
        "layout"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "enum": ["<f8", "<u4"] },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "element_count": { "type": "integer", "minimum": 1 },
        "byte_length": { "type": "integer", "minimum": 1 },
        "memory_space": { "const": "hip_device" },
        "ownership": { "const": "owned" },
        "access": { "type": "string", "minLength": 1 },
        "initialization": { "type": "string", "minLength": 1 },
        "layout": { "type": "string", "minLength": 1 }
      }
    },
    "physical_basis": {
      "allOf": [
        { "$ref": "#/$defs/buffer" },
        { "properties": { "name": { "const": "coarse_physical_basis_z" }, "dtype": { "const": "<f8" } } }
      ]
    },
    "operator_basis": {
      "allOf": [
        { "$ref": "#/$defs/buffer" },
        { "properties": { "name": { "const": "coarse_operator_basis_az" }, "dtype": { "const": "<f8" } } }
      ]
    },
    "cholesky": {
      "allOf": [
        { "$ref": "#/$defs/buffer" },
        { "properties": { "name": { "const": "coarse_cholesky_l" }, "dtype": { "const": "<f8" } } }
      ]
    },
    "rhs": {
      "allOf": [
        { "$ref": "#/$defs/buffer" },
        { "properties": { "name": { "const": "coarse_rhs" }, "dtype": { "const": "<f8" } } }
      ]
    },
    "coefficients": {
      "allOf": [
        { "$ref": "#/$defs/buffer" },
        { "properties": { "name": { "const": "coarse_coefficients" }, "dtype": { "const": "<f8" } } }
      ]
    },
    "status": {
      "allOf": [
        { "$ref": "#/$defs/buffer" },
        { "properties": { "name": { "const": "coarse_status" }, "dtype": { "const": "<u4" }, "shape": { "const": [1] }, "element_count": { "const": 1 }, "byte_length": { "const": 4 } } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "context_ready" } } },
      "then": { "properties": { "reason": { "type": "null" } } }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["poisoned", "cleanup_failed", "cleanup_quarantined", "unavailable"]
          }
        }
      },
      "then": { "properties": { "reason": { "type": "object" } } }
    }
  ]
}
