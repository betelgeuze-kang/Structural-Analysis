{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_fgmres_external_replay_ledger_receipt_v2.schema.json",
  "title": "Durably recorded external FGMRES signed release-identity evidence receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "evidence_scope",
    "ledger_id",
    "ledger_namespace",
    "reservation_event_sequence",
    "reservation_event_hash",
    "acceptance_event_sequence",
    "acceptance_event_hash",
    "acceptance_commit_head_event_sequence",
    "acceptance_commit_head_event_hash",
    "request_id",
    "campaign_id",
    "challenge_id",
    "key_id",
    "key_epoch",
    "runner_id",
    "run_sequence",
    "release_binding_hash",
    "release_identity_receipt_schema_version",
    "release_identity_receipt_hash",
    "trust_registry_hash",
    "fixture_registry_hash",
    "envelope_hash",
    "signed_payload_sha256",
    "signed_evidence_receipt_hash",
    "claims",
    "promotion_eligible",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-hip-fgmres-external-replay-ledger-receipt.v2"
    },
    "capability_profile": {
      "const": "phase0_external_signed_release_identity_local_durable_replay_ledger"
    },
    "status": {
      "const": "external_signed_release_identity_evidence_durably_recorded"
    },
    "evidence_scope": {
      "const": "single_configured_local_posix_sqlite_ledger_cross_process_at_most_once_signed_release_identity_acceptance_non_promoting"
    },
    "ledger_id": {"$ref": "#/$defs/hash"},
    "ledger_namespace": {
      "const": "hip_fgmres_external_signed_release_identity_v2"
    },
    "reservation_event_sequence": {"type": "integer", "minimum": 1},
    "reservation_event_hash": {"$ref": "#/$defs/hash"},
    "acceptance_event_sequence": {"type": "integer", "minimum": 2},
    "acceptance_event_hash": {"$ref": "#/$defs/hash"},
    "acceptance_commit_head_event_sequence": {"type": "integer", "minimum": 2},
    "acceptance_commit_head_event_hash": {"$ref": "#/$defs/hash"},
    "request_id": {"$ref": "#/$defs/id"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "challenge_id": {"$ref": "#/$defs/hash"},
    "key_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^ed25519:[a-z0-9][a-z0-9._-]{2,63}:v[1-9][0-9]*$"
    },
    "key_epoch": {"type": "integer", "minimum": 1},
    "runner_id": {"$ref": "#/$defs/runner_id"},
    "run_sequence": {"type": "integer", "minimum": 1},
    "release_binding_hash": {"$ref": "#/$defs/hash"},
    "release_identity_receipt_schema_version": {
      "const": "structural-analysis-hip-fgmres-external-release-identity.v1"
    },
    "release_identity_receipt_hash": {"$ref": "#/$defs/hash"},
    "trust_registry_hash": {"$ref": "#/$defs/hash"},
    "fixture_registry_hash": {"$ref": "#/$defs/hash"},
    "envelope_hash": {"$ref": "#/$defs/hash"},
    "signed_payload_sha256": {"$ref": "#/$defs/hash"},
    "signed_evidence_receipt_hash": {"$ref": "#/$defs/hash"},
    "claims": {"$ref": "#/$defs/claims"},
    "promotion_eligible": {"const": false},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "runner_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_artifacts_freshly_replayed",
        "ledger_issued_challenge_rehydrated",
        "signed_evidence_receipt_verified",
        "release_identity_and_signed_receipts_bound",
        "challenge_reservation_durably_committed",
        "signed_acceptance_durably_committed",
        "runner_sequence_cross_process_uniqueness_enforced",
        "challenge_and_envelope_uniqueness_enforced",
        "canonical_ledger_event_chain_replayed",
        "local_sqlite_extra_synchronous_commit_completed",
        "durable_replay_ledger_verified",
        "signed_envelope_binds_release_identity_receipt",
        "exactly_once_delivery_verified",
        "cross_host_replay_prevented",
        "coordinated_storage_rollback_resisted",
        "hostile_same_uid_storage_writer_resisted",
        "hostile_in_process_mint_isolation_verified",
        "cryptographic_ledger_authenticity_verified",
        "hardware_monotonic_anchor_verified",
        "runner_honesty_verified",
        "hardware_root_attested",
        "external_hardware_independently_observed_by_local_process",
        "same_artifact_two_architecture_verified",
        "multiarchitecture_promotion_verified",
        "result_ir_verified",
        "iteration_host_copy_zero_verified",
        "speedup_verified",
        "end_to_end_o_n_verified",
        "commercial_ready",
        "promotion_eligible"
      ],
      "properties": {
        "release_artifacts_freshly_replayed": {"const": true},
        "ledger_issued_challenge_rehydrated": {"const": true},
        "signed_evidence_receipt_verified": {"const": true},
        "release_identity_and_signed_receipts_bound": {"const": true},
        "challenge_reservation_durably_committed": {"const": true},
        "signed_acceptance_durably_committed": {"const": true},
        "runner_sequence_cross_process_uniqueness_enforced": {"const": true},
        "challenge_and_envelope_uniqueness_enforced": {"const": true},
        "canonical_ledger_event_chain_replayed": {"const": true},
        "local_sqlite_extra_synchronous_commit_completed": {"const": true},
        "durable_replay_ledger_verified": {"const": true},
        "signed_envelope_binds_release_identity_receipt": {"const": true},
        "exactly_once_delivery_verified": {"const": false},
        "cross_host_replay_prevented": {"const": false},
        "coordinated_storage_rollback_resisted": {"const": false},
        "hostile_same_uid_storage_writer_resisted": {"const": false},
        "hostile_in_process_mint_isolation_verified": {"const": false},
        "cryptographic_ledger_authenticity_verified": {"const": false},
        "hardware_monotonic_anchor_verified": {"const": false},
        "runner_honesty_verified": {"const": false},
        "hardware_root_attested": {"const": false},
        "external_hardware_independently_observed_by_local_process": {"const": false},
        "same_artifact_two_architecture_verified": {"const": false},
        "multiarchitecture_promotion_verified": {"const": false},
        "result_ir_verified": {"const": false},
        "iteration_host_copy_zero_verified": {"const": false},
        "speedup_verified": {"const": false},
        "end_to_end_o_n_verified": {"const": false},
        "commercial_ready": {"const": false},
        "promotion_eligible": {"const": false}
      }
    }
  }
}
