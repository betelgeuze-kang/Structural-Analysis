{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/stateful_fiber_frame2d_checkpoint_chain_v1.schema.json",
  "title": "Stateful Fiber Frame 2D Checkpoint Ancestor Chain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "storage_profile",
    "case_id",
    "problem_contract_hash",
    "checkpoint_count",
    "root_state_hash",
    "terminal_state_hash",
    "checkpoints",
    "chain_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "stateful-fiber-frame2d-checkpoint-chain.v1"
    },
    "role": {"const": "committed_ancestor_chain"},
    "storage_profile": {
      "const": "canonical-signed-zero-preserving-utf8-json.v1"
    },
    "case_id": {"type": "string", "minLength": 1},
    "problem_contract_hash": {"$ref": "#/$defs/hash"},
    "checkpoint_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "root_state_hash": {"$ref": "#/$defs/hash"},
    "terminal_state_hash": {"$ref": "#/$defs/hash"},
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "https://structural-analysis.local/schemas/stateful_fiber_frame2d_checkpoint_v1.schema.json"
      }
    },
    "chain_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
