{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/result_ir_v1.schema.json",
  "title": "Engine v2 ResultIR v1 linear-static success receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "result_id",
    "input_bindings",
    "analysis",
    "ordering",
    "arrays",
    "total_strain_energy_j",
    "convergence",
    "recovery",
    "backend_receipt",
    "numerical_result_hash",
    "result_ir_hash",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-result-ir.v1"},
    "capability_profile": {"const": "phase0_cpu_reference_linear_static"},
    "result_id": {"$ref": "#/$defs/stableId"},
    "input_bindings": {"$ref": "#/$defs/inputBindings"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "ordering": {"$ref": "#/$defs/ordering"},
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displacements_si",
        "residual_si",
        "reactions_si",
        "element_end_forces_local_si",
        "element_strain_energy_j"
      ],
      "properties": {
        "displacements_si": {"$ref": "#/$defs/displacementArtifact"},
        "residual_si": {"$ref": "#/$defs/residualArtifact"},
        "reactions_si": {"$ref": "#/$defs/reactionArtifact"},
        "element_end_forces_local_si": {"$ref": "#/$defs/elementForceArtifact"},
        "element_strain_energy_j": {"$ref": "#/$defs/elementEnergyArtifact"}
      }
    },
    "total_strain_energy_j": {"type": "number", "minimum": 0},
    "convergence": {"$ref": "#/$defs/convergence"},
    "recovery": {"$ref": "#/$defs/recovery"},
    "backend_receipt": {"$ref": "#/$defs/backendReceipt"},
    "numerical_result_hash": {"$ref": "#/$defs/sha256"},
    "result_ir_hash": {"$ref": "#/$defs/sha256"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]+$"},
      "additionalProperties": true
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ir_content_hash",
        "solver_numeric_buffer_hash",
        "solver_entity_mapping_hash",
        "solver_artifact_hash",
        "execution_plan_hash",
        "evaluated_trial_state_hash",
        "committed_state_hash"
      ],
      "properties": {
        "model_ir_content_hash": {"$ref": "#/$defs/sha256"},
        "solver_numeric_buffer_hash": {"$ref": "#/$defs/sha256"},
        "solver_entity_mapping_hash": {"$ref": "#/$defs/sha256"},
        "solver_artifact_hash": {"$ref": "#/$defs/sha256"},
        "execution_plan_hash": {"$ref": "#/$defs/sha256"},
        "evaluated_trial_state_hash": {"$ref": "#/$defs/sha256"},
        "committed_state_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status",
        "load_pattern_id",
        "residual_sign",
        "operator_version",
        "operator_hash",
        "recovery_operator_hash",
        "backend_native_result_hash"
      ],
      "properties": {
        "type": {"const": "linear_static"},
        "status": {"const": "ready"},
        "load_pattern_id": {"$ref": "#/$defs/stableId"},
        "residual_sign": {"const": "internal_minus_external"},
        "operator_version": {"const": "engine-v2-cpu-reference-linear-static.v1"},
        "operator_hash": {"$ref": "#/$defs/sha256"},
        "recovery_operator_hash": {"$ref": "#/$defs/sha256"},
        "backend_native_result_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_ids",
        "element_ids",
        "dof_components",
        "element_end_order",
        "component_units",
        "ordering_hash"
      ],
      "properties": {
        "node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "element_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "dof_components": {"const": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
        "element_end_order": {"const": ["i", "j"]},
        "component_units": {"const": ["N", "N", "N", "N*m", "N*m", "N*m"]},
        "ordering_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "arrayArtifactBase": {
      "type": "object",
      "required": [
        "name",
        "dtype",
        "shape",
        "layout",
        "axis_labels",
        "component_labels",
        "component_units",
        "byte_length",
        "data_hash",
        "content_hash",
        "values"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dtype": {"const": "<f8"},
        "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "layout": {"const": "C"},
        "axis_labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "component_labels": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "component_units": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "byte_length": {"type": "integer", "minimum": 8},
        "data_hash": {"$ref": "#/$defs/sha256"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "values": {"type": "array", "minItems": 1}
      }
    },
    "displacementArtifact": {
      "allOf": [
        {"$ref": "#/$defs/arrayArtifactBase"},
        {
          "properties": {
            "name": {"const": "displacements_si"},
            "shape": {
              "type": "array",
              "prefixItems": [{"type": "integer", "minimum": 1}, {"const": 6}],
              "minItems": 2,
              "maxItems": 2
            },
            "axis_labels": {"const": ["node", "dof"]},
            "component_labels": {"const": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
            "component_units": {"const": ["m", "m", "m", "rad", "rad", "rad"]},
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {"type": "number"}
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "residualArtifact": {
      "allOf": [
        {"$ref": "#/$defs/arrayArtifactBase"},
        {
          "properties": {
            "name": {"const": "residual_si"},
            "shape": {
              "type": "array",
              "prefixItems": [{"type": "integer", "minimum": 1}, {"const": 6}],
              "minItems": 2,
              "maxItems": 2
            },
            "axis_labels": {"const": ["node", "dof"]},
            "component_labels": {"const": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
            "component_units": {"const": ["N", "N", "N", "N*m", "N*m", "N*m"]},
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {"type": "number"}
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "reactionArtifact": {
      "allOf": [
        {"$ref": "#/$defs/arrayArtifactBase"},
        {
          "properties": {
            "name": {"const": "reactions_si"},
            "shape": {
              "type": "array",
              "prefixItems": [{"type": "integer", "minimum": 1}, {"const": 6}],
              "minItems": 2,
              "maxItems": 2
            },
            "axis_labels": {"const": ["node", "dof"]},
            "component_labels": {"const": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
            "component_units": {"const": ["N", "N", "N", "N*m", "N*m", "N*m"]},
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {"type": "number"}
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "elementForceArtifact": {
      "allOf": [
        {"$ref": "#/$defs/arrayArtifactBase"},
        {
          "properties": {
            "name": {"const": "element_end_forces_local_si"},
            "shape": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 1},
                {"const": 2},
                {"const": 6}
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "axis_labels": {"const": ["element", "end", "dof"]},
            "component_labels": {"const": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
            "component_units": {"const": ["N", "N", "N", "N*m", "N*m", "N*m"]},
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "items": {"type": "number"}
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "elementEnergyArtifact": {
      "allOf": [
        {"$ref": "#/$defs/arrayArtifactBase"},
        {
          "properties": {
            "name": {"const": "element_strain_energy_j"},
            "shape": {
              "type": "array",
              "prefixItems": [{"type": "integer", "minimum": 1}],
              "minItems": 1,
              "maxItems": 1
            },
            "axis_labels": {"const": ["element"]},
            "component_labels": {"const": ["strain_energy"]},
            "component_units": {"const": ["J"]},
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "converged",
        "requested_residual_tolerance",
        "free_residual_linf",
        "load_scale",
        "scaled_free_residual",
        "solve_attempts",
        "failure_code"
      ],
      "properties": {
        "converged": {"const": true},
        "requested_residual_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "free_residual_linf": {"type": "number", "minimum": 0},
        "load_scale": {"type": "number", "minimum": 1},
        "scaled_free_residual": {"type": "number", "minimum": 0},
        "solve_attempts": {"const": 1},
        "failure_code": {"type": "null"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_frame_convention",
        "end_force_order",
        "reaction_definition",
        "energy_definition",
        "constitutive_source"
      ],
      "properties": {
        "local_frame_convention": {"const": "engine_v2_frame_local_x_i_to_j_right_handed_v1"},
        "end_force_order": {"const": "element_i_then_j_local_ux_uy_uz_rx_ry_rz"},
        "reaction_definition": {"const": "full_residual_on_restrained_dofs_zero_elsewhere"},
        "energy_definition": {"const": "half_local_u_transpose_k_local_u"},
        "constitutive_source": {"const": "solver_model_buffers_linear_elastic_isotropic"}
      }
    },
    "backendReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_backend",
        "actual_backend",
        "matrix_backend",
        "precision",
        "deterministic",
        "fallback_policy",
        "fallback_used",
        "fallback_events",
        "numpy_version",
        "scipy_version",
        "hardware",
        "h2d_bytes",
        "d2h_bytes",
        "device_sync_count",
        "timing",
        "peak_memory"
      ],
      "properties": {
        "requested_backend": {"const": "cpu_reference"},
        "actual_backend": {"const": "cpu_reference"},
        "matrix_backend": {"enum": ["dense", "scipy_sparse"]},
        "precision": {"const": "fp64"},
        "deterministic": {"const": true},
        "fallback_policy": {"const": "forbidden"},
        "fallback_used": {"const": false},
        "fallback_events": {"const": []},
        "numpy_version": {"type": "string", "minLength": 1},
        "scipy_version": {"type": ["string", "null"]},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "machine", "processor"],
          "properties": {
            "platform": {"type": "string", "minLength": 1},
            "machine": {"type": "string"},
            "processor": {"type": "string"}
          }
        },
        "h2d_bytes": {"const": 0},
        "d2h_bytes": {"const": 0},
        "device_sync_count": {"const": 0},
        "timing": {"$ref": "#/$defs/timingReceipt"},
        "peak_memory": {"$ref": "#/$defs/peakMemoryReceipt"}
      },
      "allOf": [
        {
          "if": {"properties": {"matrix_backend": {"const": "scipy_sparse"}}},
          "then": {"properties": {"scipy_version": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "stageDurations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly",
        "constraint_partition",
        "linear_solve",
        "residual",
        "reaction",
        "result_recovery",
        "energy"
      ],
      "properties": {
        "assembly": {"type": ["number", "null"], "minimum": 0},
        "constraint_partition": {"type": ["number", "null"], "minimum": 0},
        "linear_solve": {"type": ["number", "null"], "minimum": 0},
        "residual": {"type": ["number", "null"], "minimum": 0},
        "reaction": {"type": ["number", "null"], "minimum": 0},
        "result_recovery": {"type": ["number", "null"], "minimum": 0},
        "energy": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "measuredStageDurations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly",
        "constraint_partition",
        "linear_solve",
        "residual",
        "reaction",
        "result_recovery",
        "energy"
      ],
      "properties": {
        "assembly": {"type": "number", "minimum": 0},
        "constraint_partition": {"type": "number", "minimum": 0},
        "linear_solve": {"type": "number", "minimum": 0},
        "residual": {"type": "number", "minimum": 0},
        "reaction": {"type": "number", "minimum": 0},
        "result_recovery": {"type": "number", "minimum": 0},
        "energy": {"type": "number", "minimum": 0}
      }
    },
    "unmeasuredStageDurations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly",
        "constraint_partition",
        "linear_solve",
        "residual",
        "reaction",
        "result_recovery",
        "energy"
      ],
      "properties": {
        "assembly": {"type": "null"},
        "constraint_partition": {"type": "null"},
        "linear_solve": {"type": "null"},
        "residual": {"type": "null"},
        "reaction": {"type": "null"},
        "result_recovery": {"type": "null"},
        "energy": {"type": "null"}
      }
    },
    "timingReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_status",
        "clock",
        "total_wall_time_s",
        "stage_wall_time_s"
      ],
      "properties": {
        "measurement_status": {"enum": ["measured", "not_instrumented"]},
        "clock": {"enum": ["perf_counter", "not_available"]},
        "total_wall_time_s": {"type": ["number", "null"], "minimum": 0},
        "stage_wall_time_s": {"$ref": "#/$defs/stageDurations"}
      },
      "allOf": [
        {
          "if": {"properties": {"measurement_status": {"const": "measured"}}},
          "then": {
            "properties": {
              "clock": {"const": "perf_counter"},
              "total_wall_time_s": {"type": "number", "minimum": 0},
              "stage_wall_time_s": {"$ref": "#/$defs/measuredStageDurations"}
            }
          },
          "else": {
            "properties": {
              "clock": {"const": "not_available"},
              "total_wall_time_s": {"type": "null"},
              "stage_wall_time_s": {"$ref": "#/$defs/unmeasuredStageDurations"}
            }
          }
        }
      ]
    },
    "peakMemoryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_status",
        "peak_host_bytes",
        "peak_device_bytes"
      ],
      "properties": {
        "measurement_status": {"enum": ["measured", "not_instrumented"]},
        "peak_host_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_device_bytes": {"const": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"measurement_status": {"const": "measured"}}},
          "then": {
            "properties": {"peak_host_bytes": {"type": "integer", "minimum": 0}}
          },
          "else": {"properties": {"peak_host_bytes": {"type": "null"}}}
        }
      ]
    }
  }
}
