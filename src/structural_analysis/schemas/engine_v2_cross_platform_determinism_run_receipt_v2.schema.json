{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine v2 cross-platform determinism coordinate receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "receipt_hash",
    "source_commit_sha",
    "source_tree",
    "coordinate",
    "execution",
    "model_fixture",
    "bounded_planar_fixture",
    "bounded_planar_settlement_fixture",
    "golden_set_hash",
    "semantic_policy",
    "expected_goldens",
    "observed_goldens",
    "expected_binary_artifacts",
    "observed_binary_artifacts",
    "contract_pass",
    "blockers",
    "claims",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "engine-v2-cross-platform-determinism-run-receipt.v2"
    },
    "generated_at": {"type": "string", "minLength": 1},
    "receipt_hash": {"$ref": "#/$defs/hash"},
    "source_commit_sha": {"type": "string"},
    "source_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout_head_sha", "tracked_source_clean"],
      "properties": {
        "checkout_head_sha": {"type": "string"},
        "tracked_source_clean": {"type": "boolean"}
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_id",
        "os_label",
        "requested_python_version",
        "actual_system",
        "actual_python_version",
        "python_implementation",
        "numpy_version",
        "platform_release"
      ],
      "properties": {
        "coordinate_id": {
          "enum": [
            "ubuntu-latest|python-3.10",
            "ubuntu-latest|python-3.12",
            "windows-latest|python-3.10",
            "windows-latest|python-3.12"
          ]
        },
        "os_label": {"enum": ["ubuntu-latest", "windows-latest"]},
        "requested_python_version": {"enum": ["3.10", "3.12"]},
        "actual_system": {"type": "string", "minLength": 1},
        "actual_python_version": {"type": "string", "minLength": 1},
        "python_implementation": {"type": "string", "minLength": 1},
        "numpy_version": {"type": "string", "minLength": 1},
        "platform_release": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_kind",
        "run_id",
        "run_attempt",
        "run_url",
        "job",
        "runner_name"
      ],
      "properties": {
        "origin_kind": {"enum": ["local", "github_actions"]},
        "run_id": {"type": "string"},
        "run_attempt": {"type": "integer", "minimum": 0},
        "run_url": {"type": "string"},
        "job": {"type": "string"},
        "runner_name": {"type": "string"}
      }
    },
    "model_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_data_hash", "observed_data_hash"],
      "properties": {
        "path": {
          "const": "tests/fixtures/model_ir_v2/frame_cantilever_all_modes.json"
        },
        "expected_data_hash": {"$ref": "#/$defs/hash"},
        "observed_data_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "bounded_planar_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_data_hash", "observed_data_hash"],
      "properties": {
        "path": {
          "const": "examples/bounded_planar_frame_alpha.model-ir.v2.json"
        },
        "expected_data_hash": {"$ref": "#/$defs/hash"},
        "observed_data_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "bounded_planar_settlement_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_data_hash", "observed_data_hash"],
      "properties": {
        "path": {
          "const": "examples/bounded_planar_settlement.model-ir.v2.json"
        },
        "expected_data_hash": {"$ref": "#/$defs/hash"},
        "observed_data_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "golden_set_hash": {"$ref": "#/$defs/hash"},
    "semantic_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "significant_digits",
        "absolute_zero_by_quantity"
      ],
      "properties": {
        "schema_version": {
          "const": "bounded-planar-semantic-projection.v1"
        },
        "significant_digits": {
          "type": "integer",
          "minimum": 1
        },
        "absolute_zero_by_quantity": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "expected_goldens": {"$ref": "#/$defs/goldens"},
    "observed_goldens": {"$ref": "#/$defs/goldens"},
    "expected_binary_artifacts": {"$ref": "#/$defs/binaryArtifacts"},
    "observed_binary_artifacts": {"$ref": "#/$defs/binaryArtifacts"},
    "contract_pass": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_contract_hash_replay",
        "canonical_binary_write_readback",
        "reference_coordinate_exact_replay",
        "github_actions_coordinate_execution",
        "bounded_planar_exact_replay",
        "bounded_planar_semantic_parity",
        "bounded_planar_settlement_exact_replay",
        "bounded_planar_settlement_semantic_parity",
        "four_way_cross_platform_determinism",
        "cpu_hip_numerical_parity",
        "developer_preview_windows_gate"
      ],
      "properties": {
        "exact_contract_hash_replay": {"type": "boolean"},
        "canonical_binary_write_readback": {"type": "boolean"},
        "reference_coordinate_exact_replay": {"type": "boolean"},
        "github_actions_coordinate_execution": {"type": "boolean"},
        "bounded_planar_exact_replay": {"type": "boolean"},
        "bounded_planar_semantic_parity": {"type": "boolean"},
        "bounded_planar_settlement_exact_replay": {"type": "boolean"},
        "bounded_planar_settlement_semantic_parity": {"type": "boolean"},
        "four_way_cross_platform_determinism": {"const": false},
        "cpu_hip_numerical_parity": {"const": false},
        "developer_preview_windows_gate": {"const": false}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "goldens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
