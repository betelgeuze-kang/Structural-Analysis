{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_current_tangent_operator_compile_receipt_v1.schema.json",
  "title": "Engine v2 HIP current-tangent dual-target compile and host-parse receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_hash",
    "generated_at",
    "status",
    "contract_pass",
    "contract_scope",
    "source",
    "fixture",
    "compiler",
    "targets",
    "claims",
    "blockers_remaining",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "engine-v2-hip-current-tangent-target-compile-host-parse-receipt.v1"
    },
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "partial"},
    "contract_pass": {"const": true},
    "contract_scope": {
      "const": "target_compile_and_host_fixture_parser_only"
    },
    "source": {"$ref": "#/$defs/source"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "compiler": {"$ref": "#/$defs/compiler"},
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "target_compile",
          "binary_sha256",
          "binary_byte_length",
          "host_fixture_parser_execution",
          "host_fixture_validation"
        ],
        "properties": {
          "architecture": {"enum": ["gfx1030", "gfx1100"]},
          "target_compile": {"const": true},
          "binary_sha256": {"$ref": "#/$defs/sha256"},
          "binary_byte_length": {"type": "integer", "minimum": 10000},
          "host_fixture_parser_execution": {"const": true},
          "host_fixture_validation": {
            "$ref": "#/$defs/host_fixture_validation"
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_target_compile",
        "gfx1030_target_compile",
        "gfx1100_target_compile",
        "dual_target_host_fixture_parser_execution",
        "actual_hardware_execution",
        "numerical_parity",
        "actual_mgt_current_tangent_action",
        "production_current_tangent_fgmres",
        "performance"
      ],
      "properties": {
        "declared_target_compile": {"const": true},
        "gfx1030_target_compile": {"const": true},
        "gfx1100_target_compile": {"const": true},
        "dual_target_host_fixture_parser_execution": {"const": true},
        "actual_hardware_execution": {"const": false},
        "numerical_parity": {"const": false},
        "actual_mgt_current_tangent_action": {"const": false},
        "production_current_tangent_fgmres": {"const": false},
        "performance": {"const": false}
      }
    },
    "blockers_remaining": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {"type": "string", "minLength": 100}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_base_commit_sha",
        "worktree_clean",
        "exact_source_commit_claim",
        "input_checksums"
      ],
      "properties": {
        "repository_base_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_clean": {"type": "boolean"},
        "exact_source_commit_claim": {"const": false},
        "input_checksums": {
          "type": "object",
          "minProperties": 10,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version_first_line", "version_output_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version_first_line": {"type": "string", "minLength": 1},
        "version_output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "array_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "byte_length", "data_hash"],
      "properties": {
        "dtype": {"enum": ["<i8", "<f8"]},
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 0}
        },
        "byte_length": {"type": "integer", "minimum": 0},
        "data_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fixture_hash",
        "parity_profile",
        "schedule_profile",
        "execution_profile",
        "accumulation_profile",
        "operator_contract_hash",
        "schedule_contract_hash",
        "execution_contract_hash",
        "load_factor",
        "dimensions",
        "expected_kernel_invocation_count",
        "binary_profile",
        "fixture_byte_length",
        "arrays",
        "claim_boundary"
      ],
      "properties": {
        "schema_version": {
          "const": "engine-v2-hip-current-tangent-operator-fixture.v1"
        },
        "fixture_hash": {"$ref": "#/$defs/sha256"},
        "parity_profile": {
          "const": "engine-v2-cpu-hip-current-tangent-operator-parity.v1"
        },
        "schedule_profile": {
          "const": "free_row_sorted_element_local_incidence.v1"
        },
        "execution_profile": {
          "const": "one_thread_per_free_row_reference_frame_geometry.v1"
        },
        "accumulation_profile": {
          "const": "reference_then_sorted_frame_then_sorted_geometry_sequential_fp64.v1"
        },
        "operator_contract_hash": {"$ref": "#/$defs/sha256"},
        "schedule_contract_hash": {"$ref": "#/$defs/sha256"},
        "execution_contract_hash": {"$ref": "#/$defs/sha256"},
        "load_factor": {"type": "number"},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equation_count",
            "global_dof_count",
            "reference_nnz",
            "frame_element_count",
            "geometry_element_count",
            "frame_incidence_count",
            "geometry_incidence_count"
          ],
          "properties": {
            "equation_count": {"const": 5},
            "global_dof_count": {"const": 12},
            "reference_nnz": {"const": 15},
            "frame_element_count": {"const": 1},
            "geometry_element_count": {"const": 1},
            "frame_incidence_count": {"const": 5},
            "geometry_incidence_count": {"const": 5}
          }
        },
        "expected_kernel_invocation_count": {"const": 1},
        "binary_profile": {
          "const": "canonical_little_endian_mixed_numeric.v1"
        },
        "fixture_byte_length": {"const": 2600},
        "arrays": {
          "type": "object",
          "minProperties": 21,
          "maxProperties": 21,
          "additionalProperties": {"$ref": "#/$defs/array_descriptor"}
        },
        "claim_boundary": {"type": "string", "minLength": 100}
      }
    },
    "host_fixture_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "contract_pass",
        "fixture_hash",
        "runtime_output_hash",
        "equation_count",
        "fixture_byte_length",
        "actual_hardware_execution",
        "hip_runtime_api_call_count"
      ],
      "properties": {
        "profile": {
          "const": "engine-v2-hip-current-tangent-host-fixture-parser.v1"
        },
        "contract_pass": {"const": true},
        "fixture_hash": {"$ref": "#/$defs/sha256"},
        "runtime_output_hash": {"$ref": "#/$defs/sha256"},
        "equation_count": {"const": 5},
        "fixture_byte_length": {"const": 2600},
        "actual_hardware_execution": {"const": false},
        "hip_runtime_api_call_count": {"const": 0}
      }
    }
  }
}
