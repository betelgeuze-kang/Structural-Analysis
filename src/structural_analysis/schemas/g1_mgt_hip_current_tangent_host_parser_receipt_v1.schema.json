{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/g1-mgt-hip-current-tangent-host-parser-receipt-v1.schema.json",
  "title": "G1 actual-MGT HIP current-tangent host-parser receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_hash",
    "generated_at",
    "status",
    "contract_pass",
    "contract_scope",
    "source_commit_sha",
    "engine_version",
    "source_commit_exact_replay_claim",
    "source_tree_state",
    "input_checksums",
    "case_id",
    "inputs",
    "fixture",
    "synthetic_compile_receipt",
    "compiler",
    "targets",
    "claims",
    "blockers_remaining",
    "artifacts",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "g1-mgt-hip-current-tangent-host-parser-receipt.v1"
    },
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "partial"},
    "contract_pass": {"const": true},
    "contract_scope": {
      "const": "actual_mgt_dual_target_compile_and_host_fixture_parser_only"
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "engine_version": {"type": "string", "minLength": 1},
    "source_commit_exact_replay_claim": {"const": false},
    "source_tree_state": {
      "const": "working_tree_with_uncommitted_goal_changes"
    },
    "input_checksums": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "case_id": {
      "const": "g1_actual_mgt_hip_current_tangent_host_parser"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mgt_path",
        "mgt_sha256",
        "checkpoint_npz",
        "checkpoint_sha256",
        "state_policy",
        "direction_policy",
        "load_factor",
        "state_data_hash",
        "direction_data_hash"
      ],
      "properties": {
        "mgt_path": {"type": "string", "minLength": 1},
        "mgt_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_npz": {"type": "string", "minLength": 1},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "state_policy": {
          "const": "full_unit_zero_state_linear_predictor"
        },
        "direction_policy": {
          "const": "normalized_current_right_hand_side"
        },
        "load_factor": {"const": 1.0},
        "state_data_hash": {"$ref": "#/$defs/sha256"},
        "direction_data_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fixture_hash",
        "parity_profile",
        "schedule_profile",
        "execution_profile",
        "accumulation_profile",
        "operator_contract_hash",
        "schedule_contract_hash",
        "execution_contract_hash",
        "load_factor",
        "dimensions",
        "expected_kernel_invocation_count",
        "binary_profile",
        "array_count",
        "fixture_byte_length",
        "fixture_binary_ephemeral",
        "fixture_binary_persisted"
      ],
      "properties": {
        "schema_version": {
          "const": "engine-v2-hip-current-tangent-operator-fixture.v1"
        },
        "fixture_hash": {"$ref": "#/$defs/sha256"},
        "parity_profile": {
          "const": "engine-v2-cpu-hip-current-tangent-operator-parity.v1"
        },
        "schedule_profile": {
          "const": "free_row_sorted_element_local_incidence.v1"
        },
        "execution_profile": {
          "const": "one_thread_per_free_row_reference_frame_geometry.v1"
        },
        "accumulation_profile": {
          "const": "reference_then_sorted_frame_then_sorted_geometry_sequential_fp64.v1"
        },
        "operator_contract_hash": {"$ref": "#/$defs/sha256"},
        "schedule_contract_hash": {"$ref": "#/$defs/sha256"},
        "execution_contract_hash": {"$ref": "#/$defs/sha256"},
        "load_factor": {"const": 1.0},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equation_count",
            "global_dof_count",
            "reference_nnz",
            "frame_element_count",
            "geometry_element_count",
            "frame_incidence_count",
            "geometry_incidence_count"
          ],
          "properties": {
            "equation_count": {"const": 70560},
            "global_dof_count": {"const": 78282},
            "reference_nnz": {"const": 1262462},
            "frame_element_count": {"const": 5572},
            "geometry_element_count": {"const": 5572},
            "frame_incidence_count": {"const": 61494},
            "geometry_incidence_count": {"const": 61494}
          }
        },
        "expected_kernel_invocation_count": {"const": 1},
        "binary_profile": {
          "const": "canonical_little_endian_mixed_numeric.v1"
        },
        "array_count": {"const": 21},
        "fixture_byte_length": {"const": 36123072},
        "fixture_binary_ephemeral": {"const": true},
        "fixture_binary_persisted": {"const": false}
      }
    },
    "synthetic_compile_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "receipt_hash",
        "fixture_equation_count",
        "target_binary_identity_pass"
      ],
      "properties": {
        "receipt": {
          "const": "implementation/phase1/release_evidence/productization/engine_v2_hip_current_tangent_operator_compile_receipt.json"
        },
        "receipt_hash": {"$ref": "#/$defs/sha256"},
        "fixture_equation_count": {"const": 5},
        "target_binary_identity_pass": {"const": true}
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version_first_line", "version_output_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version_first_line": {"type": "string", "minLength": 1},
        "version_output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/gfx1030_target"},
        {"$ref": "#/$defs/gfx1100_target"}
      ],
      "items": false
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_mgt_fixture_constructed",
        "actual_mgt_dual_target_host_fixture_parser_execution",
        "actual_mgt_host_parser_hip_runtime_api_calls_zero",
        "synthetic_and_actual_parser_binary_identity",
        "actual_hardware_execution",
        "current_tangent_action_executed",
        "cpu_hip_numerical_parity",
        "device_resident_current_tangent_fgmres",
        "performance",
        "g1_full_building_closure"
      ],
      "properties": {
        "actual_mgt_fixture_constructed": {"const": true},
        "actual_mgt_dual_target_host_fixture_parser_execution": {
          "const": true
        },
        "actual_mgt_host_parser_hip_runtime_api_calls_zero": {
          "const": true
        },
        "synthetic_and_actual_parser_binary_identity": {"const": true},
        "actual_hardware_execution": {"const": false},
        "current_tangent_action_executed": {"const": false},
        "cpu_hip_numerical_parity": {"const": false},
        "device_resident_current_tangent_fgmres": {"const": false},
        "performance": {"const": false},
        "g1_full_building_closure": {"const": false}
      }
    },
    "blockers_remaining": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "schema",
        "builder",
        "hip_source",
        "hip_fixture_module",
        "synthetic_compile_receipt"
      ],
      "properties": {
        "receipt": {
          "const": "implementation/phase1/release_evidence/productization/g1_mgt_hip_current_tangent_host_parser_receipt.json"
        },
        "schema": {
          "const": "src/structural_analysis/schemas/g1_mgt_hip_current_tangent_host_parser_receipt_v1.schema.json"
        },
        "builder": {
          "const": "scripts/build_g1_mgt_hip_current_tangent_host_parser_receipt.py"
        },
        "hip_source": {
          "const": "implementation/phase1/hip_kernels/engine_v2_current_tangent_operator.hip.cpp"
        },
        "hip_fixture_module": {
          "const": "src/structural_analysis/engine_v2_backends/hip_current_tangent_operator.py"
        },
        "synthetic_compile_receipt": {
          "const": "implementation/phase1/release_evidence/productization/engine_v2_hip_current_tangent_operator_compile_receipt.json"
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "host_fixture_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "contract_pass",
        "fixture_hash",
        "runtime_output_hash",
        "equation_count",
        "fixture_byte_length",
        "actual_hardware_execution",
        "hip_runtime_api_call_count"
      ],
      "properties": {
        "profile": {
          "const": "engine-v2-hip-current-tangent-host-fixture-parser.v1"
        },
        "contract_pass": {"const": true},
        "fixture_hash": {"$ref": "#/$defs/sha256"},
        "runtime_output_hash": {"$ref": "#/$defs/sha256"},
        "equation_count": {"const": 70560},
        "fixture_byte_length": {"const": 36123072},
        "actual_hardware_execution": {"const": false},
        "hip_runtime_api_call_count": {"const": 0}
      }
    },
    "gfx1030_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "target_compile",
        "binary_sha256",
        "binary_byte_length",
        "host_fixture_parser_execution",
        "host_fixture_validation"
      ],
      "properties": {
        "architecture": {"const": "gfx1030"},
        "target_compile": {"const": true},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "binary_byte_length": {"type": "integer", "minimum": 10000},
        "host_fixture_parser_execution": {"const": true},
        "host_fixture_validation": {
          "$ref": "#/$defs/host_fixture_validation"
        }
      }
    },
    "gfx1100_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "target_compile",
        "binary_sha256",
        "binary_byte_length",
        "host_fixture_parser_execution",
        "host_fixture_validation"
      ],
      "properties": {
        "architecture": {"const": "gfx1100"},
        "target_compile": {"const": true},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "binary_byte_length": {"type": "integer", "minimum": 10000},
        "host_fixture_parser_execution": {"const": true},
        "host_fixture_validation": {
          "$ref": "#/$defs/host_fixture_validation"
        }
      }
    }
  }
}
