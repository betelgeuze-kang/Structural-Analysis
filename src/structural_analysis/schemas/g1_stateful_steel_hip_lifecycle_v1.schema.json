{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "receipt_hash", "generated_at", "status", "contract_pass", "source", "runtime", "binaries", "comparison", "material_state_bundle", "claims", "blockers_remaining", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "g1-stateful-steel-hip-lifecycle-receipt.v1"},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generated_at": {"type": "string"}, "status": {"const": "partial"},
    "contract_pass": {"const": true}, "source": {"type": "object"},
    "runtime": {"type": "object"}, "binaries": {"type": "object"},
    "comparison": {"type": "object"}, "material_state_bundle": {"type": "object"},
    "claims": {"type": "object"}, "blockers_remaining": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"type": "string"}
  }, "additionalProperties": false
}
