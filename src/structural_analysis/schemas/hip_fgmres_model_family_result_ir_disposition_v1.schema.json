            "disposition": {"const": "not_issued_nonconverged"},
            "cpu_status": {"const": "max_iterations"},
            "cpu_termination_code": {"const": "max_iterations_exhausted"},
            "solver_tolerance_passed": {"const": false},
            "authoritative_plan_tolerance_passed": {"const": false},
            "result_ir_absence_reason": {"const": "source_not_converged"},
            "result_ir_materialized": {"const": false}
