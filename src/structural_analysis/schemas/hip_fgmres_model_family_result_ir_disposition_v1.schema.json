{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_fgmres_model_family_result_ir_disposition_v1.schema.json",
  "title": "HIP FGMRES exact-package ResultIR v2 disposition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "attestation_id",
    "evidence_scope",
    "actual_backend",
    "promotion_eligible",
    "bindings",
    "observations",
    "totals",
    "claims",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-hip-fgmres-model-family-result-ir-disposition.v1"
    },
    "capability_profile": {
      "const": "phase0_exact_package_gfx1030_ten_slot_result_ir_v2_disposition"
    },
    "status": {
      "const": "exact_gfx1030_ten_slot_result_ir_v2_disposition_verified"
    },
    "attestation_id": {"$ref": "#/$defs/hash"},
    "evidence_scope": {
      "const": "process_local_registry_bound_unsigned_nonpersistent_nonpromoting"
    },
    "actual_backend": {"const": "hip"},
    "promotion_eligible": {"const": false},
    "bindings": {"$ref": "#/$defs/bindings"},
    "observations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/readyObservation"},
            {
              "properties": {
                "slot_id": {"const": "frame_single_axial"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/readyObservation"},
            {
              "properties": {
                "slot_id": {"const": "frame_single_weak_axis_bending"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/readyObservation"},
            {
              "properties": {
                "slot_id": {"const": "frame_single_strong_axis_bending"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/readyObservation"},
            {
              "properties": {
                "slot_id": {"const": "frame_single_torsion"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/notIssuedObservation"},
            {
              "properties": {
                "slot_id": {
                  "const": "frame_single_rotated_local_axis_bending"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/readyObservation"},
            {
              "properties": {
                "slot_id": {"const": "frame_serial_later_column"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/readyObservation"},
            {
              "properties": {
                "slot_id": {"const": "truss_single_axial"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/readyObservation"},
            {
              "properties": {
                "slot_id": {
                  "const": "recurrence_initial_or_early_terminal"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/notIssuedObservation"},
            {
              "properties": {
                "slot_id": {
                  "const": "recurrence_later_restart_partial_final_cycle"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/notIssuedObservation"},
            {
              "properties": {
                "slot_id": {
                  "const": "recurrence_exact_full_final_cycle_guard"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "totals": {"$ref": "#/$defs/totals"},
    "claims": {"$ref": "#/$defs/claims"},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_schema_version",
        "fixture_suite_id",
        "registry_bytes_sha256",
        "registry_hash",
        "source_audited_schema_version",
        "source_audited_capability_profile",
        "source_audited_attestation_id",
        "source_audited_receipt_hash",
        "source_transfer_audit_receipt_hash",
        "source_family_receipt_hash",
        "result_ir_schema_version",
        "result_ir_capability_profile",
        "result_ir_bridge_capability_profile",
        "required_architecture_base",
        "required_slot_ids"
      ],
      "properties": {
        "registry_schema_version": {
          "const": "structural-analysis-hip-fgmres-fixture-registry.v1"
        },
        "fixture_suite_id": {
          "const": "phase0_execution_plan_v2_linear_frame_truss_fgmres_fixed_suite.v2"
        },
        "registry_bytes_sha256": {"$ref": "#/$defs/hash"},
        "registry_hash": {"$ref": "#/$defs/hash"},
        "source_audited_schema_version": {
          "const": "structural-analysis-hip-fgmres-model-family-audited-parity.v2"
        },
        "source_audited_capability_profile": {
          "const": "phase0_exact_gfx1030_family_parity_transfer_and_launch_fence_audit_composition"
        },
        "source_audited_attestation_id": {"$ref": "#/$defs/hash"},
        "source_audited_receipt_hash": {"$ref": "#/$defs/hash"},
        "source_transfer_audit_receipt_hash": {"$ref": "#/$defs/hash"},
        "source_family_receipt_hash": {"$ref": "#/$defs/hash"},
        "result_ir_schema_version": {
          "const": "structural-analysis-result-ir.v2"
        },
        "result_ir_capability_profile": {
          "const": "hip_fgmres_sparse_plan_recovery_linear_static"
        },
        "result_ir_bridge_capability_profile": {
          "const": "hip_fgmres_retained_completion_sparse_result_ir_v2"
        },
        "required_architecture_base": {"const": "gfx1030"},
        "required_slot_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "prefixItems": [
            {"const": "frame_single_axial"},
            {"const": "frame_single_weak_axis_bending"},
            {"const": "frame_single_strong_axis_bending"},
            {"const": "frame_single_torsion"},
            {"const": "frame_single_rotated_local_axis_bending"},
            {"const": "frame_serial_later_column"},
            {"const": "truss_single_axial"},
            {"const": "recurrence_initial_or_early_terminal"},
            {"const": "recurrence_later_restart_partial_final_cycle"},
            {"const": "recurrence_exact_full_final_cycle_guard"}
          ],
          "items": false
        }
      }
    },
    "commonObservation": {
      "type": "object",
      "required": [
        "slot_id",
        "slot_registration_hash",
        "case_fingerprint",
        "logical_case_key",
        "matrix_cell_id",
        "audited_triple_binding_hash",
        "case_id",
        "case_receipt_hash",
