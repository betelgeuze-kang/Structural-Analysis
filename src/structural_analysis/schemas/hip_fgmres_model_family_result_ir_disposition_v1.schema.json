        "cpu_result_hash": {"$ref": "#/$defs/hash"},
        "terminal_observation_receipt_hash": {"$ref": "#/$defs/hash"},
        "completion_export_context_id": {"$ref": "#/$defs/hash"},
        "completion_export_receipt_hash": {"$ref": "#/$defs/hash"},
        "completion_export_payload_hash": {"$ref": "#/$defs/hash"},
        "device_identity_receipt_hash": {"$ref": "#/$defs/hash"},
        "compiled_architecture": {"const": "gfx1030"},
        "runtime_architecture_base": {"const": "gfx1030"},
        "device_ordinal": {"$ref": "#/$defs/nonnegative"},
        "device_uuid_bytes_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "device_pci_bdf": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
        },
        "cpu_status": {
          "enum": ["converged", "max_iterations"]
        },
        "cpu_termination_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "solver_tolerance_passed": {"type": "boolean"},
        "authoritative_plan_tolerance_passed": {"type": "boolean"},
        "disposition_binding_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "readyObservation": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/commonObservation"},
        {
          "required": [
            "disposition",
            "result_id",
            "result_ir_hash",
            "numerical_result_hash",
            "accepted_state_hash",
