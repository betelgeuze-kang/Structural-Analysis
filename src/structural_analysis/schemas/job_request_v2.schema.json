{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/job_request_v2.schema.json",
  "title": "Structural Analysis Discriminated Job Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "case_id",
    "model",
    "config",
    "result_contract",
    "validator_id"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-job-request.v2"},
    "operation": {"const": "bounded_frame3d_load_control"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "result_contract": {"const": "bounded-frame3d-load-control-result.v1"},
    "validator_id": {
      "const": "structural_analysis.api.frame3d_load_control.validate_bounded_frame3d_load_control_result_manifest"
    },
    "model": {
      "type": "object",
      "minProperties": 1,
      "required": ["schema_version"],
      "properties": {
        "schema_version": {"const": "structural-analysis-model-ir.v2"}
      }
    },
    "config": {"$ref": "#/$defs/boundedFrame3DLoadControlConfig"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "boundedFrame3DLoadControlConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "load_pattern_id",
        "load_factors",
        "solver_config"
      ],
      "properties": {
        "schema_version": {"const": "bounded-frame3d-load-control-config.v1"},
        "profile": {"const": "bounded_multimember_frame3d_load_control_model_ir_api.v1"},
        "load_pattern_id": {"$ref": "#/$defs/stableId"},
        "load_factors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1.0
          }
        },
        "solver_config": {"$ref": "#/$defs/corotationalFrame3DGlobalConfig"}
      }
    },
    "corotationalFrame3DGlobalConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "residual_relative_tolerance",
        "residual_absolute_tolerance_kn",
        "increment_relative_tolerance",
        "increment_absolute_tolerance_m",
        "maximum_iterations",
        "maximum_condition_number",
        "linear_solver",
        "equation_scaling",
        "condition_number",
        "load_control",
        "line_search",
        "regularization_allowed",
        "fallback_allowed"
      ],
      "properties": {
        "profile": {"const": "dense_elastic_corotational_timoshenko_frame3d_load_control.v2"},
        "residual_relative_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1.0
        },
        "residual_absolute_tolerance_kn": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "increment_relative_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1.0
        },
        "increment_absolute_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000.0
        },
        "maximum_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
        "maximum_condition_number": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000000000000.0
        },
        "linear_solver": {"const": "numpy_dense_solve"},
        "equation_scaling": {"const": "centroid_diameter_force_moment_6dof.v1"},
        "condition_number": {"const": "scaled_matrix_1_norm"},
        "load_control": {"const": "strictly_increasing_positive_factors"},
        "line_search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "alphas"],
          "properties": {
            "policy": {"const": "strict_scaled_residual_decrease.v1"},
            "alphas": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "prefixItems": [{"const": 1.0}],
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1.0
              }
            }
          }
        },
        "regularization_allowed": {"const": false},
        "fallback_allowed": {"const": false}
      }
    }
  }
}
