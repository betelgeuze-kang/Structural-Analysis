{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/equation_scaling_v1.schema.json",
  "title": "Engine v2 EquationScaling v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "base_plan_hash", "equation_order_hash", "policies",
    "characteristic_length_m", "minimum_characteristic_length_m",
    "reference_force_n", "minimum_reference_force_n", "dof_count",
    "scale_vector", "scaling_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-equation-scaling.v1"},
    "base_plan_hash": {"$ref": "#/$defs/sha256"},
    "equation_order_hash": {"$ref": "#/$defs/sha256"},
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characteristic_length", "reference_force"],
      "properties": {
        "characteristic_length": {"const": "two_max_radius_from_fsum_centroid.v1"},
        "reference_force": {"const": "max_translation_or_equivalent_moment_with_floor.v1"}
      }
    },
    "characteristic_length_m": {"type": "number", "exclusiveMinimum": 0},
    "minimum_characteristic_length_m": {"type": "number", "exclusiveMinimum": 0},
    "reference_force_n": {"type": "number", "exclusiveMinimum": 0},
    "minimum_reference_force_n": {"type": "number", "exclusiveMinimum": 0},
    "dof_count": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "scale_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "dtype", "shape", "layout", "byte_length",
        "equation_order_hash", "data_hash", "content_hash", "values"
      ],
      "properties": {
        "name": {"const": "scale_divisors_si"},
        "dtype": {"const": "<f8"},
        "shape": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 1}},
        "layout": {"const": "C"},
        "byte_length": {"type": "integer", "minimum": 8},
        "equation_order_hash": {"$ref": "#/$defs/sha256"},
        "data_hash": {"$ref": "#/$defs/sha256"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "values": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "scaling_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
