{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/bounded-frame3d-direct-control-checkpoint-v2.schema.json",
  "title": "Bounded Frame3D cyclic direct-control checkpoint artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile", "model_ir_content_hash", "adapter_hash",
    "model_hash", "resume_contract_hash", "control_node_id", "control_dof",
    "control_global_dof", "control_unit", "path_mode",
    "entity_mapping_hash", "node_ids", "member_ids", "member_material_ids",
    "last_completed_leg_direction_sign", "cumulative_reversal_count",
    "cumulative_completed_target_count", "accepted_target_chain_hash",
    "checkpoint", "resume_binding", "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "bounded-frame3d-direct-control-checkpoint-artifact.v2"},
    "profile": {"const": "bounded_frame3d_direct_displacement_control_model_ir_api.v1"},
    "model_ir_content_hash": {"$ref": "#/$defs/hash"},
    "adapter_hash": {"$ref": "#/$defs/hash"},
    "model_hash": {"$ref": "#/$defs/hash"},
    "resume_contract_hash": {"$ref": "#/$defs/hash"},
    "control_node_id": {"$ref": "#/$defs/stableId"},
    "control_dof": {"$ref": "#/$defs/dof"},
    "control_global_dof": {"type": "integer", "minimum": 0, "maximum": 767},
    "control_unit": {"enum": ["m", "rad"]},
    "path_mode": {"const": "cyclic_reversal"},
    "entity_mapping_hash": {"$ref": "#/$defs/hash"},
    "node_ids": {"type": "array", "minItems": 2, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
    "member_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
    "member_material_ids": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/stableId"}},
    "last_completed_leg_direction_sign": {"enum": [-1, 1, null]},
    "cumulative_reversal_count": {"type": "integer", "minimum": 0, "maximum": 4095},
    "cumulative_completed_target_count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "accepted_target_chain_hash": {"$ref": "#/$defs/hash"},
    "checkpoint": {"$ref": "#/$defs/checkpoint"},
    "resume_binding": {"$ref": "#/$defs/resumeBinding"},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "dof": {"enum": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
    "steelState": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "plastic_strain", "backstress_mpa", "accumulated_plastic_strain", "dissipated_energy_density_mj_per_m3", "state_hash"],
      "properties": {
        "schema_version": {"const": "uniaxial-combined-hardening-state.v1"},
        "plastic_strain": {"type": "number"},
        "backstress_mpa": {"type": "number"},
        "accumulated_plastic_strain": {"type": "number", "minimum": 0},
        "dissipated_energy_density_mj_per_m3": {"type": "number", "minimum": 0},
        "state_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile", "model_hash", "solver_contract_hash", "step_index", "load_factor", "displacement", "material_states", "converged_iterations", "residual_inf_norm_kn", "parent_checkpoint_hash", "checkpoint_hash"],
      "properties": {
        "schema_version": {"const": "stateful-corotational-frame3d-sparse-checkpoint.v1"},
        "profile": {"const": "stateful_axial_material_corotational_timoshenko_frame3d_native_coo_csr.v1"},
        "model_hash": {"$ref": "#/$defs/hash"},
        "solver_contract_hash": {"$ref": "#/$defs/hash"},
        "step_index": {"type": "integer", "minimum": 0},
        "load_factor": {"type": "number"},
        "displacement": {"type": "array", "minItems": 12, "maxItems": 768, "items": {"type": "number"}},
        "material_states": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/steelState"}},
        "converged_iterations": {"type": "integer", "minimum": 0},
        "residual_inf_norm_kn": {"type": "number", "minimum": 0},
        "parent_checkpoint_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "checkpoint_hash": {"$ref": "#/$defs/hash"}
      },
      "allOf": [{
        "if": {"properties": {"step_index": {"const": 0}}, "required": ["step_index"]},
        "then": {"properties": {
          "load_factor": {"const": 0},
          "displacement": {"items": {"const": 0}},
          "converged_iterations": {"const": 0},
          "parent_checkpoint_hash": {"type": "null"}
        }},
        "else": {"properties": {"parent_checkpoint_hash": {"$ref": "#/$defs/hash"}}}
      }]
    },
    "resumeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile", "model_hash", "frame_solver_contract_hash", "direct_control_contract_hash", "control_global_dof", "control_unit", "path_mode", "last_completed_leg_direction_sign", "cumulative_reversal_count", "cumulative_completed_target_count", "accepted_target_chain_hash", "accepted_control_target", "accepted_step_index", "accepted_checkpoint_hash", "binding_hash"],
      "properties": {
        "schema_version": {"const": "stateful-corotational-frame3d-displacement-control-resume-binding.v2"},
        "profile": {"const": "stateful_corotational_frame3d_sparse_direct_displacement_control.v1"},
        "model_hash": {"$ref": "#/$defs/hash"},
        "frame_solver_contract_hash": {"$ref": "#/$defs/hash"},
        "direct_control_contract_hash": {"$ref": "#/$defs/hash"},
        "control_global_dof": {"type": "integer", "minimum": 0, "maximum": 767},
        "control_unit": {"enum": ["m", "rad"]},
        "path_mode": {"const": "cyclic_reversal"},
        "last_completed_leg_direction_sign": {"enum": [-1, 1, null]},
        "cumulative_reversal_count": {"type": "integer", "minimum": 0, "maximum": 4095},
        "cumulative_completed_target_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "accepted_target_chain_hash": {"$ref": "#/$defs/hash"},
        "accepted_control_target": {"type": "number"},
        "accepted_step_index": {"type": "integer", "minimum": 0},
        "accepted_checkpoint_hash": {"$ref": "#/$defs/hash"},
        "binding_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
