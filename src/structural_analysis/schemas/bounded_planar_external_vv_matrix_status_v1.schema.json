            "intake_contract_pass": {"const": true},
            "fresh_external_runtime_execution": {"const": true},
            "cryptographic_signature_verified": {"const": true},
            "operator_independence_declared": {"const": true},
            "operator_identity_credentials_verified": {"const": false},
            "verification_level_2": {"const": false}
          }
        }
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "category",
          "label",
          "required_external_case_ids",
          "verification_method",
          "execution_package_available",
          "current_source_execution_prepared",
          "technical_reference_present",
          "current_product_replay_pass",
          "fresh_current_source_technical_validation",
          "fresh_current_source_external_execution",
          "independent_operator_attested",
          "legal_use_approved",
          "scientific_decision_pass",
          "formal_promotion_receipt_attached",
          "level2_eligible",
          "status",
          "evidence",
          "blockers"
        ],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "category": {
            "enum": [
              "linear",
              "member_feature",
              "boundary",
              "modal",
              "buckling",
              "geometric_nonlinear",
              "material",
              "recovery",
              "negative",
              "scaling"
