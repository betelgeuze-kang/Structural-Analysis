          },
          "label": {"type": "string", "minLength": 1},
          "required_external_case_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "verification_method": {
            "enum": ["external_solver_execution", "independent_preflight"]
          },
          "execution_package_available": {"type": "boolean"},
          "current_source_execution_prepared": {"type": "boolean"},
          "technical_reference_present": {"type": "boolean"},
          "current_product_replay_pass": {"type": "boolean"},
          "fresh_current_source_technical_validation": {"type": "boolean"},
          "fresh_current_source_external_execution": {"type": "boolean"},
          "independent_operator_attested": {"type": "boolean"},
          "legal_use_approved": {"type": "boolean"},
          "scientific_decision_pass": {"type": "boolean"},
          "formal_promotion_receipt_attached": {"type": "boolean"},
          "level2_eligible": {"type": "boolean"},
          "status": {
            "enum": [
              "missing",
              "current_product_replay_only",
              "fresh_independent_preflight_technical",
              "fresh_external_technical",
              "promotion_eligible"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["receipt_id", "path", "artifact_hash", "case_ids"],
              "properties": {
                "receipt_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
                "path": {"type": "string", "minLength": 1},
                "artifact_hash": {"$ref": "#/$defs/sha256"},
                "case_ids": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          },
          "blockers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_count",
        "technical_reference_present_count",
        "fresh_current_source_technical_count",
        "current_product_replay_only_count",
        "fresh_external_technical_count",
        "fresh_independent_preflight_technical_count",
        "promotion_eligible_count",
        "missing_count",
        "execution_package_available_count",
        "current_source_execution_prepared_count"
      ],
      "properties": {
        "requirement_count": {"type": "integer", "minimum": 1},
        "technical_reference_present_count": {"type": "integer", "minimum": 0},
        "fresh_current_source_technical_count": {"type": "integer", "minimum": 0},
        "current_product_replay_only_count": {"type": "integer", "minimum": 0},
        "fresh_external_technical_count": {"type": "integer", "minimum": 0},
        "fresh_independent_preflight_technical_count": {"type": "integer", "minimum": 0},
        "promotion_eligible_count": {"type": "integer", "minimum": 0},
        "missing_count": {"type": "integer", "minimum": 0},
        "execution_package_available_count": {"type": "integer", "minimum": 0},
        "current_source_execution_prepared_count": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["pass", "blocked"]},
    "contract_pass": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_matrix_technical_coverage_complete",
        "fresh_current_source_technical_matrix_complete",
        "fresh_current_source_external_matrix_complete",
        "independent_operator_attested",
        "legal_use_approved",
        "formal_promotion_receipt_attached",
        "bounded_planar_profile_level_2"
      ],
      "properties": {
        "recommended_matrix_technical_coverage_complete": {"type": "boolean"},
        "fresh_current_source_technical_matrix_complete": {"type": "boolean"},
        "fresh_current_source_external_matrix_complete": {"type": "boolean"},
        "independent_operator_attested": {"type": "boolean"},
        "legal_use_approved": {"type": "boolean"},
        "formal_promotion_receipt_attached": {"type": "boolean"},
        "bounded_planar_profile_level_2": {"type": "boolean"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 80},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
