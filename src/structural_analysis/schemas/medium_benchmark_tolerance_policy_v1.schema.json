{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/medium_benchmark_tolerance_policy_v1.schema.json",
  "title": "Medium benchmark metric-specific tolerance policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "metric_families",
    "policies",
    "contract_pass",
    "blockers",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "medium-benchmark-tolerance-policy.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "metric_families": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "object"}
    },
    "contract_pass": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
