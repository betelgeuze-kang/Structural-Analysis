{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/client_input_validation_report_v1.schema.json",
  "title": "Client input validation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_commit_sha",
    "contract_pass",
    "status",
    "reason_code",
    "reason_codes",
    "summary_line",
    "input_path",
    "input_binding",
    "checks",
    "missing_data_report",
    "blockers",
    "needs_review",
    "file_rows",
    "data_file_checks",
    "claim_boundary",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "client-input-validation-report.v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_pass": {"type": "boolean"},
    "status": {"enum": ["ready", "needs_review", "blocked"]},
    "reason_code": {"type": "string", "pattern": "^(PASS|ERR_CLIENT_INPUT_[A-Z0-9_]+)$"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(PASS|ERR_CLIENT_INPUT_[A-Z0-9_]+)$"},
      "uniqueItems": true
    },
    "summary_line": {"type": "string", "minLength": 1},
    "input_path": {"type": "string", "minLength": 1},
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "repository_path",
        "current_worktree_bound",
        "commit_tree_bound",
        "source_commit_sha",
        "file_count",
        "total_bytes",
        "input_set_hash",
        "validator_path",
        "validator_sha256",
        "schema_path",
        "schema_sha256"
      ],
      "properties": {
        "source_kind": {"enum": ["operator_or_local_input", "repository_reference_fixture"]},
        "repository_path": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "current_worktree_bound": {"type": "boolean"},
        "commit_tree_bound": {"const": false},
        "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "file_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "input_set_hash": {"$ref": "#/$defs/sha256"},
        "validator_path": {"const": "scripts/validate_client_input_package.py"},
        "validator_sha256": {"$ref": "#/$defs/sha256"},
        "schema_path": {
          "const": "src/structural_analysis/schemas/client_input_validation_report_v1.schema.json"
        },
        "schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_available",
        "has_data_file",
        "data_files_parse",
        "geometry_present",
        "coordinates_valid",
        "member_identity_present",
        "topology_valid",
        "units_present",
        "load_case_present",
        "revision_present",
        "proxy_or_fallback_explicit"
      ],
      "properties": {
        "input_available": {"type": "boolean"},
        "has_data_file": {"type": "boolean"},
        "data_files_parse": {"type": "boolean"},
        "geometry_present": {"type": "boolean"},
        "coordinates_valid": {"type": "boolean"},
        "member_identity_present": {"type": "boolean"},
        "topology_valid": {"type": "boolean"},
        "units_present": {"type": "boolean"},
        "load_case_present": {"type": "boolean"},
        "revision_present": {"type": "boolean"},
        "proxy_or_fallback_explicit": {"type": "boolean"}
      }
    },
    "missing_data_report": {"$ref": "#/$defs/string_list"},
    "blockers": {"$ref": "#/$defs/string_list"},
    "needs_review": {"$ref": "#/$defs/string_list"},
    "file_rows": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "data_file_checks": {
      "type": "array",
      "items": {"type": "object"}
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden", "source_authority"],
      "properties": {
        "allowed": {"type": "string", "minLength": 1},
        "forbidden": {"$ref": "#/$defs/string_list_nonempty"},
        "source_authority": {"enum": ["operator_or_local_input", "repository_reference_fixture"]}
      }
    },
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "string_list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "string_list_nonempty": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
