{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/execution_plan_reduced_csr_v1.schema.json",
  "title": "Engine v2 ExecutionPlan reduced CSR identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_plan",
    "partition",
    "global_csr",
    "free_csr",
    "array_descriptors",
    "terminal_disposition",
    "claim_boundary",
    "identity_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-execution-plan-reduced-csr.v1"
    },
    "source_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_plan_hash",
        "model_ir_content_hash",
        "load_pattern_id",
        "operator_hash"
      ],
      "properties": {
        "execution_plan_hash": {"$ref": "#/$defs/sha256"},
        "model_ir_content_hash": {"$ref": "#/$defs/sha256"},
        "load_pattern_id": {"$ref": "#/$defs/stableId"},
        "operator_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equation_scope",
        "free_count",
        "global_to_free_content_hash",
        "free_dofs_content_hash"
      ],
      "properties": {
        "equation_scope": {"const": "free_equations"},
        "free_count": {"type": "integer", "minimum": 0},
        "global_to_free_content_hash": {"$ref": "#/$defs/sha256"},
        "free_dofs_content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "global_csr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_hash",
        "operator_numeric_values_hash",
        "numeric_values_scope"
      ],
      "properties": {
        "pattern_hash": {"$ref": "#/$defs/sha256"},
        "operator_numeric_values_hash": {"$ref": "#/$defs/sha256"},
        "numeric_values_scope": {
          "const": "global_csr_values_in_global_pattern_order"
        }
      }
    },
    "free_csr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "row_ptr",
        "column_indices",
        "global_value_indices",
        "selection_order",
        "nnz",
        "pattern_hash"
      ],
      "properties": {
        "format": {"const": "csr"},
        "row_ptr": {"const": "free_csr_row_ptr"},
        "column_indices": {"const": "free_csr_column_indices"},
        "global_value_indices": {"const": "free_csr_global_value_indices"},
        "selection_order": {
          "const": "ascending_free_row_then_ascending_global_csr_position.v1"
        },
        "nnz": {"type": "integer", "minimum": 0},
        "pattern_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "array_descriptors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_csr_row_ptr",
        "free_csr_column_indices",
        "free_csr_global_value_indices"
      ],
      "properties": {
        "free_csr_row_ptr": {"$ref": "#/$defs/arrayDescriptor"},
        "free_csr_column_indices": {"$ref": "#/$defs/arrayDescriptor"},
        "free_csr_global_value_indices": {"$ref": "#/$defs/arrayDescriptor"}
      }
    },
    "terminal_disposition": {
      "enum": ["solve_free_equations", "no_solve_reaction_only"]
    },
    "claim_boundary": {
      "const": {
        "solver_executed": false,
        "result_authority": false,
        "numeric_values_embedded": false,
        "cpu_hip_must_consume_same_identity": true,
        "fully_constrained_recurrence_allowed": false
      }
    },
    "identity_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "arrayDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "layout",
        "byte_length",
        "data_hash",
        "content_hash"
      ],
      "properties": {
        "name": {
          "enum": [
            "free_csr_row_ptr",
            "free_csr_column_indices",
            "free_csr_global_value_indices"
          ]
        },
        "dtype": {"enum": ["<i4", "<i8"]},
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "layout": {"const": "C"},
        "byte_length": {"type": "integer", "minimum": 0},
        "data_hash": {"$ref": "#/$defs/sha256"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
