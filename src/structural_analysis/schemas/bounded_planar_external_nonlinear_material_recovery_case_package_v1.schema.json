{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/bounded_planar_external_nonlinear_material_recovery_case_package_v1.schema.json",
  "title": "Bounded planar external nonlinear material recovery case package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "source_commit_sha",
    "source_files",
    "external_result_schema",
    "python_requirements",
    "operator_readme",
    "execution_workflow",
    "cases",
    "summary",
    "claims",
    "contract_pass",
    "blockers",
    "claim_boundary",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "bounded-planar-external-nonlinear-material-recovery-case-package.v1"},
    "package_id": {"const": "bounded-planar-nonlinear-material-recovery-v1"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_files": {
      "type": "object",
      "minProperties": 8,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "external_result_schema": {"$ref": "#/$defs/fileArtifact"},
    "python_requirements": {"$ref": "#/$defs/fileArtifact"},
    "operator_readme": {"$ref": "#/$defs/fileArtifact"},
    "execution_workflow": {"$ref": "#/$defs/fileArtifact"},
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "requirement_id",
          "case_kind",
          "model",
          "external_runner",
          "product_result",
          "metric_ids",
          "current_product_contract_pass",
          "external_execution_status",
          "external_reference_attached",
          "blockers"
        ],
        "properties": {
          "case_id": {"$ref": "#/$defs/caseId"},
          "requirement_id": {"$ref": "#/$defs/requirementId"},
          "case_kind": {
            "enum": [
              "p_delta_portal",
              "lee_frame_snap_through",
              "steel_uniaxial_yield",
              "rc_fiber_nonlinear_section",
              "rc_fiber_elastic_section_recovery",
              "rc_fiber_elastic_fiber_recovery"
            ]
          },
          "model": {"$ref": "#/$defs/jsonArtifact"},
          "external_runner": {"$ref": "#/$defs/fileArtifact"},
          "product_result": {"$ref": "#/$defs/jsonArtifact"},
          "metric_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^(pdelta|snap|steel|section|fiber|rc)\\.[A-Za-z0-9_.-]+$"},
            "uniqueItems": true
          },
          "current_product_contract_pass": {"const": true},
          "external_execution_status": {"const": "unavailable"},
          "external_reference_attached": {"const": false},
          "blockers": {
            "type": "array",
            "contains": {"const": "external_runtime_execution_missing"},
            "items": {"const": "external_runtime_execution_missing"},
            "uniqueItems": true
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "product_ready_count", "external_ready_count"],
      "properties": {
        "case_count": {"const": 6},
        "product_ready_count": {"const": 6},
        "external_ready_count": {"const": 0}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_case_inputs",
        "current_product_replay",
        "external_runner_syntax_checked",
        "runtime_dependency_pinned",
        "output_authenticity_contract",
        "external_solver_execution",
        "external_reference_attached",
        "verification_matrix_credit",
        "verification_level_2"
      ],
      "properties": {
        "exact_case_inputs": {"const": true},
        "current_product_replay": {"const": true},
        "external_runner_syntax_checked": {"const": true},
        "runtime_dependency_pinned": {"const": true},
        "output_authenticity_contract": {"const": true},
        "external_solver_execution": {"const": false},
        "external_reference_attached": {"const": false},
        "verification_matrix_credit": {"const": false},
        "verification_level_2": {"const": false}
      }
    },
    "contract_pass": {"const": true},
    "blockers": {
      "type": "array",
      "contains": {"const": "external_runtime_execution_missing"},
      "items": {"const": "external_runtime_execution_missing"},
      "uniqueItems": true
    },
    "claim_boundary": {"type": "string", "minLength": 100},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "jsonArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "artifact_hash"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "caseId": {
      "enum": [
        "bounded_planar_p_delta",
        "bounded_planar_snap_through",
        "bounded_planar_steel_yield",
        "bounded_planar_rc_fiber",
        "bounded_planar_section_recovery",
        "bounded_planar_fiber_recovery"
      ]
    },
    "requirementId": {
      "enum": [
        "geometric_nonlinear.p_delta",
        "geometric_nonlinear.snap_through",
        "material.steel_yield",
        "material.rc_fiber",
        "recovery.section",
        "recovery.fiber"
      ]
    }
  }
}
