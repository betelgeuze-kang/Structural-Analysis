{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/structural_verification_evidence_v1.schema.json",
  "title": "Structural verification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "level",
    "category",
    "truth_basis",
    "declared_blockers",
    "source",
    "artifacts",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": "structural-verification-evidence.v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "level": {"type": "integer", "minimum": 1, "maximum": 5},
    "category": {
      "enum": [
        "single_bar",
        "cantilever_beam",
        "simply_supported_beam",
        "portal_frame",
        "patch_tests",
        "opensees_code_to_code",
        "second_solver_code_to_code",
        "nafems",
        "shell_patch",
        "nonlinear_snap_through",
        "material_cyclic",
        "load_displacement",
        "failure_mode",
        "strain_distribution",
        "completed_customer_shadow"
      ]
    },
    "truth_basis": {
      "enum": [
        "analytic_closed_form",
        "code_to_code",
        "published_benchmark",
        "experimental",
        "customer_shadow"
      ]
    },
    "declared_blockers": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source": {"$ref": "#/$defs/source"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "decision": {"type": "object"},
    "reference": {"$ref": "#/$defs/reference"},
    "publication": {"$ref": "#/$defs/publication"},
    "experiment": {"$ref": "#/$defs/experiment"},
    "customer_shadow": {"$ref": "#/$defs/customer_shadow"}
  },
  "allOf": [
    {
      "if": {"properties": {"level": {"const": 2}}},
      "then": {"required": ["reference"]}
    },
    {
      "if": {"properties": {"level": {"const": 3}}},
      "then": {"required": ["publication"]}
    },
    {
      "if": {"properties": {"level": {"const": 4}}},
      "then": {"required": ["experiment"]}
    },
    {
      "if": {"properties": {"level": {"const": 5}}},
      "then": {"required": ["customer_shadow"]}
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url_or_doi", "sha256", "license"],
      "properties": {
        "url_or_doi": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 64},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "approval_status"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "approval_status": {
              "enum": ["approved", "signed_rights_holder_decision_required"]
            },
            "local_execution_allowed": {"type": "boolean"},
            "commercial_use_allowed": {"type": "boolean"},
            "redistribution_allowed": {"type": "boolean"},
            "derived_metadata_use_allowed": {"type": "boolean"}
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "contract_pass"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 64},
        "contract_pass": {"type": "boolean"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "version_verified",
        "independent_from_product"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "version_verified": {"type": "boolean"},
        "independent_from_product": {"type": "boolean"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_name", "publisher"],
      "properties": {
        "benchmark_name": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "measurement_categories"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "measurement_categories": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "customer_shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id_hash",
        "project_status",
        "raw_data_retained_by_customer",
        "redistribution_allowed",
        "reviewer_id"
      ],
      "properties": {
        "case_id_hash": {"type": "string", "minLength": 64},
        "project_status": {"const": "completed"},
        "raw_data_retained_by_customer": {"const": true},
        "redistribution_allowed": {"const": false},
        "reviewer_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
