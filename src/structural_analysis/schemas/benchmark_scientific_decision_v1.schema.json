{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/benchmark_scientific_decision_v1.schema.json",
  "title": "Benchmark scientific decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "evaluated_at",
    "metric_family_count",
    "metric_families",
    "passing_metric_family_count",
    "failing_metric_families",
    "numerical_pass",
    "review",
    "hard_blockers",
    "decision_blockers",
    "decision_contract_pass",
    "benchmark_credit",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "benchmark-scientific-decision.v1"
    },
    "decision": {
      "enum": ["PASS", "REVIEW", "FAIL"]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metric_family_count": {
      "type": "integer",
      "minimum": 1
    },
    "metric_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "passing_metric_family_count": {
      "type": "integer",
      "minimum": 0
    },
    "failing_metric_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "numerical_pass": {
      "type": "boolean"
    },
    "review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engineer_id",
            "reason",
            "scope",
            "evidence_ref",
            "approved_at",
            "expires_at",
            "contract_pass",
            "blockers"
          ],
          "properties": {
            "engineer_id": {"type": "string"},
            "reason": {"type": "string"},
            "scope": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "evidence_ref": {"type": "string"},
            "approved_at": {"type": "string"},
            "expires_at": {"type": "string"},
            "contract_pass": {"type": "boolean"},
            "blockers": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "hard_blockers": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "decision_blockers": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "decision_contract_pass": {
      "type": "boolean"
    },
    "benchmark_credit": {
      "type": "boolean"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
