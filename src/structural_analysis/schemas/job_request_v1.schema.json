{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/job_request_v1.schema.json",
  "title": "Structural Analysis Nonlinear Frame Job Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "case_id",
    "model",
    "config",
    "result_contract"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-job-request.v1"},
    "operation": {"const": "nonlinear_frame"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "result_contract": {"const": "unified-nonlinear-frame-result.v1"},
    "model": {"type": "object", "minProperties": 1},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "load_steps",
        "residual_tolerance",
        "increment_tolerance_m",
        "maximum_iterations",
        "matrix_backend",
        "control_mode"
      ],
      "properties": {
        "profile": {
          "enum": [
            "corotational_one_bay_portal.v1",
            "corotational_connected_frame2d.v1"
          ]
        },
        "load_steps": {"type": "integer", "minimum": 2, "maximum": 64},
        "residual_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "increment_tolerance_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_iterations": {"type": "integer", "minimum": 1, "maximum": 200},
        "matrix_backend": {
          "enum": ["numpy_linalg_solve_dense", "scipy_sparse_spsolve_cpu"]
        },
        "control_mode": {
          "enum": ["load_control", "direct_displacement_control", "arc_length"]
        },
        "control_node_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "control_dof": {"enum": ["UX", "UY"]},
        "target_control_displacements_m": {
          "type": "array",
          "items": {"type": "number"}
        },
        "control_tolerance_m": {"type": "number", "exclusiveMinimum": 0},
        "load_factor_increment_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "load_factor_coordinate_scale_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "arc_length_initial_m": {"type": "number", "exclusiveMinimum": 0},
        "arc_length_minimum_m": {"type": "number", "exclusiveMinimum": 0},
        "arc_length_maximum_m": {"type": "number", "exclusiveMinimum": 0},
        "arc_length_failed_step_reduction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "arc_length_constraint_tolerance_m2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "arc_length_maximum_attempt_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "allOf": [
        {
          "if": {"properties": {"control_mode": {"const": "load_control"}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["control_node_id"]},
                {"required": ["control_dof"]},
                {"required": ["target_control_displacements_m"]},
                {"required": ["control_tolerance_m"]},
                {"required": ["load_factor_increment_tolerance"]},
                {"required": ["load_factor_coordinate_scale_m"]},
                {"required": ["arc_length_initial_m"]},
                {"required": ["arc_length_minimum_m"]},
                {"required": ["arc_length_maximum_m"]},
                {"required": ["arc_length_failed_step_reduction"]},
                {"required": ["arc_length_constraint_tolerance_m2"]},
                {"required": ["arc_length_maximum_attempt_count"]}
              ]
            }
          },
          "else": {
            "required": [
              "control_node_id",
              "control_dof",
              "target_control_displacements_m",
              "load_factor_coordinate_scale_m"
            ],
            "if": {
              "properties": {
                "control_mode": {"const": "direct_displacement_control"}
              }
            },
            "then": {
              "required": [
                "control_tolerance_m",
                "load_factor_increment_tolerance"
              ],
              "properties": {
                "target_control_displacements_m": {
                  "minItems": 1,
                  "maxItems": 64
                }
              },
              "not": {
                "anyOf": [
                  {"required": ["arc_length_initial_m"]},
                  {"required": ["arc_length_minimum_m"]},
                  {"required": ["arc_length_maximum_m"]},
                  {"required": ["arc_length_failed_step_reduction"]},
                  {"required": ["arc_length_constraint_tolerance_m2"]},
                  {"required": ["arc_length_maximum_attempt_count"]}
                ]
              }
            },
            "else": {
              "required": [
                "arc_length_initial_m",
                "arc_length_minimum_m",
                "arc_length_maximum_m",
                "arc_length_failed_step_reduction",
                "arc_length_constraint_tolerance_m2",
                "arc_length_maximum_attempt_count"
              ],
              "properties": {
                "target_control_displacements_m": {
                  "minItems": 1,
                  "maxItems": 1
                }
              },
              "not": {
                "anyOf": [
                  {"required": ["control_tolerance_m"]},
                  {"required": ["load_factor_increment_tolerance"]}
                ]
              }
            }
          }
        }
      ]
    }
  }
}
