{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_fgmres_model_case_parity_v2.schema.json",
  "title": "HIP FGMRES scoped high-load model-case parity receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "evidence_scope",
    "actual_backend",
    "promotion_eligible",
    "case_id",
    "bindings",
    "dimensions",
    "discrete",
    "solution",
    "history",
    "compatibility",
    "telemetry",
    "claims",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-hip-fgmres-model-case-parity.v2"},
    "capability_profile": {"const": "phase0_high_load_single_terminal_restart_cpu_hip_fgmres_parity_v2"},
    "status": {"const": "scoped_case_parity_verified"},
    "evidence_scope": {"const": "process_local_exact_one_terminal_restart_native_hip_normwise_parity_non_promoting"},
    "actual_backend": {"const": "hip"},
    "promotion_eligible": {"const": false},
    "case_id": {"$ref": "#/$defs/hash"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "dimensions": {"$ref": "#/$defs/dimensions"},
    "discrete": {"$ref": "#/$defs/discrete"},
    "solution": {"$ref": "#/$defs/solution"},
    "history": {"$ref": "#/$defs/history"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "telemetry": {"$ref": "#/$defs/telemetry"},
    "claims": {"$ref": "#/$defs/claims"},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ir_content_hash",
        "execution_plan_id",
        "execution_plan_hash",
        "operator_hash",
        "numeric_snapshot_hash",
        "symbolic_reuse_hash",
        "partition_hash",
        "load_pattern_id",
        "fgmres_plan_id",
        "fgmres_plan_hash",
        "recurrence_plan_id",
        "recurrence_plan_hash",
        "policy_hash",
        "terminal_observation_id",
        "terminal_observation_receipt_hash",
        "terminal_outcome_hash",
        "completion_export_context_id",
        "completion_export_receipt_hash",
        "completion_export_payload_hash",
        "global_context_id",
        "global_receipt_hash",
        "kernel_identity_hash",
        "kernel_source_sha256",
        "compiled_architecture",
        "runtime_architecture_base",
        "device_ordinal",
        "device_identity_receipt_hash",
        "runtime_library_sha256",
        "device_uuid_bytes_hex",
        "device_pci_bdf",
        "cpu_result_hash",
        "terminal_metric_parity_id",
        "terminal_metric_parity_receipt_hash",
        "cpu_candidate_componentwise_receipt_hash",
        "cpu_candidate_normwise_receipt_hash",
        "candidate_replay_componentwise_receipt_hash",
        "candidate_replay_normwise_receipt_hash",
        "terminal_metric_projection_hash",
        "retained_execution_plan_snapshot_identity_verified",
        "process_local_runtime_identity_verified",
        "process_local_identities_serialized"
      ],
      "properties": {
        "model_ir_content_hash": {"$ref": "#/$defs/hash"},
        "execution_plan_id": {"type": "string", "pattern": "^SparsePlan:[0-9a-f]{24}$"},
        "execution_plan_hash": {"$ref": "#/$defs/hash"},
        "operator_hash": {"$ref": "#/$defs/hash"},
        "numeric_snapshot_hash": {"$ref": "#/$defs/hash"},
        "symbolic_reuse_hash": {"$ref": "#/$defs/hash"},
        "partition_hash": {"$ref": "#/$defs/hash"},
        "load_pattern_id": {"type": "string", "minLength": 1},
        "fgmres_plan_id": {"type": "string", "pattern": "^HipFgmresPlan:[0-9a-f]{24}$"},
        "fgmres_plan_hash": {"$ref": "#/$defs/hash"},
        "recurrence_plan_id": {"type": "string", "pattern": "^HipFgmresRecurrencePlan:[0-9a-f]{24}$"},
        "recurrence_plan_hash": {"$ref": "#/$defs/hash"},
        "policy_hash": {"$ref": "#/$defs/hash"},
        "terminal_observation_id": {"$ref": "#/$defs/hash"},
        "terminal_observation_receipt_hash": {"$ref": "#/$defs/hash"},
        "terminal_outcome_hash": {"$ref": "#/$defs/hash"},
        "completion_export_context_id": {"$ref": "#/$defs/hash"},
        "completion_export_receipt_hash": {"$ref": "#/$defs/hash"},
        "completion_export_payload_hash": {"$ref": "#/$defs/hash"},
        "global_context_id": {"$ref": "#/$defs/hash"},
        "global_receipt_hash": {"$ref": "#/$defs/hash"},
        "kernel_identity_hash": {"$ref": "#/$defs/hash"},
        "kernel_source_sha256": {"$ref": "#/$defs/hash"},
        "compiled_architecture": {"type": "string", "pattern": "^gfx[0-9a-f]+(?::[a-z][a-z0-9_]*[+-])*$"},
        "runtime_architecture_base": {"type": "string", "pattern": "^gfx[0-9a-f]+$"},
        "device_ordinal": {"type": "integer", "minimum": 0},
        "device_identity_receipt_hash": {"$ref": "#/$defs/hash"},
        "runtime_library_sha256": {"$ref": "#/$defs/hash"},
        "device_uuid_bytes_hex": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "device_pci_bdf": {"type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"},
        "cpu_result_hash": {"$ref": "#/$defs/hash"},
        "terminal_metric_parity_id": {"$ref": "#/$defs/hash"},
        "terminal_metric_parity_receipt_hash": {"$ref": "#/$defs/hash"},
        "cpu_candidate_componentwise_receipt_hash": {"$ref": "#/$defs/hash"},
        "cpu_candidate_normwise_receipt_hash": {"$ref": "#/$defs/hash"},
        "candidate_replay_componentwise_receipt_hash": {"$ref": "#/$defs/hash"},
        "candidate_replay_normwise_receipt_hash": {"$ref": "#/$defs/hash"},
        "terminal_metric_projection_hash": {"$ref": "#/$defs/hash"},
        "retained_execution_plan_snapshot_identity_verified": {"const": true},
        "process_local_runtime_identity_verified": {"const": true},
        "process_local_identities_serialized": {"const": false}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_dof_count",
        "free_dof_count",
        "reduced_csr_nnz",
        "restart_dimension",
        "max_iterations",
        "maximum_restart_count",
        "populated_restart_row_count",
        "prior_restart_row_count",
        "exported_checkpoint_solution_vector_count",
        "exported_checkpoint_true_residual_vector_count",
        "solve_record_scalar_count_per_restart"
      ],
      "properties": {
        "global_dof_count": {"type": "integer", "minimum": 1},
        "free_dof_count": {"type": "integer", "minimum": 1},
        "reduced_csr_nnz": {"type": "integer", "minimum": 1},
        "restart_dimension": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maximum_restart_count": {"type": "integer", "minimum": 1},
        "populated_restart_row_count": {"const": 1},
        "prior_restart_row_count": {"const": 0},
        "exported_checkpoint_solution_vector_count": {"const": 0},
        "exported_checkpoint_true_residual_vector_count": {"const": 0},
        "solve_record_scalar_count_per_restart": {"const": 5}
      }
    },
    "discrete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_status_match",
        "termination_code_match",
        "iteration_count_match",
        "restart_count_match",
        "operator_apply_count_match",
        "preconditioner_apply_count_match",
        "restart_history_shape_match",
        "restart_history_discrete_fields_match",
        "terminal_metrics_normwise_bound_verified",
        "terminal_restart_true_residual_metrics_normwise_bound_verified",
        "estimated_residual_legacy_fixed_gate_passed",
        "solution_update_legacy_fixed_gate_passed",
        "general_restart_history_metric_v2_verified",
        "numerical_failure_absent"
      ],
      "properties": {
        "terminal_status_match": {"const": true},
        "termination_code_match": {"const": true},
        "iteration_count_match": {"const": true},
        "restart_count_match": {"const": true},
        "operator_apply_count_match": {"const": true},
        "preconditioner_apply_count_match": {"const": true},
        "restart_history_shape_match": {"const": true},
        "restart_history_discrete_fields_match": {"const": true},
        "terminal_metrics_normwise_bound_verified": {"const": true},
        "terminal_restart_true_residual_metrics_normwise_bound_verified": {"const": true},
        "estimated_residual_legacy_fixed_gate_passed": {"const": true},
        "solution_update_legacy_fixed_gate_passed": {"const": true},
        "general_restart_history_metric_v2_verified": {"const": false},
        "numerical_failure_absent": {"const": true}
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "element_count",
        "cpu_or_reference_sha256",
        "hip_or_candidate_sha256",
        "maximum_absolute_error",
        "l2_absolute_error",
        "reference_l2",
        "relative_l2_error",
        "maximum_tolerance_ratio",
        "relative_l2_tolerance_passed",
        "absolute_linf_tolerance_passed",
        "componentwise_tolerance_passed"
      ],
      "properties": {
        "name": {"const": "solution_x"},
        "element_count": {"type": "integer", "minimum": 1},
        "cpu_or_reference_sha256": {"$ref": "#/$defs/hash"},
        "hip_or_candidate_sha256": {"$ref": "#/$defs/hash"},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "l2_absolute_error": {"type": "number", "minimum": 0},
        "reference_l2": {"type": "number", "minimum": 0},
        "relative_l2_error": {"type": "number", "minimum": 0},
        "maximum_tolerance_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "relative_l2_tolerance_passed": {"type": "boolean"},
        "absolute_linf_tolerance_passed": {"type": "boolean"},
        "componentwise_tolerance_passed": {"const": true}
      }
    },
    "legacyMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reference_record",
        "candidate_record",
        "absolute_difference",
        "legacy_fixed_tolerance",
        "maximum_tolerance_ratio",
        "legacy_fixed_gate_passed",
        "roundoff_error_model_verified"
      ],
      "properties": {
        "name": {"enum": ["estimated_residual_l2", "solution_update_l2"]},
        "reference_record": {"type": "number", "minimum": 0},
        "candidate_record": {"type": "number", "minimum": 0},
        "absolute_difference": {"type": "number", "minimum": 0},
        "legacy_fixed_tolerance": {"type": "number", "minimum": 0},
        "maximum_tolerance_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "legacy_fixed_gate_passed": {"const": true},
        "roundoff_error_model_verified": {"const": false}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "terminal_restart_index",
        "terminal_row_slot_index",
        "cpu_terminal_true_residual_alias_verified",
        "hip_terminal_true_residual_alias_verified",
        "terminal_true_residual_metrics_delegated_to_normwise_v2",
        "checkpoint_vector_roles_exported",
        "general_history_status",
        "required_next_abi",
        "missing_evidence",
        "estimated_residual",
        "solution_update",
        "general_restart_history_v2_verified"
      ],
      "properties": {
        "scope": {"const": "exactly_one_populated_terminal_restart_row"},
        "terminal_restart_index": {"type": "integer", "minimum": 1},
        "terminal_row_slot_index": {"const": 1},
        "cpu_terminal_true_residual_alias_verified": {"const": true},
        "hip_terminal_true_residual_alias_verified": {"const": true},
        "terminal_true_residual_metrics_delegated_to_normwise_v2": {"const": true},
        "checkpoint_vector_roles_exported": {"const": false},
        "general_history_status": {"const": "not_verified_missing_checkpoint_vectors_and_scalar_error_models"},
        "required_next_abi": {"const": "per_restart_checkpoint_solution_and_true_residual_vector_export_v2"},
        "missing_evidence": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"const": "intermediate_checkpoint_solution_vectors_not_exported"},
            {"const": "intermediate_checkpoint_true_residual_vectors_not_exported"},
            {"const": "estimated_residual_roundoff_model_not_available"},
            {"const": "solution_update_roundoff_model_not_available"}
          ],
          "items": false
        },
        "estimated_residual": {
          "allOf": [
            {"$ref": "#/$defs/legacyMetric"},
            {"properties": {"name": {"const": "estimated_residual_l2"}}}
          ]
        },
        "solution_update": {
          "allOf": [
            {"$ref": "#/$defs/legacyMetric"},
            {"properties": {"name": {"const": "solution_update_l2"}}}
          ]
        },
        "general_restart_history_v2_verified": {"const": false}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_model_case_parity_schema_version",
        "terminal_metric_parity_schema_version",
        "legacy_wire_receipt_mutated",
        "legacy_solution_gate_relaxed",
        "legacy_residual_gate_relaxed",
        "legacy_terminal_or_history_gate_relaxed",
        "legacy_v1_receipt_required",
        "persisted_v1_migration_claimed",
        "migration_action"
      ],
      "properties": {
        "legacy_model_case_parity_schema_version": {"const": "structural-analysis-hip-fgmres-model-case-parity.v1"},
        "terminal_metric_parity_schema_version": {"const": "structural-analysis-hip-fgmres-terminal-metric-parity.v2"},
        "legacy_wire_receipt_mutated": {"const": false},
        "legacy_solution_gate_relaxed": {"const": false},
        "legacy_residual_gate_relaxed": {"const": false},
        "legacy_terminal_or_history_gate_relaxed": {"const": false},
        "legacy_v1_receipt_required": {"const": false},
        "persisted_v1_migration_claimed": {"const": false},
        "migration_action": {"const": "issue_additive_model_case_v2_without_mutating_or_requiring_v1"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_reference_result_count",
        "hip_terminal_observation_result_count",
        "hip_device_identity_result_count",
        "terminal_metric_parity_result_count",
        "populated_restart_row_count",
        "fixed_solution_vector_comparison_count",
        "additional_d2h_operation_count",
        "h2d_operation_count",
        "device_allocation_count",
        "kernel_launch_count",
        "explicit_stream_sync_count",
        "fallback_count"
      ],
      "properties": {
        "cpu_reference_result_count": {"const": 1},
        "hip_terminal_observation_result_count": {"const": 1},
        "hip_device_identity_result_count": {"const": 1},
        "terminal_metric_parity_result_count": {"const": 1},
        "populated_restart_row_count": {"const": 1},
        "fixed_solution_vector_comparison_count": {"const": 1},
        "additional_d2h_operation_count": {"const": 0},
        "h2d_operation_count": {"const": 0},
        "device_allocation_count": {"const": 0},
        "kernel_launch_count": {"const": 0},
        "explicit_stream_sync_count": {"const": 0},
        "fallback_count": {"const": 0}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_retained_execution_plan_snapshot_bound",
        "deterministic_cpu_reference_replayed",
        "actual_hip_backend_verified",
        "runtime_device_identity_verified",
        "legacy_fixed_solution_vector_gate_verified",
        "componentwise_residual_roundoff_bound_verified",
        "independent_operator_residual_replay_verified",
        "terminal_normwise_metric_v2_verified",
        "single_terminal_restart_true_residual_metric_v2_verified",
        "estimated_residual_roundoff_model_verified",
        "solution_update_roundoff_model_verified",
        "general_restart_history_metric_v2_verified",
        "scoped_single_model_case_numerical_parity_verified",
        "full_model_family_parity_verified",
        "multi_architecture_parity_verified",
        "iteration_host_copy_zero_proven",
        "solution_ready",
        "result_ir_ready",
        "performance_or_speedup_proven",
        "signed_evidence",
        "commercial_ready",
        "promotion_eligible"
      ],
      "properties": {
        "exact_retained_execution_plan_snapshot_bound": {"const": true},
        "deterministic_cpu_reference_replayed": {"const": true},
        "actual_hip_backend_verified": {"const": true},
        "runtime_device_identity_verified": {"const": true},
        "legacy_fixed_solution_vector_gate_verified": {"const": true},
        "componentwise_residual_roundoff_bound_verified": {"const": true},
        "independent_operator_residual_replay_verified": {"const": true},
        "terminal_normwise_metric_v2_verified": {"const": true},
        "single_terminal_restart_true_residual_metric_v2_verified": {"const": true},
        "estimated_residual_roundoff_model_verified": {"const": false},
        "solution_update_roundoff_model_verified": {"const": false},
        "general_restart_history_metric_v2_verified": {"const": false},
        "scoped_single_model_case_numerical_parity_verified": {"const": true},
        "full_model_family_parity_verified": {"const": false},
        "multi_architecture_parity_verified": {"const": false},
        "iteration_host_copy_zero_proven": {"const": false},
        "solution_ready": {"const": false},
        "result_ir_ready": {"const": false},
        "performance_or_speedup_proven": {"const": false},
        "signed_evidence": {"const": false},
        "commercial_ready": {"const": false},
        "promotion_eligible": {"const": false}
      }
    }
  }
}
