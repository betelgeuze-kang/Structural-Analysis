{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_assembly_evaluation_receipt_v1.schema.json",
  "title": "Engine v2 HIP device assembly evaluation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capability_profile", "status", "execution_id",
    "context_id", "requested_backend", "actual_backend", "evidence_scope",
    "promotion_eligible", "fallback_policy", "fallback_used", "reason",
    "bindings", "operator_id", "device_error_code", "csr_values",
    "telemetry_delta", "parity", "work", "claims", "extensions",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-hip-assembly-evaluation-receipt.v1"},
    "capability_profile": {"const": "phase0_hiprtc_linear_frame_truss_device_assembly"},
    "status": {"enum": ["verified", "assembled_unverified", "parity_failed", "unavailable"]},
    "execution_id": {"type": "string", "pattern": "^HipAssemblyEvaluation:[0-9a-f]{24}$"},
    "context_id": {"type": "string", "pattern": "^HipAssemblyContext:[0-9a-f]{24}$"},
    "requested_backend": {"const": "hip_rtc"},
    "actual_backend": {"enum": ["hip", "test_double", null]},
    "evidence_scope": {"enum": ["native_hiprtc", "injected_test_double"]},
    "promotion_eligible": {"const": false},
    "fallback_policy": {"const": "forbidden"},
    "fallback_used": {"const": false},
    "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]},
    "bindings": {"$ref": "#/$defs/bindings"},
    "operator_id": {"type": "string", "pattern": "^HipAssemblyOperator:[0-9a-f]{24}$"},
    "device_error_code": {"type": ["integer", "null"], "minimum": 0},
    "csr_values": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/array"}]},
    "telemetry_delta": {"$ref": "#/$defs/telemetry"},
    "parity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/parity"}]},
    "work": {"$ref": "#/$defs/work"},
    "claims": {"$ref": "#/$defs/claims"},
    "extensions": {"type": "object", "maxProperties": 0},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0},
    "positive": {"type": "integer", "minimum": 1},
    "reason": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "detail": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["model_ir_content_hash", "solver_artifact_hash", "solver_numeric_buffer_hash", "source_execution_plan_hash", "source_operator_hash", "source_numeric_snapshot_hash", "source_symbolic_reuse_hash", "source_partition_hash", "assembly_plan_hash", "assembly_symbolic_payload_hash", "axis_policy_hash", "reverse_map_hash", "kernel_identity_hash", "device_ordinal", "load_pattern_id", "verification_requested", "host_csr_values_role"],
      "properties": {
        "model_ir_content_hash": {"$ref": "#/$defs/hash"}, "solver_artifact_hash": {"$ref": "#/$defs/hash"},
        "solver_numeric_buffer_hash": {"$ref": "#/$defs/hash"}, "source_execution_plan_hash": {"$ref": "#/$defs/hash"},
        "source_operator_hash": {"$ref": "#/$defs/hash"}, "source_numeric_snapshot_hash": {"$ref": "#/$defs/hash"},
        "source_symbolic_reuse_hash": {"$ref": "#/$defs/hash"}, "source_partition_hash": {"$ref": "#/$defs/hash"},
        "assembly_plan_hash": {"$ref": "#/$defs/hash"}, "assembly_symbolic_payload_hash": {"$ref": "#/$defs/hash"},
        "axis_policy_hash": {"$ref": "#/$defs/hash"}, "reverse_map_hash": {"$ref": "#/$defs/hash"}, "kernel_identity_hash": {"$ref": "#/$defs/hash"}, "device_ordinal": {"$ref": "#/$defs/nonnegative"},
        "load_pattern_id": {"type": "string", "minLength": 1}, "verification_requested": {"type": "boolean"},
        "host_csr_values_role": {"const": "verification_oracle_only_never_uploaded"}
      }
    },
    "array": {
      "type": "object", "additionalProperties": false,
      "required": ["dtype", "shape", "byte_length", "data_hash"],
      "properties": {
        "dtype": {"const": "<f8"},
        "shape": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/positive"}},
        "byte_length": {"$ref": "#/$defs/positive"}, "data_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["h2d_bytes", "d2h_bytes", "h2d_operation_count", "d2h_operation_count", "d2h_operation_attempt_count", "d2h_operation_success_count", "d2h_bytes_attempted", "d2h_bytes_succeeded", "blocking_copy_count", "explicit_sync_count", "allocation_count", "deallocation_count", "current_device_payload_bytes", "peak_device_payload_bytes", "kernel_launch_attempt_count", "kernel_launch_count", "fallback_count", "child_allocation_attempt_count", "child_allocation_success_count", "child_deallocation_attempt_count", "child_deallocation_success_count", "child_initial_h2d_attempt_count", "child_initial_h2d_success_count", "assembly_sync_count", "assembly_sync_attempt_count", "assembly_sync_success_count", "error_flag_d2h_bytes", "verification_csr_d2h_bytes", "host_csr_values_h2d_bytes"],
      "properties": {
        "h2d_bytes": {"$ref": "#/$defs/nonnegative"}, "d2h_bytes": {"$ref": "#/$defs/nonnegative"},
        "h2d_operation_count": {"$ref": "#/$defs/nonnegative"}, "d2h_operation_count": {"$ref": "#/$defs/nonnegative"},
        "d2h_operation_attempt_count": {"$ref": "#/$defs/nonnegative"}, "d2h_operation_success_count": {"$ref": "#/$defs/nonnegative"},
        "d2h_bytes_attempted": {"$ref": "#/$defs/nonnegative"}, "d2h_bytes_succeeded": {"$ref": "#/$defs/nonnegative"},
        "blocking_copy_count": {"const": 0}, "explicit_sync_count": {"$ref": "#/$defs/nonnegative"},
        "allocation_count": {"$ref": "#/$defs/nonnegative"}, "deallocation_count": {"$ref": "#/$defs/nonnegative"},
        "current_device_payload_bytes": {"$ref": "#/$defs/nonnegative"}, "peak_device_payload_bytes": {"$ref": "#/$defs/nonnegative"},
        "kernel_launch_attempt_count": {"$ref": "#/$defs/nonnegative"}, "kernel_launch_count": {"$ref": "#/$defs/nonnegative"},
        "fallback_count": {"const": 0}, "child_allocation_attempt_count": {"$ref": "#/$defs/nonnegative"},
        "child_allocation_success_count": {"$ref": "#/$defs/nonnegative"}, "child_deallocation_attempt_count": {"$ref": "#/$defs/nonnegative"},
        "child_deallocation_success_count": {"$ref": "#/$defs/nonnegative"}, "child_initial_h2d_attempt_count": {"$ref": "#/$defs/nonnegative"},
        "child_initial_h2d_success_count": {"$ref": "#/$defs/nonnegative"}, "assembly_sync_count": {"$ref": "#/$defs/nonnegative"},
        "assembly_sync_attempt_count": {"$ref": "#/$defs/nonnegative"}, "assembly_sync_success_count": {"$ref": "#/$defs/nonnegative"},
        "error_flag_d2h_bytes": {"$ref": "#/$defs/nonnegative"}, "verification_csr_d2h_bytes": {"$ref": "#/$defs/nonnegative"},
        "host_csr_values_h2d_bytes": {"const": 0}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "max_abs_error", "relative_l2_error", "max_scaled_error", "relative_tolerance", "scaled_tolerance", "passed"],
      "properties": {
        "count": {"$ref": "#/$defs/positive"}, "max_abs_error": {"type": "number", "minimum": 0},
        "relative_l2_error": {"type": "number", "minimum": 0}, "max_scaled_error": {"type": "number", "minimum": 0},
        "relative_tolerance": {"const": 1e-8}, "scaled_tolerance": {"const": 1e-8}, "passed": {"type": "boolean"}
      }
    },
    "parity": {
      "type": "object", "additionalProperties": false,
      "required": ["oracle", "oracle_role", "csr_values", "structural_zero_count", "structural_zeros_exact", "passed"],
      "properties": {
        "oracle": {"const": "execution_plan_v2_cpu_csr_values_fp64"},
        "oracle_role": {"const": "verification_only_never_fallback"},
        "csr_values": {"$ref": "#/$defs/metric"},
        "structural_zero_count": {"$ref": "#/$defs/nonnegative"},
        "structural_zeros_exact": {"type": "boolean"}, "passed": {"type": "boolean"}
      }
    },
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "operation_count_basis", "element_count", "csr_nnz", "contribution_count", "element_kernel_launch_count", "segmented_gather_launch_count", "contribution_write_count", "gather_read_count", "physical_dram_bytes", "fixed_rank_kernel_scope_linear_in_e_plus_c_plus_z", "end_to_end_o_n_claim", "solver_ready"],
      "properties": {
        "scope": {"const": "hiprtc_linear_frame_truss_assembly_v1"},
        "operation_count_basis": {"const": "structural_source_equivalent_not_hardware_counter"},
        "element_count": {"$ref": "#/$defs/positive"}, "csr_nnz": {"$ref": "#/$defs/positive"},
        "contribution_count": {"$ref": "#/$defs/positive"}, "element_kernel_launch_count": {"const": 1},
        "segmented_gather_launch_count": {"const": 1}, "contribution_write_count": {"$ref": "#/$defs/positive"},
        "gather_read_count": {"$ref": "#/$defs/positive"}, "physical_dram_bytes": {"const": "not_instrumented"},
        "fixed_rank_kernel_scope_linear_in_e_plus_c_plus_z": {"const": true},
        "end_to_end_o_n_claim": {"const": false}, "solver_ready": {"const": false}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["device_element_contributions_executed", "device_segmented_gather_executed", "device_csr_operator_resident", "cpu_reference_parity_verified", "native_hiprtc_kernel_loaded", "solver_ready", "device_resident_krylov_ready", "commercial_readiness"],
      "properties": {
        "device_element_contributions_executed": {"type": "boolean"},
        "device_segmented_gather_executed": {"type": "boolean"},
        "device_csr_operator_resident": {"type": "boolean"},
        "cpu_reference_parity_verified": {"type": "boolean"},
        "native_hiprtc_kernel_loaded": {"type": "boolean"},
        "solver_ready": {"const": false}, "device_resident_krylov_ready": {"const": false},
        "commercial_readiness": {"const": false}
      }
    }
  }
}
