{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_fgmres_all_converged_model_family_v1.schema.json",
  "title": "Exact HIP FGMRES all-converged ten-slot live family v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "attestation_id",
    "evidence_scope",
    "actual_backend",
    "promotion_eligible",
    "bindings",
    "observations",
    "totals",
    "claims",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-hip-fgmres-all-converged-model-family.v1"},
    "capability_profile": {"const": "phase0_exact_package_gfx1030_all_converged_ten_slot_family"},
    "status": {"const": "exact_gfx1030_all_converged_ten_slot_family_verified"},
    "attestation_id": {"$ref": "#/$defs/hash"},
    "evidence_scope": {"const": "process_local_registry_bound_unsigned_nonpersistent_nonpromoting"},
    "actual_backend": {"const": "hip"},
    "promotion_eligible": {"const": false},
    "bindings": {"$ref": "#/$defs/bindings"},
    "observations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_single_axial"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_single_weak_axis_bending"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_single_strong_axis_bending"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_single_torsion"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_single_rotated_axis_bending"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_serial_two_span_axial"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_truss_single_axial"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_zero_free_rhs_edge"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_serial_four_span_axial"}}}]},
        {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"slot_id": {"const": "solution_frame_serial_five_span_axial"}}}]}
      ],
      "items": false
    },
    "totals": {"$ref": "#/$defs/totals"},
    "claims": {"$ref": "#/$defs/claims"},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 512},
    "slot_ids": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"const": "solution_frame_single_axial"},
        {"const": "solution_frame_single_weak_axis_bending"},
        {"const": "solution_frame_single_strong_axis_bending"},
        {"const": "solution_frame_single_torsion"},
        {"const": "solution_frame_single_rotated_axis_bending"},
        {"const": "solution_frame_serial_two_span_axial"},
        {"const": "solution_truss_single_axial"},
        {"const": "solution_frame_zero_free_rhs_edge"},
        {"const": "solution_frame_serial_four_span_axial"},
        {"const": "solution_frame_serial_five_span_axial"}
      ],
      "items": false
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_schema_version",
        "registry_capability_profile",
        "fixture_suite_id",
        "fixture_registry_evidence_scope",
        "registry_bytes_sha256",
        "registry_hash",
        "required_architecture_base",
        "required_slot_ids"
      ],
      "properties": {
        "registry_schema_version": {"const": "structural-analysis-hip-fgmres-all-converged-fixture-registry.v1"},
        "registry_capability_profile": {"const": "phase0_package_owned_fgmres_all_converged_fixed_suite_replay"},
        "fixture_suite_id": {"const": "phase0_execution_plan_v2_linear_frame_truss_fgmres_all_converged_suite.v1"},
        "fixture_registry_evidence_scope": {"const": "package_local_unsigned_non_promoting"},
        "registry_bytes_sha256": {"$ref": "#/$defs/hash"},
        "registry_hash": {"$ref": "#/$defs/hash"},
        "required_architecture_base": {"const": "gfx1030"},
        "required_slot_ids": {"$ref": "#/$defs/slot_ids"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "slot_registration_hash",
        "case_fingerprint",
        "case_id",
        "case_receipt_hash",
        "model_ir_content_hash",
        "execution_plan_hash",
        "fgmres_plan_hash",
        "recurrence_plan_hash",
        "policy_hash",
        "cpu_result_hash",
        "descriptor_hash",
        "terminal_observation_receipt_hash",
        "completion_export_context_id",
        "completion_export_receipt_hash",
        "completion_export_payload_hash",
        "device_identity_receipt_hash",
        "kernel_identity_hash",
        "kernel_source_sha256",
        "runtime_library_sha256",
        "compiled_architecture",
        "runtime_architecture_base",
        "device_ordinal",
        "device_uuid_bytes_hex",
        "device_pci_bdf",
        "cpu_status",
        "cpu_termination_code",
        "solver_tolerance_passed",
        "authoritative_plan_tolerance_passed",
        "authority_snapshot_hash",
        "logical_case_key",
        "observation_binding_hash"
      ],
      "properties": {
        "slot_id": {"type": "string"},
        "slot_registration_hash": {"$ref": "#/$defs/hash"},
        "case_fingerprint": {"$ref": "#/$defs/hash"},
        "case_id": {"$ref": "#/$defs/nonempty"},
        "case_receipt_hash": {"$ref": "#/$defs/hash"},
        "model_ir_content_hash": {"$ref": "#/$defs/hash"},
        "execution_plan_hash": {"$ref": "#/$defs/hash"},
        "fgmres_plan_hash": {"$ref": "#/$defs/hash"},
        "recurrence_plan_hash": {"$ref": "#/$defs/hash"},
        "policy_hash": {"$ref": "#/$defs/hash"},
        "cpu_result_hash": {"$ref": "#/$defs/hash"},
        "descriptor_hash": {"$ref": "#/$defs/hash"},
        "terminal_observation_receipt_hash": {"$ref": "#/$defs/hash"},
        "completion_export_context_id": {"$ref": "#/$defs/nonempty"},
        "completion_export_receipt_hash": {"$ref": "#/$defs/hash"},
        "completion_export_payload_hash": {"$ref": "#/$defs/hash"},
        "device_identity_receipt_hash": {"$ref": "#/$defs/hash"},
        "kernel_identity_hash": {"$ref": "#/$defs/hash"},
        "kernel_source_sha256": {"$ref": "#/$defs/hash"},
        "runtime_library_sha256": {"$ref": "#/$defs/hash"},
        "compiled_architecture": {"const": "gfx1030"},
        "runtime_architecture_base": {"const": "gfx1030"},
        "device_ordinal": {"type": "integer", "minimum": 0},
        "device_uuid_bytes_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "device_pci_bdf": {"$ref": "#/$defs/nonempty"},
        "cpu_status": {"const": "converged"},
        "cpu_termination_code": {"$ref": "#/$defs/nonempty"},
        "solver_tolerance_passed": {"const": true},
        "authoritative_plan_tolerance_passed": {"const": true},
        "authority_snapshot_hash": {"$ref": "#/$defs/hash"},
        "logical_case_key": {"$ref": "#/$defs/hash"},
        "observation_binding_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_slot_count",
        "validated_live_case_count",
        "converged_case_count",
        "solver_tolerance_passed_count",
        "authoritative_plan_tolerance_passed_count",
        "unique_model_ir_count",
        "unique_execution_plan_count",
        "unique_case_count",
        "package_global_dof_count",
        "package_element_count",
        "package_free_dof_count",
        "package_csr_nnz"
      ],
      "properties": {
        "required_slot_count": {"const": 10},
        "validated_live_case_count": {"const": 10},
        "converged_case_count": {"const": 10},
        "solver_tolerance_passed_count": {"const": 10},
        "authoritative_plan_tolerance_passed_count": {"const": 10},
        "unique_model_ir_count": {"const": 10},
        "unique_execution_plan_count": {"const": 10},
        "unique_case_count": {"const": 10},
        "package_global_dof_count": {"type": "integer", "minimum": 1},
        "package_element_count": {"type": "integer", "minimum": 1},
        "package_free_dof_count": {"type": "integer", "minimum": 1},
        "package_csr_nnz": {"type": "integer", "minimum": 1}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_all_converged_package_registry_replayed",
        "exact_ten_registered_slots_verified",
        "exact_ten_live_case_authorities_replayed",
        "canonical_registry_order_verified",
        "ten_unique_model_ir_verified",
        "all_cpu_reference_converged",
        "all_solver_tolerance_passed",
        "all_authoritative_plan_tolerance_passed",
        "exact_gfx1030_family_authority_issued",
        "actual_hardware_execution_verified",
        "hardware_gate_completed",
        "serialized_receipt_grants_process_local_provenance",
        "result_ir_verified",
        "external_gfx1100_verified",
        "multiarchitecture_parity_verified",
        "signed_evidence",
        "persistent_external_log_verified",
        "performance_or_speedup_proven",
        "end_to_end_o_n_verified",
        "commercial_ready",
        "promotion_eligible"
      ],
      "properties": {
        "fixed_all_converged_package_registry_replayed": {"const": true},
        "exact_ten_registered_slots_verified": {"const": true},
        "exact_ten_live_case_authorities_replayed": {"const": true},
        "canonical_registry_order_verified": {"const": true},
        "ten_unique_model_ir_verified": {"const": true},
        "all_cpu_reference_converged": {"const": true},
        "all_solver_tolerance_passed": {"const": true},
        "all_authoritative_plan_tolerance_passed": {"const": true},
        "exact_gfx1030_family_authority_issued": {"const": true},
        "actual_hardware_execution_verified": {"const": false},
        "hardware_gate_completed": {"const": false},
        "serialized_receipt_grants_process_local_provenance": {"const": false},
        "result_ir_verified": {"const": false},
        "external_gfx1100_verified": {"const": false},
        "multiarchitecture_parity_verified": {"const": false},
        "signed_evidence": {"const": false},
        "persistent_external_log_verified": {"const": false},
        "performance_or_speedup_proven": {"const": false},
        "end_to_end_o_n_verified": {"const": false},
        "commercial_ready": {"const": false},
        "promotion_eligible": {"const": false}
      }
    }
  }
}
