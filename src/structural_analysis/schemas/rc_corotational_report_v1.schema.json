    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_index",
          "phase",
          "checkpoint_hash",
          "parent_checkpoint_hash",
          "load_factor",
          "control_displacement_m",
