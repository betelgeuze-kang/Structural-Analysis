{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/g1-mgt-state-updated-frame-axial-geometry-preflight-v1.schema.json",
  "title": "G1 actual-MGT state-updated frame axial geometry preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "contract_pass",
    "readiness_pass",
    "diagnostic_execution_ready",
    "engineer_review_required",
    "evidence_closure_pass",
    "source_commit_sha",
    "engine_version",
    "source_commit_exact_replay_claim",
    "source_tree_state",
    "input_checksums",
    "case_id",
    "inputs",
    "frame_connectivity_audit",
    "source_property_coverage_audit",
    "dgn_material_property_alias_audit",
    "resolved_source_property_coverage_audit",
    "prepack_probe",
    "resolved_prepack_probe",
    "claims",
    "blockers_remaining",
    "artifacts",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "g1-mgt-state-updated-frame-axial-geometry-preflight.v1"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "partial", "blocked"]},
    "contract_pass": {"type": "boolean"},
    "readiness_pass": {"type": "boolean"},
    "diagnostic_execution_ready": {"type": "boolean"},
    "engineer_review_required": {"type": "boolean"},
    "evidence_closure_pass": {"const": false},
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "engine_version": {"type": "string", "minLength": 1},
    "source_commit_exact_replay_claim": {"const": false},
    "source_tree_state": {
      "const": "working_tree_with_uncommitted_goal_changes"
    },
    "input_checksums": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "case_id": {
      "const": "g1_real_mgt_state_updated_frame_axial_geometry_preflight"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mgt_path",
        "mgt_sha256",
        "roundtrip_derivation",
        "roundtrip_generated_uncoarsened",
        "generated_roundtrip_sha256",
        "uncoarsened_parser_contract_pass",
        "node_count",
        "element_count",
        "analysis_material_table_ids",
        "dgn_alias_material_ids",
        "resolved_analysis_material_ids",
        "dgn_alias_frame_element_count",
        "dgn_alias_frame_material_id_counts"
      ],
      "properties": {
        "mgt_path": {"type": "string", "minLength": 1},
        "mgt_sha256": {"$ref": "#/$defs/sha256"},
        "roundtrip_derivation": {
          "const": "parse_midas_mgt_to_json_npz:no_resolve_rigid_links:no_drop_unreferenced_nodes"
        },
        "roundtrip_generated_uncoarsened": {"const": true},
        "generated_roundtrip_sha256": {"$ref": "#/$defs/sha256"},
        "uncoarsened_parser_contract_pass": {"const": true},
        "node_count": {"type": "integer", "minimum": 1},
        "element_count": {"type": "integer", "minimum": 1},
        "analysis_material_table_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer"}
        },
        "dgn_alias_material_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer"}
        },
        "resolved_analysis_material_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer"}
        },
        "dgn_alias_frame_element_count": {
          "type": "integer",
          "minimum": 1
        },
        "dgn_alias_frame_material_id_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material_id", "element_count"],
            "properties": {
              "material_id": {"type": "integer"},
              "element_count": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "frame_connectivity_audit": {
      "type": "object",
      "required": [
        "frame_connectivity_source",
        "edge_index_used_for_element_binding",
        "raw_line_element_count",
        "line_elements_solved",
        "skipped_invalid_line_connectivity_count",
        "line_element_row_accounting_exact"
      ],
      "properties": {
        "frame_connectivity_source": {
          "const": "elem_conn_ptr/elem_conn_idx"
        },
        "edge_index_used_for_element_binding": {"const": false},
        "raw_line_element_count": {"type": "integer", "minimum": 1},
        "line_elements_solved": {"type": "integer", "minimum": 1},
        "skipped_invalid_line_connectivity_count": {
          "type": "integer",
          "minimum": 0
        },
        "line_element_row_accounting_exact": {"type": "boolean"}
      }
    },
    "source_property_coverage_audit": {
      "$ref": "#/$defs/frame_source_property_coverage"
    },
    "dgn_material_property_alias_audit": {
      "$ref": "#/$defs/dgn_material_property_alias_audit"
    },
    "resolved_source_property_coverage_audit": {
      "$ref": "#/$defs/frame_source_property_coverage"
    },
    "prepack_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "succeeded",
        "expected_fail_closed",
        "failure_type",
        "failure_reason_code",
        "failure_message",
        "property_fallback_attempted",
        "property_fallback_count"
      ],
      "properties": {
        "attempted": {"const": true},
        "succeeded": {"type": "boolean"},
        "expected_fail_closed": {"type": "boolean"},
        "failure_type": {"type": ["string", "null"]},
        "failure_reason_code": {"type": ["string", "null"]},
        "failure_message": {"type": ["string", "null"]},
        "property_fallback_attempted": {"const": false},
        "property_fallback_count": {"const": 0}
      }
    },
    "resolved_prepack_probe": {
      "$ref": "#/$defs/prepack_probe"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_mgt_source_and_roundtrip_consumed",
        "authoritative_element_connectivity_consumed",
        "exact_raw_material_table_frame_property_coverage",
        "exact_source_derived_alias_frame_property_coverage",
        "missing_property_prepack_failed_closed",
        "dgn_exact_type_name_alias_contract_pass",
        "dgn_numeric_elastic_override_consumed",
        "dgn_alias_engineer_review_required",
        "synthetic_property_fallback_used",
        "design_material_rows_promoted_to_analysis_properties",
        "actual_mgt_state_updated_axial_geometry_prepacked",
        "actual_mgt_state_updated_axial_geometry_connected_to_residual",
        "full_nonlinear_continuation",
        "full_corotational_frame",
        "g1_full_building_closure"
      ],
      "properties": {
        "actual_mgt_source_and_roundtrip_consumed": {"const": true},
        "authoritative_element_connectivity_consumed": {"const": true},
        "exact_raw_material_table_frame_property_coverage": {
          "type": "boolean"
        },
        "exact_source_derived_alias_frame_property_coverage": {
          "type": "boolean"
        },
        "missing_property_prepack_failed_closed": {"type": "boolean"},
        "dgn_exact_type_name_alias_contract_pass": {"type": "boolean"},
        "dgn_numeric_elastic_override_consumed": {"const": false},
        "dgn_alias_engineer_review_required": {"type": "boolean"},
        "synthetic_property_fallback_used": {"const": false},
        "design_material_rows_promoted_to_analysis_properties": {
          "const": false
        },
        "actual_mgt_state_updated_axial_geometry_prepacked": {
          "type": "boolean"
        },
        "actual_mgt_state_updated_axial_geometry_connected_to_residual": {
          "const": false
        },
        "full_nonlinear_continuation": {"const": false},
        "full_corotational_frame": {"const": false},
        "g1_full_building_closure": {"const": false}
      }
    },
    "blockers_remaining": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "schema"],
      "properties": {
        "receipt": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "prepack_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "succeeded",
        "expected_fail_closed",
        "failure_type",
        "failure_reason_code",
        "failure_message",
        "property_fallback_attempted",
        "property_fallback_count"
      ],
      "properties": {
        "attempted": {"const": true},
        "succeeded": {"type": "boolean"},
        "expected_fail_closed": {"type": "boolean"},
        "failure_type": {"type": ["string", "null"]},
        "failure_reason_code": {"type": ["string", "null"]},
        "failure_message": {"type": ["string", "null"]},
        "property_fallback_attempted": {"const": false},
        "property_fallback_count": {"const": 0}
      }
    },
    "dgn_material_property_alias_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "resolution_policy",
        "source_material_count",
        "dgn_material_row_count",
        "dgn_unique_material_id_count",
        "existing_source_id_row_count",
        "exact_unique_identity_match_row_count",
        "alias_material_count",
        "alias_rows",
        "unresolved_identity_rows",
        "ambiguous_identity_rows",
        "duplicate_dgn_material_ids",
        "dgn_numeric_elastic_override_consumed_count",
        "fuzzy_name_match_count",
        "contract_pass",
        "engineer_review_required",
        "claim_boundary"
      ],
      "properties": {
        "schema_version": {
          "const": "mgt-dgn-material-property-alias-audit.v1"
        },
        "resolution_policy": {
          "const": "exact_normalized_type_and_name_unique_source_material.v1"
        },
        "source_material_count": {"type": "integer", "minimum": 1},
        "dgn_material_row_count": {"type": "integer", "minimum": 1},
        "dgn_unique_material_id_count": {"type": "integer", "minimum": 1},
        "existing_source_id_row_count": {"type": "integer", "minimum": 0},
        "exact_unique_identity_match_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "alias_material_count": {"type": "integer", "minimum": 0},
        "alias_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dgn_material_id",
              "material_type",
              "material_name",
              "source_material_id",
              "source_material_type",
              "source_material_name"
            ],
            "properties": {
              "dgn_material_id": {"type": "integer"},
              "material_type": {"type": "string", "minLength": 1},
              "material_name": {"type": "string", "minLength": 1},
              "source_material_id": {"type": "integer"},
              "source_material_type": {"type": "string", "minLength": 1},
              "source_material_name": {"type": "string", "minLength": 1}
            }
          }
        },
        "unresolved_identity_rows": {"type": "array"},
        "ambiguous_identity_rows": {"type": "array"},
        "duplicate_dgn_material_ids": {
          "type": "array",
          "items": {"type": "integer"}
        },
        "dgn_numeric_elastic_override_consumed_count": {"const": 0},
        "fuzzy_name_match_count": {"const": 0},
        "contract_pass": {"type": "boolean"},
        "engineer_review_required": {"type": "boolean"},
        "claim_boundary": {"type": "string", "minLength": 1}
      }
    },
    "frame_source_property_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_element_count",
        "source_section_property_count",
        "source_material_property_count",
        "section_property_resolved_element_count",
        "material_property_resolved_element_count",
        "resolved_source_property_element_count",
        "unresolved_source_property_element_count",
        "source_property_coverage_ratio",
        "exact_source_property_coverage",
        "missing_section_element_count",
        "missing_material_element_count",
        "missing_section_id_counts",
        "missing_material_id_counts",
        "unresolved_element_head",
        "unresolved_element_head_limit",
        "fallback_allowed_for_state_updated_geometry",
        "claim_boundary"
      ],
      "properties": {
        "schema_version": {
          "const": "mgt-state-updated-frame-axial-property-coverage.v1"
        },
        "frame_element_count": {"type": "integer", "minimum": 1},
        "source_section_property_count": {"type": "integer", "minimum": 0},
        "source_material_property_count": {"type": "integer", "minimum": 0},
        "section_property_resolved_element_count": {
          "type": "integer",
          "minimum": 0
        },
        "material_property_resolved_element_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_source_property_element_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_source_property_element_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_property_coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exact_source_property_coverage": {"type": "boolean"},
        "missing_section_element_count": {"type": "integer", "minimum": 0},
        "missing_material_element_count": {"type": "integer", "minimum": 0},
        "missing_section_id_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "element_count"],
            "properties": {
              "section_id": {"type": "integer"},
              "element_count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "missing_material_id_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material_id", "element_count"],
            "properties": {
              "material_id": {"type": "integer"},
              "element_count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "unresolved_element_head": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element_id",
              "section_id",
              "material_id",
              "missing_section_property",
              "missing_material_property"
            ],
            "properties": {
              "element_id": {"type": "integer", "minimum": 1},
              "section_id": {"type": "integer"},
              "material_id": {"type": "integer"},
              "missing_section_property": {"type": "boolean"},
              "missing_material_property": {"type": "boolean"}
            }
          }
        },
        "unresolved_element_head_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "fallback_allowed_for_state_updated_geometry": {"const": false},
        "claim_boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}
