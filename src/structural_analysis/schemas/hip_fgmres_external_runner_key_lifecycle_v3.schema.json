    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"
    },
    "reviewerRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "key_id",
        "key_epoch",
        "public_key_base64",
        "public_key_sha256",
        "valid_from_utc",
        "valid_until_utc"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519-review:[a-z0-9][a-z0-9._-]{2,63}:v1$"
        },
        "key_epoch": {"const": 1},
        "public_key_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
