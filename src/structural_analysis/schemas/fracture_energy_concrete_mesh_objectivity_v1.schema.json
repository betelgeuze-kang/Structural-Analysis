{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/fracture_energy_concrete_mesh_objectivity_v1.schema.json",
  "title": "Fracture-energy concrete mesh-objectivity benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_hash",
    "status",
    "contract_pass",
    "profile",
    "material_algorithm",
    "tangent_definition",
    "configuration",
    "traction_opening_cases",
    "tangent_checks",
    "mesh_cases",
    "metrics",
    "checks",
    "claims",
    "limitations",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "fracture-energy-concrete-mesh-objectivity-benchmark.v1"
    },
    "artifact_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["candidate_verified", "blocked"]},
    "contract_pass": {"type": "boolean"},
    "profile": {"const": "localized_crack_band_rc_tie_2_4_8_meshes.v1"},
    "material_algorithm": {
      "const": "crack_band_exponential_traction_effective_crack_opening"
    },
    "tangent_definition": {
      "const": "implicit_consistent_d_traction_d_total_strain"
    },
    "configuration": {"type": "object"},
    "traction_opening_cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "object"}
    },
    "tangent_checks": {
      "type": "array",
      "minItems": 6,
      "items": {"type": "object"}
    },
    "mesh_cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "mesh_count",
          "element_length_m",
          "status",
          "contract_pass",
          "concrete_force_history_kn",
          "reinforcement_force_history_kn",
          "total_rc_force_history_kn",
          "concrete_dissipated_energy_j",
          "expected_tensile_fracture_energy_j",
          "localized_element_indices",
          "checks"
        ],
        "properties": {
          "mesh_count": {"enum": [2, 4, 8]},
          "element_length_m": {"type": "number", "exclusiveMinimum": 0},
          "status": {"const": "ready"},
          "contract_pass": {"const": true},
          "concrete_force_history_kn": {"$ref": "#/$defs/history"},
          "reinforcement_force_history_kn": {"$ref": "#/$defs/history"},
          "total_rc_force_history_kn": {"$ref": "#/$defs/history"},
          "concrete_dissipated_energy_j": {"type": "number", "minimum": 0},
          "expected_tensile_fracture_energy_j": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "localized_element_indices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {"type": "integer", "minimum": 0}
          },
          "checks": {"type": "object"}
        }
      }
    },
    "metrics": {"type": "object"},
    "checks": {
      "type": "object",
      "additionalProperties": {"const": true}
    },
    "claims": {
      "type": "object",
      "required": [
        "uniaxial_fracture_energy_regularization",
        "bounded_seeded_rc_tie_mesh_objectivity",
        "arbitrary_rc_frame_or_shell_mesh_objectivity",
        "multiaxial_or_confined_concrete",
        "bond_slip",
        "published_or_external_validation",
        "release_readiness"
      ],
      "properties": {
        "uniaxial_fracture_energy_regularization": {"type": "boolean"},
        "bounded_seeded_rc_tie_mesh_objectivity": {"type": "boolean"},
        "arbitrary_rc_frame_or_shell_mesh_objectivity": {"const": false},
        "multiaxial_or_confined_concrete": {"const": false},
        "bond_slip": {"const": false},
        "published_or_external_validation": {"const": false},
        "release_readiness": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "history": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {"type": "number"}
    }
  }
}
