{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/state_updated_composite_section_v1.schema.json",
  "title": "State-updated iso-strain composite section Newton receipt",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "contract_pass",
    "truth_class",
    "analysis_type",
    "residual_formula",
    "residual_formula_hash",
    "composite_algorithm",
    "material_point",
    "element_benchmark",
    "structure_benchmark",
    "rollback_probe",
    "verification",
    "state_updated_composite_seed_contract_pass",
    "perfect_bond_only",
    "composite_section_breadth_closure_claim",
    "material_newton_breadth_closure_claim",
    "g1_material_newton_breadth_claim",
    "production_nonlinear_closure_claim",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "phase2-state-updated-composite-section-result.v1"
    },
    "status": {"enum": ["ready", "blocked"]},
    "contract_pass": {"type": "boolean"},
    "truth_class": {"const": "analytic_1d_iso_strain_composite_axial_truth"},
    "analysis_type": {"const": "state_updated_composite_section_newton_seed"},
    "residual_formula": {"const": "F_internal_minus_F_external"},
    "residual_formula_hash": {"$ref": "#/$defs/hash"},
    "composite_algorithm": {
      "const": "iso_strain_parallel_constituent_integration"
    },
    "material_point": {"type": "object"},
    "element_benchmark": {"type": "object"},
    "structure_benchmark": {"type": "object"},
    "rollback_probe": {"type": "object"},
    "verification": {"type": "object"},
    "state_updated_composite_seed_contract_pass": {"type": "boolean"},
    "perfect_bond_only": {"const": true},
    "composite_section_breadth_closure_claim": {"const": false},
    "material_newton_breadth_closure_claim": {"const": false},
    "g1_material_newton_breadth_claim": {"const": false},
    "production_nonlinear_closure_claim": {"const": false},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
