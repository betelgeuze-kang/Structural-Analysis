{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/bounded_planar_external_nonlinear_material_recovery_execution_receipt_v1.schema.json",
  "title": "Bounded planar external nonlinear material recovery execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit_sha",
    "package_binding",
    "runtime_policy",
    "cases",
    "summary",
    "status",
    "technical_contract_pass",
    "claims",
    "blockers",
    "claim_boundary",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "bounded-planar-external-nonlinear-material-recovery-execution-receipt.v1"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "path", "file_sha256", "artifact_hash", "source_commit_sha"],
      "properties": {
        "package_id": {"const": "bounded-planar-nonlinear-material-recovery-v1"},
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_hash": {"$ref": "#/$defs/sha256"},
        "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openseespy_version", "opensees_core_version"],
      "properties": {
        "openseespy_version": {"const": "3.7.1.2"},
        "opensees_core_version": {"const": "3.7.1"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "requirement_id",
          "external_result",
          "metric_comparisons",
          "maximum_absolute_error",
          "maximum_relative_error",
          "technical_comparison_pass",
          "blockers"
        ],
        "properties": {
          "case_id": {"$ref": "#/$defs/caseId"},
          "requirement_id": {"$ref": "#/$defs/requirementId"},
          "external_result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "file_sha256",
              "artifact_hash",
              "executed_at",
              "runner_file_sha256",
              "source_model_file_sha256",
              "runtime"
            ],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "file_sha256": {"$ref": "#/$defs/sha256"},
              "artifact_hash": {"$ref": "#/$defs/sha256"},
              "executed_at": {"type": "string", "format": "date-time"},
              "runner_file_sha256": {"$ref": "#/$defs/sha256"},
              "source_model_file_sha256": {"$ref": "#/$defs/sha256"},
              "runtime": {
                "type": "object",
                "additionalProperties": false,
                "required": ["python_version", "platform", "openseespy_version", "opensees_core_version"],
                "properties": {
                  "python_version": {"type": "string", "minLength": 1},
                  "platform": {"type": "string", "minLength": 1},
                  "openseespy_version": {"const": "3.7.1.2"},
                  "opensees_core_version": {"const": "3.7.1"}
                }
              }
            }
          },
          "metric_comparisons": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/metricComparison"}
          },
          "maximum_absolute_error": {"type": "number", "minimum": 0},
          "maximum_relative_error": {"type": "number", "minimum": 0},
          "technical_comparison_pass": {"type": "boolean"},
          "blockers": {
            "type": "array",
            "items": {"const": "comparison_tolerance_exceeded"},
            "uniqueItems": true
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "self_consistent_result_count", "technical_comparison_pass_count"],
      "properties": {
        "case_count": {"const": 6},
        "self_consistent_result_count": {"const": 6},
        "technical_comparison_pass_count": {"type": "integer", "minimum": 0, "maximum": 6}
      }
    },
    "status": {"enum": ["technical_pass", "technical_blocked"]},
    "technical_contract_pass": {"type": "boolean"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_bytes_authenticated",
        "external_results_self_consistent",
        "fresh_current_source_external_execution",
        "independent_operator_attested",
        "legal_use_approved",
        "verification_matrix_credit",
        "verification_level_2"
      ],
      "properties": {
        "package_bytes_authenticated": {"const": true},
        "external_results_self_consistent": {"const": true},
        "fresh_current_source_external_execution": {"const": false},
        "independent_operator_attested": {"const": false},
        "legal_use_approved": {"const": false},
        "verification_matrix_credit": {"const": false},
        "verification_level_2": {"const": false}
      }
    },
    "blockers": {
      "type": "array",
      "contains": {"const": "independent_operator_attestation_missing"},
      "items": {
        "enum": [
          "comparison_tolerance_exceeded",
          "fresh_current_source_execution_not_attested",
          "independent_operator_attestation_missing",
          "product_legal_license_approval_missing",
          "formal_level2_promotion_receipt_missing"
        ]
      },
      "uniqueItems": true
    },
    "claim_boundary": {"type": "string", "minLength": 100},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "caseId": {
      "enum": [
        "bounded_planar_p_delta",
        "bounded_planar_snap_through",
        "bounded_planar_steel_yield",
        "bounded_planar_rc_fiber",
        "bounded_planar_section_recovery",
        "bounded_planar_fiber_recovery"
      ]
    },
    "requirementId": {
      "enum": [
        "geometric_nonlinear.p_delta",
        "geometric_nonlinear.snap_through",
        "material.steel_yield",
        "material.rc_fiber",
        "recovery.section",
        "recovery.fiber"
      ]
    },
    "metricComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "product_value",
        "external_value",
        "absolute_error",
        "relative_error",
        "absolute_tolerance",
        "relative_tolerance",
        "contract_pass"
      ],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^(pdelta|snap|steel|section|fiber|rc)\\.[A-Za-z0-9_.-]+$"},
        "product_value": {"type": "number"},
        "external_value": {"type": "number"},
        "absolute_error": {"type": "number", "minimum": 0},
        "relative_error": {"type": "number", "minimum": 0},
        "absolute_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "relative_tolerance": {"type": "number", "exclusiveMinimum": 0},
        "contract_pass": {"type": "boolean"}
      }
    }
  }
}
