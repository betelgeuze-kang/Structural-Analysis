{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip-fgmres-terminal-metric-parity-v2.schema.json",
  "title": "Engine v2 detached HIP FGMRES terminal metric parity v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "evidence_scope",
    "promotion_eligible",
    "parity_id",
    "bindings",
    "records",
    "summary",
    "compatibility",
    "claims",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-hip-fgmres-terminal-metric-parity.v2"
    },
    "capability_profile": {
      "const": "phase0_detached_fgmres_terminal_norm_metric_parity_v2"
    },
    "status": {"const": "terminal_metric_parity_verified"},
    "evidence_scope": {
      "const": "detached_value_replay_non_provenance_non_promoting"
    },
    "promotion_eligible": {"const": false},
    "parity_id": {"$ref": "#/$defs/hash"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/l2Record"},
        {"$ref": "#/$defs/linfRecord"},
        {"$ref": "#/$defs/scaledLinfRecord"}
      ],
      "items": false
    },
    "summary": {"$ref": "#/$defs/summary"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "claims": {"$ref": "#/$defs/claims"},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegativeNumber": {"type": "number", "minimum": 0},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_plan_hash",
        "operator_hash",
        "cpu_result_hash",
        "terminal_outcome_hash",
        "candidate_solution_sha256",
        "candidate_residual_sha256",
        "cpu_candidate_componentwise_receipt_hash",
        "cpu_candidate_normwise_receipt_hash",
        "candidate_replay_componentwise_receipt_hash",
        "candidate_replay_normwise_receipt_hash",
        "terminal_metric_projection_hash"
      ],
      "properties": {
        "execution_plan_hash": {"$ref": "#/$defs/hash"},
        "operator_hash": {"$ref": "#/$defs/hash"},
        "cpu_result_hash": {"$ref": "#/$defs/hash"},
        "terminal_outcome_hash": {"$ref": "#/$defs/hash"},
        "candidate_solution_sha256": {"$ref": "#/$defs/hash"},
        "candidate_residual_sha256": {"$ref": "#/$defs/hash"},
        "cpu_candidate_componentwise_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "cpu_candidate_normwise_receipt_hash": {"$ref": "#/$defs/hash"},
        "candidate_replay_componentwise_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "candidate_replay_normwise_receipt_hash": {"$ref": "#/$defs/hash"},
        "terminal_metric_projection_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "recordBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reference_record",
        "candidate_record",
        "reference_record_evaluation_error_upper_bound",
        "candidate_record_evaluation_error_upper_bound",
        "vector_difference_upper_bound",
        "total_record_difference_upper_bound",
        "absolute_record_difference_upper_bound",
        "maximum_bound_ratio",
        "record_difference_bound_passed"
      ],
      "properties": {
        "name": {"enum": ["l2", "linf", "scaled_linf"]},
        "reference_record": {"$ref": "#/$defs/nonnegativeNumber"},
        "candidate_record": {"$ref": "#/$defs/nonnegativeNumber"},
        "reference_record_evaluation_error_upper_bound": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "candidate_record_evaluation_error_upper_bound": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "vector_difference_upper_bound": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "total_record_difference_upper_bound": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "absolute_record_difference_upper_bound": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "maximum_bound_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "record_difference_bound_passed": {"const": true}
      }
    },
    "l2Record": {
      "allOf": [
        {"$ref": "#/$defs/recordBase"},
        {"properties": {"name": {"const": "l2"}}}
      ]
    },
    "linfRecord": {
      "allOf": [
        {"$ref": "#/$defs/recordBase"},
        {"properties": {"name": {"const": "linf"}}}
      ]
    },
    "scaledLinfRecord": {
      "allOf": [
        {"$ref": "#/$defs/recordBase"},
        {"properties": {"name": {"const": "scaled_linf"}}}
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_dof_count",
        "rhs_linf",
        "load_scale",
        "metric_count",
        "maximum_record_bound_ratio",
        "all_terminal_record_bounds_passed"
      ],
      "properties": {
        "free_dof_count": {"type": "integer", "minimum": 1},
        "rhs_linf": {"$ref": "#/$defs/nonnegativeNumber"},
        "load_scale": {"type": "number", "minimum": 1},
        "metric_count": {"const": 3},
        "maximum_record_bound_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "all_terminal_record_bounds_passed": {"const": true}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_model_case_parity_schema_version",
        "legacy_wire_receipt_mutated",
        "legacy_solution_gate_relaxed",
        "legacy_residual_gate_relaxed",
        "legacy_terminal_or_history_gate_relaxed",
        "migration_action"
      ],
      "properties": {
        "legacy_model_case_parity_schema_version": {
          "const": "structural-analysis-hip-fgmres-model-case-parity.v1"
        },
        "legacy_wire_receipt_mutated": {"const": false},
        "legacy_solution_gate_relaxed": {"const": false},
        "legacy_residual_gate_relaxed": {"const": false},
        "legacy_terminal_or_history_gate_relaxed": {"const": false},
        "migration_action": {
          "const": "preserve_v1_and_issue_additive_terminal_metric_v2"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_fixed_solution_gate_verified",
        "cpu_candidate_componentwise_roundoff_replayed",
        "candidate_independent_replay_roundoff_replayed",
        "cpu_stable_l2_record_replayed",
        "candidate_gpu_tree_record_replayed",
        "terminal_l2_record_bound_verified",
        "terminal_linf_record_bound_verified",
        "terminal_scaled_linf_record_bound_verified",
        "caller_tolerance_allowed",
        "history_metric_v2_verified",
        "actual_backend_verified",
        "hardware_provenance_verified",
        "result_ir_ready",
        "performance_speedup_verified",
        "commercial_ready",
        "promotion_eligible"
      ],
      "properties": {
        "legacy_fixed_solution_gate_verified": {"const": true},
        "cpu_candidate_componentwise_roundoff_replayed": {"const": true},
        "candidate_independent_replay_roundoff_replayed": {"const": true},
        "cpu_stable_l2_record_replayed": {"const": true},
        "candidate_gpu_tree_record_replayed": {"const": true},
        "terminal_l2_record_bound_verified": {"const": true},
        "terminal_linf_record_bound_verified": {"const": true},
        "terminal_scaled_linf_record_bound_verified": {"const": true},
        "caller_tolerance_allowed": {"const": false},
        "history_metric_v2_verified": {"const": false},
        "actual_backend_verified": {"const": false},
        "hardware_provenance_verified": {"const": false},
        "result_ir_ready": {"const": false},
        "performance_speedup_verified": {"const": false},
        "commercial_ready": {"const": false},
        "promotion_eligible": {"const": false}
      }
    }
  }
}
