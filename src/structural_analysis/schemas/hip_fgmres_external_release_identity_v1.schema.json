{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_fgmres_external_release_identity_v1.schema.json",
  "title": "Independently replayed external FGMRES release identity receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "evidence_scope",
    "release_binding_hash",
    "wheel_identity_hash",
    "installed_replay_hash",
    "source_identity_hash",
    "dependency_lock_receipt_hash",
    "build_recipe_semantic_hash",
    "wheel_filename",
    "wheel_byte_count",
    "wheel_sha256",
    "wheel_record_sha256",
    "wheel_member_count",
    "installed_verified_member_count",
    "installed_extra_file_count",
    "installed_script_file_count",
    "installed_script_manifest_sha256",
    "source_commit",
    "source_tree_sha256",
    "source_tracked_file_count",
    "source_bundle_byte_count",
    "source_bundle_sha256",
    "runner_source_file_count",
    "runner_source_sha256",
    "build_recipe_sha256",
    "dependency_lock_sha256",
    "dependency_artifact_count",
    "dependency_artifact_aggregate_hash",
    "claims",
    "promotion_eligible",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-hip-fgmres-external-release-identity.v1"
    },
    "capability_profile": {
      "const": "phase0_external_release_artifact_identity_replay"
    },
    "status": {"const": "external_release_artifacts_independently_verified"},
    "evidence_scope": {
      "const": "local_double_replay_sequential_release_artifact_identity_non_promoting"
    },
    "release_binding_hash": {"$ref": "#/$defs/hash"},
    "wheel_identity_hash": {"$ref": "#/$defs/hash"},
    "installed_replay_hash": {"$ref": "#/$defs/hash"},
    "source_identity_hash": {"$ref": "#/$defs/hash"},
    "dependency_lock_receipt_hash": {"$ref": "#/$defs/hash"},
    "build_recipe_semantic_hash": {"$ref": "#/$defs/hash"},
    "wheel_filename": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]{0,254}\\.whl$",
      "maxLength": 255
    },
    "wheel_byte_count": {"type": "integer", "minimum": 1},
    "wheel_sha256": {"$ref": "#/$defs/hash"},
    "wheel_record_sha256": {"$ref": "#/$defs/hash"},
    "wheel_member_count": {"type": "integer", "minimum": 1},
    "installed_verified_member_count": {"type": "integer", "minimum": 0},
    "installed_extra_file_count": {"type": "integer", "minimum": 0},
    "installed_script_file_count": {"type": "integer", "minimum": 0},
    "installed_script_manifest_sha256": {"$ref": "#/$defs/hash"},
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "source_tree_sha256": {"$ref": "#/$defs/hash"},
    "source_tracked_file_count": {"type": "integer", "minimum": 1},
    "source_bundle_byte_count": {"type": "integer", "minimum": 1},
    "source_bundle_sha256": {"$ref": "#/$defs/hash"},
    "runner_source_file_count": {"type": "integer", "minimum": 1},
    "runner_source_sha256": {"$ref": "#/$defs/hash"},
    "build_recipe_sha256": {"$ref": "#/$defs/hash"},
    "dependency_lock_sha256": {"$ref": "#/$defs/hash"},
    "dependency_artifact_count": {"type": "integer", "minimum": 0},
    "dependency_artifact_aggregate_hash": {"$ref": "#/$defs/hash"},
    "claims": {"$ref": "#/$defs/claims"},
    "promotion_eligible": {"const": false},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wheel_bytes_independently_hashed",
        "wheel_record_fully_replayed",
        "installed_distribution_record_replayed",
        "source_commit_and_manifest_replayed",
        "source_worktree_clean",
        "source_bundle_matches_manifest",
        "runner_sources_independently_hashed",
        "declared_build_recipe_policy_matched",
        "dependency_artifacts_independently_hashed",
        "declared_target_runtime_dependency_closure_matched",
        "release_binding_derived_from_verified_artifacts",
        "build_recipe_execution_observed",
        "build_system_dependency_closure_verified",
        "runtime_dependency_installation_observed",
        "current_interpreter_wheel_tag_compatibility_verified",
        "bounded_source_artifact_memory_verified",
        "reproducible_build_verified",
        "remote_commit_authenticity_verified",
        "atomic_multi_artifact_snapshot_verified",
        "signed_envelope_binds_release_identity_receipt",
        "hostile_in_process_mint_isolation_verified",
        "runner_honesty_verified",
        "durable_replay_ledger_verified",
        "hardware_root_attested",
        "external_gpu_observed",
        "same_artifact_two_architecture_verified",
        "commercial_ready",
        "promotion_eligible"
      ],
      "properties": {
        "wheel_bytes_independently_hashed": {"const": true},
        "wheel_record_fully_replayed": {"const": true},
        "installed_distribution_record_replayed": {"const": true},
        "source_commit_and_manifest_replayed": {"const": true},
        "source_worktree_clean": {"const": true},
        "source_bundle_matches_manifest": {"const": true},
        "runner_sources_independently_hashed": {"const": true},
        "declared_build_recipe_policy_matched": {"const": true},
        "dependency_artifacts_independently_hashed": {"const": true},
        "declared_target_runtime_dependency_closure_matched": {"const": true},
        "release_binding_derived_from_verified_artifacts": {"const": true},
        "build_recipe_execution_observed": {"const": false},
        "build_system_dependency_closure_verified": {"const": false},
        "runtime_dependency_installation_observed": {"const": false},
        "current_interpreter_wheel_tag_compatibility_verified": {"const": false},
        "bounded_source_artifact_memory_verified": {"const": false},
        "reproducible_build_verified": {"const": false},
        "remote_commit_authenticity_verified": {"const": false},
        "atomic_multi_artifact_snapshot_verified": {"const": false},
        "signed_envelope_binds_release_identity_receipt": {"const": false},
        "hostile_in_process_mint_isolation_verified": {"const": false},
        "runner_honesty_verified": {"const": false},
        "durable_replay_ledger_verified": {"const": false},
        "hardware_root_attested": {"const": false},
        "external_gpu_observed": {"const": false},
        "same_artifact_two_architecture_verified": {"const": false},
        "commercial_ready": {"const": false},
        "promotion_eligible": {"const": false}
      }
    }
  }
}
