{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/rtc_kernel_scaling_report_v1.schema.json",
  "title": "Engine v2 HIPRTC kernel-only scaling report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "decision", "reason",
    "requested_backend", "actual_backend", "evidence_scope", "claim_scope",
    "evidence_authenticity", "signature", "promotion_eligible", "nonpromoting",
    "fallback_policy", "fallback_count", "device_ordinal", "architecture",
    "agent_enumerator", "detected_architectures", "environment", "harness_identity", "configuration",
    "device", "kernel_identity", "samples", "fit", "acceptance", "claims",
    "report_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-rtc-kernel-scaling-report.v1"},
    "status": {"enum": ["accepted", "rejected", "inconclusive", "unavailable", "error"]},
    "decision": {"enum": ["accepted", "rejected", "inconclusive", "not_evaluated"]},
    "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]},
    "requested_backend": {"const": "hip"},
    "actual_backend": {"oneOf": [{"const": "hip"}, {"type": "null"}]},
    "evidence_scope": {"const": "native_hiprtc_kernel_event_timing"},
    "claim_scope": {"const": "hiprtc_fused_csr_residual_jvp_kernel_only"},
    "evidence_authenticity": {"const": "unsigned_local_measurement"},
    "signature": {"type": "null"},
    "promotion_eligible": {"const": false},
    "nonpromoting": {"const": true},
    "fallback_policy": {"const": "forbidden"},
    "fallback_count": {"const": 0},
    "device_ordinal": {"type": "integer", "minimum": 0},
    "architecture": {
      "oneOf": [
        {"type": "string", "pattern": "^gfx[0-9][0-9a-f]{2,15}$"},
        {"type": "null"}
      ]
    },
    "agent_enumerator": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "detected_architectures": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^gfx[0-9][0-9a-f]{2,15}$"}
    },
    "environment": {"$ref": "#/$defs/environment"},
    "harness_identity": {"$ref": "#/$defs/harness_identity"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "device": {"oneOf": [{"$ref": "#/$defs/device"}, {"type": "null"}]},
    "kernel_identity": {
      "oneOf": [{"$ref": "#/$defs/kernel_identity"}, {"type": "null"}]
    },
    "samples": {"type": "array", "items": {"$ref": "#/$defs/sample"}},
    "fit": {"oneOf": [{"$ref": "#/$defs/fit"}, {"type": "null"}]},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "claims": {"$ref": "#/$defs/claims"},
    "report_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {"properties": {
        "decision": {"const": "accepted"}, "actual_backend": {"const": "hip"},
        "reason": {"type": "null"}, "fit": {"$ref": "#/$defs/fit"},
        "device": {"$ref": "#/$defs/device"},
        "kernel_identity": {"$ref": "#/$defs/kernel_identity"},
        "samples": {"minItems": 5},
        "acceptance": {"properties": {
          "evaluated": {"const": true}, "accepted": {"const": true},
          "outcome": {"const": "accepted"},
          "robust_slope_passed": {"const": true},
          "ols_slope_passed": {"const": true},
          "r2_passed": {"const": true},
          "bootstrap_ci_passed": {"const": true},
          "hardware_profile_matched": {"const": true},
          "off_cache_occupancy_precondition_passed": {"const": true},
          "batch_duration_passed": {"const": true},
          "batch_length_stability_passed": {"const": true},
          "coefficient_of_variation_passed": {"const": true},
          "end_repeat_drift_passed": {"const": true},
          "correctness_passed": {"const": true},
          "timed_region_clean": {"const": true}
        }},
        "claims": {"properties": {
          "kernel_scope_timing_measured": {"const": true},
          "kernel_scope_initial_linear_scaling_accepted": {"const": true}
        }}
      }}
    },
    {
      "if": {"properties": {"status": {"const": "rejected"}}},
      "then": {"properties": {
        "decision": {"const": "rejected"},
        "actual_backend": {"const": "hip"}, "reason": {"$ref": "#/$defs/reason"},
        "fit": {"$ref": "#/$defs/fit"},
        "acceptance": {"properties": {
          "evaluated": {"const": true}, "accepted": {"const": false},
          "outcome": {"const": "rejected"}
        }},
        "claims": {"properties": {
          "kernel_scope_initial_linear_scaling_accepted": {"const": false}
        }}
      }}
    },
    {
      "if": {"properties": {"status": {"const": "inconclusive"}}},
      "then": {"properties": {
        "decision": {"const": "inconclusive"},
        "actual_backend": {"const": "hip"}, "reason": {"$ref": "#/$defs/reason"},
        "fit": {"$ref": "#/$defs/fit"},
        "acceptance": {"properties": {
          "evaluated": {"const": true}, "accepted": {"const": false},
          "outcome": {"const": "inconclusive"}
        }},
        "claims": {"properties": {
          "kernel_scope_initial_linear_scaling_accepted": {"const": false}
        }}
      }}
    },
    {
      "if": {"properties": {"status": {"enum": ["unavailable", "error"]}}},
      "then": {"properties": {
        "decision": {"const": "not_evaluated"}, "actual_backend": {"type": "null"},
        "reason": {"$ref": "#/$defs/reason"}, "samples": {"maxItems": 0},
        "fit": {"type": "null"},
        "acceptance": {"properties": {
          "evaluated": {"const": false}, "accepted": {"const": false},
          "outcome": {"const": "not_evaluated"}
        }},
        "claims": {"properties": {
          "kernel_scope_timing_measured": {"const": false},
          "kernel_scope_initial_linear_scaling_accepted": {"const": false}
        }}
      }}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reason": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "detail": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "clean_worker_reexec", "serialization_overrides_removed_before_runtime_init",
        "serialization_overrides_present_in_worker", "hip_launch_blocking",
        "amd_serialize_kernel", "amd_serialize_copy", "timing_api",
        "host_wall_clock_used_for_acceptance"
      ],
      "properties": {
        "clean_worker_reexec": {"const": true},
        "serialization_overrides_removed_before_runtime_init": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": [
            "HIP_LAUNCH_BLOCKING", "AMD_SERIALIZE_KERNEL", "AMD_SERIALIZE_COPY",
            "CUDA_LAUNCH_BLOCKING"
          ]}
        },
        "serialization_overrides_present_in_worker": {"type": "array", "maxItems": 0},
        "hip_launch_blocking": {"type": "null"},
        "amd_serialize_kernel": {"type": "null"},
        "amd_serialize_copy": {"type": "null"},
        "timing_api": {"const": "hip_event_elapsed_time"},
        "host_wall_clock_used_for_acceptance": {"const": false}
      }
    },
    "harness_identity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "benchmark_script_resource", "benchmark_script_sha256",
        "report_schema_resource", "report_schema_sha256",
        "python_implementation", "python_version", "numpy_version"
      ],
      "properties": {
        "benchmark_script_resource": {
          "const": "scripts/benchmark_engine_v2_rtc_kernel_scaling.py"
        },
        "benchmark_script_sha256": {"$ref": "#/$defs/hash"},
        "report_schema_resource": {
          "const": "src/structural_analysis/schemas/rtc_kernel_scaling_report_v1.schema.json"
        },
        "report_schema_sha256": {"$ref": "#/$defs/hash"},
        "python_implementation": {"type": "string", "minLength": 1},
        "python_version": {
          "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "numpy_version": {"type": "string", "minLength": 1}
      }
    },
    "off_cache_precondition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "hardware_profile_source", "expected_architecture",
        "expected_device_name_token", "reference_cache_bytes",
        "minimum_unique_read_multiple", "reference_compute_units",
        "minimum_blocks_per_compute_unit", "kernel_block_size"
      ],
      "properties": {
        "hardware_profile_source": {"const": "predeclared_rx6900xt_gfx1030"},
        "expected_architecture": {"const": "gfx1030"},
        "expected_device_name_token": {"const": "6900 XT"},
        "reference_cache_bytes": {"const": 134217728},
        "minimum_unique_read_multiple": {"const": 2},
        "reference_compute_units": {"const": 80},
        "minimum_blocks_per_compute_unit": {"const": 8},
        "kernel_block_size": {"const": 256}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sizes", "measurement_order", "measurement_order_policy", "warmup_launches",
        "pilot_launches", "target_batch_ms", "max_batch_launches",
        "stability_repeats", "repeats", "fit_min_n", "fit_max_n",
        "slope_lower_inclusive", "slope_upper_inclusive", "minimum_ols_r2",
        "maximum_coefficient_of_variation",
        "maximum_batch_length_stability_relative_delta",
        "maximum_end_repeat_relative_drift", "bootstrap_replicates",
        "bootstrap_seed", "minimum_free_device_bytes",
        "maximum_payload_fraction_of_free_memory", "fit_regime",
        "fit_regime_rationale", "off_cache_precondition", "end_repeat_definition",
        "automatic_size_downscaling"
      ],
      "properties": {
        "sizes": {
          "type": "array", "minItems": 5, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 715827883}
        },
        "measurement_order": {
          "type": "array", "minItems": 5, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 715827883}
        },
        "measurement_order_policy": {"const": "alternating_low_high_predeclared"},
        "warmup_launches": {"type": "integer", "minimum": 20},
        "pilot_launches": {"type": "integer", "minimum": 1},
        "target_batch_ms": {"type": "number", "minimum": 20},
        "max_batch_launches": {"type": "integer", "minimum": 2},
        "stability_repeats": {"type": "integer", "minimum": 3},
        "repeats": {"type": "integer", "minimum": 3},
        "fit_min_n": {"type": "integer", "minimum": 1},
        "fit_max_n": {"type": "integer", "minimum": 1},
        "slope_lower_inclusive": {"type": "number", "exclusiveMinimum": 0},
        "slope_upper_inclusive": {"type": "number", "exclusiveMinimum": 0},
        "minimum_ols_r2": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_coefficient_of_variation": {"type": "number", "exclusiveMinimum": 0},
        "maximum_batch_length_stability_relative_delta": {
          "type": "number", "exclusiveMinimum": 0
        },
        "maximum_end_repeat_relative_drift": {"type": "number", "exclusiveMinimum": 0},
        "bootstrap_replicates": {"type": "integer", "minimum": 200},
        "bootstrap_seed": {"type": "integer"},
        "minimum_free_device_bytes": {"type": "integer", "minimum": 0},
        "maximum_payload_fraction_of_free_memory": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 0.75
        },
        "fit_regime": {"enum": [
          "predeclared_dram_resident_large_problem", "explicit_user_configured"
        ]},
        "fit_regime_rationale": {"type": "string", "minLength": 1},
        "off_cache_precondition": {"$ref": "#/$defs/off_cache_precondition"},
        "end_repeat_definition": {
          "const": "same_allocation_same_size_after_main_trials_before_correctness_download"
        },
        "automatic_size_downscaling": {"const": false}
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "free_memory_bytes_before", "total_memory_bytes",
        "runtime_version_raw", "driver_version_raw", "capability_receipt_hash",
        "hardware_profile_matched"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "free_memory_bytes_before": {"type": "integer", "minimum": 0},
        "total_memory_bytes": {"type": "integer", "minimum": 1},
        "runtime_version_raw": {"type": "integer", "minimum": 0},
        "driver_version_raw": {"type": "integer", "minimum": 0},
        "capability_receipt_hash": {"$ref": "#/$defs/hash"},
        "hardware_profile_matched": {"type": "boolean"}
      }
    },
    "kernel_identity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "kernel_symbol", "architecture", "source_sha256", "code_object_sha256",
        "identity_hash", "hiprtc_version_major", "hiprtc_version_minor",
        "runtime_library_sha256", "hiprtc_library_sha256"
      ],
      "properties": {
        "kernel_symbol": {"const": "engine_v2_csr_residual_jvp_v1"},
        "architecture": {"type": "string", "pattern": "^gfx[0-9][0-9a-f]{2,15}$"},
        "source_sha256": {"$ref": "#/$defs/hash"},
        "code_object_sha256": {"$ref": "#/$defs/hash"},
        "identity_hash": {"$ref": "#/$defs/hash"},
        "hiprtc_version_major": {"type": "integer", "minimum": 0},
        "hiprtc_version_minor": {"type": "integer", "minimum": 0},
        "runtime_library_sha256": {"$ref": "#/$defs/hash"},
        "hiprtc_library_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "trial": {
      "type": "object", "additionalProperties": false,
      "required": ["trial_index", "batch_elapsed_ms", "per_launch_ms"],
      "properties": {
        "trial_index": {"type": "integer", "minimum": 0},
        "batch_elapsed_ms": {"type": "number", "exclusiveMinimum": 0},
        "per_launch_ms": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": [
        "calibration_index", "launch_count", "median_batch_elapsed_ms",
        "raw_batch_elapsed_ms"
      ],
      "properties": {
        "calibration_index": {"type": "integer", "minimum": 0},
        "launch_count": {"type": "integer", "minimum": 1},
        "median_batch_elapsed_ms": {"type": "number", "exclusiveMinimum": 0},
        "raw_batch_elapsed_ms": {
          "type": "array", "minItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "correctness": {
      "type": "object", "additionalProperties": false,
      "required": [
        "performed_outside_timed_region", "finite", "residual_max_abs_error",
        "residual_relative_l2_error", "jvp_max_abs_error", "jvp_relative_l2_error",
        "absolute_tolerance", "relative_l2_tolerance", "passed"
      ],
      "properties": {
        "performed_outside_timed_region": {"const": true},
        "finite": {"type": "boolean"},
        "residual_max_abs_error": {"type": "number", "minimum": 0},
        "residual_relative_l2_error": {"type": "number", "minimum": 0},
        "jvp_max_abs_error": {"type": "number", "minimum": 0},
        "jvp_relative_l2_error": {"type": "number", "minimum": 0},
        "absolute_tolerance": {"const": 1e-10},
        "relative_l2_tolerance": {"const": 1e-10},
        "passed": {"type": "boolean"}
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": [
        "row_count", "csr_nnz", "fp64_equivalent_operations_per_launch",
        "source_logical_bytes_per_launch", "unique_read_bytes", "resident_touched_bytes",
        "physical_dram_bytes", "grid_block_count", "allocated_device_payload_bytes",
        "allocation_count", "initial_h2d_operation_count", "initial_h2d_bytes",
        "outside_timed_region_d2h_operation_count", "outside_timed_region_d2h_bytes",
