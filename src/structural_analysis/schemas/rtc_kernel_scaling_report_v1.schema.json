      "properties": {
        "evaluated": {"type": "boolean"},
        "accepted": {"type": "boolean"},
        "scope": {"const": "hiprtc_fused_csr_residual_jvp_kernel_only"},
        "slope_lower_inclusive": {"type": "number", "exclusiveMinimum": 0},
