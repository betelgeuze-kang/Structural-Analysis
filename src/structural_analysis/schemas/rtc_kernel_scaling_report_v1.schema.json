        "minimum_ols_r2": {"type": "number", "minimum": 0, "maximum": 1},
        "robust_slope_passed": {"type": "boolean"},
        "ols_slope_passed": {"type": "boolean"},
        "r2_passed": {"type": "boolean"},
        "bootstrap_ci_passed": {"type": "boolean"},
