        "timed_region_d2h_operation_count": {"const": 0},
        "timed_region_allocation_count": {"const": 0},
        "fallback_count": {"const": 0},
        "raw_trials": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/trial"}},
        "median_batch_elapsed_ms": {"type": "number", "exclusiveMinimum": 0},
        "median_per_launch_ms": {"type": "number", "exclusiveMinimum": 0},
        "minimum_per_launch_ms": {"type": "number", "exclusiveMinimum": 0},
        "maximum_per_launch_ms": {"type": "number", "exclusiveMinimum": 0},
        "mean_per_launch_ms": {"type": "number", "exclusiveMinimum": 0},
        "standard_deviation_per_launch_ms": {"type": "number", "minimum": 0},
        "median_absolute_deviation_per_launch_ms": {"type": "number", "minimum": 0},
        "coefficient_of_variation": {"type": "number", "minimum": 0},
        "end_repeat_batch_elapsed_ms": {"type": "number", "exclusiveMinimum": 0},
        "end_repeat_per_launch_ms": {"type": "number", "exclusiveMinimum": 0},
        "end_repeat_relative_drift": {"type": "number", "minimum": 0},
