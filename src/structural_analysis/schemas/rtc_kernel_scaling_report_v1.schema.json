        "source_logical_bytes_per_launch": {"type": "integer", "minimum": 1},
        "unique_read_bytes": {"type": "integer", "minimum": 1},
        "resident_touched_bytes": {"type": "integer", "minimum": 1},
        "physical_dram_bytes": {"const": "not_instrumented"},
        "grid_block_count": {"type": "integer", "minimum": 1},
        "allocated_device_payload_bytes": {"type": "integer", "minimum": 1},
        "allocation_count": {"const": 8},
        "initial_h2d_operation_count": {"const": 6},
        "initial_h2d_bytes": {"type": "integer", "minimum": 1},
        "outside_timed_region_d2h_operation_count": {"const": 2},
        "outside_timed_region_d2h_bytes": {"type": "integer", "minimum": 1},
        "warmup_launch_count": {"type": "integer", "minimum": 20},
        "pilot_launch_count": {"type": "integer", "minimum": 1},
        "pilot_batch_elapsed_ms": {"type": "number", "exclusiveMinimum": 0},
        "calibration_trials": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/calibration"}
        },
        "timed_batch_launch_count": {"type": "integer", "minimum": 1},
        "double_batch_launch_count": {"type": "integer", "minimum": 2},
        "batch_length_stability_k_per_launch_ms": {"type": "number", "exclusiveMinimum": 0},
        "batch_length_stability_2k_per_launch_ms": {"type": "number", "exclusiveMinimum": 0},
        "batch_length_stability_relative_delta": {"type": "number", "minimum": 0},
        "batch_length_stability_k_raw_batch_elapsed_ms": {
          "type": "array", "minItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "batch_length_stability_2k_raw_batch_elapsed_ms": {
          "type": "array", "minItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "timed_trial_count": {"type": "integer", "minimum": 3},
        "fit_trial_kernel_launch_count": {"type": "integer", "minimum": 3},
        "event_timed_kernel_launch_count_total": {"type": "integer", "minimum": 3},
