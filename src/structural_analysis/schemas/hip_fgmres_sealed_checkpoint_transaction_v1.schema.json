{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_fgmres_sealed_checkpoint_transaction_v1.schema.json",
  "title": "HIP FGMRES sealed checkpoint transaction receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "context_id",
    "evidence_scope",
    "actual_backend",
    "promotion_eligible",
    "reason",
    "bindings",
    "dimensions",
    "projection",
    "telemetry",
    "claims",
    "extensions",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-hip-fgmres-sealed-checkpoint-transaction.v1"
    },
    "capability_profile": {
      "const": "phase0_canonical_capability_consuming_sealed_checkpoint_transaction"
    },
    "status": {
      "enum": [
        "context_ready",
        "transaction_pending",
        "fence_observed_ack_pending",
        "transaction_fenced",
        "poisoned_no_work",
        "poisoned_pending_fence",
        "poisoned_fence_observed_ack_pending",
        "poisoned_fenced",
        "context_closed",
        "cleanup_failed"
      ]
    },
    "context_id": {
      "$ref": "#/$defs/hash"
    },
    "evidence_scope": {
      "const": "canonical_capability_consumed_device_outcome_unobserved_non_promoting"
    },
    "actual_backend": {
      "enum": ["hip", "test_double"]
    },
    "promotion_eligible": {
      "const": false
    },
    "reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "detail"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,127}$"
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_predecessor_context_id",
        "canonical_predecessor_receipt_hash",
        "live_context_id",
        "live_opening_receipt_hash",
        "primitive_context_id",
        "primitive_opening_receipt_hash",
        "primitive_evidence_scope",
        "primitive_actual_backend",
        "source_apply_receipt_hash",
        "source_state_hash",
        "recurrence_plan_hash",
        "recurrence_kernel_abi_hash",
        "combined_recurrence_abi_hash",
        "kernel_identity_hash",
        "kernel_source_sha256",
        "kernel_origin",
        "runtime_library_discovery_source",
        "hiprtc_library_discovery_source",
        "canonical_schedule_hash",
        "validator_schedule_hash",
        "checkpoint_schedule_hash",
        "direct_generation_binding_hash",
        "physical_projection_hash",
        "primitive_parent_lease_epoch",
        "solver_child_lease_epoch"
      ],
      "properties": {
        "canonical_predecessor_context_id": {
          "$ref": "#/$defs/hash"
        },
        "canonical_predecessor_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "live_context_id": {
          "$ref": "#/$defs/hash"
        },
        "live_opening_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "primitive_context_id": {
          "$ref": "#/$defs/hash"
        },
        "primitive_opening_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "primitive_evidence_scope": {
          "enum": [
            "native_hiprtc_krylov_primitives_composite",
            "injected_test_double"
          ]
        },
        "primitive_actual_backend": {
          "enum": ["hip", "test_double"]
        },
        "source_apply_receipt_hash": {
          "$ref": "#/$defs/hash"
        },
        "source_state_hash": {
          "$ref": "#/$defs/hash"
        },
        "recurrence_plan_hash": {
          "$ref": "#/$defs/hash"
        },
        "recurrence_kernel_abi_hash": {
          "$ref": "#/$defs/hash"
        },
        "combined_recurrence_abi_hash": {
          "$ref": "#/$defs/hash"
        },
        "kernel_identity_hash": {
          "$ref": "#/$defs/hash"
        },
        "kernel_source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "kernel_origin": {
          "enum": ["internally_compiled", "caller_supplied"]
        },
        "runtime_library_discovery_source": {
          "$ref": "#/$defs/libraryDiscoverySource"
        },
        "hiprtc_library_discovery_source": {
          "$ref": "#/$defs/libraryDiscoverySource"
        },
        "canonical_schedule_hash": {
          "$ref": "#/$defs/hash"
        },
        "validator_schedule_hash": {
          "$ref": "#/$defs/hash"
        },
        "checkpoint_schedule_hash": {
          "$ref": "#/$defs/hash"
        },
        "direct_generation_binding_hash": {
          "$ref": "#/$defs/hash"
        },
        "physical_projection_hash": {
          "$ref": "#/$defs/hash"
        },
        "primitive_parent_lease_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "solver_child_lease_epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_dof_count",
        "restart_dimension",
        "max_iterations",
        "maximum_restart_count",
        "reduction_stage_count",
        "transaction_launch_count",
        "persistent_capability_count",
        "physical_capability_count"
      ],
      "properties": {
        "free_dof_count": {
          "type": "integer",
          "minimum": 1
        },
        "restart_dimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maximum_restart_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "reduction_stage_count": {
          "type": "integer",
          "minimum": 1
        },
        "transaction_launch_count": {
          "const": 4
        },
        "persistent_capability_count": {
          "const": 11
        },
        "physical_capability_count": {
          "const": 16
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistent_roles",
        "delegated_operator_roles",
        "delegated_workspace_roles",
        "pointer_values_serialized",
        "additional_allocation_count",
        "additional_device_bytes",
        "additional_borrow_count",
        "additional_checkpoint_owner_count",
        "additional_module_load_count"
      ],
      "properties": {
        "persistent_roles": {
          "const": [
            "reduced_state",
            "reduced_load",
            "jacobi_inverse",
            "solution_x",
            "true_residual",
            "work_w",
            "basis_v",
            "preconditioned_basis_z",
            "packed_dense_state",
            "fgmres_control_state_v2",
            "solve_record"
          ]
        },
        "delegated_operator_roles": {
          "const": [
            "reduced_csr_row_ptr",
            "reduced_csr_column_indices",
            "reduced_csr_values"
          ]
        },
        "delegated_workspace_roles": {
          "const": ["reduction_ping", "reduction_pong"]
        },
        "pointer_values_serialized": {
          "const": false
        },
        "additional_allocation_count": {
          "const": 0
        },
        "additional_device_bytes": {
          "const": 0
        },
        "additional_borrow_count": {
          "const": 0
        },
        "additional_checkpoint_owner_count": {
          "const": 0
        },
        "additional_module_load_count": {
          "const": 0
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_capability_reservation_count",
        "predecessor_capability_consume_count",
        "kernel_launch_attempt_count",
        "kernel_launch_accept_lower_bound",
        "kernel_launch_accept_upper_bound",
        "fence_attempt_count",
        "fence_success_count",
        "pending_consume_attempt_count",
        "consumed_launch_count",
        "allocation_count",
        "allocation_borrow_count",
        "checkpoint_owner_acquire_count",
        "module_load_count",
        "module_unload_count",
        "h2d_operation_count",
        "d2h_operation_count",
        "intermediate_sync_count",
        "fallback_count"
      ],
      "properties": {
        "predecessor_capability_reservation_count": {
          "const": 1
        },
        "predecessor_capability_consume_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "kernel_launch_attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "kernel_launch_accept_lower_bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "kernel_launch_accept_upper_bound": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "fence_attempt_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "fence_success_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "pending_consume_attempt_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "consumed_launch_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "allocation_count": {
          "const": 0
        },
        "allocation_borrow_count": {
          "const": 0
        },
        "checkpoint_owner_acquire_count": {
          "const": 0
        },
        "module_load_count": {
          "const": 0
        },
        "module_unload_count": {
          "const": 0
        },
        "h2d_operation_count": {
          "const": 0
        },
        "d2h_operation_count": {
          "const": 0
        },
        "intermediate_sync_count": {
          "const": 0
        },
        "fallback_count": {
          "const": 0
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_krylov_parent_bound",
        "canonical_predecessor_capability_reserved",
        "canonical_predecessor_capability_consumed",
        "direct11_physical16_continuity_bound",
        "same_runtime_device_stream_bound",
        "fixed_four_row_program_bound",
        "fixed_four_row_transaction_fenced",
        "device_seal_transition_program_bound",
        "invalid_source_destination_atomicity_contract_bound",
        "conditional_post_checkpoint_capability_issued",
        "device_validation_outcome_host_observed",
        "actual_mask_host_observed",
        "commit_gate_host_observed",
        "checkpoint_commit_host_observed",
        "authoritative_predecessor_proven",
        "authoritative_numerical_transaction_proven",
        "live_solver_ready",
        "solution_ready",
        "later_recurrence_ready",
        "iteration_host_copy_zero_proven",
        "asymptotic_o_n_proven",
        "speedup_proven",
        "commercial_ready",
        "promotion_eligible"
      ],
      "properties": {
        "live_krylov_parent_bound": {
          "type": "boolean"
        },
        "canonical_predecessor_capability_reserved": {
          "type": "boolean"
        },
        "canonical_predecessor_capability_consumed": {
          "type": "boolean"
        },
        "direct11_physical16_continuity_bound": {
          "type": "boolean"
        },
        "same_runtime_device_stream_bound": {
          "type": "boolean"
        },
        "fixed_four_row_program_bound": {
          "type": "boolean"
        },
        "fixed_four_row_transaction_fenced": {
          "type": "boolean"
        },
        "device_seal_transition_program_bound": {
          "type": "boolean"
        },
        "invalid_source_destination_atomicity_contract_bound": {
          "type": "boolean"
        },
        "conditional_post_checkpoint_capability_issued": {
          "type": "boolean"
        },
        "device_validation_outcome_host_observed": {
          "const": false
        },
        "actual_mask_host_observed": {
          "const": false
        },
        "commit_gate_host_observed": {
          "const": false
        },
        "checkpoint_commit_host_observed": {
          "const": false
        },
        "authoritative_predecessor_proven": {
          "const": false
        },
        "authoritative_numerical_transaction_proven": {
          "const": false
        },
        "live_solver_ready": {
          "const": false
        },
        "solution_ready": {
          "const": false
        },
        "later_recurrence_ready": {
          "const": false
        },
        "iteration_host_copy_zero_proven": {
          "const": false
        },
        "asymptotic_o_n_proven": {
          "const": false
        },
        "speedup_proven": {
          "const": false
        },
        "commercial_ready": {
          "const": false
        },
        "promotion_eligible": {
          "const": false
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {},
      "maxProperties": 0
    },
    "receipt_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "libraryDiscoverySource": {
      "enum": ["explicit", "opt_rocm", "system_loader", "injected"]
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  }
}
