{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.dev/schemas/corotational_fiber_frame_j1_j5_adapter_v1.schema.json",
  "title": "Corotational Fiber Frame J1-J5 Adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_hash",
    "compiler_profile",
    "compiler_hash",
    "authority_profile",
    "model_content_hash",
    "problem_contract_hash",
    "case_id",
    "terminal_checkpoint_hash",
    "terminal_load_factor",
    "stage_receipts",
    "authority_axes",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "stateful-corotational-fiber-frame2d-j1-j5-adapter.v1"},
    "adapter_hash": {"$ref": "#/$defs/hash"},
    "compiler_profile": {"const": "planar_one_bay_one_story_portal_explicit_fiber_section.v1"},
    "compiler_hash": {"$ref": "#/$defs/hash"},
    "authority_profile": {"const": "non_promoting_bounded_corotational_convergence_candidate.v1"},
    "model_content_hash": {"$ref": "#/$defs/hash"},
    "problem_contract_hash": {"$ref": "#/$defs/hash"},
    "case_id": {"type": "string", "minLength": 1},
    "terminal_checkpoint_hash": {"$ref": "#/$defs/hash"},
    "terminal_load_factor": {"type": "number"},
    "stage_receipts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/stage"}
    },
    "authority_axes": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {"type": "string"}
    },
    "limitations": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "stage_hash", "contract_profile", "source_hashes", "checks"],
      "properties": {
        "stage": {"enum": ["J1", "J2", "J3", "J4", "J5"]},
        "stage_hash": {"$ref": "#/$defs/hash"},
        "contract_profile": {"type": "string", "minLength": 1},
        "source_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hash"}
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"const": true}
        }
      }
    }
  }
}
