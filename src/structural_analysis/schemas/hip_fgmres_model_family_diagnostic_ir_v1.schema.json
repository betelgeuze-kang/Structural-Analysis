        "registry_validation_cpu_reference_replay_zero_proven": {"const": false},
        "exact_ten_slot_result_ir_v2_ready": {"const": false},
        "all_ten_solution_ready": {"const": false},
        "all_ten_converged": {"const": false},
        "diagnostic_ir_is_solution_result": {"const": false},
        "nonconverged_state_committed": {"const": false},
        "external_gfx1100_diagnostic_ir_verified": {"const": false},
        "full_model_family_diagnostic_ir_verified": {"const": false},
        "process_wide_host_transfer_zero_proven": {"const": false},
        "iteration_host_copy_zero_proven": {"const": false},
        "standalone_receipt_provenance_authenticity": {"const": false},
        "hostile_same_process_mutation_or_interposition_resistance": {
          "const": false
        },
        "signed_evidence": {"const": false},
        "persistent_external_log_verified": {"const": false},
        "performance_or_speedup_proven": {"const": false},
        "end_to_end_o_n_verified": {"const": false},
