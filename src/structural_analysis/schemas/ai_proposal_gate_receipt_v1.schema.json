{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/ai_proposal_gate_receipt_v1.schema.json",
  "title": "Engine v2 Phase 0 AI proposal full-physics gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "gate_id",
    "status",
    "reason_codes",
    "input_bindings",
    "proposal_policy",
    "physics_replay",
    "checks",
    "rollback_proof",
    "authority",
    "gate_receipt_hash",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-ai-proposal-gate-receipt.v1"},
    "capability_profile": {"const": "phase0_cpu_full_physics_initial_guess_gate"},
    "gate_id": {"$ref": "#/$defs/stableId"},
    "status": {"const": "rejected"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reasonCode"}
    },
    "input_bindings": {"$ref": "#/$defs/inputBindings"},
    "proposal_policy": {"$ref": "#/$defs/proposalPolicy"},
    "physics_replay": {"$ref": "#/$defs/physicsReplay"},
    "checks": {"$ref": "#/$defs/checks"},
    "rollback_proof": {"$ref": "#/$defs/rollbackProof"},
    "authority": {"$ref": "#/$defs/authority"},
    "gate_receipt_hash": {"$ref": "#/$defs/sha256"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "finiteNonnegative": {"type": "number", "minimum": 0},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]+$"},
      "additionalProperties": true
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ir_content_hash",
        "solver_numeric_buffer_hash",
        "solver_entity_mapping_hash",
        "solver_artifact_hash",
        "execution_plan_hash",
        "operator_hash",
        "pattern_hash",
        "partition_hash",
        "accepted_state_hash",
        "accepted_displacement_hash",
        "accepted_state_epoch",
        "proposal_hash",
        "projection_hash"
      ],
      "properties": {
        "model_ir_content_hash": {"$ref": "#/$defs/sha256"},
        "solver_numeric_buffer_hash": {"$ref": "#/$defs/sha256"},
        "solver_entity_mapping_hash": {"$ref": "#/$defs/sha256"},
        "solver_artifact_hash": {"$ref": "#/$defs/sha256"},
        "execution_plan_hash": {"$ref": "#/$defs/sha256"},
        "operator_hash": {"$ref": "#/$defs/sha256"},
        "pattern_hash": {"$ref": "#/$defs/sha256"},
        "partition_hash": {"$ref": "#/$defs/sha256"},
        "accepted_state_hash": {"$ref": "#/$defs/sha256"},
        "accepted_displacement_hash": {"$ref": "#/$defs/sha256"},
        "accepted_state_epoch": {"type": "integer", "minimum": 0},
        "proposal_hash": {"$ref": "#/$defs/sha256"},
        "projection_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "proposalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook",
        "target_vector_space",
        "free_dof_count",
        "retained_rank",
        "rank_cap",
        "basis_gram_condition",
        "max_basis_gram_condition",
        "trust_radius",
        "trust_coordinate_units",
        "coefficient_l2_norm",
        "correction_scaled_l2_norm",
        "ood_status",
        "statistical_calibration",
        "ood_policy"
      ],
      "properties": {
        "hook": {"const": "initial_guess"},
        "target_vector_space": {"const": "scaled_reduced_free_dof"},
        "free_dof_count": {"type": "integer", "minimum": 1},
        "retained_rank": {"type": "integer", "minimum": 1},
        "rank_cap": {"type": "integer", "minimum": 1, "maximum": 16},
        "basis_gram_condition": {"type": "number", "exclusiveMinimum": 0},
        "max_basis_gram_condition": {"const": 1.00000001},
        "trust_radius": {"type": "number", "exclusiveMinimum": 0},
        "trust_coordinate_units": {"const": "sqrt_joule_energy_coordinate"},
        "coefficient_l2_norm": {"$ref": "#/$defs/finiteNonnegative"},
        "correction_scaled_l2_norm": {"$ref": "#/$defs/finiteNonnegative"},
        "ood_status": {"const": "not_evaluated"},
        "statistical_calibration": {"const": false},
        "ood_policy": {"const": "require_in_distribution_and_statistically_calibrated"}
      }
    },
    "physicsReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "residual_sign",
        "scaled_residual_definition",
        "constitutive_mode",
        "load_scale",
        "base_residual_hash",
        "trial_residual_hash",
        "base_constitutive_internal_force_hash",
        "trial_constitutive_internal_force_hash",
        "trial_displacement_hash",
        "ephemeral_trial_state_hash",
        "base_full_residual_linf",
        "trial_full_residual_linf",
        "base_free_residual_linf",
        "trial_free_residual_linf",
        "base_scaled_free_residual",
        "trial_scaled_free_residual",
        "scaled_free_residual_reduction",
        "scaled_free_residual_reduction_ratio",
        "base_total_potential_energy_j",
        "trial_total_potential_energy_j",
        "potential_energy_change_j",
        "constrained_increment_linf",
        "constitutive_operator_consistency_linf",
        "constitutive_energy_consistency_abs_j",
        "constitutive_force_tolerance",
        "constitutive_energy_tolerance_j"
      ],
      "properties": {
        "residual_sign": {"const": "internal_minus_external"},
        "scaled_residual_definition": {"const": "l2_of_D_times_free_residual_D_equals_inv_sqrt_diag_Kff"},
        "constitutive_mode": {"const": "stateless_linear_elastic"},
        "load_scale": {"type": "number", "minimum": 1},
        "base_residual_hash": {"$ref": "#/$defs/sha256"},
        "trial_residual_hash": {"$ref": "#/$defs/sha256"},
        "base_constitutive_internal_force_hash": {"$ref": "#/$defs/sha256"},
        "trial_constitutive_internal_force_hash": {"$ref": "#/$defs/sha256"},
        "trial_displacement_hash": {"$ref": "#/$defs/sha256"},
        "ephemeral_trial_state_hash": {"$ref": "#/$defs/sha256"},
        "base_full_residual_linf": {"$ref": "#/$defs/finiteNonnegative"},
        "trial_full_residual_linf": {"$ref": "#/$defs/finiteNonnegative"},
        "base_free_residual_linf": {"$ref": "#/$defs/finiteNonnegative"},
        "trial_free_residual_linf": {"$ref": "#/$defs/finiteNonnegative"},
        "base_scaled_free_residual": {"$ref": "#/$defs/finiteNonnegative"},
        "trial_scaled_free_residual": {"$ref": "#/$defs/finiteNonnegative"},
        "scaled_free_residual_reduction": {"type": "number"},
        "scaled_free_residual_reduction_ratio": {"type": "number"},
        "base_total_potential_energy_j": {"type": "number"},
        "trial_total_potential_energy_j": {"type": "number"},
        "potential_energy_change_j": {"type": "number"},
        "constrained_increment_linf": {"$ref": "#/$defs/finiteNonnegative"},
        "constitutive_operator_consistency_linf": {"$ref": "#/$defs/finiteNonnegative"},
        "constitutive_energy_consistency_abs_j": {"$ref": "#/$defs/finiteNonnegative"},
        "constitutive_force_tolerance": {"$ref": "#/$defs/finiteNonnegative"},
        "constitutive_energy_tolerance_j": {"$ref": "#/$defs/finiteNonnegative"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_contract_valid",
        "plan_state_proposal_binding_pass",
        "initial_guess_hook_pass",
        "free_vector_space_pass",
        "trust_budget_pass",
        "rank_budget_pass",
        "condition_pass",
        "ood_policy_pass",
        "full_residual_replayed",
        "stateless_linear_elastic_constitutive_replayed",
        "constitutive_admissibility_pass",
        "free_scaled_residual_reduced",
        "total_potential_energy_nonincrease",
        "constrained_increment_exact_zero",
        "rollback_exact",
        "accepted_state_preserved",
        "eligible_initial_guess"
      ],
      "properties": {
        "proposal_contract_valid": {"const": true},
        "plan_state_proposal_binding_pass": {"const": true},
        "initial_guess_hook_pass": {"type": "boolean"},
        "free_vector_space_pass": {"type": "boolean"},
        "trust_budget_pass": {"type": "boolean"},
        "rank_budget_pass": {"type": "boolean"},
        "condition_pass": {"type": "boolean"},
        "ood_policy_pass": {"const": false},
        "full_residual_replayed": {"const": true},
        "stateless_linear_elastic_constitutive_replayed": {"type": "boolean"},
        "constitutive_admissibility_pass": {"type": "boolean"},
        "free_scaled_residual_reduced": {"type": "boolean"},
        "total_potential_energy_nonincrease": {"type": "boolean"},
        "constrained_increment_exact_zero": {"type": "boolean"},
        "rollback_exact": {"const": true},
        "accepted_state_preserved": {"const": true},
        "eligible_initial_guess": {"const": false}
      }
    },
    "rollbackProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_state_hash_before",
        "accepted_state_hash_after",
        "accepted_state_object_identity_preserved",
        "accepted_displacement_hash_before",
        "accepted_displacement_hash_after",
        "rollback_returned_exact_accepted_object",
        "trial_committed",
        "state_commit_count"
      ],
      "properties": {
        "accepted_state_hash_before": {"$ref": "#/$defs/sha256"},
        "accepted_state_hash_after": {"$ref": "#/$defs/sha256"},
        "accepted_state_object_identity_preserved": {"const": true},
        "accepted_displacement_hash_before": {"$ref": "#/$defs/sha256"},
        "accepted_displacement_hash_after": {"$ref": "#/$defs/sha256"},
        "rollback_returned_exact_accepted_object": {"const": true},
        "trial_committed": {"const": false},
        "state_commit_count": {"const": 0}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_use",
        "proposal_consumed_by_authoritative_solver",
        "commit_performed",
        "final_result",
        "authoritative_result",
        "speed_claim_allowed"
      ],
      "properties": {
        "eligible_use": {"const": "initial_guess_only"},
        "proposal_consumed_by_authoritative_solver": {"const": false},
        "commit_performed": {"const": false},
        "final_result": {"const": false},
        "authoritative_result": {"const": false},
        "speed_claim_allowed": {"const": false}
      }
    }
  }
}
