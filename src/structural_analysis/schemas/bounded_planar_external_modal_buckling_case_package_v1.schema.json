{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/bounded_planar_external_modal_buckling_case_package_v1.schema.json",
  "title": "Bounded planar external modal/buckling package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "source_commit_sha", "source_files", "external_result_schema", "python_requirements", "operator_readme", "execution_workflow", "cases", "summary", "claims", "contract_pass", "blockers", "claim_boundary", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "bounded-planar-external-modal-buckling-case-package.v1"},
    "package_id": {"const": "bounded-planar-modal-buckling-v1"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_files": {"type": "object", "minProperties": 10, "additionalProperties": {"$ref": "#/$defs/sha"}},
    "external_result_schema": {"$ref": "#/$defs/file"},
    "python_requirements": {"$ref": "#/$defs/file"},
    "operator_readme": {"$ref": "#/$defs/file"},
    "execution_workflow": {"$ref": "#/$defs/file"},
    "cases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/rigidCase"},
        {"$ref": "#/$defs/repeatedCase"},
        {"$ref": "#/$defs/portalCase"}
      ],
      "items": false
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["case_count", "product_ready_count", "external_ready_count"],
      "properties": {"case_count": {"const": 3}, "product_ready_count": {"const": 3}, "external_ready_count": {"const": 0}}
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_canonical_model_inputs", "current_product_replay", "external_runner_syntax_checked", "runtime_dependencies_pinned", "output_authenticity_contract", "external_solver_execution", "external_reference_attached", "verification_matrix_credit", "verification_level_2"],
      "properties": {
        "exact_canonical_model_inputs": {"const": true},
        "current_product_replay": {"const": true},
        "external_runner_syntax_checked": {"const": true},
        "runtime_dependencies_pinned": {"const": true},
        "output_authenticity_contract": {"const": true},
        "external_solver_execution": {"const": false},
        "external_reference_attached": {"const": false},
        "verification_matrix_credit": {"const": false},
        "verification_level_2": {"const": false}
      }
    },
    "contract_pass": {"const": true},
    "blockers": {"type": "array", "contains": {"const": "external_runtime_execution_missing"}, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "claim_boundary": {"type": "string", "minLength": 120},
    "artifact_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "file_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "file_sha256": {"$ref": "#/$defs/sha"}}},
    "json": {"type": "object", "additionalProperties": false, "required": ["path", "file_sha256", "artifact_hash"], "properties": {"path": {"type": "string", "minLength": 1}, "file_sha256": {"$ref": "#/$defs/sha"}, "artifact_hash": {"$ref": "#/$defs/sha"}}},
    "caseBase": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "requirement_id", "analysis_type", "external_solver", "model", "external_runner", "product_result", "current_product_contract_pass", "external_execution_status", "external_reference_attached", "blockers"],
      "properties": {
        "case_id": {"type": "string"}, "requirement_id": {"type": "string"},
        "analysis_type": {"enum": ["modal", "linear_buckling"]}, "external_solver": {"enum": ["OpenSees", "CalculiX"]},
        "model": {"$ref": "#/$defs/json"}, "external_runner": {"$ref": "#/$defs/file"}, "product_result": {"$ref": "#/$defs/json"},
        "current_product_contract_pass": {"const": true}, "external_execution_status": {"const": "unavailable"},
        "external_reference_attached": {"const": false},
        "blockers": {"type": "array", "contains": {"const": "external_runtime_execution_missing"}, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "rigidCase": {"$ref": "#/$defs/caseBase", "properties": {"case_id": {"const": "bounded_planar_modal_rigid_mode"}, "requirement_id": {"const": "modal.rigid_mode"}, "analysis_type": {"const": "modal"}, "external_solver": {"const": "OpenSees"}}},
    "repeatedCase": {"$ref": "#/$defs/caseBase", "properties": {"case_id": {"const": "bounded_planar_modal_repeated_mode"}, "requirement_id": {"const": "modal.repeated_mode"}, "analysis_type": {"const": "modal"}, "external_solver": {"const": "OpenSees"}}},
    "portalCase": {"$ref": "#/$defs/caseBase", "properties": {"case_id": {"const": "bounded_planar_buckling_portal"}, "requirement_id": {"const": "buckling.portal"}, "analysis_type": {"const": "linear_buckling"}, "external_solver": {"const": "CalculiX"}}}
  }
}
