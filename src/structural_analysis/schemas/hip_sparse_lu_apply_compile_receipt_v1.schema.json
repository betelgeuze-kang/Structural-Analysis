{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_sparse_lu_apply_compile_receipt_v1.schema.json",
  "title": "Engine v2 HIP sparse-LU dual-target compile and host-parse receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_hash",
    "generated_at",
    "status",
    "contract_pass",
    "contract_scope",
    "source",
    "compiler",
    "targets",
    "claims",
    "blockers_remaining",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "engine-v2-hip-sparse-lu-apply-target-compile-host-parse-receipt.v1"
    },
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "partial"},
    "contract_pass": {"const": true},
    "contract_scope": {
      "const": "target_compile_and_host_fixture_parser_only"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_base_commit_sha",
        "worktree_clean",
        "exact_source_commit_claim",
        "input_checksums"
      ],
      "properties": {
        "repository_base_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_clean": {"type": "boolean"},
        "exact_source_commit_claim": {"const": false},
        "input_checksums": {
          "type": "object",
          "minProperties": 7,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version_first_line", "version_output_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version_first_line": {"type": "string", "minLength": 1},
        "version_output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "target_compile",
          "binary_sha256",
          "binary_byte_length",
          "host_fixture_parser_execution",
          "host_fixture_validation"
        ],
        "properties": {
          "architecture": {"enum": ["gfx1030", "gfx1100"]},
          "target_compile": {"const": true},
          "binary_sha256": {"$ref": "#/$defs/sha256"},
          "binary_byte_length": {"type": "integer", "minimum": 10000},
          "host_fixture_parser_execution": {"const": true},
          "host_fixture_validation": {
            "$ref": "#/$defs/host_fixture_validation"
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_target_compile",
        "gfx1030_target_compile",
        "gfx1100_target_compile",
        "dual_target_host_fixture_parser_execution",
        "actual_hardware_execution",
        "numerical_parity",
        "actual_mgt_factor_apply",
        "production_scale_factor_apply",
        "production_current_tangent_fgmres",
        "performance"
      ],
      "properties": {
        "declared_target_compile": {"const": true},
        "gfx1030_target_compile": {"const": true},
        "gfx1100_target_compile": {"const": true},
        "dual_target_host_fixture_parser_execution": {"const": true},
        "actual_hardware_execution": {"const": false},
        "numerical_parity": {"const": false},
        "actual_mgt_factor_apply": {"const": false},
        "production_scale_factor_apply": {"const": false},
        "production_current_tangent_fgmres": {"const": false},
        "performance": {"const": false}
      }
    },
    "blockers_remaining": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {"type": "string", "minLength": 100}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "host_fixture_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "contract_pass",
        "fixture_hash",
        "runtime_output_hash",
        "dimension",
        "fixture_byte_length",
        "actual_hardware_execution",
        "hip_runtime_api_call_count"
      ],
      "properties": {
        "profile": {
          "const": "engine-v2-hip-sparse-lu-host-fixture-parser.v1"
        },
        "contract_pass": {"const": true},
        "fixture_hash": {"$ref": "#/$defs/sha256"},
        "runtime_output_hash": {"$ref": "#/$defs/sha256"},
        "dimension": {"const": 8},
        "fixture_byte_length": {"type": "integer", "minimum": 1000},
        "actual_hardware_execution": {"const": false},
        "hip_runtime_api_call_count": {"const": 0}
      }
    }
  }
}
