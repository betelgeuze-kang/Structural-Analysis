{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_hash",
    "generated_at",
    "status",
    "contract_pass",
    "public_product_promotion_passed",
    "aggregate_source",
    "trusted_signer_policy_anchor_count",
    "stage_count",
    "required_surface_count_per_stage",
    "self_verified_stage_count",
    "vertical_stage_contract_pass_count",
    "recorded_public_product_promotion_count",
    "current_source_bound_stage_count",
    "cryptographically_verified_stage_count",
    "independently_signed_stage_count",
    "stage_rows",
    "claims",
    "blockers_remaining",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "f3-external-vv-signature-status.v2"},
    "receipt_hash": {"$ref": "#/$defs/hash"},
    "generated_at": {"type": "string"},
    "status": {"const": "partial"},
    "contract_pass": {"const": true},
    "public_product_promotion_passed": {"const": false},
    "aggregate_source": {"$ref": "#/$defs/aggregateSource"},
    "trusted_signer_policy_anchor_count": {"const": 0},
    "stage_count": {"const": 10},
    "required_surface_count_per_stage": {"const": 9},
    "self_verified_stage_count": {"const": 10},
    "vertical_stage_contract_pass_count": {"const": 10},
    "recorded_public_product_promotion_count": {"const": 0},
    "current_source_bound_stage_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "cryptographically_verified_stage_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "independently_signed_stage_count": {"const": 0},
    "stage_rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/stageRow"}
    },
    "claims": {
      "type": "object",
      "required": [
        "ten_stage_nine_surface_self_verification",
        "all_vertical_stage_contracts_passed",
        "no_stage_self_promoted",
        "signature_verification_adapter_available",
        "all_canonical_stage_receipts_bound",
        "all_stage_sources_ancestral",
        "all_stage_inputs_match_recorded_sources",
        "all_stage_inputs_match_aggregate_source",
        "trusted_signer_policy_configured",
        "planar_product_replay_prerequisite_bound",
        "planar_external_vv_prerequisite_bound",
        "all_independent_external_vv_signatures_verified",
        "f3_signed_promotion_closure"
      ],
      "properties": {
        "ten_stage_nine_surface_self_verification": {"const": true},
        "all_vertical_stage_contracts_passed": {"const": true},
        "no_stage_self_promoted": {"const": true},
        "signature_verification_adapter_available": {"const": true},
        "all_canonical_stage_receipts_bound": {"type": "boolean"},
        "all_stage_sources_ancestral": {"type": "boolean"},
        "all_stage_inputs_match_recorded_sources": {"type": "boolean"},
        "all_stage_inputs_match_aggregate_source": {"type": "boolean"},
        "trusted_signer_policy_configured": {"const": false},
        "planar_product_replay_prerequisite_bound": {"const": false},
        "planar_external_vv_prerequisite_bound": {"const": false},
        "all_independent_external_vv_signatures_verified": {"const": false},
        "f3_signed_promotion_closure": {"const": false}
      },
      "additionalProperties": false
    },
    "blockers_remaining": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {"type": "string", "minLength": 160}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableHash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "treeOid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "sourceArtifact": {
      "type": "object",
      "required": ["path", "committed_sha256", "worktree_sha256", "worktree_matches_committed_blob"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "committed_sha256": {"$ref": "#/$defs/nullableHash"},
        "worktree_sha256": {"$ref": "#/$defs/nullableHash"},
        "worktree_matches_committed_blob": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "aggregateSource": {
      "type": "object",
      "required": ["source_commit_sha", "source_tree_oid", "source_commit_is_ancestor_of_head", "builder", "schema", "exact_source_binding"],
      "properties": {
        "source_commit_sha": {"$ref": "#/$defs/commit"},
        "source_tree_oid": {"$ref": "#/$defs/treeOid"},
        "source_commit_is_ancestor_of_head": {"type": "boolean"},
        "builder": {"$ref": "#/$defs/sourceArtifact"},
        "schema": {"$ref": "#/$defs/sourceArtifact"},
        "exact_source_binding": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stageRow": {
      "type": "object",
      "required": [
        "stage",
        "stage_index",
        "stage_source_commit_sha",
        "stage_source_tree_oid",
        "stage_receipt_path",
        "stage_receipt_sha256",
        "aggregate_tree_stage_receipt_sha256",
        "external_vv_artifact_sha256",
        "vertical_stage_contract_passed",
        "recorded_public_product_promotion_passed",
        "stage_technical_blockers",
        "stage_promotion_blockers",
        "recorded_signature_status",
        "signature_envelope_path",
        "signature_envelope_receipt_hash",
        "organization_id",
        "signer_id",
        "public_key_sha256",
        "independence_authority_receipt_sha256",
        "cryptographic_signature_valid",
        "trusted_signer_allowlisted",
        "independence_authority_bound",
        "signature_source_matches_aggregate",
        "stage_source_is_ancestor",
        "canonical_stage_receipt_bound",
        "recorded_source_inputs_match",
        "aggregate_source_inputs_match",
        "recorded_source_mismatch_paths",
        "aggregate_source_mismatch_paths",
        "predecessor_binding_pass",
        "predecessor_semantic_hash_recomputed",
        "predecessor_semantic_hash_matches",
        "current_source_binding_pass",
        "independent_signature_verified"
      ],
      "properties": {
        "stage": {"enum": ["frame3d_linear", "frame3d_load_control", "frame3d_direct_control", "frame3d_stateful_material", "modal_buckling", "sdof_authenticated_transient", "mdof_linear_transient", "nonlinear_mdof", "shell", "contact"]},
        "stage_index": {"type": "integer", "minimum": 0, "maximum": 9},
        "stage_source_commit_sha": {"$ref": "#/$defs/commit"},
        "stage_source_tree_oid": {"$ref": "#/$defs/treeOid"},
        "stage_receipt_path": {"type": "string", "minLength": 1},
        "stage_receipt_sha256": {"$ref": "#/$defs/hash"},
        "aggregate_tree_stage_receipt_sha256": {"$ref": "#/$defs/nullableHash"},
        "external_vv_artifact_sha256": {"$ref": "#/$defs/hash"},
        "vertical_stage_contract_passed": {"const": true},
        "recorded_public_product_promotion_passed": {"const": false},
        "stage_technical_blockers": {"type": "array", "maxItems": 0},
        "stage_promotion_blockers": {"$ref": "#/$defs/stringList"},
        "recorded_signature_status": {"enum": ["waived", "verified", "unverified", "absent"]},
        "signature_envelope_path": {"type": "string", "minLength": 1},
        "signature_envelope_receipt_hash": {"$ref": "#/$defs/nullableHash"},
        "organization_id": {"type": ["string", "null"]},
        "signer_id": {"type": ["string", "null"]},
        "public_key_sha256": {"$ref": "#/$defs/nullableHash"},
        "independence_authority_receipt_sha256": {"$ref": "#/$defs/nullableHash"},
        "cryptographic_signature_valid": {"type": "boolean"},
        "trusted_signer_allowlisted": {"type": "boolean"},
        "independence_authority_bound": {"type": "boolean"},
        "signature_source_matches_aggregate": {"type": "boolean"},
        "stage_source_is_ancestor": {"type": "boolean"},
        "canonical_stage_receipt_bound": {"type": "boolean"},
        "recorded_source_inputs_match": {"type": "boolean"},
        "aggregate_source_inputs_match": {"type": "boolean"},
        "recorded_source_mismatch_paths": {"$ref": "#/$defs/stringList"},
        "aggregate_source_mismatch_paths": {"$ref": "#/$defs/stringList"},
        "predecessor_binding_pass": {"type": "boolean"},
        "predecessor_semantic_hash_recomputed": {"type": ["boolean", "null"]},
        "predecessor_semantic_hash_matches": {"type": ["boolean", "null"]},
        "current_source_binding_pass": {"type": "boolean"},
        "independent_signature_verified": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
