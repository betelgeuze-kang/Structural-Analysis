{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/model_ir_v2.schema.json",
  "title": "Structural Analysis ModelIR v2",
  "description": "Backend-neutral, fail-closed structural model contract for Engine v2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "capability_profile",
    "provenance",
    "units",
    "coordinate_system",
    "dof_components",
    "nodes",
    "materials",
    "sections",
    "elements",
    "constraints",
    "load_patterns",
    "load_combinations",
    "time_functions",
    "construction_stages",
    "roundtrip_map",
    "unsupported_features",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-model-ir.v2"},
    "model_id": {"$ref": "#/$defs/stableId"},
    "capability_profile": {
      "enum": [
        "engine_v2_phase0_linear_3d",
        "frame3d_stateful_nonlinear_3d_v1"
      ]
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "units": {"$ref": "#/$defs/canonicalUnits"},
    "coordinate_system": {"$ref": "#/$defs/coordinateSystem"},
    "dof_components": {"const": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/material"}
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/element"}
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fixedDofConstraint"}
    },
    "load_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/loadPattern"}
    },
    "load_combinations": {
      "type": "array",
      "items": {"$ref": "#/$defs/loadCombination"}
    },
    "time_functions": {
      "type": "array",
      "items": {"$ref": "#/$defs/timeFunction"}
    },
    "construction_stages": {
      "type": "array",
      "items": {"$ref": "#/$defs/constructionStage"}
    },
    "roundtrip_map": {
      "type": "array",
      "items": {"$ref": "#/$defs/roundtripRow"}
    },
    "unsupported_features": {
      "type": "array",
      "items": {"$ref": "#/$defs/unsupportedFeature"}
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonNegativeIndex": {"type": "integer", "minimum": 0},
    "nonNegativeNumber": {"type": "number", "minimum": 0},
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "dof": {
      "enum": ["UX", "UY", "UZ", "RX", "RY", "RZ"]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": true
    },
    "sourceUnits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "force", "mass", "time", "rotation"],
      "properties": {
        "length": {"enum": ["m", "mm", "cm", "ft", "in"]},
        "force": {"enum": ["N", "kN", "MN", "lbf", "kip"]},
        "mass": {"enum": ["kg", "tonne", "slug"]},
        "time": {"enum": ["s"]},
        "rotation": {"enum": ["rad", "deg"]}
      }
    },
    "unitScales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length_to_m", "force_to_n", "mass_to_kg", "time_to_s", "rotation_to_rad"],
      "properties": {
        "length_to_m": {"$ref": "#/$defs/positiveNumber"},
        "force_to_n": {"$ref": "#/$defs/positiveNumber"},
        "mass_to_kg": {"$ref": "#/$defs/positiveNumber"},
        "time_to_s": {"$ref": "#/$defs/positiveNumber"},
        "rotation_to_rad": {"$ref": "#/$defs/positiveNumber"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_format",
        "source_ref",
        "source_sha256",
        "normalizer_id",
        "normalizer_version",
        "source_units",
        "unit_scales_to_si"
      ],
      "properties": {
        "source_format": {
          "enum": ["neutral_json", "midas_mgt", "ifc", "opensees", "etabs_e2k", "dxf", "generated"]
        },
        "source_ref": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "normalizer_id": {"$ref": "#/$defs/stableId"},
        "normalizer_version": {"type": "string", "minLength": 1},
        "source_units": {"$ref": "#/$defs/sourceUnits"},
        "unit_scales_to_si": {"$ref": "#/$defs/unitScales"},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "canonicalUnits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "force", "mass", "time", "rotation"],
      "properties": {
        "length": {"const": "m"},
        "force": {"const": "N"},
        "mass": {"const": "kg"},
        "time": {"const": "s"},
        "rotation": {"const": "rad"}
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "axis_order", "up_axis", "handedness", "origin_m"],
      "properties": {
        "frame_id": {"const": "global"},
        "axis_order": {"const": ["X", "Y", "Z"]},
        "up_axis": {"const": "Z"},
        "handedness": {"const": "right"},
        "origin_m": {"$ref": "#/$defs/vector3"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "coordinates_m", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "coordinates_m": {"$ref": "#/$defs/vector3"},
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "material": {
      "oneOf": [
        {"$ref": "#/$defs/linearElasticMaterial"},
        {"$ref": "#/$defs/bilinearCombinedHardeningSteelMaterial"}
      ]
    },
    "linearElasticMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "law_id", "parameter_set_version", "parameters", "state_schema", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "law_id": {"const": "linear_elastic_isotropic"},
        "parameter_set_version": {"const": "1"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["elastic_modulus_pa", "poisson_ratio", "density_kg_m3"],
          "properties": {
            "elastic_modulus_pa": {"$ref": "#/$defs/positiveNumber"},
            "poisson_ratio": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5},
            "density_kg_m3": {"type": "number", "minimum": 0}
          }
        },
        "state_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stateful", "state_update_epoch", "supports_trial_commit_rollback"],
          "properties": {
            "stateful": {"const": false},
            "state_update_epoch": {"const": "none"},
            "supports_trial_commit_rollback": {"const": true}
          }
        },
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "bilinearCombinedHardeningSteelMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "law_id", "parameter_set_version", "parameters", "state_schema", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "law_id": {"const": "bilinear_combined_hardening_steel"},
        "parameter_set_version": {"const": "1"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "elastic_modulus_pa",
            "poisson_ratio",
            "density_kg_m3",
            "yield_stress_pa",
            "isotropic_hardening_modulus_pa",
            "kinematic_hardening_modulus_pa"
          ],
          "properties": {
            "elastic_modulus_pa": {"$ref": "#/$defs/positiveNumber"},
            "poisson_ratio": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5},
            "density_kg_m3": {"$ref": "#/$defs/nonNegativeNumber"},
            "yield_stress_pa": {"$ref": "#/$defs/positiveNumber"},
            "isotropic_hardening_modulus_pa": {"$ref": "#/$defs/nonNegativeNumber"},
            "kinematic_hardening_modulus_pa": {"$ref": "#/$defs/nonNegativeNumber"}
          }
        },
        "state_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stateful", "state_update_epoch", "supports_trial_commit_rollback"],
          "properties": {
            "stateful": {"const": true},
            "state_update_epoch": {"const": "accepted_state"},
            "supports_trial_commit_rollback": {"const": true}
          }
        },
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "frameSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "family_id", "parameter_set_version", "parameters", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "family_id": {"const": "frame_3d"},
        "parameter_set_version": {"const": "1"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["area_m2", "iy_m4", "iz_m4", "torsional_constant_m4", "shear_area_y_m2", "shear_area_z_m2"],
          "properties": {
            "area_m2": {"$ref": "#/$defs/positiveNumber"},
            "iy_m4": {"$ref": "#/$defs/positiveNumber"},
            "iz_m4": {"$ref": "#/$defs/positiveNumber"},
            "torsional_constant_m4": {"$ref": "#/$defs/positiveNumber"},
            "shear_area_y_m2": {"$ref": "#/$defs/positiveNumber"},
            "shear_area_z_m2": {"$ref": "#/$defs/positiveNumber"}
          }
        },
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "trussSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "family_id", "parameter_set_version", "parameters", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "family_id": {"const": "truss_3d"},
        "parameter_set_version": {"const": "1"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["area_m2"],
          "properties": {
            "area_m2": {"$ref": "#/$defs/positiveNumber"}
          }
        },
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "section": {
      "oneOf": [
        {"$ref": "#/$defs/frameSection"},
        {"$ref": "#/$defs/trussSection"}
      ]
    },
    "elementOffsets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["i_global_m", "j_global_m"],
      "properties": {
        "i_global_m": {"$ref": "#/$defs/vector3"},
        "j_global_m": {"$ref": "#/$defs/vector3"}
      }
    },
    "elementReleases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["i", "j"],
      "properties": {
        "i": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dof"}},
        "j": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dof"}}
      }
    },
    "frameElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "type", "formulation", "node_ids", "material_id", "section_id", "local_axis_rotation_rad", "offsets", "releases", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "type": {"const": "frame_3d"},
        "formulation": {"const": "euler_bernoulli_3d"},
        "node_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/stableId"}},
        "material_id": {"$ref": "#/$defs/stableId"},
        "section_id": {"$ref": "#/$defs/stableId"},
        "local_axis_rotation_rad": {"type": "number"},
        "offsets": {"$ref": "#/$defs/elementOffsets"},
        "releases": {"$ref": "#/$defs/elementReleases"},
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "trussElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "type", "formulation", "node_ids", "material_id", "section_id", "offsets", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "type": {"const": "truss_3d"},
        "formulation": {"const": "linear_truss_3d"},
        "node_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/stableId"}},
        "material_id": {"$ref": "#/$defs/stableId"},
        "section_id": {"$ref": "#/$defs/stableId"},
        "offsets": {"$ref": "#/$defs/elementOffsets"},
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "element": {
      "oneOf": [
        {"$ref": "#/$defs/frameElement"},
        {"$ref": "#/$defs/trussElement"}
      ]
    },
    "fixedDofConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "type", "node_id", "dofs", "prescribed_values_si", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "type": {"const": "fixed_dofs"},
        "node_id": {"$ref": "#/$defs/stableId"},
        "dofs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/dof"}},
        "prescribed_values_si": {
          "type": "object",
          "propertyNames": {"enum": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
          "additionalProperties": {"type": "number"}
        },
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "nodalLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "node_id", "components_si", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "node_id": {"$ref": "#/$defs/stableId"},
        "components_si": {
          "type": "object",
          "additionalProperties": false,
          "required": ["FX", "FY", "FZ", "MX", "MY", "MZ"],
          "properties": {
            "FX": {"type": "number"},
            "FY": {"type": "number"},
            "FZ": {"type": "number"},
            "MX": {"type": "number"},
            "MY": {"type": "number"},
            "MZ": {"type": "number"}
          }
        },
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "loadPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "analysis_type", "self_weight", "nodal_loads", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "analysis_type": {"enum": ["linear_static", "nonlinear_static"]},
        "self_weight": {"$ref": "#/$defs/vector3"},
        "nodal_loads": {"type": "array", "items": {"$ref": "#/$defs/nodalLoad"}},
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "combinationTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "ref_kind", "factor"],
      "properties": {
        "ref_id": {"$ref": "#/$defs/stableId"},
        "ref_kind": {"enum": ["load_pattern", "load_combination"]},
        "factor": {"type": "number"}
      }
    },
    "loadCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "combination_type", "terms", "source_id", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "combination_type": {"const": "linear"},
        "terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/combinationTerm"}},
        "source_id": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "timeFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "type", "points", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "type": {"const": "piecewise_linear"},
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number"}
          }
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "constructionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "active_element_ids", "active_constraint_ids", "load_pattern_ids", "extensions"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "index": {"$ref": "#/$defs/nonNegativeIndex"},
        "active_element_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "active_constraint_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "load_pattern_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "roundtripRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_entity_id", "entity_kind", "model_ir_entity_id", "mapping_status", "extensions"],
      "properties": {
        "source_entity_id": {"type": "string", "minLength": 1},
        "entity_kind": {"enum": ["node", "material", "section", "element", "constraint", "load_pattern", "load_combination", "time_function", "construction_stage"]},
        "model_ir_entity_id": {"$ref": "#/$defs/stableId"},
        "mapping_status": {"enum": ["exact", "canonicalized", "approximated", "unsupported"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "unsupportedFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "kind", "source_entity_id", "disposition", "blocking", "detail", "extensions"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/stableId"},
        "kind": {"type": "string", "minLength": 1},
        "source_entity_id": {"type": ["string", "null"]},
        "disposition": {"enum": ["blocked", "partial_import", "approximated", "preserved_only"]},
        "blocking": {"type": "boolean"},
        "detail": {"type": "string", "minLength": 1},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    }
  }
}
