{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/result_ir_v2.schema.json",
  "title": "Engine v2 sparse HIP FGMRES ResultIR v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "result_id",
    "input_bindings",
    "analysis",
    "ordering",
    "arrays",
    "convergence",
    "energy",
    "source_provenance",
    "recovery",
    "claims",
    "numerical_result_hash",
    "result_ir_hash",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-result-ir.v2"},
    "capability_profile": {"const": "hip_fgmres_sparse_plan_recovery_linear_static"},
    "result_id": {"$ref": "#/$defs/stableId"},
    "input_bindings": {"$ref": "#/$defs/inputBindings"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "ordering": {"$ref": "#/$defs/ordering"},
    "arrays": {"$ref": "#/$defs/arrays"},
    "convergence": {"$ref": "#/$defs/convergence"},
    "energy": {"$ref": "#/$defs/energy"},
    "source_provenance": {"$ref": "#/$defs/sourceProvenance"},
    "recovery": {"$ref": "#/$defs/recovery"},
    "claims": {"$ref": "#/$defs/claims"},
    "numerical_result_hash": {"$ref": "#/$defs/sha256"},
    "result_ir_hash": {"$ref": "#/$defs/sha256"},
    "extensions": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "inputBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ir_content_hash",
        "solver_numeric_buffer_hash",
        "solver_entity_mapping_hash",
        "solver_artifact_hash",
        "execution_plan_hash",
        "evaluated_trial_state_hash",
        "committed_state_hash"
      ],
      "properties": {
        "model_ir_content_hash": {"$ref": "#/$defs/sha256"},
        "solver_numeric_buffer_hash": {"$ref": "#/$defs/sha256"},
        "solver_entity_mapping_hash": {"$ref": "#/$defs/sha256"},
        "solver_artifact_hash": {"$ref": "#/$defs/sha256"},
        "execution_plan_hash": {"$ref": "#/$defs/sha256"},
        "evaluated_trial_state_hash": {"$ref": "#/$defs/sha256"},
        "committed_state_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status",
        "load_pattern_id",
        "residual_sign",
        "exported_free_residual_sign",
        "operator_version",
        "operator_hash",
        "recovery_operator_hash"
      ],
      "properties": {
        "type": {"const": "linear_static"},
        "status": {"const": "ready"},
        "load_pattern_id": {"$ref": "#/$defs/stableId"},
        "residual_sign": {"const": "internal_minus_external"},
        "exported_free_residual_sign": {"const": "external_minus_internal"},
        "operator_version": {"const": "engine-v2-cpu-direct-csr-linear-static.v2"},
        "operator_hash": {"$ref": "#/$defs/sha256"},
        "recovery_operator_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_ids",
        "element_ids",
        "dof_components",
        "element_end_order",
        "constrained_dofs",
        "free_dofs",
        "ordering_hash"
      ],
      "properties": {
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "element_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "dof_components": {"const": ["UX", "UY", "UZ", "RX", "RY", "RZ"]},
        "element_end_order": {"const": ["i", "j"]},
        "constrained_dofs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/index"}
        },
        "free_dofs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/index"}
        },
        "ordering_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "arrayDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "layout",
        "axis_labels",
        "component_labels",
        "component_units",
        "byte_length",
        "data_hash",
        "content_hash"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dtype": {"const": "<f8"},
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}
        },
        "layout": {"const": "C"},
        "axis_labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "component_labels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "component_units": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "byte_length": {
          "type": "integer",
          "minimum": 8,
          "maximum": 9007199254740991
        },
        "data_hash": {"$ref": "#/$defs/sha256"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displacements_si",
        "residual_si",
        "reactions_si",
        "element_end_forces_local_si",
        "element_strain_energy_j",
        "exported_free_residual_si"
      ],
      "properties": {
        "displacements_si": {"$ref": "#/$defs/arrayDescriptor"},
        "residual_si": {"$ref": "#/$defs/arrayDescriptor"},
        "reactions_si": {"$ref": "#/$defs/arrayDescriptor"},
        "element_end_forces_local_si": {"$ref": "#/$defs/arrayDescriptor"},
        "element_strain_energy_j": {"$ref": "#/$defs/arrayDescriptor"},
        "exported_free_residual_si": {"$ref": "#/$defs/arrayDescriptor"}
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_residual_tolerance",
        "free_residual_linf",
        "exported_free_residual_linf",
        "load_scale",
        "scaled_free_residual",
        "scaled_exported_free_residual",
        "converged"
      ],
      "properties": {
        "requested_residual_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "free_residual_linf": {"$ref": "#/$defs/nonnegativeNumber"},
        "exported_free_residual_linf": {"$ref": "#/$defs/nonnegativeNumber"},
        "load_scale": {"type": "number", "minimum": 1},
        "scaled_free_residual": {"$ref": "#/$defs/nonnegativeNumber"},
        "scaled_exported_free_residual": {"$ref": "#/$defs/nonnegativeNumber"},
        "converged": {"const": true}
      }
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_strain_energy_j",
        "element_strain_energy_sum_j",
        "global_strain_energy_j",
        "external_work_energy_j",
        "residual_work_energy_j",
        "balance_error_j"
      ],
      "properties": {
        "total_strain_energy_j": {"type": "number"},
        "element_strain_energy_sum_j": {"type": "number"},
        "global_strain_energy_j": {"type": "number"},
        "external_work_energy_j": {"type": "number"},
        "residual_work_energy_j": {"type": "number"},
        "balance_error_j": {"type": "number"}
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_parity_receipt_hash",
        "terminal_observation_receipt_hash",
        "completion_export_receipt_hash",
        "completion_export_payload_hash",
        "device_identity_receipt_hash",
        "solution_payload_sha256",
        "exported_free_residual_payload_sha256",
        "compiled_architecture",
        "runtime_architecture_base",
        "device_ordinal",
        "device_uuid_bytes_hex",
        "device_pci_bdf",
        "actual_backend",
        "recovery_backend",
        "additional_device_operation_count",
        "additional_d2h_operation_count",
        "additional_solve_count",
        "additional_export_count",
        "fallback_count",
        "live_authority_serialized"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/stableId"},
        "case_parity_receipt_hash": {"$ref": "#/$defs/sha256"},
        "terminal_observation_receipt_hash": {"$ref": "#/$defs/sha256"},
        "completion_export_receipt_hash": {"$ref": "#/$defs/sha256"},
        "completion_export_payload_hash": {"$ref": "#/$defs/sha256"},
        "device_identity_receipt_hash": {"$ref": "#/$defs/sha256"},
        "solution_payload_sha256": {"$ref": "#/$defs/sha256"},
        "exported_free_residual_payload_sha256": {"$ref": "#/$defs/sha256"},
        "compiled_architecture": {
          "type": "string",
          "pattern": "^gfx[0-9a-f]+(?::[A-Za-z0-9_+.-]+)*$"
        },
        "runtime_architecture_base": {
          "type": "string",
          "pattern": "^gfx[0-9a-f]+$"
        },
        "device_ordinal": {"$ref": "#/$defs/index"},
        "device_uuid_bytes_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "not": {"const": "00000000000000000000000000000000"}
        },
        "device_pci_bdf": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
        },
        "actual_backend": {"const": "hip"},
        "recovery_backend": {"const": "cpu_sparse_execution_plan_v2"},
        "additional_device_operation_count": {"const": 0},
        "additional_d2h_operation_count": {"const": 0},
        "additional_solve_count": {"const": 0},
        "additional_export_count": {"const": 0},
        "fallback_count": {"const": 0},
        "live_authority_serialized": {"const": false}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_operator",
        "element_operator",
        "reaction_definition",
        "element_force_definition",
        "energy_definition",
        "global_dense_matrix_materialized",
        "linear_solve_invoked"
      ],
      "properties": {
        "global_operator": {"const": "execution_plan_v2_residual_csr"},
        "element_operator": {"const": "execution_plan_v2_local_recovery_arrays"},
        "reaction_definition": {
          "const": "full_internal_minus_external_residual_on_constrained_dofs"
        },
        "element_force_definition": {"const": "k_local_times_u_local"},
        "energy_definition": {"const": "half_u_transpose_force"},
        "global_dense_matrix_materialized": {"const": false},
        "linear_solve_invoked": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_ir_verified",
        "result_ir_ready",
        "state_ir_lineage_verified",
        "reaction_recovery_verified",
        "member_force_recovery_verified",
        "energy_identities_verified",
        "device_recovery_verified",
        "iteration_host_copy_zero_proven",
        "end_to_end_o_n_proven",
        "performance_or_speedup_proven",
        "commercial_ready",
        "promotion_eligible",
        "signed_evidence",
        "standalone_provenance"
      ],
      "properties": {
        "result_ir_verified": {"const": true},
        "result_ir_ready": {"type": "boolean"},
        "state_ir_lineage_verified": {"const": true},
        "reaction_recovery_verified": {"const": true},
        "member_force_recovery_verified": {"const": true},
        "energy_identities_verified": {"const": true},
        "device_recovery_verified": {"const": false},
        "iteration_host_copy_zero_proven": {"const": false},
        "end_to_end_o_n_proven": {"const": false},
        "performance_or_speedup_proven": {"const": false},
        "commercial_ready": {"const": false},
        "promotion_eligible": {"const": false},
        "signed_evidence": {"const": false},
        "standalone_provenance": {"const": false}
      }
    }
  }
}
