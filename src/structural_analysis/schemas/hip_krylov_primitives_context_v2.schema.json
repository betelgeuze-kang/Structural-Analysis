{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_krylov_primitives_context_v2.schema.json",
  "title": "HIP Krylov Primitives Context Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_profile", "status", "context_id", "evidence_scope", "actual_backend", "promotion_eligible", "reason", "bindings", "kernel", "dimensions", "owned_buffers", "allocation_lineage", "telemetry", "claims", "context_receipt_hash"],
  "properties": {
    "schema_version": {"const": "structural-analysis-hip-krylov-primitives-context.v2"},
    "capability_profile": {"const": "phase0_hip_krylov_vector_reduction_positive_jacobi_primitives"},
    "status": {"enum": ["context_ready", "context_closed", "poisoned", "cleanup_failed", "cleanup_quarantined", "unavailable"]},
    "context_id": {"$ref": "#/$defs/hash"},
    "evidence_scope": {"enum": ["native_hiprtc_krylov_primitives_composite", "injected_test_double"]},
    "actual_backend": {"enum": ["hip", "test_double", null]},
    "promotion_eligible": {"const": false},
    "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]},
    "bindings": {"$ref": "#/$defs/bindings"},
    "kernel": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/kernel"}]},
    "dimensions": {"$ref": "#/$defs/dimensions"},
    "owned_buffers": {"type": "array", "items": {"$ref": "#/$defs/buffer"}, "maxItems": 9},
    "allocation_lineage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/allocation_lineage"}]},
    "telemetry": {"$ref": "#/$defs/telemetry"},
    "claims": {"$ref": "#/$defs/claims"},
    "context_receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "context_ready"}}, "required": ["status"]},
      "then": {"properties": {"reason": {"type": "null"}, "actual_backend": {"enum": ["hip", "test_double"]}, "kernel": {"$ref": "#/$defs/kernel"}, "owned_buffers": {"minItems": 9, "maxItems": 9}, "allocation_lineage": {"$ref": "#/$defs/allocation_lineage"}, "claims": {"$ref": "#/$defs/ready_claims"}}}
    },
    {
      "if": {"properties": {"status": {"const": "context_closed"}}, "required": ["status"]},
      "then": {"properties": {"reason": {"type": "null"}, "actual_backend": {"enum": ["hip", "test_double"]}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["poisoned", "cleanup_failed", "cleanup_quarantined"]}}, "required": ["status"]},
      "then": {"properties": {"reason": {"$ref": "#/$defs/reason"}, "actual_backend": {"enum": ["hip", "test_double"]}}}
    },
    {
      "if": {"properties": {"status": {"const": "cleanup_quarantined"}}, "required": ["status"]},
      "then": {"properties": {"allocation_lineage": {"$ref": "#/$defs/allocation_lineage"}}}
    },
    {
