      "type": "object", "additionalProperties": false,
      "required": ["allocation_attempt_count", "allocation_success_count", "deallocation_attempt_count", "deallocation_success_count", "current_device_bytes", "peak_device_bytes", "h2d_operation_attempt_count", "h2d_operation_success_count", "h2d_bytes_attempted", "h2d_bytes_succeeded", "d2h_operation_attempt_count", "d2h_operation_success_count", "d2h_bytes_attempted", "d2h_bytes_succeeded", "kernel_launch_attempt_count", "kernel_launch_success_count", "sync_attempt_count", "sync_success_count", "module_owner_acquired_count", "module_close_attempt_count", "module_close_success_count", "lease_release_attempt_count", "lease_release_success_count", "lineage_owner_open_success_count", "lineage_capability_mint_success_count", "lineage_capability_mint_bytes", "lineage_free_acknowledgement_count", "lineage_free_quarantine_count", "lineage_orphan_acknowledgement_count", "lineage_orphan_quarantine_count", "lineage_owner_close_success_count", "quarantined_device_bytes", "unknown_malloc_outcome_count", "unknown_requested_bytes", "error_flag_h2d_bytes", "error_flag_d2h_bytes", "vector_h2d_bytes", "reduction_h2d_bytes", "new_stream_create_count", "fallback_count"],
      "properties": {
        "allocation_attempt_count": {"type": "integer", "minimum": 0}, "allocation_success_count": {"type": "integer", "minimum": 0}, "deallocation_attempt_count": {"type": "integer", "minimum": 0}, "deallocation_success_count": {"type": "integer", "minimum": 0}, "current_device_bytes": {"type": "integer", "minimum": 0}, "peak_device_bytes": {"type": "integer", "minimum": 0},
        "h2d_operation_attempt_count": {"type": "integer", "minimum": 0}, "h2d_operation_success_count": {"type": "integer", "minimum": 0}, "h2d_bytes_attempted": {"type": "integer", "minimum": 0}, "h2d_bytes_succeeded": {"type": "integer", "minimum": 0}, "d2h_operation_attempt_count": {"type": "integer", "minimum": 0}, "d2h_operation_success_count": {"type": "integer", "minimum": 0}, "d2h_bytes_attempted": {"type": "integer", "minimum": 0}, "d2h_bytes_succeeded": {"type": "integer", "minimum": 0},
        "kernel_launch_attempt_count": {"type": "integer", "minimum": 0}, "kernel_launch_success_count": {"type": "integer", "minimum": 0}, "sync_attempt_count": {"type": "integer", "minimum": 0}, "sync_success_count": {"type": "integer", "minimum": 0}, "module_owner_acquired_count": {"type": "integer", "minimum": 0}, "module_close_attempt_count": {"type": "integer", "minimum": 0}, "module_close_success_count": {"type": "integer", "minimum": 0}, "lease_release_attempt_count": {"type": "integer", "minimum": 0}, "lease_release_success_count": {"type": "integer", "minimum": 0},
        "lineage_owner_open_success_count": {"type": "integer", "minimum": 0}, "lineage_capability_mint_success_count": {"type": "integer", "minimum": 0}, "lineage_capability_mint_bytes": {"type": "integer", "minimum": 0}, "lineage_free_acknowledgement_count": {"type": "integer", "minimum": 0}, "lineage_free_quarantine_count": {"type": "integer", "minimum": 0}, "lineage_orphan_acknowledgement_count": {"type": "integer", "minimum": 0}, "lineage_orphan_quarantine_count": {"type": "integer", "minimum": 0}, "lineage_owner_close_success_count": {"type": "integer", "minimum": 0}, "quarantined_device_bytes": {"type": "integer", "minimum": 0}, "unknown_malloc_outcome_count": {"type": "integer", "minimum": 0}, "unknown_requested_bytes": {"type": "integer", "minimum": 0},
        "error_flag_h2d_bytes": {"type": "integer", "minimum": 0}, "error_flag_d2h_bytes": {"type": "integer", "minimum": 0}, "vector_h2d_bytes": {"const": 0}, "reduction_h2d_bytes": {"const": 0}, "new_stream_create_count": {"const": 0}, "fallback_count": {"const": 0}
      }
    },
    "claims": {"type": "object", "additionalProperties": false, "required": ["exclusive_parent_lease_active", "same_runtime_and_stream", "positive_jacobi_inverse_ready", "affine_primitive_ready", "dot_primitive_ready", "stable_l2_primitive_ready", "native_hiprtc_evidence", "host_copy_zero_proven", "diagonal_shift_or_clamp_used", "spd_proven", "pcg_ready", "krylov_solver_ready", "preconditioner_integrated", "solver_iteration_ready", "asymptotic_o_n_proven", "speedup_proven", "commercial_ready", "fallback_used"], "properties": {"exclusive_parent_lease_active": {"type": "boolean"}, "same_runtime_and_stream": {"type": "boolean"}, "positive_jacobi_inverse_ready": {"type": "boolean"}, "affine_primitive_ready": {"type": "boolean"}, "dot_primitive_ready": {"type": "boolean"}, "stable_l2_primitive_ready": {"type": "boolean"}, "native_hiprtc_evidence": {"type": "boolean"}, "host_copy_zero_proven": {"const": false}, "diagonal_shift_or_clamp_used": {"const": false}, "spd_proven": {"const": false}, "pcg_ready": {"const": false}, "krylov_solver_ready": {"const": false}, "preconditioner_integrated": {"const": false}, "solver_iteration_ready": {"const": false}, "asymptotic_o_n_proven": {"const": false}, "speedup_proven": {"const": false}, "commercial_ready": {"const": false}, "fallback_used": {"const": false}}},
    "ready_claims": {"allOf": [{"$ref": "#/$defs/claims"}, {"properties": {"exclusive_parent_lease_active": {"const": true}, "same_runtime_and_stream": {"const": true}, "positive_jacobi_inverse_ready": {"const": true}, "affine_primitive_ready": {"const": true}, "dot_primitive_ready": {"const": true}, "stable_l2_primitive_ready": {"const": true}}}]}
