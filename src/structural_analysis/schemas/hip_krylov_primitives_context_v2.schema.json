        "source_numeric_snapshot_hash": {"$ref": "#/$defs/hash"}, "source_partition_hash": {"$ref": "#/$defs/hash"},
        "state_hash": {"$ref": "#/$defs/hash"}, "state_epoch": {"type": "integer", "minimum": 0},
        "lease_epoch": {"type": "integer", "minimum": 1}, "kernel_origin": {"enum": ["internally_compiled", "caller_supplied"]}
      }
    },
    "kernel": {
      "type": "object", "additionalProperties": false,
