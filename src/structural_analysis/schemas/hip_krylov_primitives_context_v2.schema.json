      "properties": {
        "abi_version": {"type": "integer"}, "architecture": {"type": "string"}, "kernel_name": {"type": "string"},
        "prepare_positive_jacobi_symbol": {"type": "string"}, "fill_symbol": {"type": "string"}, "affine_symbol": {"type": "string"}, "apply_jacobi_symbol": {"type": "string"}, "dot_stage_symbol": {"type": "string"}, "sum_stage_symbol": {"type": "string"}, "lassq_stage_symbol": {"type": "string"}, "lassq_combine_stage_symbol": {"type": "string"}, "lassq_finalize_symbol": {"type": "string"},
        "vector_block_size": {"type": "integer"}, "reduction_segment_size": {"type": "integer"}, "source_resource": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/hash"}, "code_object_sha256": {"$ref": "#/$defs/hash"}, "identity_hash": {"$ref": "#/$defs/hash"},
        "runtime_library_discovery_source": {"type": "string"}, "runtime_library_sha256": {"$ref": "#/$defs/hash"},
        "hiprtc_library_discovery_source": {"type": "string"}, "hiprtc_library_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["free_dof_count", "reduced_csr_nnz", "reduction_segment_size", "reduction_partial_count", "borrowed_buffer_count", "owned_buffer_count"], "properties": {"free_dof_count": {"type": "integer", "minimum": 1}, "reduced_csr_nnz": {"type": "integer", "minimum": 1}, "reduction_segment_size": {"const": 512}, "reduction_partial_count": {"type": "integer", "minimum": 1}, "borrowed_buffer_count": {"const": 5}, "owned_buffer_count": {"const": 9}}},
    "buffer": {"type": "object", "additionalProperties": false, "required": ["name", "dtype", "shape", "byte_length", "data_hash", "memory_space", "access", "initial_transfer"], "properties": {"name": {"type": "string"}, "dtype": {"enum": ["<f8", "<i4"]}, "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "maxItems": 1}, "byte_length": {"type": "integer", "minimum": 1}, "data_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}, "memory_space": {"const": "hip_device"}, "access": {"type": "string"}, "initial_transfer": {"type": "string"}}},
    "allocation_lineage": {"type": "object", "additionalProperties": false, "required": ["capability_profile", "evidence_scope", "owner_role", "runtime_device_bound", "parent_borrowed_capability_count", "managed_buffer_count", "managed_device_bytes", "all_owned_buffers_managed", "pointer_values_serialized", "promotion_eligible"], "properties": {"capability_profile": {"const": "foundation_non_promoting"}, "evidence_scope": {"const": "foundation_non_promoting"}, "owner_role": {"const": "krylov_primitives_owned_buffers"}, "runtime_device_bound": {"const": true}, "parent_borrowed_capability_count": {"const": 5}, "managed_buffer_count": {"type": "integer", "minimum": 0, "maximum": 9}, "managed_device_bytes": {"type": "integer", "minimum": 0}, "all_owned_buffers_managed": {"type": "boolean"}, "pointer_values_serialized": {"const": false}, "promotion_eligible": {"const": false}}},
