{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_krylov_primitives_evaluation_v1.schema.json",
  "title": "HIP Krylov Primitives Evaluation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "execution_id",
    "context_id",
    "opening_context_receipt_hash",
    "source_apply_receipt_hash",
    "batch",
    "evidence_scope",
    "actual_backend",
    "promotion_eligible",
    "reason",
    "arrays",
    "telemetry_delta",
    "parity",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-hip-krylov-primitives-evaluation.v1"
    },
    "capability_profile": {
      "const": "phase0_hip_krylov_vector_reduction_positive_jacobi_primitives"
    },
    "status": {
      "enum": ["verified", "parity_failed", "unavailable"]
    },
    "execution_id": {"$ref": "#/$defs/hash"},
    "context_id": {"$ref": "#/$defs/hash"},
    "opening_context_receipt_hash": {"$ref": "#/$defs/hash"},
    "source_apply_receipt_hash": {"$ref": "#/$defs/hash"},
    "batch": {"$ref": "#/$defs/batch"},
    "evidence_scope": {
      "enum": [
        "native_hiprtc_krylov_primitives_composite",
        "injected_test_double"
      ]
    },
    "actual_backend": {"enum": ["hip", "test_double"]},
    "promotion_eligible": {"const": false},
    "reason": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/reason"}
      ]
    },
    "arrays": {"$ref": "#/$defs/arrays"},
    "telemetry_delta": {"$ref": "#/$defs/evaluation_delta"},
    "parity": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/parity"}
      ]
    },
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "verified"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason": {"type": "null"},
          "batch": {
            "allOf": [
              {"$ref": "#/$defs/batch"},
              {"properties": {"status": {"const": "enqueued"}}}
            ]
          },
          "arrays": {"$ref": "#/$defs/arrays_full"},
          "parity": {
            "allOf": [
              {"$ref": "#/$defs/parity"},
              {
                "properties": {
                  "passed": {"const": true},
                  "metrics": {"$ref": "#/$defs/metrics_all_passed"}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "parity_failed"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason": {"type": "null"},
          "batch": {
            "allOf": [
              {"$ref": "#/$defs/batch"},
              {"properties": {"status": {"const": "enqueued"}}}
            ]
          },
          "arrays": {"$ref": "#/$defs/arrays_full"},
          "parity": {
            "allOf": [
              {"$ref": "#/$defs/parity"},
              {
                "properties": {
                  "passed": {"const": false},
                  "metrics": {
                    "not": {"$ref": "#/$defs/metrics_all_passed"}
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "unavailable"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason": {"$ref": "#/$defs/reason"},
          "arrays": {
            "type": "object",
            "maxProperties": 0
          },
          "parity": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtype", "shape", "byte_length", "data_hash"],
      "properties": {
        "dtype": {"const": "<f8"},
        "shape": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 1,
          "maxItems": 1
        },
        "byte_length": {"type": "integer", "minimum": 8},
        "data_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jacobi_inverse": {"$ref": "#/$defs/descriptor"},
        "work_x": {"$ref": "#/$defs/descriptor"},
        "work_y": {"$ref": "#/$defs/descriptor"},
        "preconditioned": {"$ref": "#/$defs/descriptor"},
        "dot_result": {"$ref": "#/$defs/descriptor"},
        "norm_result": {"$ref": "#/$defs/descriptor"}
      }
    },
    "arrays_full": {
      "allOf": [
        {"$ref": "#/$defs/arrays"},
        {
          "required": [
            "jacobi_inverse",
            "work_x",
            "work_y",
            "preconditioned",
            "dot_result",
            "norm_result"
          ],
          "minProperties": 6,
          "maxProperties": 6
        }
      ]
    },
    "evaluation_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "d2h_operation_attempt_count",
        "d2h_operation_success_count",
        "d2h_bytes_attempted",
        "d2h_bytes_succeeded",
        "sync_attempt_count",
        "sync_success_count",
        "allocation_count",
        "h2d_operation_count",
        "fallback_count"
      ],
      "properties": {
        "d2h_operation_attempt_count": {"type": "integer", "minimum": 0},
        "d2h_operation_success_count": {"type": "integer", "minimum": 0},
        "d2h_bytes_attempted": {"type": "integer", "minimum": 0},
        "d2h_bytes_succeeded": {"type": "integer", "minimum": 0},
        "sync_attempt_count": {"type": "integer", "minimum": 0},
        "sync_success_count": {"type": "integer", "minimum": 0},
        "allocation_count": {"const": 0},
        "h2d_operation_count": {"const": 0},
        "fallback_count": {"const": 0}
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capability_profile",
        "status",
        "batch_id",
        "context_id",
        "opening_context_receipt_hash",
        "source_apply_receipt_hash",
        "sequence",
        "evidence_scope",
        "promotion_eligible",
        "reason",
        "telemetry_delta",
        "claims",
        "receipt_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "structural-analysis-hip-krylov-primitives-batch.v1"
        },
        "capability_profile": {
          "const": "phase0_hip_krylov_vector_reduction_positive_jacobi_primitives"
        },
        "status": {"enum": ["enqueued", "unavailable"]},
        "batch_id": {"$ref": "#/$defs/hash"},
        "context_id": {"$ref": "#/$defs/hash"},
        "opening_context_receipt_hash": {"$ref": "#/$defs/hash"},
        "source_apply_receipt_hash": {"$ref": "#/$defs/hash"},
        "sequence": {"type": "integer", "minimum": 1},
        "evidence_scope": {
          "enum": [
            "native_hiprtc_krylov_primitives_composite",
            "injected_test_double"
          ]
        },
        "promotion_eligible": {"const": false},
        "reason": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/reason"}
          ]
        },
        "telemetry_delta": {"$ref": "#/$defs/batch_delta"},
        "claims": {"$ref": "#/$defs/batch_claims"},
        "receipt_hash": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "enqueued"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reason": {"type": "null"},
              "claims": {"$ref": "#/$defs/batch_claims_all_complete"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "unavailable"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reason": {"$ref": "#/$defs/reason"},
              "claims": {
                "not": {"$ref": "#/$defs/batch_claims_all_complete"}
              }
            }
          }
        }
      ]
    },
    "batch_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fill_launch_attempt_count",
        "fill_launch_success_count",
        "affine_launch_attempt_count",
        "affine_launch_success_count",
        "jacobi_launch_attempt_count",
        "jacobi_launch_success_count",
        "dot_stage_launch_attempt_count",
        "dot_stage_launch_success_count",
        "sum_stage_launch_attempt_count",
        "sum_stage_launch_success_count",
        "lassq_stage_launch_attempt_count",
        "lassq_stage_launch_success_count",
        "lassq_combine_launch_attempt_count",
        "lassq_combine_launch_success_count",
        "lassq_finalize_launch_attempt_count",
        "lassq_finalize_launch_success_count",
        "h2d_operation_count",
        "d2h_operation_count",
        "allocation_count",
        "sync_count",
        "fallback_count"
      ],
      "properties": {
        "fill_launch_attempt_count": {"type": "integer", "minimum": 0},
        "fill_launch_success_count": {"type": "integer", "minimum": 0},
        "affine_launch_attempt_count": {"type": "integer", "minimum": 0},
        "affine_launch_success_count": {"type": "integer", "minimum": 0},
        "jacobi_launch_attempt_count": {"type": "integer", "minimum": 0},
        "jacobi_launch_success_count": {"type": "integer", "minimum": 0},
        "dot_stage_launch_attempt_count": {"type": "integer", "minimum": 0},
        "dot_stage_launch_success_count": {"type": "integer", "minimum": 0},
        "sum_stage_launch_attempt_count": {"type": "integer", "minimum": 0},
        "sum_stage_launch_success_count": {"type": "integer", "minimum": 0},
        "lassq_stage_launch_attempt_count": {"type": "integer", "minimum": 0},
        "lassq_stage_launch_success_count": {"type": "integer", "minimum": 0},
        "lassq_combine_launch_attempt_count": {"type": "integer", "minimum": 0},
        "lassq_combine_launch_success_count": {"type": "integer", "minimum": 0},
        "lassq_finalize_launch_attempt_count": {"type": "integer", "minimum": 0},
        "lassq_finalize_launch_success_count": {"type": "integer", "minimum": 0},
        "h2d_operation_count": {"const": 0},
        "d2h_operation_count": {"const": 0},
        "allocation_count": {"const": 0},
        "sync_count": {"const": 0},
        "fallback_count": {"const": 0}
      }
    },
    "batch_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fill_enqueued",
        "affine_program_enqueued",
        "jacobi_apply_enqueued",
        "dot_reduction_enqueued",
        "stable_l2_reduction_enqueued",
        "completion_fence_observed",
        "solver_iteration",
        "pcg_iteration",
        "fallback_used"
      ],
      "properties": {
        "fill_enqueued": {"type": "boolean"},
        "affine_program_enqueued": {"type": "boolean"},
        "jacobi_apply_enqueued": {"type": "boolean"},
        "dot_reduction_enqueued": {"type": "boolean"},
        "stable_l2_reduction_enqueued": {"type": "boolean"},
        "completion_fence_observed": {"const": false},
        "solver_iteration": {"const": false},
        "pcg_iteration": {"const": false},
        "fallback_used": {"const": false}
      }
    },
    "batch_claims_all_complete": {
      "type": "object",
      "required": [
        "fill_enqueued",
        "affine_program_enqueued",
        "jacobi_apply_enqueued",
        "dot_reduction_enqueued",
        "stable_l2_reduction_enqueued"
      ],
      "properties": {
        "fill_enqueued": {"const": true},
        "affine_program_enqueued": {"const": true},
        "jacobi_apply_enqueued": {"const": true},
        "dot_reduction_enqueued": {"const": true},
        "stable_l2_reduction_enqueued": {"const": true}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "max_abs_error",
        "relative_l2_error",
        "max_scaled_error",
        "absolute_tolerance",
        "relative_tolerance",
        "passed"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "max_abs_error": {"type": "number", "minimum": 0},
        "relative_l2_error": {"type": "number", "minimum": 0},
        "max_scaled_error": {"type": "number", "minimum": 0},
        "absolute_tolerance": {"const": 1e-8},
        "relative_tolerance": {"const": 1e-8},
        "passed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"passed": {"const": true}},
            "required": ["passed"]
          },
          "then": {
            "properties": {"max_scaled_error": {"maximum": 1.0}}
          }
        },
        {
          "if": {
            "properties": {"passed": {"const": false}},
            "required": ["passed"]
          },
          "then": {
            "properties": {"max_scaled_error": {"exclusiveMinimum": 1.0}}
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jacobi_inverse",
        "work_x",
        "work_y",
        "preconditioned",
        "dot_result",
        "norm_result"
      ],
      "properties": {
        "jacobi_inverse": {"$ref": "#/$defs/metric"},
        "work_x": {"$ref": "#/$defs/metric"},
        "work_y": {"$ref": "#/$defs/metric"},
        "preconditioned": {"$ref": "#/$defs/metric"},
        "dot_result": {"$ref": "#/$defs/metric"},
        "norm_result": {"$ref": "#/$defs/metric"}
      }
    },
    "metrics_all_passed": {
      "type": "object",
      "required": [
        "jacobi_inverse",
        "work_x",
        "work_y",
        "preconditioned",
        "dot_result",
        "norm_result"
      ],
      "properties": {
        "jacobi_inverse": {
          "type": "object",
          "required": ["passed"],
          "properties": {"passed": {"const": true}}
        },
        "work_x": {
          "type": "object",
          "required": ["passed"],
          "properties": {"passed": {"const": true}}
        },
        "work_y": {
          "type": "object",
          "required": ["passed"],
          "properties": {"passed": {"const": true}}
        },
        "preconditioned": {
          "type": "object",
          "required": ["passed"],
          "properties": {"passed": {"const": true}}
        },
        "dot_result": {
          "type": "object",
          "required": ["passed"],
          "properties": {"passed": {"const": true}}
        },
        "norm_result": {
          "type": "object",
          "required": ["passed"],
          "properties": {"passed": {"const": true}}
        }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle", "oracle_role", "metrics", "passed"],
      "properties": {
        "oracle": {"const": "execution_plan_v2_cpu_reduced_csr_fp64"},
        "oracle_role": {"const": "verification_only_never_fallback"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "passed": {"type": "boolean"}
      }
    }
  }
}
