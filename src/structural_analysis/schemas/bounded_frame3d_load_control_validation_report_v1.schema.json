{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/bounded_frame3d_load_control_validation_report_v1.schema.json",
  "title": "Bounded Frame3D load-control validation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "contract_pass",
    "result_schema_version",
    "profile",
    "source_adapter_profile",
    "solver_profile",
    "backend_role",
    "validator_id",
    "result_hash",
    "result_artifact_sha256",
    "job_request_artifact_sha256",
    "model_ir_content_hash",
    "model_ir_semantic_hash",
    "model_ir_provenance_hash",
    "adapter_hash",
    "compiled_model_hash",
    "api_request_hash",
    "resume_contract_hash",
    "source_solver_receipt_hash",
    "numerical_result_ir_hash",
    "resume_checkpoint_artifact_sha256",
    "terminal_checkpoint_hash",
    "terminal_checkpoint_artifact_hash",
    "terminal_checkpoint_artifact_sha256",
    "recovery_hash",
    "full_node_equilibrium_hash",
    "equilibrium_scaling_hash",
    "final_load_factor",
    "total_load_factor_count",
    "resume_completed_prefix_count",
    "accepted_suffix_step_count",
    "completed_prefix_count",
    "remaining_load_factor_count",
    "terminal_checkpoint_embedded",
    "exact_result_manifest_replay",
    "exact_source_solver_replay",
    "exact_resume_checkpoint_binding",
    "exact_terminal_checkpoint_replay",
    "exact_numerical_result_ir_replay",
    "exact_recovery_replay",
    "residual_gate_pass",
    "increment_gate_pass",
    "line_search_pass",
    "terminal_reassembled_equilibrium_pass",
    "full_node_equilibrium_pass",
    "unsupported_feature_count",
    "fallback_count",
    "regularization_count",
    "external_vv_level",
    "workbench_execution",
    "public_product_promotion",
    "release_eligible",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "bounded-frame3d-load-control-validation-report.v1"},
    "status": {"const": "ready"},
    "contract_pass": {"const": true},
    "result_schema_version": {"const": "bounded-frame3d-load-control-result.v1"},
    "profile": {"const": "bounded_multimember_frame3d_load_control_model_ir_api.v1"},
    "source_adapter_profile": {"const": "model_ir_v2_to_multimember_corotational_frame3d_load_control.v1"},
    "solver_profile": {"const": "dense_elastic_corotational_timoshenko_frame3d_load_control.v2"},
    "backend_role": {"const": "cpu_reference"},
    "validator_id": {
      "const": "structural_analysis.api.frame3d_load_control.validate_bounded_frame3d_load_control_result_manifest"
    },
    "result_hash": {"$ref": "#/$defs/hash"},
    "result_artifact_sha256": {"$ref": "#/$defs/hash"},
    "job_request_artifact_sha256": {"$ref": "#/$defs/hash"},
    "model_ir_content_hash": {"$ref": "#/$defs/hash"},
    "model_ir_semantic_hash": {"$ref": "#/$defs/hash"},
    "model_ir_provenance_hash": {"$ref": "#/$defs/hash"},
    "adapter_hash": {"$ref": "#/$defs/hash"},
    "compiled_model_hash": {"$ref": "#/$defs/hash"},
    "api_request_hash": {"$ref": "#/$defs/hash"},
    "resume_contract_hash": {"$ref": "#/$defs/hash"},
    "source_solver_receipt_hash": {"$ref": "#/$defs/hash"},
    "numerical_result_ir_hash": {"$ref": "#/$defs/hash"},
    "resume_checkpoint_artifact_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/hash"}
      ]
    },
    "terminal_checkpoint_hash": {"$ref": "#/$defs/hash"},
    "terminal_checkpoint_artifact_hash": {"$ref": "#/$defs/hash"},
    "terminal_checkpoint_artifact_sha256": {"$ref": "#/$defs/hash"},
    "recovery_hash": {"$ref": "#/$defs/hash"},
    "full_node_equilibrium_hash": {"$ref": "#/$defs/hash"},
    "equilibrium_scaling_hash": {"$ref": "#/$defs/hash"},
    "final_load_factor": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "maximum": 1.0
    },
    "total_load_factor_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "resume_completed_prefix_count": {"type": "integer", "minimum": 0, "maximum": 63},
    "accepted_suffix_step_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "completed_prefix_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "remaining_load_factor_count": {"const": 0},
    "terminal_checkpoint_embedded": {"const": true},
    "exact_result_manifest_replay": {"const": true},
    "exact_source_solver_replay": {"const": true},
    "exact_resume_checkpoint_binding": {"const": true},
    "exact_terminal_checkpoint_replay": {"const": true},
    "exact_numerical_result_ir_replay": {"const": true},
    "exact_recovery_replay": {"const": true},
    "residual_gate_pass": {"const": true},
    "increment_gate_pass": {"const": true},
    "line_search_pass": {"const": true},
    "terminal_reassembled_equilibrium_pass": {"const": true},
    "full_node_equilibrium_pass": {"const": true},
    "unsupported_feature_count": {"const": 0},
    "fallback_count": {"const": 0},
    "regularization_count": {"const": 0},
    "external_vv_level": {"const": 0},
    "workbench_execution": {"const": false},
    "public_product_promotion": {"const": false},
    "release_eligible": {"const": false},
    "claim_boundary": {
      "const": "This bounded candidate API executes one source-bound 3-16 node, 2-32 member elastic ModelIR v2 Frame3D load-control path. It returns authoritative nonlinear numerical ResultIR displacement/convergence, exact durable checkpoint restart, and bounded solver-derived reactions, member recovery, and full-node equilibrium. It has no stateful material, distributed load, offset/release, external-V&V, design, public-product, release, or commercial authority."
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
