    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "summary",
        "schema",
        "restart_checkpoint_vector",
        "full_load_checkpoint_vector"
      ],
      "properties": {
        "receipt": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "restart_checkpoint_vector": {"type": "string", "minLength": 1},
        "full_load_checkpoint_vector": {"type": "string", "minLength": 1}
      }
