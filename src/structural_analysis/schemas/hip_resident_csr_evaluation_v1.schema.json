{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_resident_csr_evaluation_v1.schema.json",
  "title": "HIP resident CSR residual/JVP verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_profile", "status", "execution_id", "context_id", "opening_context_receipt_hash", "enqueue", "evidence_scope", "promotion_eligible", "actual_backend", "reason", "operator_id", "state_hash", "state_epoch", "direction", "residual", "jvp", "telemetry_delta", "parity", "work", "claims", "receipt_hash"],
  "properties": {
    "schema_version": {"const": "structural-analysis-hip-resident-csr-evaluation.v1"},
    "capability_profile": {"const": "phase0_hiprtc_assembly_resident_csr_residual_jvp_consumer"},
    "status": {"enum": ["verified", "parity_failed", "unavailable"]},
    "execution_id": {"$ref": "#/$defs/hash"}, "context_id": {"$ref": "#/$defs/hash"}, "opening_context_receipt_hash": {"$ref": "#/$defs/hash"}, "enqueue": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/enqueue"}]},
    "evidence_scope": {"enum": ["native_hiprtc_composite", "injected_test_double"]}, "promotion_eligible": {"const": false}, "actual_backend": {"enum": ["hip", "test_double", null]},
    "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]}, "operator_id": {"type": "string", "pattern": "^HipAssemblyOperator:[0-9a-f]{24}$"}, "state_hash": {"$ref": "#/$defs/hash"}, "state_epoch": {"type": "integer", "minimum": 0},
    "direction": {"$ref": "#/$defs/array"}, "residual": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/array"}]}, "jvp": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/array"}]},
    "telemetry_delta": {"$ref": "#/$defs/delta"}, "parity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/parity"}]}, "work": {"$ref": "#/$defs/work"}, "claims": {"$ref": "#/$defs/claims"}, "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0},
    "reason": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 128}, "detail": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "enqueue_delta": {"type": "object", "additionalProperties": false, "required": ["h2d_operation_count", "h2d_bytes", "d2h_operation_count", "d2h_bytes", "allocation_count", "sync_count", "kernel_launch_attempt_count", "kernel_launch_success_count", "fallback_count"], "properties": {"h2d_operation_count": {"const": 0}, "h2d_bytes": {"const": 0}, "d2h_operation_count": {"const": 0}, "d2h_bytes": {"const": 0}, "allocation_count": {"const": 0}, "sync_count": {"const": 0}, "kernel_launch_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "kernel_launch_success_count": {"type": "integer", "minimum": 0, "maximum": 1}, "fallback_count": {"const": 0}}},
    "enqueue": {"type": "object", "additionalProperties": false, "required": ["schema_version", "capability_profile", "status", "enqueue_id", "context_id", "opening_context_receipt_hash", "operator_id", "state_hash", "state_epoch", "kernel_identity_hash", "sequence", "evidence_scope", "promotion_eligible", "reason", "telemetry_delta", "completion_fence_observed", "residual_jvp_enqueued", "solver_iteration", "receipt_hash"], "properties": {"schema_version": {"const": "structural-analysis-hip-resident-csr-enqueue.v1"}, "capability_profile": {"const": "phase0_hiprtc_assembly_resident_csr_residual_jvp_consumer"}, "status": {"enum": ["enqueued", "unavailable"]}, "enqueue_id": {"$ref": "#/$defs/hash"}, "context_id": {"$ref": "#/$defs/hash"}, "opening_context_receipt_hash": {"$ref": "#/$defs/hash"}, "operator_id": {"type": "string", "pattern": "^HipAssemblyOperator:[0-9a-f]{24}$"}, "state_hash": {"$ref": "#/$defs/hash"}, "state_epoch": {"type": "integer", "minimum": 0}, "kernel_identity_hash": {"$ref": "#/$defs/hash"}, "sequence": {"type": "integer", "minimum": 1}, "evidence_scope": {"enum": ["native_hiprtc_composite", "injected_test_double"]}, "promotion_eligible": {"const": false}, "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]}, "telemetry_delta": {"$ref": "#/$defs/enqueue_delta"}, "completion_fence_observed": {"const": false}, "residual_jvp_enqueued": {"type": "boolean"}, "solver_iteration": {"const": false}, "receipt_hash": {"$ref": "#/$defs/hash"}}},
    "array": {"type": "object", "additionalProperties": false, "required": ["dtype", "shape", "byte_length", "data_hash"], "properties": {"dtype": {"const": "<f8"}, "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "byte_length": {"type": "integer", "minimum": 8}, "data_hash": {"$ref": "#/$defs/hash"}}},
    "delta": {"type": "object", "additionalProperties": false, "required": ["h2d_operation_attempt_count", "h2d_operation_success_count", "h2d_bytes_attempted", "h2d_bytes_succeeded", "d2h_operation_attempt_count", "d2h_operation_success_count", "d2h_bytes_attempted", "d2h_bytes_succeeded", "kernel_launch_attempt_count", "kernel_launch_success_count", "sync_attempt_count", "sync_success_count", "allocation_count", "fallback_count"], "properties": {"h2d_operation_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "h2d_operation_success_count": {"type": "integer", "minimum": 0, "maximum": 1}, "h2d_bytes_attempted": {"$ref": "#/$defs/nonnegative"}, "h2d_bytes_succeeded": {"$ref": "#/$defs/nonnegative"}, "d2h_operation_attempt_count": {"type": "integer", "minimum": 0, "maximum": 2}, "d2h_operation_success_count": {"type": "integer", "minimum": 0, "maximum": 2}, "d2h_bytes_attempted": {"$ref": "#/$defs/nonnegative"}, "d2h_bytes_succeeded": {"$ref": "#/$defs/nonnegative"}, "kernel_launch_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "kernel_launch_success_count": {"type": "integer", "minimum": 0, "maximum": 1}, "sync_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "sync_success_count": {"type": "integer", "minimum": 0, "maximum": 1}, "allocation_count": {"const": 0}, "fallback_count": {"const": 0}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["count", "max_abs_error", "relative_l2_error", "max_scaled_error", "absolute_tolerance", "relative_tolerance", "passed"], "properties": {"count": {"$ref": "#/$defs/nonnegative"}, "max_abs_error": {"type": "number", "minimum": 0}, "relative_l2_error": {"type": "number", "minimum": 0}, "max_scaled_error": {"type": "number", "minimum": 0}, "absolute_tolerance": {"const": 1e-8}, "relative_tolerance": {"const": 1e-8}, "passed": {"type": "boolean"}}},
    "partition_metrics": {"type": "object", "additionalProperties": false, "required": ["full", "free", "constrained"], "properties": {"full": {"$ref": "#/$defs/metric"}, "free": {"$ref": "#/$defs/metric"}, "constrained": {"$ref": "#/$defs/metric"}}},
    "parity": {"type": "object", "additionalProperties": false, "required": ["oracle", "oracle_role", "residual", "jvp", "zero_direction_exact", "passed"], "properties": {"oracle": {"const": "execution_plan_v2_cpu_csr_fp64"}, "oracle_role": {"const": "verification_only_never_fallback"}, "residual": {"$ref": "#/$defs/partition_metrics"}, "jvp": {"$ref": "#/$defs/partition_metrics"}, "zero_direction_exact": {"type": "boolean"}, "passed": {"type": "boolean"}}},
    "work": {"type": "object", "additionalProperties": false, "required": ["scope", "global_dof_count", "csr_nnz", "csr_pass_count", "multiplication_count", "accumulation_count", "load_subtraction_count", "flop_equivalent_count", "operation_count_basis", "physical_dram_bytes", "end_to_end_o_n_claim"], "properties": {"scope": {"const": "assembled_device_csr_residual_jvp_verification_v1"}, "global_dof_count": {"type": "integer", "minimum": 1}, "csr_nnz": {"type": "integer", "minimum": 1}, "csr_pass_count": {"const": 1}, "multiplication_count": {"type": "integer", "minimum": 2}, "accumulation_count": {"type": "integer", "minimum": 2}, "load_subtraction_count": {"type": "integer", "minimum": 1}, "flop_equivalent_count": {"type": "integer", "minimum": 5}, "operation_count_basis": {"const": "structural_source_equivalent_not_counter"}, "physical_dram_bytes": {"const": "not_instrumented"}, "end_to_end_o_n_claim": {"const": false}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["assembled_device_csr_consumed", "residual_jvp_completed_after_fence", "cpu_reference_parity_verified", "zero_consumer_csr_h2d", "same_parent_stream", "solver_ready", "device_resident_krylov_ready", "iteration_host_copy_zero", "end_to_end_on_complexity", "performance_or_speedup", "commercial_readiness"], "properties": {"assembled_device_csr_consumed": {"type": "boolean"}, "residual_jvp_completed_after_fence": {"type": "boolean"}, "cpu_reference_parity_verified": {"type": "boolean"}, "zero_consumer_csr_h2d": {"const": true}, "same_parent_stream": {"const": true}, "solver_ready": {"const": false}, "device_resident_krylov_ready": {"const": false}, "iteration_host_copy_zero": {"const": false}, "end_to_end_on_complexity": {"const": false}, "performance_or_speedup": {"const": false}, "commercial_readiness": {"const": false}}}
  }
}
