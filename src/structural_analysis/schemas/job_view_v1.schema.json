{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/job_view_v1.schema.json",
  "title": "Structural Analysis Workbench Job View v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service_profile",
    "job_id",
    "status",
    "revision",
    "attempt",
    "progress",
    "created_at",
    "updated_at",
    "lease_expires_at",
    "error_code",
    "can_resume",
    "request",
    "checkpoint",
    "result",
    "evidence",
    "resume_contract_hash",
    "solver_truth_owner",
    "result_authority",
    "claim_boundary",
    "terminal_event_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-job-view.v1"},
    "service_profile": {"const": "sqlite_wal_content_addressed_single_host.v1"},
    "job_id": {"type": "string", "pattern": "^job_[0-9a-f]{32}$"},
    "status": {"enum": ["queued", "running", "checkpointed", "succeeded", "failed", "cancelled"]},
    "revision": {"type": "integer", "minimum": 0},
    "attempt": {"type": "integer", "minimum": 0},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_steps", "total_steps"],
      "properties": {
        "completed_steps": {"type": "integer", "minimum": 0},
        "total_steps": {"type": "integer", "minimum": 1}
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "lease_expires_at": {"type": ["string", "null"]},
    "error_code": {"type": ["string", "null"]},
    "can_resume": {"type": "boolean"},
    "request": {"$ref": "#/$defs/artifact"},
    "checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
    "result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
    "evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
    "resume_contract_hash": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "solver_truth_owner": {"const": "structural_analysis_core"},
    "result_authority": {"const": "referenced_result_and_evidence_contracts_only"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "terminal_event_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content_hash", "byte_length", "media_type"],
      "properties": {
        "role": {"enum": ["request", "checkpoint", "result", "evidence"]},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 3}
      }
    }
  }
}
