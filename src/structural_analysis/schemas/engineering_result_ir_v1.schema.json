{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/engineering_result_ir_v1.schema.json",
  "title": "Engine v2 engineering ResultIR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engineering_result_id",
    "result_kind",
    "authority_profile",
    "promotion_basis",
    "bindings",
    "source_numerical_result",
    "recovery",
    "dimensions",
    "gates",
    "outputs",
    "authority",
    "claim_boundary",
    "extensions",
    "engineering_result_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "structural-analysis-engineering-result-ir.v1"
    },
    "engineering_result_id": {"$ref": "#/$defs/stable_id"},
    "result_kind": {"const": "linear_static_reaction_and_member_force"},
    "authority_profile": {
      "const": "authoritative_bound_linear_static_recovery.v1"
    },
    "promotion_basis": {
      "const": "authoritative_numerical_result_plus_exact_operator_replay_and_equilibrium.v1"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ir_content_hash",
        "execution_plan_hash",
        "reduced_csr_identity_hash",
        "equation_scaling_hash",
        "operator_hash",
        "state_hash",
        "state_epoch",
        "load_pattern_id"
      ],
      "properties": {
        "model_ir_content_hash": {"$ref": "#/$defs/sha256"},
        "execution_plan_hash": {"$ref": "#/$defs/sha256"},
        "reduced_csr_identity_hash": {"$ref": "#/$defs/sha256"},
        "equation_scaling_hash": {"$ref": "#/$defs/sha256"},
        "operator_hash": {"$ref": "#/$defs/sha256"},
        "state_hash": {"$ref": "#/$defs/sha256"},
        "state_epoch": {"type": "integer", "minimum": 1},
        "load_pattern_id": {"$ref": "#/$defs/stable_id"}
      }
    },
    "source_numerical_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result_hash",
        "full_residual_receipt_hash",
        "boundary_condition_receipt_hash",
        "authority_inherited"
      ],
      "properties": {
        "schema_version": {
          "const": "structural-analysis-numerical-result-ir.v1"
        },
        "result_hash": {"$ref": "#/$defs/sha256"},
        "full_residual_receipt_hash": {"$ref": "#/$defs/sha256"},
        "boundary_condition_receipt_hash": {"$ref": "#/$defs/sha256"},
        "authority_inherited": {"const": true}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery_operator_hash",
        "recovery_law_receipt_hash",
        "element_profile_hash",
        "residual_sign",
        "reference_load_scaled_by_state_load_factor",
        "load_factor"
      ],
      "properties": {
        "recovery_operator_hash": {"$ref": "#/$defs/sha256"},
        "recovery_law_receipt_hash": {"$ref": "#/$defs/sha256"},
        "element_profile_hash": {"$ref": "#/$defs/sha256"},
        "residual_sign": {"const": "internal_minus_external"},
        "reference_load_scaled_by_state_load_factor": {"const": true},
        "load_factor": {"type": "number"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dof_count",
        "element_count",
        "constrained_reaction_count",
        "evaluated_member_force_value_count",
        "local_component_count"
      ],
      "properties": {
        "dof_count": {"type": "integer", "minimum": 6, "multipleOf": 6},
        "element_count": {"type": "integer", "minimum": 1},
        "constrained_reaction_count": {"type": "integer", "minimum": 0},
        "evaluated_member_force_value_count": {
          "type": "integer",
          "minimum": 2
        },
        "local_component_count": {"const": 12}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_assembly_scaled_linf",
        "operator_assembly_scaled_linf_tolerance",
        "free_residual_scaled_linf",
        "free_residual_scaled_linf_tolerance",
        "element_balance_scaled_linf",
        "element_balance_scaled_linf_tolerance",
        "operator_assembly_gate_passed",
        "free_equilibrium_gate_passed",
        "element_balance_gate_passed",
        "zero_prescribed_displacement_gate_passed"
      ],
      "properties": {
        "operator_assembly_scaled_linf": {"type": "number", "minimum": 0},
        "operator_assembly_scaled_linf_tolerance": {"const": 1e-12},
        "free_residual_scaled_linf": {"type": "number", "minimum": 0},
        "free_residual_scaled_linf_tolerance": {"const": 1e-10},
        "element_balance_scaled_linf": {"type": "number", "minimum": 0},
        "element_balance_scaled_linf_tolerance": {"const": 1e-10},
        "operator_assembly_gate_passed": {"const": true},
        "free_equilibrium_gate_passed": {"const": true},
        "element_balance_gate_passed": {"const": true},
        "zero_prescribed_displacement_gate_passed": {"const": true}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_profile",
        "local_components",
        "element_profile_hash",
        "artifacts"
      ],
      "properties": {
        "storage_profile": {
          "const": "canonical_little_endian_fp64_binary.v1"
        },
        "local_components": {
          "const": [
            "FX_I", "FY_I", "FZ_I", "MX_I", "MY_I", "MZ_I",
            "FX_J", "FY_J", "FZ_J", "MX_J", "MY_J", "MZ_J"
          ]
        },
        "element_profile_hash": {"$ref": "#/$defs/sha256"},
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/artifact_descriptor"}
        }
      }
    },
    "authority": {
      "const": {
        "numerical_state": "inherited_authoritative",
        "convergence": "inherited_authoritative",
        "displacement": "inherited_authoritative",
        "reaction": "authoritative",
        "member_force": "authoritative",
        "engineering_design": "not_authoritative",
        "code_compliance": "not_authoritative",
        "release_readiness": "not_authoritative",
        "commercial_use": "not_authoritative"
      }
    },
    "claim_boundary": {
      "const": {
        "linear_static_only": true,
        "zero_prescribed_displacement_only": true,
        "reaction_from_constrained_global_residual": true,
        "member_force_from_bound_local_element_law": true,
        "engineering_design": false,
        "code_compliance": false,
        "nonlinear_recovery": false,
        "legacy_output_adapter": false,
        "viewer_projection": false,
        "receipt_authenticity_established": false,
        "cpu_hip_parity_established": false,
        "release_readiness": false,
        "commercial_claim": false
      }
    },
    "extensions": {"const": {}},
    "engineering_result_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "artifact_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "dtype", "shape", "layout", "byte_order",
        "equation_scope", "unit_profile", "byte_length", "data_hash",
        "content_hash", "artifact_uri"
      ],
      "properties": {
        "name": {
          "enum": [
            "reaction_global_si",
            "equilibrium_residual_global_si",
            "member_local_end_force_si"
          ]
        },
        "dtype": {"const": "<f8"},
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 1}
        },
        "layout": {"const": "C"},
        "byte_order": {"const": "little"},
        "equation_scope": {
          "enum": [
            "global_storage_constrained_equations",
            "global_storage_free_equations",
            "element_order_local_end_force_components"
          ]
        },
        "unit_profile": {
          "enum": [
            "node_major_fx_fy_fz_n_mx_my_mz_nm.v1",
            "element_major_fx_fy_fz_n_mx_my_mz_nm_i_then_j.v1"
          ]
        },
        "byte_length": {"type": "integer", "minimum": 8},
        "data_hash": {"$ref": "#/$defs/sha256"},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "artifact_uri": {
          "type": "string",
          "pattern": "^artifact://engine-v2/engineering-results/[A-Za-z][A-Za-z0-9_.:-]{0,127}/(reaction_global|equilibrium_residual_global|member_local_end_force)\\.f64le$"
        }
      }
    }
  }
}
