{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-analysis.local/schemas/hip_fgmres_model_family_host_transfer_audit_v1.schema.json",
  "title": "HIP FGMRES model-family host-transfer audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile",
    "status",
    "attestation_id",
    "evidence_scope",
    "actual_backend",
    "promotion_eligible",
    "bindings",
    "observations",
    "totals",
    "claims",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "structural-analysis-hip-fgmres-model-family-host-transfer-audit.v1"},
    "capability_profile": {"const": "phase0_registry_gfx1030_fixed_suite_live_transfer_audit_composition"},
    "status": {"const": "primary_gfx1030_fixed_suite_audited_external_gfx1100_pending"},
    "attestation_id": {"$ref": "#/$defs/hash"},
    "evidence_scope": {"const": "process_local_registry_bound_gfx1030_fixed_suite_parity_and_per_case_bound_runtime_copy_audit_unsigned_non_promoting"},
    "actual_backend": {"const": "hip"},
    "promotion_eligible": {"const": false},
    "bindings": {"$ref": "#/$defs/bindings"},
    "observations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/observation"}
    },
    "totals": {"$ref": "#/$defs/totals"},
    "claims": {"$ref": "#/$defs/claims"},
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_bytes_sha256",
        "registry_hash",
        "source_family_schema_version",
        "source_family_receipt_hash",
        "required_architecture_base",
        "required_slot_ids"
      ],
      "properties": {
        "registry_bytes_sha256": {"$ref": "#/$defs/hash"},
        "registry_hash": {"$ref": "#/$defs/hash"},
        "source_family_schema_version": {"const": "structural-analysis-hip-fgmres-model-family-parity.v2"},
        "source_family_receipt_hash": {"$ref": "#/$defs/hash"},
        "required_architecture_base": {"const": "gfx1030"},
        "required_slot_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "logical_case_key",
        "matrix_cell_id",
        "family_observation_hash",
        "case_id",
        "case_receipt_hash",
        "audit_context_id",
        "audit_receipt_hash",
        "completion_export_context_id",
        "completion_export_receipt_hash",
        "completion_export_payload_hash",
        "global_context_id",
        "global_receipt_hash",
        "recurrence_plan_hash",
        "kernel_identity_hash",
        "kernel_source_sha256",
        "runtime_architecture_base",
        "compiled_architecture",
        "device_ordinal",
        "device_identity_receipt_hash",
        "runtime_library_sha256",
        "device_uuid_bytes_hex",
        "device_pci_bdf",
        "runtime_scope",
        "native_loader_bound_runtime",
        "free_dof_count",
        "maximum_restart_count",
        "recurrence_program_sequence_delta",
        "recurrence_program_copy_attempt_count",
        "completion_export_sequence_delta",
        "completion_export_blocking_d2h_attempt_count",
        "completion_export_blocking_d2h_success_count",
        "completion_export_blocking_d2h_failure_count",
        "completion_export_byte_count",
        "pair_binding_hash"
      ],
      "properties": {
        "slot_id": {"type": "string", "minLength": 1},
        "logical_case_key": {"$ref": "#/$defs/hash"},
        "matrix_cell_id": {"$ref": "#/$defs/hash"},
        "family_observation_hash": {"$ref": "#/$defs/hash"},
        "case_id": {"$ref": "#/$defs/hash"},
        "case_receipt_hash": {"$ref": "#/$defs/hash"},
        "audit_context_id": {"$ref": "#/$defs/hash"},
        "audit_receipt_hash": {"$ref": "#/$defs/hash"},
        "completion_export_context_id": {"$ref": "#/$defs/hash"},
        "completion_export_receipt_hash": {"$ref": "#/$defs/hash"},
        "completion_export_payload_hash": {"$ref": "#/$defs/hash"},
        "global_context_id": {"$ref": "#/$defs/hash"},
        "global_receipt_hash": {"$ref": "#/$defs/hash"},
        "recurrence_plan_hash": {"$ref": "#/$defs/hash"},
        "kernel_identity_hash": {"$ref": "#/$defs/hash"},
        "kernel_source_sha256": {"$ref": "#/$defs/hash"},
        "runtime_architecture_base": {"const": "gfx1030"},
        "compiled_architecture": {"const": "gfx1030"},
        "device_ordinal": {"$ref": "#/$defs/nonnegative"},
        "device_identity_receipt_hash": {"$ref": "#/$defs/hash"},
        "runtime_library_sha256": {"$ref": "#/$defs/hash"},
        "device_uuid_bytes_hex": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "device_pci_bdf": {"type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"},
        "runtime_scope": {"const": "exact_engine_v2_bound_context_runtime_only"},
        "native_loader_bound_runtime": {"const": true},
        "free_dof_count": {"$ref": "#/$defs/nonnegative"},
        "maximum_restart_count": {"$ref": "#/$defs/nonnegative"},
        "recurrence_program_sequence_delta": {"const": 0},
        "recurrence_program_copy_attempt_count": {"const": 0},
        "completion_export_sequence_delta": {"const": 6},
        "completion_export_blocking_d2h_attempt_count": {"const": 3},
        "completion_export_blocking_d2h_success_count": {"const": 3},
        "completion_export_blocking_d2h_failure_count": {"const": 0},
        "completion_export_byte_count": {"$ref": "#/$defs/nonnegative"},
        "pair_binding_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_slot_count",
        "paired_slot_count",
        "source_family_expected_matrix_cell_count",
        "source_family_covered_matrix_cell_count",
        "source_family_missing_matrix_cell_count",
        "audited_gfx1030_slot_count",
        "audited_gfx1100_slot_count",
        "recurrence_program_copy_attempt_count",
        "completion_export_blocking_d2h_attempt_count",
        "completion_export_blocking_d2h_success_count",
        "completion_export_blocking_d2h_failure_count",
        "completion_export_byte_count"
      ],
      "properties": {
        "required_slot_count": {"const": 10},
        "paired_slot_count": {"const": 10},
        "source_family_expected_matrix_cell_count": {"const": 20},
        "source_family_covered_matrix_cell_count": {"const": 10},
        "source_family_missing_matrix_cell_count": {"const": 10},
        "audited_gfx1030_slot_count": {"const": 10},
        "audited_gfx1100_slot_count": {"const": 0},
        "recurrence_program_copy_attempt_count": {"const": 0},
        "completion_export_blocking_d2h_attempt_count": {"const": 30},
        "completion_export_blocking_d2h_success_count": {"const": 30},
        "completion_export_blocking_d2h_failure_count": {"const": 0},
        "completion_export_byte_count": {"const": 4408}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_package_registry_and_source_family_receipt_bound",
        "exact_gfx1030_registered_ten_slot_coverage_bound",
        "ten_same_process_audit_authorities_captured_while_exported",
        "case_parity_and_audit_same_export_identity_bound",
        "case_and_audit_lineage_hashes_cross_bound",
        "per_slot_bound_runtime_recurrence_copy_attempt_zero",
        "per_slot_post_fence_exact_three_blocking_d2h",
        "composition_factory_reuses_retained_export_identity_only",
        "external_gfx1100_fixed_suite_audited",
        "unsigned_two_architecture_fixed_suite_audited",
        "process_wide_host_transfer_zero_proven",
        "pre_window_async_copy_completion_or_device_dma_activity_zero_proven",
        "raw_cdll_fresh_binding_or_third_party_transfer_zero_proven",
        "full_solver_setup_or_between_case_transfer_zero_proven",
        "same_runtime_or_stream_shared_across_all_cases_proven",
        "iteration_host_copy_zero_proven",
        "full_model_family_parity_verified",
        "multiarchitecture_parity_verified",
        "standalone_receipt_provenance_authenticity",
        "signed_evidence",
        "result_ir_verified",
        "performance_or_speedup_proven",
        "end_to_end_o_n_verified",
        "whole_process_additional_device_solve_or_export_absence_proven",
        "commercial_ready",
        "promotion_eligible"
      ],
      "properties": {
        "fixed_package_registry_and_source_family_receipt_bound": {"const": true},
        "exact_gfx1030_registered_ten_slot_coverage_bound": {"const": true},
        "ten_same_process_audit_authorities_captured_while_exported": {"const": true},
        "case_parity_and_audit_same_export_identity_bound": {"const": true},
        "case_and_audit_lineage_hashes_cross_bound": {"const": true},
        "per_slot_bound_runtime_recurrence_copy_attempt_zero": {"const": true},
        "per_slot_post_fence_exact_three_blocking_d2h": {"const": true},
        "composition_factory_reuses_retained_export_identity_only": {"const": true},
        "external_gfx1100_fixed_suite_audited": {"const": false},
        "unsigned_two_architecture_fixed_suite_audited": {"const": false},
        "process_wide_host_transfer_zero_proven": {"const": false},
        "pre_window_async_copy_completion_or_device_dma_activity_zero_proven": {"const": false},
        "raw_cdll_fresh_binding_or_third_party_transfer_zero_proven": {"const": false},
        "full_solver_setup_or_between_case_transfer_zero_proven": {"const": false},
        "same_runtime_or_stream_shared_across_all_cases_proven": {"const": false},
        "iteration_host_copy_zero_proven": {"const": false},
        "full_model_family_parity_verified": {"const": false},
        "multiarchitecture_parity_verified": {"const": false},
        "standalone_receipt_provenance_authenticity": {"const": false},
        "signed_evidence": {"const": false},
        "result_ir_verified": {"const": false},
        "performance_or_speedup_proven": {"const": false},
        "end_to_end_o_n_verified": {"const": false},
        "whole_process_additional_device_solve_or_export_absence_proven": {"const": false},
        "commercial_ready": {"const": false},
        "promotion_eligible": {"const": false}
      }
    }
  }
}
