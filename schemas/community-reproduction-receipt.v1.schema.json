{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/structural-analysis/community-reproduction-receipt.v1.schema.json",
  "title": "Structural Analysis community reproduction receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "engine_artifact_sha256",
    "execution_plan_sha256",
    "model_sha256",
    "result_sha256",
    "environment",
    "execution",
    "metrics",
    "attestation",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "community-reproduction-receipt.v1"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "engine_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "execution_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "architecture", "runtime"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "compiler": {"type": ["string", "null"]},
        "rocm_version": {"type": ["string", "null"]},
        "gpu_architecture": {"type": ["string", "null"]},
        "gpu_device_uuid": {"type": ["string", "null"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "backend",
        "fallback_count",
        "regularization_count"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "exit_code": {"type": "integer"},
        "backend": {"enum": ["cpu", "hip"]},
        "fallback_count": {"type": "integer", "minimum": 0},
        "regularization_count": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_seconds", "peak_memory_bytes"],
      "properties": {
        "runtime_seconds": {"type": "number", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "max_residual": {"type": ["number", "null"], "minimum": 0},
        "equilibrium_norm": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "independent_from_repository_author",
        "signed_at",
        "signature_reference"
      ],
      "properties": {
        "operator": {"type": "string", "minLength": 1},
        "independent_from_repository_author": {"type": "boolean"},
        "signed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "signature_reference": {"type": ["string", "null"]}
      }
    },
    "claim_boundary": {
      "const": "Receipt validation records one reproduction only and grants no product, design, hardware, external-V&V, public-support, or release authority."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
