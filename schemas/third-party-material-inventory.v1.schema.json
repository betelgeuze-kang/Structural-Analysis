{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/structural-analysis/third-party-material-inventory.v1.schema.json",
  "title": "Structural Analysis third-party material inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "third-party-material-inventory.v1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_id",
          "path_globs",
          "source_reference",
          "source_sha256",
          "license_identifier",
          "review_status",
          "permissions",
          "evidence_reference",
          "notes"
        ],
        "properties": {
          "material_id": {"type": "string", "minLength": 1},
          "path_globs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_reference": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "license_identifier": {"type": "string", "minLength": 1},
          "review_status": {"enum": ["unreviewed", "restricted", "approved"]},
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["use", "redistribution", "derivative_works", "training"],
            "properties": {
              "use": {"type": "boolean"},
              "redistribution": {"type": "boolean"},
              "derivative_works": {"type": "boolean"},
              "training": {"type": "boolean"}
            }
          },
          "evidence_reference": {"type": ["string", "null"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "claim_boundary": {
      "const": "Inventory validation records declared review metadata only and grants no software-use, data-use, redistribution, derivative-work, training, legal, open-source, commercial, or release authority."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
